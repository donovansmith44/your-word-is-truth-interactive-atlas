@using BibleAtlas.Client.Explore
@inject IJSRuntime JS

@foreach (var seg in PlaceMentions.Scan(Text, Places, Persons))
{
    @if (seg.PlaceId is { } placeId)
    {
        <span class="@ClassPrefix" data-testid="@($"{ClassPrefix}-{Verse}-{placeId}{TestIdSuffix}")"
              tabindex="0" role="button" aria-label="@($"Explore {seg.PlaceName}")"
              @onpointerenter="() => Blink(placeId, true)" @onpointerleave="() => Blink(placeId, false)"
              @onfocus="() => Blink(placeId, true)" @onblur="() => Blink(placeId, false)"
              @onclick="@(e => OpenPlace(e, placeId, seg.PlaceName!))" @onclick:stopPropagation="true"
              @onkeydown="@(e => OnPlaceKeyDown(e, placeId, seg.PlaceName!))" @onkeydown:stopPropagation="true">@seg.Text</span>
    }
    else if (seg.PersonId is { } personId)
    {
        <span class="@ClassPrefix @($"{ClassPrefix}-person")" data-testid="@($"{ClassPrefix}-person-{Verse}-{personId}{TestIdSuffix}")"
              tabindex="0" role="button" aria-label="@($"Explore {seg.PersonName}")"
              @onclick="@(e => OpenPerson(e, personId, seg.PersonName!))" @onclick:stopPropagation="true"
              @onkeydown="@(e => OnPersonKeyDown(e, personId, seg.PersonName!))" @onkeydown:stopPropagation="true">@seg.Text</span>
    }
    else
    {
        @seg.Text
    }
}

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<PlaceRef> Places { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<PersonRef> Persons { get; set; } = default!;
    [Parameter, EditorRequired] public int Verse { get; set; }
    [Parameter, EditorRequired] public string ClassPrefix { get; set; } = default!;
    [Parameter] public string TestIdSuffix { get; set; } = "";
    [Parameter, EditorRequired] public EventCallback<IExplorable> OnExplore { get; set; }

    [Parameter] public EventCallback<IExplorable> OnToggleSelect { get; set; }

    private Task Blink(string placeId, bool active) => MapInterop.BlinkPlace(JS, placeId, active);

    private Task OpenPlace(MouseEventArgs e, string placeId, string placeName)
    {
        var node = new PlaceNode(placeId, placeName);
        return e.CtrlKey || e.MetaKey ? OnToggleSelect.InvokeAsync(node) : OnExplore.InvokeAsync(node);
    }

    private Task OpenPerson(MouseEventArgs e, string personId, string personName)
    {
        var node = new PersonNode($"Person:{personId}", personName);
        return e.CtrlKey || e.MetaKey ? OnToggleSelect.InvokeAsync(node) : OnExplore.InvokeAsync(node);
    }

    private Task OnPlaceKeyDown(KeyboardEventArgs e, string placeId, string placeName) => e.Key == "Enter" ? OnExplore.InvokeAsync(new PlaceNode(placeId, placeName)) : Task.CompletedTask;
    private Task OnPersonKeyDown(KeyboardEventArgs e, string personId, string personName) => e.Key == "Enter" ? OnExplore.InvokeAsync(new PersonNode($"Person:{personId}", personName)) : Task.CompletedTask;
}
