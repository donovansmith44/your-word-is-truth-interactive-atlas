@inject IPresenter Presenter
@implements IDisposable

@if (_request is { } request)
{
    @_outcome?.Match(arrived: Body, failed: () => Failure(request), superseded: () => Nothing)
}

@code {
    [Parameter, EditorRequired] public Explorable Node { get; set; } = default!;

    [Parameter, EditorRequired] public Surface Surface { get; set; }

    [Parameter, EditorRequired] public EventCallback<Link> OnFollow { get; set; }

    [Parameter] public EventCallback OnShowOnWorld { get; set; }

    [Parameter] public EventCallback OnMoved { get; set; }

    private readonly RequestSeries _series = new();
    private PresentationRequest? _request;
    private Outcome<Presented>? _outcome;

    private sealed record Presented(PresentationRequest Request, Presentation? Presentation, IReadOnlyDictionary<EdgeKind, PageWindow<Entry>> Windows)
    {
        public void Stop()
        {
            foreach (var window in Windows.Values)
            {
                window.Stop();
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        var request = new PresentationRequest(Node, Surface);
        if (request == _request)
        {
            return;
        }

        _request = request;
        await Load(request);
    }

    public void Dispose()
    {
        _series.Stop();
        Retire();
    }

    private async Task Load(PresentationRequest request)
    {
        Retire();
        _outcome = null;
        var groups = request.Element.Groups;
        var outcome = await _series.Next().Fetch(() => Presenter.Present(request), () => Task.WhenAll(groups.Select(group => Paging.Window(request, group.Kind))));
        var presented = outcome.Select(loaded => new Presented(request, loaded.Item1, groups.Zip(loaded.Item2).ToDictionary(pair => pair.First.Kind, pair => pair.Second)));
        _outcome = presented.Match(arrived: _ => presented, failed: () => presented, superseded: () => _outcome);
        await presented.Match(arrived: _ => Task.CompletedTask, failed: () => Renewing(request), superseded: () => Task.CompletedTask);
    }

    private Task Renewing(PresentationRequest request) => request.Element.Moved ? OnMoved.InvokeAsync() : Task.CompletedTask;

    private Task Retry(PresentationRequest request) => request.Element.Moved ? OnMoved.InvokeAsync() : Load(request);

    private void Retire() => _outcome?.Match(arrived: presented => presented.Stop(), failed: () => { }, superseded: () => { });

    private async Task Turned(PresentationRequest request, Task<Outcome<Unit>> turning) =>
        await (await turning).Match(
            arrived: _ => Task.CompletedTask,
            failed: () =>
            {
                Retire();
                _outcome = new Outcome<Presented>.Failed();
                return Renewing(request);
            },
            superseded: () => Task.CompletedTask);

    private RenderFragment Failure(PresentationRequest request) => __builder =>
    {
        <CouldNotLoad OnRetry="() => Retry(request)" />
    };

    private static RenderFragment Nothing => _ => { };

    private RenderFragment Body(Presented presented) => __builder =>
    {
        var request = presented.Request;
        var handle = Handle(request.Surface);

        @if (OnShowOnWorld.HasDelegate && HomeSurfaces.Of(request.Element.Kind) == Surface.World)
        {
            <button type="button" class="popover-head-action" data-testid="@($"{handle}-chip-map")" aria-label="Show on the map" title="Show on the map"
                    @onclick="() => OnShowOnWorld.InvokeAsync()">&#8982;</button>
        }

        @foreach (var end in request.Element.Ends.Where(request.Offers))
        {
            <button type="button" class="focus-up explorable" data-testid="@($"{handle}-end-{Id(end)}")"
                    @onclick="() => OnFollow.InvokeAsync(end)">@Label(end)</button>
        }

        @foreach (var (group, _) in Offered<Affordance.UpCrumb>(request))
        {
            @foreach (var entry in Shown(presented, group))
            {
                <button type="button" class="focus-up explorable" data-testid="@($"{handle}-up-{group.Kind.WireName()}-{Id(entry.Neighbour)}")"
                        @onclick="() => OnFollow.InvokeAsync(entry.Neighbour)">@Label(entry.Neighbour)</button>
                @EdgeStep(request, entry)
            }
            @Reveal(presented, group, $"{handle}-up-{group.Kind.WireName()}")
        }

        @if (presented.Presentation is Presentation.Card card)
        {
            <div class="popover-section" data-testid="@($"{handle}-section-card")">
                <p class="focus-title" data-testid="@($"{handle}-card-title")">@card.Title</p>
                @Fields(handle, card.Fields)
            </div>
        }

        @if (presented.Presentation is Presentation.Text text)
        {
            <div class="popover-section" data-testid="@($"{handle}-section-text")">
                <UnitTextView Unit="text.Unit" Handle="@handle" OnFollow="OnFollow" />
                @Fields(handle, text.Fields)
            </div>
        }

        @foreach (var (group, arrows) in Offered<Affordance.Arrows>(request))
        {
            @foreach (var entry in Shown(presented, group))
            {
                <button type="button" class="focus-arrow explorable" data-testid="@($"{handle}-{ArrowHandle(arrows.Direction)}")"
                        @onclick="() => OnFollow.InvokeAsync(entry.Neighbour)">@Arrowed(arrows.Direction, Label(entry.Neighbour))</button>
                @EdgeStep(request, entry)
            }
            @Reveal(presented, group, $"{handle}-{ArrowHandle(arrows.Direction)}")
        }

        @foreach (var (group, _) in Offered<Affordance.InlineChildren>(request))
        {
            var section = $"{handle}-children-{group.Kind.WireName()}";
            <div class="popover-section" data-testid="@section">
                @foreach (var entry in Shown(presented, group))
                {
                    <button type="button" class="focus-child explorable" data-testid="@($"{handle}-child-{group.Kind.WireName()}-{Id(entry.Neighbour)}")"
                            @onclick="() => OnFollow.InvokeAsync(entry.Neighbour)">@Label(entry.Neighbour)</button>
                    @EdgeStep(request, entry)
                }
                @Reveal(presented, group, section)
            </div>
        }

        @foreach (var (group, list) in Offered<Affordance.SectionList>(request))
        {
            var section = $"{handle}-section-{group.Kind.WireName()}";
            <div class="popover-section" data-testid="@section">
                <p class="catechism-section-heading" data-testid="@($"{section}-heading")">@Heading(request.Surface, group)</p>
                @foreach (var entry in Shown(presented, group))
                {
                    <button type="button" class="focus-link @Register(list.Style)" data-testid="@($"{handle}-link-{group.Kind.WireName()}-{Id(entry.Neighbour)}")"
                            @onclick="() => OnFollow.InvokeAsync(entry.Neighbour)">@Label(entry.Neighbour)</button>
                    @EdgeStep(request, entry)
                }
                @Reveal(presented, group, section)
            </div>
        }
    };

    private static RenderFragment Fields(string handle, IReadOnlyList<Presentation.Field> fields) => __builder =>
    {
        <dl class="focus-fields">
            @foreach (var field in fields)
            {
                <div class="focus-field" data-testid="@($"{handle}-field-{field.Name}")"><dt>@field.Name</dt><dd>@field.Value</dd></div>
            }
        </dl>
    };

    private static IEnumerable<Entry> Shown(Presented presented, FrontierGroup group) => presented.Windows[group.Kind].Shown;

    private RenderFragment Reveal(Presented presented, FrontierGroup group, string handle) => __builder =>
    {
        var window = presented.Windows[group.Kind];
        <PageControls Position="window.Position(group.Count)"
                      OnMore="() => Turned(presented.Request, window.More())" OnLess="() => Turned(presented.Request, window.Fewer())"
                      MoreTestId="@($"{handle}-more")" LessTestId="@($"{handle}-collapse")" PositionTestId="@($"{handle}-position")" />
    };

    private static string Id(Link link) => Positions.Of(link.Target).Id;

    private static string Label(Link link) => Positions.Of(link.Target).Label;

    private static string Heading(Surface surface, FrontierGroup group) =>
        surface == Surface.Popover ? $"{group.Kind.DisplayLabel()} ({group.Count})" : group.Kind.DisplayLabel();

    private static string ArrowHandle(ArrowDirection direction) => direction switch
    {
        ArrowDirection.Previous => "prev",
        ArrowDirection.Next => "next",
    };

    private static string Arrowed(ArrowDirection direction, string label) => direction switch
    {
        ArrowDirection.Previous => $"‹ {label}",
        ArrowDirection.Next => $"{label} ›",
    };

    private RenderFragment EdgeStep(PresentationRequest request, Entry entry) => __builder =>
    {
        @if (request.Offers(entry.Edge))
        {
            var handle = Handle(request.Surface);
            <button type="button" class="focus-entry-edge explorable-quiet" data-testid="@($"{handle}-entry-edge-{entry.Edge.Kind.WireName()}-{Id(entry.Edge)}")"
                    aria-label="@Label(entry.Edge)" title="@Label(entry.Edge)" @onclick="() => OnFollow.InvokeAsync(entry.Edge)">&#8942;</button>
        }
    };

    private static IEnumerable<(FrontierGroup Group, T Affordance)> Offered<T>(PresentationRequest request) where T : Affordance
    {
        foreach (var group in request.Element.Groups)
        {
            if (Affordances.Of(group.Kind) is T affordance)
            {
                yield return (group, affordance);
            }
        }
    }

    private static string Handle(Surface surface) => surface switch
    {
        Surface.World => "world",
        Surface.Reader => "reader",
        Surface.Popover => "popover",
    };

    private static string Register(SectionStyle style) => style switch
    {
        SectionStyle.Standard => "explorable",
        SectionStyle.Quiet => "explorable-quiet",
    };
}
