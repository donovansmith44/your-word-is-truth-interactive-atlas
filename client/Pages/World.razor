    private PlaceChooser.Choice? ChoiceOf(string id) =>
        _scene?.Places.Where(p => p.Id == id).Select(PlaceChooser.Choice.Of).FirstOrDefault()
        ?? _scene?.QuietPlaces.Where(p => p.Id == id).Select(PlaceChooser.Choice.Of).FirstOrDefault();

