@page "/concord"
@using BibleAtlas.Client.Explore
@using BibleAtlas.Client.State
@using BibleAtlas.Client.Views
@inject IExplorableClient Graph
@inject AtlasClient Atlas

@* Batch CORPREAD-1b (ticket C, owner order verbatim: "I want to be able ot
   read it like the normal BoC. Everything doesn't need to be shown
   visually as belonging to these boxes. It should be a smooth reading
   experiecne like the Bible, except verses and verse fragements and
   verse/passage references are explorable. I should have a menu through
   which I can navigate to different parts in the BoC.") -- REBUILDS
   CORP-1's own bordered-row list (see git history, R3) into a CONTINUOUS
   READING SURFACE: the SAME reading-column register Kretzmann.razor and
   Reader.razor both now share -- part/article STRUCTURE carried by
   TYPOGRAPHY (a part heading, an article heading, each interleaved
   directly in the reading flow the moment the window crosses into a new
   one -- BuildRenderRows below), never a container.

   NAV MENU (ticket C): a "Contents" toggle reveals a panel over the BoC's
   own canon -- Explore/ConcordToc.cs's ten traditional documents (Creeds,
   AC, Apology, Smalcald, Treatise, SC, LC, FC, plus the Preface and the
   Formula's two forms), mirrored from `atlas-etl/src/concord.rs`'s own
   `DOCUMENTS: &[ConcordDocSpec]` table (read directly before writing, not
   guessed -- fix round S-7 trivia: an earlier draft of this comment named
   this table "CONCORD_DOC_SPECS," which is the RECORD TYPE's name
   (`ConcordDocSpec`), not the constant's own real name; the content mirror
   itself was always exact, verified line by line -- this was a citation
   slip only, corrected here and in ConcordToc.cs/CONTRACT.md).
   Jumping loads that document's own opening window (BoC {part}.1.1) into
   the SAME reading-flow body every other navigation renders through --
   never a bare fragment. The pre-existing numeric part/article/paragraph
   picker stays too (fine-grained jump beyond the menu's own per-document
   granularity) -- both live under one grouped "controls" cluster (design
   discipline, not chrome clutter).

   SCRIPTURE REFS + QUOTED FRAGMENTS EXPLORABLE (ticket C, "same mechanism
   as ticket K -- do not fork the scanner"): every unit's own confession
   text renders through the SAME Components/ScriptureRefText.razor scanner
   Kretzmann.razor uses.

   VIEW-LOCAL STATE, UNCHANGED (R3/ST-3 D2): `_currentRef` stays ordinary
   component state, not an atom -- this ticket's own text says so
   explicitly ("Concord's browse position stays VIEW-LOCAL state ... no
   sixth atom, no allowlist growth") -- nothing about this mechanism
   changes in this batch.

   Official host recipe (CompositionSplit.razor's own header): unchanged --
   follows Sources.razor verbatim, same as Kretzmann.razor. *@

<PageTitle>Bible Explorer &mdash; Concord</PageTitle>

<CompositionSplit HostName="@ViewNames.Concord" SplitModeOverride="@SplitMode" HostPaneClass="split-pane-host" Context="ctx">
    <div class="@($"concord-page{ctx.HostPaneClassSuffix}")" data-testid="concord-page">
        <article class="concord-column reader-column">
            <h1 class="concord-title">The Book of Concord</h1>
            <p class="concord-intro">
                The Lutheran confessions of 1580 &mdash; the church's own
                confession, subordinate to the Scripture it confesses.
            </p>

            <div class="concord-controls">
                <button type="button" class="concord-toc-toggle" data-testid="concord-toc-toggle"
                        aria-expanded="@(_tocOpen ? "true" : "false")" aria-controls="concord-toc-menu" @onclick="ToggleToc">
                    Contents
                </button>

                @if (!ctx.IsSplitOpen)
                {
                    <button type="button" class="split-open split-open-parchment" data-testid="split-open-concord"
                            @onclick="ctx.InvokeHatch">
                        Read beside the reader
                    </button>
                }
            </div>

            @if (_tocOpen)
            {
                @* Ticket C, "a menu through which I can navigate to
                   different parts in the BoC" -- a reader's
                   table-of-contents affordance, collapsed by default (no
                   chrome clutter), the traditional documents in canon
                   order. *@
                <nav class="concord-toc-menu" id="concord-toc-menu" data-testid="concord-toc-menu" aria-label="Book of Concord contents">
                    <ul class="concord-toc-list">
                        @foreach (var doc in ConcordToc.Documents)
                        {
                            <li>
                                <button type="button" class="concord-toc-item" data-testid="@($"concord-toc-part-{doc.Part}")"
                                        @onclick="@(() => JumpToPartAsync(doc.Part))">
                                    @doc.Title
                                </button>
                            </li>
                        }
                    </ul>
                </nav>
            }

            <form class="concord-picker" data-testid="concord-picker" @onsubmit="JumpToAsync">
                <label class="concord-picker-field">
                    <span class="concord-picker-label">Part</span>
                    <input class="concord-picker-input" type="number" min="1" data-testid="concord-picker-part" @bind="_jumpPart" />
                </label>
                <label class="concord-picker-field">
                    <span class="concord-picker-label">Article</span>
                    <input class="concord-picker-input" type="number" min="1" data-testid="concord-picker-article" @bind="_jumpArticle" />
                </label>
                <label class="concord-picker-field">
                    <span class="concord-picker-label">Paragraph</span>
                    <input class="concord-picker-input" type="number" min="1" data-testid="concord-picker-paragraph" @bind="_jumpParagraph" />
                </label>
                <button type="submit" class="picker-apply" data-testid="concord-picker-go">Go</button>
            </form>

            @* Fix round (Q-7, TRIVIA -- review): this used to be an `<h2>`
               with its own bronze rule, stacked directly above
               `.concord-part-heading`'s own bronze rule -- two rules, and a
               machine citation ("BoC 1.1.1") sitting in HEADING position,
               exactly the "page of BoC x.x.x labels" the owner complained
               about (the boxes are gone; this one label wasn't). Demoted to
               a plain `<p>`, quiet register (app.css's own `.concord-
               position`) -- a position ANNOUNCEMENT, not a document
               heading; `.concord-part-heading` is the one real heading now. *@
            <p class="concord-position" data-testid="concord-position">@_currentRef</p>

            @if (_error is not null)
            {
                <div class="toast" data-testid="toast">
                    <p class="toast-message">@_error</p>
                </div>
            }
            else if (_loading)
            {
                <p class="concord-loading">Loading&hellip;</p>
            }
            else
            {
                @foreach (var row in RenderRows)
                {
                    if (row is PartHeadingRow ph)
                    {
                        <h2 class="concord-part-heading" data-testid="@($"concord-part-heading-{ph.Part}")">@ph.Title</h2>
                    }
                    else if (row is ArticleHeadingRow ah)
                    {
                        <h3 class="concord-article-heading" data-testid="@($"concord-article-heading-{ah.Part}-{ah.Article}")">Article @ah.Article</h3>
                    }
                    else if (row is UnitRow ur)
                    {
                        var unit = ur.Unit;
                        @* Fix round (Q-6, IMPORTANT -- review): dropped the
                           `aria-label="Explore ..."` this wrapper used to
                           carry -- it REPLACED the accessible name, so a
                           screen reader announced only "Explore BoC x.x.x,
                           button" and never read the confession paragraph
                           itself. The element's own text content (the ref
                           label + the paragraph) is now its accessible name
                           -- still focusable/actionable via tabindex+Enter,
                           unchanged. Mirrors Kretzmann.razor's own identical
                           fix, same finding, same reasoning. *@
                        <div class="concord-unit explorable" data-testid="@($"concord-unit-{Slug(unit.Ref)}")"
                             tabindex="0" role="button"
                             @onclick="@(() => OnExplore(unit))" @onkeydown="@(e => OnUnitKeyDown(e, unit))">
                            <span class="concord-unit-ref">@unit.Ref</span>
                            <ScriptureRefText Text="@unit.Text" Toc="@(_toc ?? EmptyToc)" ClassPrefix="concord-ref"
                                               OwnerSlug="@Slug(unit.Ref)" OnExplore="OnExploreNode" />
                        </div>
                    }
                }

                <nav class="concord-nav" aria-label="Concord navigation">
                    @if (_prevRef is not null)
                    {
                        <button type="button" class="concord-nav-button" data-testid="concord-prev" @onclick="GoBackward">&lsaquo; Previous</button>
                    }
                    @if (_nextRef is not null)
                    {
                        <button type="button" class="concord-nav-button" data-testid="concord-next" @onclick="GoForward">Next &rsaquo;</button>
                    }
                </nav>
            }
        </article>
    </div>
</CompositionSplit>

@if (_activeNode is not null)
{
    <ExplorerPopover @key="_activeNode" Root="_activeNode" OnClose="ClosePopover" />
}

@code {
    private const int PageSize = 20;
    private const string DefaultRef = "BoC 1.1.1";

    private abstract record ConcordRenderRow;
    private sealed record PartHeadingRow(int Part, string Title) : ConcordRenderRow;
    private sealed record ArticleHeadingRow(int Part, int Article) : ConcordRenderRow;
    private sealed record UnitRow(TextUnitDto Unit) : ConcordRenderRow;

    private static readonly List<BookTocEntry> EmptyToc = new();

    [Parameter] public bool? SplitMode { get; set; }

    // R3: view-local UI state -- see this file's own header for why this is
    // deliberately NOT an atom.
    private string _currentRef = DefaultRef;
    private List<TextUnitDto> _units = new();
    private string? _nextRef;
    private string? _prevRef; // the position this page's own window started FROM, kept for "Previous" -- see GoBackward's own comment
    private bool _loading = true;
    private string? _error;
    private int _requestId;
    private IExplorable? _activeNode;
    private bool _tocOpen;

    private int? _jumpPart;
    private int? _jumpArticle;
    private int? _jumpParagraph;

    // Batch CORPREAD-1b (ticket C, "scripture refs ... explorable, same
    // mechanism as ticket K"): the app's own canonical book TOC, fetched
    // once, feeding ScriptureRefText's own scanner exactly like
    // Kretzmann.razor does.
    private List<BookTocEntry>? _toc;

    private static string Slug(string reference) => reference.Replace(' ', '-').Replace('.', '-');

    // Batch CORPREAD-1b (ticket C): part/article structure carried by
    // TYPOGRAPHY -- a fresh part/article heading is emitted the instant the
    // window's own ordered units cross into one, interleaved directly with
    // the unit rows (never a container grouping them). Recomputed whenever
    // `_units` changes (a plain property, not cached -- this window is at
    // most PageSize=20 units, recomputation is immaterial).
    private List<ConcordRenderRow> RenderRows
    {
        get
        {
            var rows = new List<ConcordRenderRow>();
            int? lastPart = null;
            int? lastArticle = null;
            foreach (var unit in _units)
            {
                var (part, article, _) = ParseRef(unit.Ref);
                if (part != lastPart)
                {
                    rows.Add(new PartHeadingRow(part, ConcordToc.TitleOf(part)));
                    lastPart = part;
                    lastArticle = null;
                }
                if (article != lastArticle)
                {
                    rows.Add(new ArticleHeadingRow(part, article));
                    lastArticle = article;
                }
                rows.Add(new UnitRow(unit));
            }
            return rows;
        }
    }

    private static (int Part, int Article, int Paragraph) ParseRef(string reference)
    {
        var afterPrefix = reference.StartsWith("BoC ", StringComparison.Ordinal) ? reference[4..] : reference;
        var parts = afterPrefix.Split('.');
        return (int.Parse(parts[0]), int.Parse(parts[1]), int.Parse(parts[2]));
    }

    private void ToggleToc() => _tocOpen = !_tocOpen;

    // Batch CORPREAD-1b (ticket C, "jump anywhere; landing position renders
    // the target in reading flow"): jumps to the document's own opening
    // paragraph -- the SAME LoadWindowAsync every other navigation uses, so
    // the landing is a full reading-flow window, never a bare fragment.
    private Task JumpToPartAsync(int part)
    {
        _tocOpen = false;
        _currentRef = ConcordToc.StartRef(part);
        return LoadWindowAsync(_currentRef, "onward");
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _toc = await Atlas.Books();
        }
        catch (Exception)
        {
            // Non-fatal -- ScriptureRefText simply renders no explorable
            // refs until the TOC resolves (Scan's own toc.Count==0
            // short-circuit); the confession text itself still renders.
        }

        await LoadWindowAsync(_currentRef, "onward");
    }

    private Task JumpToAsync()
    {
        var part = _jumpPart is > 0 ? _jumpPart.Value : 1;
        var article = _jumpArticle is > 0 ? _jumpArticle.Value : 1;
        var paragraph = _jumpParagraph is > 0 ? _jumpParagraph.Value : 1;
        _currentRef = $"BoC {part}.{article}.{paragraph}";
        return LoadWindowAsync(_currentRef, "onward");
    }

    private Task GoForward() => _nextRef is { } next ? LoadWindowAsync(next, "onward") : Task.CompletedTask;

    // "Previous" walks backward N units ENDING at this page's own first
    // unit -- the reading spine's own `dir=backward` semantics (server:
    // graph_handlers.rs's own text_window doc comment: "walks the window
    // ending AT ref instead of starting from it").
    private Task GoBackward() => _prevRef is { } prev ? LoadWindowAsync(prev, "backward") : Task.CompletedTask;

    private async Task LoadWindowAsync(string fromRef, string dir)
    {
        var myRequest = ++_requestId;
        _loading = true;
        _error = null;
        _activeNode = null;
        StateHasChanged();

        try
        {
            var window = await Graph.Reading(fromRef, PageSize, dir, corpus: "concord");
            if (myRequest != _requestId)
            {
                return;
            }

            _units = window.Units;

            // CORP-1 trivia (batch-corp1-report.md §13): dir=backward's own
            // server semantics walk a window ENDING AT fromRef, INCLUSIVE --
            // so fromRef itself (the unit already shown as the page we're
            // paging backward FROM) reappears as this window's own last row.
            // Trim that one boundary duplicate here rather than displaying
            // it twice; forward-paging from the trimmed page must then land
            // back on fromRef (the unit we just removed), not on whatever
            // `window.Next` the server computed past it -- otherwise Forward
            // would skip the very unit Previous just hid.
            if (dir == "backward" && _units.Count > 0 && _units[^1].Ref == fromRef)
            {
                _units.RemoveAt(_units.Count - 1);
                _nextRef = fromRef;
            }
            else
            {
                _nextRef = window.Next;
            }

            _currentRef = _units.Count > 0 ? _units[0].Ref : fromRef;
            // "Previous" from here means: walk backward from THIS window's
            // own first unit (exclusive of it) -- the same anchor the
            // server's own dir=backward semantics already resolve against.
            // No "Previous" from the corpus's own true first paragraph
            // (the Preface's own BoC 1.1.1) -- there is nothing earlier to
            // walk back to, and the reading spine has no "prev" field of its
            // own to check this against (only Next); DefaultRef IS that one
            // known fixed point.
            _prevRef = _units.Count > 0 && _units[0].Ref != DefaultRef ? _units[0].Ref : null;
        }
        catch (Exception)
        {
            if (myRequest != _requestId)
            {
                return;
            }

            _error = "Couldn't load this part of the Book of Concord — check your connection and try again.";
        }
        finally
        {
            if (myRequest == _requestId)
            {
                _loading = false;
                StateHasChanged();
            }
        }
    }

    private void OnExplore(TextUnitDto unit) => _activeNode = new ConcordUnitNode(unit.Ref, unit.Text);

    private void OnUnitKeyDown(KeyboardEventArgs e, TextUnitDto unit)
    {
        if (e.Key == "Enter")
        {
            OnExplore(unit);
        }
    }

    // Batch CORPREAD-1b (ticket C, "verses and verse fragments and
    // verse/passage references are explorable"): ScriptureRefText's own
    // OnExplore callback -- a plain VerseNode push, ONE-RULE, the same
    // shape Kretzmann.razor's OnExploreNode already establishes.
    private void OnExploreNode(IExplorable node) => _activeNode = node;

    private void ClosePopover() => _activeNode = null;
}
