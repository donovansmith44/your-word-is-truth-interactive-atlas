@using BibleAtlas.Client.Exploring

<div class="@RowClass" data-testid="@RowTestId" data-focal="@(Focal ? "true" : "false")" id="@Id"
     tabindex="0" role="button" aria-label="@($"Explore {Unit.Node.Label}")"
     @onclick="OnRowClick" @onkeydown="@(e => OnLineKeyDown(e))">
    @if (ShowVerseNumButton)
    {
        <button type="button" class="@VerseNumClass" data-testid="@VerseNumTestId"
                @onclick="@(e => OnVerseNumClick.InvokeAsync(e))" @onclick:stopPropagation="true"
                @onkeydown:stopPropagation="true">@Verse.Number</button>
    }
    else
    {
        <span class="@VerseNumClass">@Verse.Number</span>
    }
    <span class="@TextClass">
        <MentionText Text="@Unit.Body.Text" Anchors="@Unit.Body.Anchors" WordsOfChrist="@Unit.Body.WordsOfChrist" Verse="@Verse.Number"
                     ClassPrefix="@MentionClass" TestIdSuffix="@TestIdSuffix" OnExplore="OnExplore" OnToggleSelect="OnToggleSelect" />
        @if (ShowXrefMarker)
        {
            <sup class="verse-xref-marker" data-testid="@XrefMarkerTestId"
                 tabindex="0" role="button" aria-label="@XrefMarkerAriaLabel"
                 @onclick="() => OnXrefClick.InvokeAsync(Verse.Number)" @onclick:stopPropagation="true"
                 @onmouseenter="() => OnXrefHoverEnter.InvokeAsync(Verse.Number)" @onmouseleave="() => OnXrefHoverLeave.InvokeAsync()"
                 @onfocus="() => OnXrefClick.InvokeAsync(Verse.Number)"
                 @onkeydown="@(e => OnXrefKeyDown(e))" @onkeydown:stopPropagation="true">@XrefMarkerGlyph</sup>
        }
    </span>
</div>

@code {
    [Parameter, EditorRequired] public Verse Verse { get; set; } = default!;
    [Parameter, EditorRequired] public TextUnit Unit { get; set; } = default!;

    [Parameter, EditorRequired] public EventCallback<PopoverOpening> OnExplore { get; set; }

    [Parameter] public EventCallback<NodeRef> OnToggleSelect { get; set; }

    private Task OnRowClick(MouseEventArgs e) =>
        e.CtrlKey || e.MetaKey ? OnToggleSelect.InvokeAsync(Unit.Node) : Explore();

    private Task Explore() => OnExplore.InvokeAsync(new PopoverOpening.Explore(new NodePosition(Unit.Node)));

    [Parameter] public bool Focal { get; set; }

    [Parameter] public string? Id { get; set; }

    [Parameter, EditorRequired] public string RowClass { get; set; } = default!;
    [Parameter, EditorRequired] public string RowTestIdPrefix { get; set; } = default!;

    [Parameter] public string TestIdSuffix { get; set; } = "";

    [Parameter, EditorRequired] public string VerseNumClass { get; set; } = default!;

    [Parameter] public bool ShowVerseNumButton { get; set; }
    [Parameter] public string? VerseNumTestIdPrefix { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnVerseNumClick { get; set; }

    [Parameter, EditorRequired] public string TextClass { get; set; } = default!;
    [Parameter, EditorRequired] public string MentionClass { get; set; } = default!;

    [Parameter] public string XrefMarkerTestIdPrefix { get; set; } = "verse-xref-marker";

    [Parameter, EditorRequired] public string XrefMarkerGlyph { get; set; } = default!;

    [Parameter, EditorRequired] public EventCallback<int> OnXrefClick { get; set; }

    [Parameter] public EventCallback<int> OnXrefHoverEnter { get; set; }
    [Parameter] public EventCallback OnXrefHoverLeave { get; set; }

    private string RowTestId => $"{RowTestIdPrefix}-{Verse.Number}{TestIdSuffix}";

    private string? VerseNumTestId => VerseNumTestIdPrefix is { } prefix ? $"{prefix}-{Verse.Number}{TestIdSuffix}" : null;

    // Ordinal among the chapter's xref-bearing verses, in reading order ("a" for the first) --
    // computed once per chapter, never a mutable counter incremented during this row's own render.
    public static Dictionary<int, string> ComputeXrefLetters(IReadOnlyList<Verse> verses)
    {
        var map = new Dictionary<int, string>();
        var ordinal = 0;
        foreach (var v in verses)
        {
            if (v.XrefCount > 0)
            {
                ordinal++;
                map[v.Number] = BijectiveBase26(ordinal);
            }
        }
        return map;
    }

    // Bijective base-26 (like spreadsheet column names): unlike plain base-26 there's no zero
    // digit, so "aa" (27) is genuinely distinct from "a" (1) rather than colliding with it.
    public static string BijectiveBase26(int n)
    {
        var letters = "";
        while (n > 0)
        {
            n -= 1;
            letters = (char)('a' + n % 26) + letters;
            n /= 26;
        }
        return letters;
    }

    private bool ShowXrefMarker => FeatureFlags.XrefSuperscripts && Verse.XrefCount > 0;

    private string XrefMarkerAriaLabel => $"Cross-references for verse {Verse.Number}";
    private string XrefMarkerTestId => $"{XrefMarkerTestIdPrefix}-{Verse.Number}{TestIdSuffix}";

    private Task OnLineKeyDown(KeyboardEventArgs e) => e.Key == "Enter" ? Explore() : Task.CompletedTask;
    private Task OnXrefKeyDown(KeyboardEventArgs e) => e.Key == "Enter" ? OnXrefClick.InvokeAsync(Verse.Number) : Task.CompletedTask;
}
