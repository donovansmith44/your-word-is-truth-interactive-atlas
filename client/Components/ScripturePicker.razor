@inject AtlasClient Atlas

<div class="picker @ThemeClass" data-testid="picker">
    <p class="picker-eyebrow">Scripture</p>

    <select class="picker-select" data-testid="picker-book" aria-label="Book"
            @bind="_bookCode" @bind:after="OnBookChanged">
        @if (_toc is not null)
        {
            @foreach (var b in _toc)
            {
                <option value="@b.Code">@b.Name</option>
            }
        }
    </select>

    <select class="picker-select" data-testid="picker-chapter" aria-label="Chapter"
            @bind="_chapterText" @bind:after="OnChapterChanged">
        <option value="">Chapter</option>
        @for (var c = 1; c <= ChapterCount; c++)
        {
            <option value="@c">@c</option>
        }
    </select>

    <input class="picker-verse" type="number" data-testid="picker-verse-from" aria-label="From verse"
           min="1" max="@MaxVerse" disabled="@(SelectedChapter is null)"
           value="@_verseFrom.Text" @oninput="OnVerseFromInput" />
    <span class="picker-verse-sep" aria-hidden="true">&ndash;</span>
    <input class="picker-verse" type="number" data-testid="picker-verse-to" aria-label="To verse"
           min="1" max="@MaxVerse" disabled="@(SelectedChapter is null)"
           value="@_verseTo.Text" @oninput="OnVerseToInput" />

    <button type="button" class="picker-apply" data-testid="picker-apply" @onclick="Apply">Go</button>
</div>

@code {
    [Parameter, EditorRequired] public EventCallback<string> OnApply { get; set; }
    [Parameter, EditorRequired] public string ThemeClass { get; set; } = "";

    // Null (World.razor's mount) means "don't sync at all."
    [Parameter] public string? CurrentBook { get; set; }
    [Parameter] public int? CurrentChapter { get; set; }

    // An opaque counter the mounting page bumps to force a resync even when
    // CurrentBook/CurrentChapter haven't changed -- needed because a toggle (e.g. World's
    // follow chip flipping off then back on) can leave those values byte-identical across
    // the cycle while still needing the dropdowns re-synced.
    [Parameter] public int SyncToken { get; set; }
    private int _syncedToken;

    private readonly RequestSeries _startup = new();
    private List<CanonBook>? _toc;
    private string _bookCode = "";
    private string _chapterText = "";
    private Draft _verseFrom = Draft.Empty;
    private Draft _verseTo = Draft.Empty;

    // The last (book, chapter) actually synced to the dropdowns -- distinct from
    // _bookCode/_chapterText, which the user's own live selection also mutates.
    private (string Book, int Chapter)? _synced;

    // Blazor does not wait for this method's in-flight Atlas.Books() fetch before invoking a
    // later SetParametersAsync/OnParametersSet on the same instance, so Reader's real routed
    // CurrentBook/CurrentChapter can arrive and correctly sync while this fetch is still
    // pending. Reading CurrentBook/CurrentChapter fresh here (not a value captured before the
    // await) keeps the unconditional _toc[0] fallback below from clobbering that sync once this resolves.
    protected override async Task OnInitializedAsync()
    {
        _toc = await _startup.Next().Fetch(() => Atlas.Books());
        if (_toc is null || _toc.Count == 0)
        {
            return;
        }

        if (CurrentBook is { } book && CurrentChapter is { } chapter)
        {
            _synced = (book, chapter);
            _syncedToken = SyncToken;
            _bookCode = book;
            _chapterText = chapter.ToString();
        }
        else
        {
            _bookCode = _toc[0].Code;
        }
    }

    protected override void OnParametersSet()
    {
        if (CurrentBook is not { } book || CurrentChapter is not { } chapter)
        {
            return; // World.razor's mount -- stays unsynced
        }

        var forced = _syncedToken != SyncToken;

        if (!forced && _synced is { } prior && prior.Book == book && prior.Chapter == chapter)
        {
            return; // already reflects this exact chapter -- don't clobber in-progress typing
        }

        _synced = (book, chapter);
        _syncedToken = SyncToken;
        _bookCode = book;
        _chapterText = chapter.ToString();
        _verseFrom = Draft.Empty;
        _verseTo = Draft.Empty;
    }

    private CanonBook? SelectedBookEntry => _toc?.FirstOrDefault(b => b.Code == _bookCode);
    private int ChapterCount => SelectedBookEntry?.Chapters.Count ?? 0;

    private int? SelectedChapter =>
        int.TryParse(_chapterText, out var c) && c >= 1 && c <= ChapterCount ? c : null;

    private int MaxVerse => SelectedChapter is int c ? SelectedBookEntry!.Chapters[c - 1] : 0;

    private void OnBookChanged()
    {
        _chapterText = "";
        _verseFrom = Draft.Empty;
        _verseTo = Draft.Empty;
    }

    private void OnChapterChanged()
    {
        _verseFrom = Draft.Empty;
        _verseTo = Draft.Empty;
    }

    private void OnVerseFromInput(ChangeEventArgs e) => _verseFrom = _verseFrom.Type(e.Value?.ToString() ?? "");
    private void OnVerseToInput(ChangeEventArgs e) => _verseTo = _verseTo.Type(e.Value?.ToString() ?? "");

    private async Task Apply()
    {
        if (string.IsNullOrEmpty(_bookCode))
        {
            return;
        }

        var sref = _bookCode;
        if (SelectedChapter is int chapter)
        {
            sref = $"{sref}.{chapter}";
            if (int.TryParse(_verseFrom.Text, out var from) && from >= 1 && from <= MaxVerse)
            {
                sref = $"{sref}.{from}";
                if (int.TryParse(_verseTo.Text, out var to) && to > from && to <= MaxVerse)
                {
                    sref = $"{sref}-{to}";
                }
            }
        }

        await OnApply.InvokeAsync(sref);
    }
}
