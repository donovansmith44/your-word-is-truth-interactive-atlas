@using System.Globalization
@using BibleAtlas.Client.Contracts
@using BibleAtlas.Client.State
@using BibleAtlas.Client.Views
@inject AtlasClient Atlas
@inject IExplorableClient GraphClient
@inject IExplorer Explorer
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject SavedExplorationsService SavedExplorations
@inject StateAtom<ExplorationState> ExplorationAtom
@inject OwnershipRegistry Ownership
@inject StateAtom<IReadOnlyList<NodeRef>> SelectionAtom
@inject StateAtom<ViewArrangement> ViewArrangementAtom
@implements IPopoverSectionContext
@implements IDisposable

@if (ShowBackdrop)
{
    <div class="popover-backdrop" data-testid="popover-backdrop" @onclick="RequestClose"></div>
}

@* ShowBackdrop=false omits the backdrop entirely rather than making it inert: a backdrop that merely APPEARED inert would still be a full-viewport position:fixed element sitting over the marker, swallowing the mousedown/mouseup/click/focus of the very click meant to persist a hover-only popover (.reader-page's own contain:layout traps the marker below the backdrop's stacking context, so no z-index fix on the marker alone can win). Without a backdrop at all, a hover-only popover's marker stays genuinely clickable. *@
<div class="popover @(_verseAnchorRect is not null ? "popover-verse-anchored" : _paneRect is not null ? "popover-pane-anchored" : null)"
     style="@(VerseAnchorStyle ?? PaneRectStyle)" data-testid="popover" tabindex="-1" @ref="_panelRef" @onkeydown="OnKeyDown"
     @onpointerenter="OnPanelPointerEnter" @onpointerleave="OnPanelPointerLeave">
    <div class="popover-head">
        @if (Exploration is { Breadcrumb.Count: > 0 })
        {
            <button type="button" class="popover-breadcrumb-back" data-testid="popover-breadcrumb-back"
                    aria-label="Back" title="Back" @onclick="Back">&lsaquo;</button>
        }
        <p class="popover-title" data-testid="popover-title" data-ref="@(IsText ? "true" : "false")">@Title</p>
        @if (_chips.Count > 0)
        {
            <div class="popover-head-actions" data-testid="popover-head-actions">
                @foreach (var chip in _chips)
                {
                    <button type="button" class="popover-head-action" data-testid="@chip.ChipTestId"
                            aria-label="@chip.Label" title="@chip.Label" @onclick="() => Activate(chip)">@ChipGlyph(chip.ChipTestId)</button>
                }
            </div>
        }
        @if (SavedExplorations.Available && Exploration is not null)
        {
            <button type="button" class="popover-save-exploration@(_justSaved ? " popover-save-exploration-saved" : "")"
                    data-testid="popover-save-exploration" aria-label="Save this exploration" title="Save this exploration"
                    @onclick="SaveExploration">&#9733;</button>
        }
        <button type="button" class="popover-close" data-testid="popover-close" aria-label="Close" title="Close" @onclick="RequestClose">&times;</button>
    </div>

    <div class="popover-body" data-testid="popover-body" @key="@($"body:{Exploration?.Current.Id}")">
        @if (_failedAttempt is { } failedAttempt)
        {
            <CouldNotLoad OnRetry="() => Retry(failedAttempt)" />
        }
        else if (_legacy is null && Exploration is { } exploration)
        {
            <FocusView Node="exploration.Current" Surface="Surface.Popover" OnFollow="FollowAsync" OnShowOnWorld="WayToTheWorld" />
        }
        else if (_usingSectionRegistry)
        {
            @foreach (var section in _sections)
            {
                <div class="popover-section" data-testid="popover-section-@section.Testid">
                    @section.Body
                </div>
            }
        }
        else
        {
            @_body
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public PopoverOpening Opening { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }

    [Parameter] public bool InSplit { get; set; }

    [Parameter] public bool HostedByWorld { get; set; }
    [Parameter] public EventCallback<string> OnNavigateWorldInSplit { get; set; }

    [Parameter] public string? PaneAnchor { get; set; }

    [Parameter] public string? VerseAnchorSelector { get; set; }

    [Parameter] public bool ShowBackdrop { get; set; } = true;

    [Parameter] public EventCallback OnPanelPointerEnter { get; set; }
    [Parameter] public EventCallback OnPanelPointerLeave { get; set; }

    private Projection<ExplorationState>? _projectionBacking;
    private Projection<ExplorationState> _projection => _projectionBacking ??= new Projection<ExplorationState>(ExplorationAtom);
    private ExplorationState _frozenSnapshot = new ExplorationState.Closed();
    private readonly LegacyPresentations _legacyViews = new();
    private readonly RequestSeries _requests = new();
    private OwnershipClaim? _claim;
    private IExplorable? _legacy;
    private bool _justSaved;

    private Exploration? Exploration => (_frozenSnapshot as ExplorationState.Open)?.Exploration;

    private string Title => _legacy?.Title ?? Exploration?.Current.Label ?? Opening.Match(explore: target => Positions.Of(target).Label, resume: saved => Positions.Of(saved.Trail[^1]).Label, legacy: node => node.Title);

    private bool IsText => Exploration?.Current.Kind.Match(node: kind => kind is NodeKind.TextUnit or NodeKind.Container, edge: _ => false) == true;

    private void SyncSnapshot()
    {
        if (_claim?.IsCurrent == true)
        {
            Focus(_projection.Value);
        }
    }

    private void Focus(ExplorationState state)
    {
        _frozenSnapshot = state;
        _legacy = Exploration is { } exploration ? _legacyViews.Present(exploration) : null;
    }

    private void ApplyLocally(ExplorationIntent intent)
    {
        if (intent is not ExplorationIntent.Reset)
        {
            _justSaved = false;
        }

        if (_claim?.IsCurrent == true)
        {
            ExplorationAtom.Dispatch(intent);
            SyncSnapshot();
        }
        else
        {
            Focus(intent.Apply(_frozenSnapshot));
        }
    }

    private void OnExplorationChanged()
    {
        if (_claim?.IsCurrent != true && ExplorationAtom.Value is ExplorationState.Closed && _frozenSnapshot is ExplorationState.Open own)
        {
            _claim?.Dispose();
            _claim = Ownership.Claim(AtomNames.Exploration);
            ExplorationAtom.Dispatch(new ExplorationIntent.Reseed(own.Exploration));
        }

        SyncSnapshot();
        StateHasChanged();
    }

    private void SaveExploration()
    {
        if (Exploration is { } exploration)
        {
            SavedExplorations.Save(exploration);
            _justSaved = true;
        }
    }

    public void Dispose()
    {
        ExplorationAtom.Changed -= OnExplorationChanged;
        _requests.Stop();
        ApplyLocally(new ExplorationIntent.Reset());
        _claim?.Dispose();
    }

    private IReadOnlyList<Chip> _chips = [];
    private RenderFragment _body = _ => { };
    private Func<Task>? _failedAttempt;
    private bool _usingSectionRegistry;
    private IReadOnlyList<PopoverSection> _sections = [];
    private ElementReference _panelRef;
    private bool _focused;

    private PaneRect? _paneRect;
    private bool _paneMeasured;

    private VerseAnchorRect? _verseAnchorRect;
    private bool _verseAnchorMeasured;

    // reader-root's own testid never changes with its class (unlike split-pane-atlas, whose class AND testid switch together) -- a selector targeting "split-pane-reader" would match nothing, ever, so this targets the stable "reader-root" testid instead.
    private string PaneSelector => PaneAnchor switch
    {
        "reader" => "[data-testid=\"reader-root\"]",
        "atlas" => "[data-testid=\"split-pane-atlas\"]",
        _ => "",
    };

    private string? PaneRectStyle => _paneRect is { } r
        ? $"--pane-center-x:{(r.Left + r.Width / 2).ToString(CultureInfo.InvariantCulture)}px;" +
          $"--pane-center-y:{(r.Top + r.Height / 2).ToString(CultureInfo.InvariantCulture)}px;" +
          $"--pane-width:{r.Width.ToString(CultureInfo.InvariantCulture)}px;" +
          $"--pane-height:{r.Height.ToString(CultureInfo.InvariantCulture)}px;"
        : null;

    private const double VerseAnchorGapPx = 10;
    private const double VerseAnchorMarginPx = 16;
    private const double VerseAnchorEstimatedWidthPx = 544;

    // verse- and pane-anchoring's CSS rules sit at equal specificity, so BOTH would otherwise apply to the same element (a real live bug: width came from pane-anchoring while top/left came from verse-anchoring, rendering the panel at the pane's width but positioned by verse math meant for the base width). Verse-anchoring wins outright when present, checked first here.
    private string? VerseAnchorStyle
    {
        get
        {
            if (_verseAnchorRect is not { } r)
            {
                return null;
            }

            var halfWidth = Math.Min(VerseAnchorEstimatedWidthPx, r.ViewportWidth - 2 * VerseAnchorMarginPx) / 2;
            var centerX = Math.Clamp(r.Left + r.Width / 2, VerseAnchorMarginPx + halfWidth, r.ViewportWidth - VerseAnchorMarginPx - halfWidth);

            var verseMidY = r.Top + r.Height / 2;
            var openBelow = verseMidY < r.ViewportHeight / 2;

            string verticalProp;
            double verticalPx;
            double maxHeightPx;
            if (openBelow)
            {
                verticalProp = "--verse-anchor-top";
                verticalPx = Math.Max(r.Top + r.Height + VerseAnchorGapPx, VerseAnchorMarginPx);
                maxHeightPx = Math.Max(r.ViewportHeight - verticalPx - VerseAnchorMarginPx, 0);
            }
            else
            {
                verticalProp = "--verse-anchor-bottom";
                verticalPx = Math.Max(r.ViewportHeight - r.Top + VerseAnchorGapPx, VerseAnchorMarginPx);
                maxHeightPx = Math.Max(r.ViewportHeight - verticalPx - VerseAnchorMarginPx, 0);
            }

            return $"{verticalProp}:{verticalPx.ToString(CultureInfo.InvariantCulture)}px;" +
                   $"--verse-anchor-left:{centerX.ToString(CultureInfo.InvariantCulture)}px;" +
                   $"--verse-anchor-max-height:{maxHeightPx.ToString(CultureInfo.InvariantCulture)}px;";
        }
    }


    protected override async Task OnInitializedAsync()
    {
        _claim = Ownership.Claim(AtomNames.Exploration);
        ExplorationAtom.Changed += OnExplorationChanged;

        var request = _requests.Next();
        await Opening.Match(
            explore: target => OpenAt(request, target, null),
            resume: saved => Resume(request, saved),
            legacy: node => OpenAt(request, new NodePosition(node.Identity), node));
    }

    private async Task Resume(Request request, SavedExploration saved)
    {
        if (Arriving(await request.Fetch(() => Explorer.Resolve(saved.Trail)), () => Resume(_requests.Next(), saved)) is not [var start, ..] trail)
        {
            return;
        }

        ApplyLocally(new ExplorationIntent.Reseed(new Exploration(start, saved.Steps.Zip(trail.Skip(1), (step, target) => new Step(step.Kind, target)).ToList())));
        await LoadCurrent();
    }

    private async Task OpenAt(Request request, PositionRef target, IExplorable? legacy)
    {
        if (Arriving(await request.Fetch(() => Explorer.Resolve(target)), () => OpenAt(_requests.Next(), target, legacy)) is not { } start)
        {
            return;
        }

        PresentArrival(new ExplorationIntent.Open(start), legacy);
        await LoadCurrent();
    }

    private void PresentArrival(ExplorationIntent intent, IExplorable? legacy)
    {
        if (legacy is not null && intent.Apply(_frozenSnapshot) is ExplorationState.Open { Exploration: var arrived })
        {
            _legacyViews.Arrive(arrived, legacy);
        }

        ApplyLocally(intent);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_paneMeasured && PaneAnchor is not null)
        {
            _paneMeasured = true;
            try
            {
                var readerJs = await JS.InvokeAsync<IJSObjectReference>("import", "./js/reader.js");
                _paneRect = await readerJs.InvokeAsync<PaneRect?>("getPaneRect", PaneSelector);
                if (_paneRect is not null)
                {
                    StateHasChanged();
                }
            }
            catch (Exception)
            {
            }
        }

        if (!_verseAnchorMeasured && VerseAnchorSelector is not null)
        {
            _verseAnchorMeasured = true;
            try
            {
                var readerJs = await JS.InvokeAsync<IJSObjectReference>("import", "./js/reader.js");
                _verseAnchorRect = await readerJs.InvokeAsync<VerseAnchorRect?>("getVerseAnchorRect", VerseAnchorSelector);
                if (_verseAnchorRect is not null)
                {
                    StateHasChanged();
                }
            }
            catch (Exception)
            {
            }
        }

        if (_focused)
        {
            return;
        }

        _focused = true;
        try
        {
            await _panelRef.FocusAsync();
        }
        catch (Exception)
        {
        }
    }

    private async Task LoadCurrent()
    {
        if (Exploration is not { } exploration)
        {
            return;
        }

        var request = _requests.Next();
        _sections = [];
        _chips = [];
        _body = _ => { };
        _failedAttempt = null;
        _usingSectionRegistry = false;

        if (_legacy is { } legacy && !await LoadLegacy(legacy, request))
        {
            return;
        }

        await SyncNarrativeFocusAsync(request);
    }

    private async Task<bool> LoadLegacy(IExplorable legacy, Request request)
    {
        var applicable = PopoverSectionRegistry.Providers.Where(p => p.AppliesTo(legacy)).ToList();
        _usingSectionRegistry = applicable.Count > 0;

        return _usingSectionRegistry
            ? await LoadSections(legacy, applicable, request)
            : (await request.Fetch(() => legacy.ExploreAsync(Atlas), () => legacy.BodyAsync(Atlas))).Match(
                arrived: loaded =>
                {
                    (_chips, _body) = loaded;
                    return true;
                },
                failed: CouldNotLoadCurrent,
                superseded: () => false);
    }

    private async Task<bool> LoadSections(IExplorable legacy, IReadOnlyList<IPopoverSectionProvider> applicable, Request request)
    {
        var chips = request.Fetch(() => legacy.ExploreAsync(Atlas));
        var sections = await Task.WhenAll(applicable.Select(provider => request.Fetch(() => provider.ResolveAsync(legacy, Atlas, this))));
        var chipsOutcome = await chips;
        if (request.Superseded)
        {
            return false;
        }

        _chips = chipsOutcome.Match<IReadOnlyList<Chip>>(arrived: arrived => arrived, failed: () => [], superseded: () => []);
        var resolved = sections.SelectMany(section => section.Match<IEnumerable<PopoverSection>>(arrived: arrived => arrived is null ? [] : [arrived], failed: () => [], superseded: () => [])).ToList();
        if (sections.Any(Failed) || Failed(chipsOutcome))
        {
            resolved.Add(new PopoverSection(SectionsCouldNotLoad, SomeSectionsCouldNotLoad));
        }

        _sections = XrefEntryPoint ? resolved.OrderByDescending(s => s.Testid == "xrefs").ToList() : resolved;
        return true;
    }

    private static bool Failed<T>(Outcome<T> outcome) => outcome.Match(arrived: _ => false, failed: () => true, superseded: () => false);

    private const string SectionsCouldNotLoad = "could-not-load";

    private RenderFragment SomeSectionsCouldNotLoad => __builder =>
    {
        <CouldNotLoad OnRetry="LoadCurrent" />
    };

    private bool CouldNotLoadCurrent()
    {
        ShowCouldNotLoad(LoadCurrent);
        return true;
    }

    private T? Arriving<T>(Outcome<T> outcome, Func<Task> retry)
        where T : class =>
        outcome.Match<T?>(
            arrived: arrived => arrived,
            failed: () =>
            {
                ShowCouldNotLoad(retry);
                return null;
            },
            superseded: () => null);

    private void ShowCouldNotLoad(Func<Task> retry)
    {
        _chips = [];
        _failedAttempt = retry;
    }

    private Task Retry(Func<Task> attempt)
    {
        _failedAttempt = null;
        return attempt();
    }

    private async Task SyncNarrativeFocusAsync(Request request)
    {
        var focus = _legacy is INarrativeAware aware
            ? (await request.Fetch(() => aware.NarrativePositionsAsync(Atlas))).Select(NarrativeFocus.Of)
            : new Outcome<NarrativeFocus>.Arrived(NarrativeFocus.None);
        await focus.Match(arrived: FocusMap, failed: () => FocusMap(NarrativeFocus.None), superseded: () => Task.CompletedTask);
    }

    private async Task FocusMap(NarrativeFocus focus)
    {
        try
        {
            await MapInterop.SetNarrativeFocus(JS, focus.Narratives, focus.Events);
        }
        catch (Exception)
        {
        }
    }

    private sealed record NarrativeFocus(IReadOnlyList<string> Narratives, IReadOnlyList<string> Events)
    {
        public static readonly NarrativeFocus None = new([], []);

        public static NarrativeFocus Of(NarrativeEventPositions positions) =>
            new(positions.Narrative.Select(p => p.NarrativeId).Distinct().ToList(), positions.Narrative.Select(p => p.EventId).Distinct().ToList());
    }

    public Task PushAsync(PopoverOpening opening, EdgeKind via) =>
        opening.Match(
            explore: target => FollowAsync(new Link(via, target)),
            resume: saved => Resume(_requests.Next(), saved),
            legacy: node => PushLegacyAsync(node, via));

    private Task PushLegacyAsync(IExplorable node, EdgeKind via) =>
        Arrive(new Link(via, new NodePosition(node.Identity)), node, () => PushLegacyAsync(node, via));

    private Task FollowAsync(Link link) => Arrive(link, null, () => FollowAsync(link));

    private async Task Arrive(Link link, IExplorable? legacy, Func<Task> retry)
    {
        if (Arriving(await _requests.Next().Fetch(() => Explorer.Follow(link)), retry) is { } target)
        {
            PresentArrival(new ExplorationIntent.Follow(new Step(link.Kind, target)), legacy);
            await LoadCurrent();
        }

        StateHasChanged();
    }

    public Task ToggleSelectAsync(NodeRef node)
    {
        SelectionAtom.Dispatch(new ToggleSelection(node));
        return Task.CompletedTask;
    }

    public int OtherContextSectionCount => _sections.Count(s => s.Testid is not ("verse-text" or "xrefs"));

    public bool XrefEntryPoint => _legacy is VerseNode { XrefEntryPoint: true };

    public IExplorableClient Graph => GraphClient;

    private async Task NavigateWorld(string query)
    {
        await RequestClose();
        if (InSplit && OnNavigateWorldInSplit.HasDelegate)
        {
            await OnNavigateWorldInSplit.InvokeAsync(query);
        }
        else
        {
            Nav.NavigateTo($"{WorldPage}?{query}");
        }
    }

    public Task NavigateWorldAsync(string query) => NavigateWorld(query);

    private EventCallback WayToTheWorld => HostedByWorld || InSplit ? default : EventCallback.Factory.Create(this, ShowOnWorld);

    private async Task ShowOnWorld()
    {
        _claim?.Dispose();
        await RequestClose();
        Nav.NavigateTo(WorldPage);
    }

    private async Task Activate(Chip ex)
    {
        switch (ex.Target)
        {
            case ChipTarget.Push push:
                await PushLegacyAsync(push.Next, push.Via);
                break;

            case ChipTarget.NavigateWorld world:
                await NavigateWorld(world.Query);
                break;

            case ChipTarget.NavigateReader reader:
                await RequestClose();
                var query = InSplit
                    ? $"?{SplitUrlContract.SplitParam}={ViewNames.World}" +
                      (ViewArrangementAtom.Value.Follow ? $"&{SplitUrlContract.FollowParam}={SplitUrlContract.FollowTrueValue}" : "")
                    : "";
                var fragment = reader.Verse is int v ? $"#v{v}" : "";
                var url = $"/read/{reader.Book}/{reader.Chapter}{query}{fragment}";
                Nav.NavigateTo(url);
                break;
        }
    }

    private async Task Back()
    {
        if (Exploration is not { Breadcrumb.Count: > 0 })
        {
            return;
        }

        ApplyLocally(new ExplorationIntent.Back());
        await LoadCurrent();
    }

    private async Task RequestClose()
    {
        try
        {
            await MapInterop.SetNarrativeFocus(JS, Array.Empty<string>(), Array.Empty<string>());
        }
        catch (Exception)
        {
        }
        await OnClose.InvokeAsync();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await RequestClose();
        }
    }

    private static string ChipGlyph(string chipTestId) => chipTestId switch
    {
        "popover-chip-map" => "⌖",
        "popover-chip-book" => "❧",
        "popover-chip-context" => "¶",
        _ => "•",
    };

    private const string WorldPage = "/world";

    private sealed record VerseAnchorRect(double Left, double Top, double Width, double Height, double ViewportWidth, double ViewportHeight);
}
