@using BibleAtlas.Client.Contract
@using BibleAtlas.Client.Exploring
@implements IDisposable

<div class="popover-person-mentions">
    @if (!string.IsNullOrEmpty(Provenance))
    {
        <p class="popover-meta" data-testid="popover-person-provenance">Source: @Provenance</p>
    }

    @if (ShowHeading)
    {
        <p class="catechism-section-heading" data-testid="person-mentions-heading">MENTIONED IN SCRIPTURE (@TotalCount)</p>
    }

    @if (!Mentions.Shown.Any())
    {
        <p class="popover-meta">No recorded mentions.</p>
    }
    else
    {
        @foreach (var verse in Mentions.Shown.Nodes())
        {
            var vref = verse.Label;
            <button type="button" class="popover-event-row popover-event-row-button explorable" data-testid="@($"person-mention-{vref}")"
                    @onclick="() => OnExplore.InvokeAsync(new PopoverOpening.Legacy(new VerseNode(vref)))">
                @vref
            </button>
        }
    }

    @if (_failed)
    {
        <CouldNotLoad OnRetry="() => Settled(Mentions.Resume())" />
    }
    else
    {
        <PageControls Position="Mentions.Position(TotalCount)" OnMore="() => Settled(Mentions.More())" OnLess="() => Settled(Mentions.Fewer())"
                      MoreTestId="person-mentions-more" LessTestId="person-mentions-less" PositionTestId="person-mentions-position" />
    }
</div>

@code {
    [Parameter] public string? Provenance { get; set; }
    [Parameter, EditorRequired] public PageWindow<EdgeEntry> Mentions { get; set; } = default!;
    [Parameter, EditorRequired] public int TotalCount { get; set; }
    [Parameter] public bool ShowHeading { get; set; } = true;
    [Parameter, EditorRequired] public EventCallback<PopoverOpening> OnExplore { get; set; }

    private bool _failed;

    public void Dispose() => Mentions.Stop();

    private async Task Settled(Task<Outcome<Unit>> settling)
    {
        _failed = false;
        (await settling).Match(arrived: _ => { }, failed: () => _failed = true, superseded: () => { });
    }
}
