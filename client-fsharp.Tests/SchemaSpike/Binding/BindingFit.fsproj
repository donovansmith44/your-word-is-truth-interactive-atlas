<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../SurveyData.fs" />
    <Compile Include="../SurveyInputs.fs" />
    <Compile Include="../SchemaSurvey.fs" />
    <Compile Include="obj/Contract/SchemaTypes.g.fs" />
    <Compile Include="BindingLaws.fs" />
    <Compile Include="../../PropertyTests.fs" />
    <ProjectReference Include="$(JsonSchemaSource)/src/JsonSchema/JsonSchema.csproj" AdditionalProperties="GeneratePackageOnBuild=false" />
    <ProjectReference Include="../../../client-fsharp/Core/BibleAtlas.FSharp.Core.fsproj" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="FsCheck.Xunit" Version="3.4.0" />
  </ItemGroup>
  <Target Name="GenerateSchemaBindings" BeforeTargets="CoreCompile" Inputs="$(MSBuildProjectDirectory)/../../../contracts/openapi.yaml;$(MSBuildProjectDirectory)/../../../client-fsharp.ContractGenerator/bin/$(Configuration)/net10.0/BibleAtlas.FSharp.ContractGenerator.dll" Outputs="$(MSBuildProjectDirectory)/obj/Contract/SchemaTypes.g.fs">
    <Exec Command="dotnet &quot;$(MSBuildProjectDirectory)/../../../client-fsharp.ContractGenerator/bin/$(Configuration)/net10.0/BibleAtlas.FSharp.ContractGenerator.dll&quot; --schema-bindings &quot;$(MSBuildProjectDirectory)/../../../contracts/openapi.yaml&quot; &quot;$(MSBuildProjectDirectory)/obj/Contract/SchemaTypes.g.fs&quot;" />
  </Target>
  <Target Name="RequireJsonSchemaSource" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(JsonSchemaSource)' == ''" Text="Set JsonSchemaSource to the pinned MIT source checkout documented in the JSON validation report." />
  </Target>
</Project>
