@page "/sources"
@using BibleAtlas.Client.State
@using BibleAtlas.Client.Views
@inject AtlasClient Atlas

<PageTitle>Bible Explorer &mdash; Sources</PageTitle>

<CompositionSplit HostName="@ViewNames.Sources" SplitModeOverride="@SplitMode" HostPaneClass="split-pane-host" Context="ctx">
    <div class="@($"sources-page{ctx.HostPaneClassSuffix}")" data-testid="sources-page">
        <div class="sources-column">
            <h1 class="sources-title">Sources</h1>
            <p class="sources-intro">
                Bible Explorer stands on the work of translators, researchers, and
                scholars across many centuries. Every source below is honestly
                named: what it is, what we built from it, and its license.
            </p>

            @if (!ctx.IsSplitOpen)
            {
                <button type="button" class="split-open split-open-parchment" data-testid="split-open-sources"
                        @onclick="ctx.InvokeHatch">
                    Read beside the reader
                </button>
            }

            @if (_error is not null)
            {
                <div class="toast" data-testid="toast">
                    <p class="toast-message">@_error</p>
                </div>
            }
            else if (_doc is null)
            {
                <p class="sources-loading">Loading sources&hellip;</p>
            }
            else
            {
                @foreach (var category in _doc.Categories)
                {
                    <section class="sources-category" data-testid="sources-category-@category.Id">
                        <h2 class="sources-category-title">@category.Label</h2>
                        <div class="sources-grid">
                            @foreach (var source in SourcesFor(category.Id))
                            {
                                <article class="source-card" data-testid="source-@source.Id">
                                    <h3 class="source-title">@source.Title</h3>
                                    <p class="source-what">@source.WhatItIs</p>
                                    <p class="source-built"><span class="source-label">What we built:</span> @source.WhatWeBuilt</p>
                                    <p class="source-license"><span class="source-label">License:</span> @source.License</p>
                                    @if (!string.IsNullOrWhiteSpace(source.Link))
                                    {
                                        <a class="source-link" data-testid="source-link-@source.Id" href="@source.Link" target="_blank" rel="noopener noreferrer">Visit source</a>
                                    }
                                </article>
                            }
                        </div>
                    </section>
                }
            }
        </div>
    </div>
</CompositionSplit>

@code {
    private SourcesDocument? _doc;
    private string? _error;

    // Currently unreachable (no shipped pairing mounts Sources as a guest
    // yet), but kept: Reader and World both carry this identical
    // parameter/null-check shape, and Sources is registered in the same
    // view registry with the same mount-closure machinery.
    [Parameter] public bool? SplitMode { get; set; }

    private readonly RequestSeries _startup = new();

    protected override async Task OnInitializedAsync()
    {
        (await _startup.Next().Fetch(() => Atlas.Sources())).Match(
            arrived: doc =>
            {
                _doc = doc;
                _byCategory = doc.Sources
                    .GroupBy(s => s.Category)
                    .ToDictionary(g => g.Key, g => (IReadOnlyList<SourceEntry>)g.ToList());
            },
            failed: () => _error = "Couldn't load the sources list -- try refreshing the page.",
            superseded: () => { });
    }

    private static readonly IReadOnlyList<SourceEntry> EmptySources = Array.Empty<SourceEntry>();

    private Dictionary<string, IReadOnlyList<SourceEntry>> _byCategory = new();

    private IReadOnlyList<SourceEntry> SourcesFor(string categoryId) =>
        _byCategory.TryGetValue(categoryId, out var sources) ? sources : EmptySources;
}
