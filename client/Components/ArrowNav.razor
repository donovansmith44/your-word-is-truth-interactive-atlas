@using System.Globalization
@inject AtlasClient Atlas
@inject IJSRuntime JS
@implements IDisposable

<div class="@WrapperClass" @ref="_sideRef"
     @onpointerenter="OnPointerEnter" @onpointerleave="OnPointerLeave" @onpointerdown="OnWrapperPointerDown">
@if (Adjacent is null)
{
    @if (!Inline)
    {
        <span class="popover-event-nav-arrow popover-event-nav-arrow-@Direction popover-event-nav-arrow-empty"></span>
    }
}
else if (Inline)
{
    <button type="button" class="popover-story-thread-leg explorable-quiet"
            data-testid="@($"{EventTestIdPrefix}-{IdSuffix}")"
            aria-label="@($"{(Direction == "prior" ? "Prior" : "Following")} event: {Adjacent.Label}")"
            @onclick="Commit">@InlinePrefixText<span class="popover-event-nav-glyph">@Glyph</span> @Adjacent.Label</button>
}
else
{
    <button type="button" class="popover-event-nav-arrow popover-event-nav-arrow-@Direction explorable"
            data-testid="@($"{EventTestIdPrefix}-{IdSuffix}")"
            aria-label="@($"{(Direction == "prior" ? "Prior" : "Following")} event: {Adjacent.Label}")"
            @onclick="Commit">
        @if (Direction == "prior")
        {
            <span class="popover-event-nav-glyph">@Glyph</span>
        }
        <span class="popover-event-nav-label @(LabelIsLong ? "popover-event-nav-label-long" : null)" title="@Adjacent.Label">@Adjacent.Label</span>
        @if (Direction == "following")
        {
            <span class="popover-event-nav-glyph">@Glyph</span>
        }
    </button>

    <p class="popover-event-nav-role" data-testid="@($"{RoleTestIdPrefix}-{IdSuffix}")">@RoleText</p>

    <RefsList Refs="@RefDescriptors" TestIdPrefix="@($"{EventTestIdPrefix}-{IdSuffix}-refs")" OnExplore="OnExplore" />
}

@if (_showPeek && Adjacent is not null)
{
    <div class="popover-arrow-peek @(_peekFlipAbove ? "popover-arrow-peek-above" : null)" style="@PeekStyle"
         data-testid="@($"{EventTestIdPrefix}-{IdSuffix}-peek")" @onkeydown="OnPeekKeyDown">
        <div class="popover-arrow-peek-head">
            <p class="popover-arrow-peek-title" data-testid="@($"{EventTestIdPrefix}-{IdSuffix}-peek-title")">@Adjacent.Label</p>
            <button type="button" class="popover-arrow-peek-close" data-testid="@($"{EventTestIdPrefix}-{IdSuffix}-peek-close")"
                    aria-label="Close preview" title="Close preview"
                    @onclick="ClosePeek" @onclick:stopPropagation="true">&times;</button>
        </div>
        @if (_peekVerses.Count > 0)
        {
            @foreach (var v in _peekVerses.Take(_peekShown))
            {
                <p class="popover-arrow-peek-verse" data-testid="@($"{EventTestIdPrefix}-{IdSuffix}-peek-verse-{v.Vref}")">
                    <sup class="popover-arrow-peek-verse-num">@CanonRef.ParseVerse(v.Vref).Verse</sup><MentionText Text="@v.Text" Places="@(v.Places ?? Array.Empty<PlaceRef>())" Persons="@(v.Persons ?? Array.Empty<PersonRef>())" WordsOfChrist="@(v.WordsOfChrist ?? Array.Empty<WordsOfChristSpan>())"
                        Verse="@CanonRef.ParseVerse(v.Vref).Verse" ClassPrefix="popover-arrow-peek-mention" TestIdSuffix="@($"-{EventTestIdPrefix}-{IdSuffix}-peek")" OnExplore="OnExplore" />
                </p>
            }
            <RevealControls Total="@_peekVerses.Count" Default="1" Shown="@_peekShown" ShownChanged="OnPeekShownChanged"
                             MoreTestId="@($"{EventTestIdPrefix}-{IdSuffix}-peek-more")" CollapseTestId="@($"{EventTestIdPrefix}-{IdSuffix}-peek-collapse")"
                             RevealNoun="verses" />
            @if (_peekTruncatedBy > 0)
            {
                <p class="popover-arrow-peek-truncated" data-testid="@($"{EventTestIdPrefix}-{IdSuffix}-peek-truncated")"
                   title="This chapter has more verses than this peek can show">+@_peekTruncatedBy more (this chapter's own display cap)</p>
            }
        }
    </div>
}
</div>

@code {
    [Parameter, EditorRequired] public string Direction { get; set; } = default!;

    [Parameter, EditorRequired] public string EventTestIdPrefix { get; set; } = default!;
    [Parameter, EditorRequired] public string RoleTestIdPrefix { get; set; } = default!;
    [Parameter, EditorRequired] public string IdSuffix { get; set; } = default!;

    [Parameter] public NarrativeAdjacentEvent? Adjacent { get; set; }
    [Parameter, EditorRequired] public string Glyph { get; set; } = default!;

    [Parameter] public bool Inline { get; set; }
    [Parameter] public string? InlinePrefixText { get; set; }

    [Parameter, EditorRequired] public EventCallback<IExplorable> OnExplore { get; set; }

    private string RoleText => Direction == "prior" ? "PRIOR EVENT" : "FOLLOWING EVENT";

    private string? _lastAdjacentId;
    private List<RefsList.RefDescriptor>? _fetchedRefs;

    protected override async Task OnParametersSetAsync()
    {
        if (Inline || Adjacent?.Id == _lastAdjacentId)
        {
            return;
        }
        var capturedId = Adjacent?.Id;
        _lastAdjacentId = capturedId;
        _fetchedRefs = null;
        if (capturedId is null)
        {
            return;
        }
        try
        {
            var detailTask = Atlas.Event(capturedId);
            var booksTask = Atlas.Books();
            var detail = await detailTask;
            Versification? canon = null;
            try
            {
                canon = Versification.From(await booksTask);
            }
            catch (Exception)
            {
            }
            if (_lastAdjacentId != capturedId)
            {
                // a newer Adjacent may have already landed while this fetch was in flight -- never overwrite its state with a stale result
                return;
            }
            // an empty witness list must never replace the fallback refs already showing -- it is never a real state to switch to
            _fetchedRefs = detail.Witnesses.Count > 0 ? SelectRefsFromWitnesses(detail.Witnesses, canon) : null;
            StateHasChanged();
        }
        catch (Exception)
        {
        }
    }

    private List<RefsList.RefDescriptor> RefDescriptors => _fetchedRefs ?? SelectRefs(Adjacent?.VerseGroups);

    public static List<RefsList.RefDescriptor> SelectRefs(IReadOnlyList<VerseGroup>? groups)
    {
        var result = new List<RefsList.RefDescriptor>();
        if (groups is null)
        {
            return result;
        }
        foreach (var g in groups)
        {
            if (g.Verses.Count == 0)
            {
                continue;
            }
            // span computed via the coalesced run math, not first+Count-1 arithmetic, so a real internal gap in the delivered verses is never fabricated into a contiguous envelope
            var verses = g.Verses.Select(v => new PassageListVerse(v, "", g.Count)).ToList();
            var block = PassageBlockBuilder.BuildCoalescedBlock(new PassageSourceUnit(verses, CoalesceAcrossChapters: true));
            result.Add(new RefsList.RefDescriptor(block.Span, new VerseNode(block.FirstVref)));
        }
        return result;
    }

    public static List<RefsList.RefDescriptor> SelectRefsFromWitnesses(IReadOnlyList<EventWitness> witnesses, Versification? canon)
    {
        var result = new List<RefsList.RefDescriptor>();
        foreach (var w in witnesses)
        {
            var verses = PassageBlockBuilder.FlattenWitness(w);
            if (verses.Count == 0)
            {
                continue;
            }
            var block = PassageBlockBuilder.BuildCoalescedBlock(new PassageSourceUnit(verses, CoalesceAcrossChapters: true, Canon: canon));
            result.Add(new RefsList.RefDescriptor(block.Span, new VerseNode(block.FirstVref)));
        }
        return result;
    }

    private string WrapperClass => Inline ? "popover-story-thread-leg-wrap" : $"popover-event-nav-side popover-event-nav-side-{Direction}";

    private Task Commit()
    {
        if (Adjacent is null)
        {
            return Task.CompletedTask;
        }

        CancelDwell();
        CancelDismiss();
        HidePeekState();
        // Adjacent is always a narrative/timeline event by construction here (NarrativeAdjacentEvent carries no Kind field) -- not a guessed literal
        return OnExplore.InvokeAsync(new EventNode(Adjacent.Id, Adjacent.Label, EventKind.Event));
    }

    private const int LongLabelThreshold = 24;
    private bool LabelIsLong => Adjacent is not null && Adjacent.Label.Length > LongLabelThreshold;

    private bool _showPeek;
    private List<PassageListVerse> _peekVerses = new();

    private int _peekTruncatedBy;

    private int _peekShown = 1;

    private CancellationTokenSource? _dwellCts;

    private CancellationTokenSource? _dismissCts;
    // grace period before hiding the peek: the browser fires a spurious pointerleave+enter pair while the pointer crosses the small visual gap between the arrow and the peek box
    private const int PeekDismissGraceMs = 1000;

    private ElementReference _sideRef;
    private bool _peekMeasured;
    private bool _peekFlipAbove;
    private double? _peekMaxHeightPx;

    private const double PeekMarginPx = 12;

    private string? PeekStyle => _peekMaxHeightPx is double h
        ? $"--peek-max-height:{h.ToString(CultureInfo.InvariantCulture)}px;"
        : null;

    // clicking RevealControls' own "less" can remove the element the pointer is resting on, which breaks the browser's pointerenter/pointerleave tracking for this wrapper; these fields re-verify pointer position after such a change before scheduling a dismiss
    private double? _pointerDownX;
    private double? _pointerDownY;
    private bool _recentPointerDown;

    private void OnWrapperPointerDown(PointerEventArgs e)
    {
        _pointerDownX = e.ClientX;
        _pointerDownY = e.ClientY;
        _recentPointerDown = true;
    }

    private async Task OnPeekShownChanged(int shown)
    {
        _peekShown = shown;

        if (!_recentPointerDown || _pointerDownX is not double x || _pointerDownY is not double y)
        {
            return;
        }
        _recentPointerDown = false;

        try
        {
            var readerJs = await JS.InvokeAsync<IJSObjectReference>("import", "./js/reader.js");
            var stillInside = await readerJs.InvokeAsync<bool>("isPointInsideEither", _sideRef, x, y);
            if (!stillInside && _showPeek)
            {
                ScheduleDismiss();
            }
        }
        catch (Exception)
        {
        }
    }

    private void OnPointerEnter()
    {
        // the hover/dwell peek is Inline-only; block-mode prior/following arrows had it removed at the owner's request
        if (!Inline)
        {
            return;
        }

        if (Adjacent is null)
        {
            return;
        }

        CancelDismiss();
        if (_showPeek)
        {
            return;
        }

        CancelDwell();
        var cts = new CancellationTokenSource();
        _dwellCts = cts;
        _ = DwellThenPeek(cts);
    }

    private void OnPointerLeave()
    {
        if (_showPeek)
        {
            ScheduleDismiss();
            return;
        }

        CancelDwell();
    }

    private void CancelDwell()
    {
        _dwellCts?.Cancel();
        _dwellCts = null;
    }

    private async Task DwellThenPeek(CancellationTokenSource cts)
    {
        try
        {
            await Task.Delay(DwellTiming.PeekDelayMs, cts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (cts.IsCancellationRequested || Adjacent is null)
        {
            return;
        }

        try
        {
            _peekVerses = await VerseTextResolver.ResolveGroupsAsync(Atlas, Adjacent.VerseGroups);
        }
        catch (Exception)
        {
            _peekVerses = new List<PassageListVerse>();
        }

        if (cts.IsCancellationRequested)
        {
            return;
        }

        _peekShown = 1;
        _peekTruncatedBy = ComputeTruncatedBy(_peekVerses);
        _peekMeasured = false;
        _showPeek = true;
        StateHasChanged();
    }

    private void ScheduleDismiss()
    {
        CancelDismiss();
        var cts = new CancellationTokenSource();
        _dismissCts = cts;
        _ = DelayedDismiss(cts);
    }

    private void CancelDismiss()
    {
        _dismissCts?.Cancel();
        _dismissCts = null;
    }

    private async Task DelayedDismiss(CancellationTokenSource cts)
    {
        try
        {
            await Task.Delay(PeekDismissGraceMs, cts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (cts.IsCancellationRequested)
        {
            return;
        }

        HidePeekState();
        StateHasChanged();
    }

    private void ClosePeek()
    {
        CancelDwell();
        CancelDismiss();
        HidePeekState();
    }

    private void OnPeekKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            ClosePeek();
        }
    }

    private void HidePeekState()
    {
        _showPeek = false;
        _peekShown = 1;
        _peekTruncatedBy = 0;
        _peekMeasured = false;
        _peekFlipAbove = false;
        _peekMaxHeightPx = null;
        _recentPointerDown = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_showPeek || _peekMeasured || Adjacent is null)
        {
            return;
        }

        _peekMeasured = true;
        try
        {
            var readerJs = await JS.InvokeAsync<IJSObjectReference>("import", "./js/reader.js");
            var rect = await readerJs.InvokeAsync<ElementRect?>("getElementRect", _sideRef);
            if (rect is { } r && _showPeek)
            {
                // budget against the enclosing .popover's own edges, not the viewport: .popover is routinely shorter than the viewport (its own max-height), so budgeting off the viewport would let an expanded peek spill past the popover's bottom edge
                var spaceBelow = r.PopoverBottom - (r.Top + r.Height) - PeekMarginPx;
                var spaceAbove = r.Top - r.PopoverTop - PeekMarginPx;
                _peekFlipAbove = spaceBelow < spaceAbove;
                _peekMaxHeightPx = Math.Max(_peekFlipAbove ? spaceAbove : spaceBelow, 0);
                StateHasChanged();
            }
        }
        catch (Exception)
        {
        }
    }

    private static int ComputeTruncatedBy(IReadOnlyList<PassageListVerse> verses)
    {
        var byGroup = new Dictionary<(string Book, int Chapter), (int Delivered, int? TrueCount)>();
        foreach (var v in verses)
        {
            var (book, chapter, _) = CanonRef.ParseVerse(v.Vref);
            var key = (book, chapter);
            var existing = byGroup.GetValueOrDefault(key, (0, null));
            byGroup[key] = (existing.Delivered + 1, v.GroupCount ?? existing.TrueCount);
        }

        var missing = 0;
        foreach (var (_, entry) in byGroup)
        {
            if (entry.TrueCount is int trueCount && trueCount > entry.Delivered)
            {
                missing += trueCount - entry.Delivered;
            }
        }
        return missing;
    }

    private sealed record ElementRect(double Left, double Top, double Width, double Height, double PopoverTop, double PopoverBottom);

    public void Dispose()
    {
        CancelDwell();
        CancelDismiss();
        HidePeekState();
    }
}
