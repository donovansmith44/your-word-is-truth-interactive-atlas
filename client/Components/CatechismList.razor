@using BibleAtlas.Client.Explore
@if (Items.Count > 0)
{
    <div class="popover-catechism-list">
        @foreach (var entry in Visible)
        {
            <button type="button" class="popover-catechism-item explorable" data-testid="@entry.TestId"
                    @onclick="() => OnExplore.InvokeAsync(new CatechismNode(entry.Item.Id, entry.Item.Name))">
                @entry.Label
            </button>
        }
    </div>
    @if (Cap is int cap && Items.Count > cap)
    {
        <RevealControls Total="@Items.Count" Default="@cap" Shown="@ShownCount(cap)" ShownChanged="@(n => _shown = n)"
                         MoreTestId="@MoreTestId" CollapseTestId="@CollapseTestId" RevealNoun="catechism items" />
    }
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<CatechismRef> Items { get; set; } = Array.Empty<CatechismRef>();
    [Parameter] public int? Cap { get; set; }
    [Parameter] public string MoreTestId { get; set; } = "catechism-more";
    [Parameter] public string CollapseTestId { get; set; } = "catechism-collapse";
    [Parameter, EditorRequired] public EventCallback<IExplorable> OnExplore { get; set; }

    private int? _shown;
    private int ShownCount(int cap) => _shown ??= cap;

    private sealed record VisibleEntry(CatechismRef Item, string TestId, string Label);

    private IEnumerable<VisibleEntry> Visible
    {
        get
        {
            var shown = Cap is int cap ? Items.Take(ShownCount(cap)) : Items;
            var occurrences = new Dictionary<string, int>();
            foreach (var it in shown)
            {
                var count = occurrences[it.Id] = occurrences.GetValueOrDefault(it.Id) + 1;
                var testId = count == 1 ? $"catechism-item-{it.Id}" : $"catechism-item-{it.Id}--q{count}";
                var label = it.Question is { } q ? $"{it.Name} — {q}" : it.Name;
                yield return new VisibleEntry(it, testId, label);
            }
        }
    }
}
