@using BibleAtlas.Client.Contract
@using BibleAtlas.Client.Explore
@inject IExplorableClient Graph
@implements IDisposable

<div class="popover-person-mentions">
    @if (!string.IsNullOrEmpty(Provenance))
    {
        <p class="popover-meta" data-testid="popover-person-provenance">Source: @Provenance</p>
    }

    @if (ShowHeading)
    {
        <p class="catechism-section-heading" data-testid="person-mentions-heading">MENTIONED IN SCRIPTURE (@TotalCount)</p>
    }

    @if (_paging.Kept.Count == 0)
    {
        <p class="popover-meta">No recorded mentions.</p>
    }
    else
    {
        @foreach (var verse in _paging.Kept.Nodes())
        {
            var vref = verse.Label;
            <button type="button" class="popover-event-row popover-event-row-button explorable" data-testid="@($"person-mention-{vref}")"
                    @onclick="() => OnExplore.InvokeAsync(new PopoverOpening.Legacy(new VerseNode(vref)))">
                @vref
            </button>
        }
    }

    @if (_failed)
    {
        <CouldNotLoad OnRetry="RevealMore" />
    }
    else if (!_paging.Ended)
    {
        <button type="button" class="popover-passage-reveal" data-testid="person-mentions-more" aria-label="Show more mentions"
                disabled="@_loading" @onclick="RevealMore">
            @(_loading ? "…" : "▾")
        </button>
    }
</div>

@code {
    [Parameter, EditorRequired] public string PersonId { get; set; } = default!;
    [Parameter] public string? Provenance { get; set; }
    [Parameter, EditorRequired] public Paging<EdgeEntry> Initial { get; set; } = default!;
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public bool ShowHeading { get; set; } = true;
    [Parameter, EditorRequired] public EventCallback<PopoverOpening> OnExplore { get; set; }

    private readonly RequestSeries _reveals = new();
    private Paging<EdgeEntry> _paging = Paging.Unread<EdgeEntry>();
    private bool _initialized;
    private bool _loading;
    private bool _failed;

    protected override void OnParametersSet()
    {
        if (_initialized)
        {
            return;
        }

        _initialized = true;
        _paging = Initial;
    }

    public void Dispose() => _reveals.Stop();

    private async Task RevealMore()
    {
        if (_loading)
        {
            return;
        }

        _loading = true;
        _failed = false;
        (await _reveals.Next().Fetch(() => _paging.Next(Graph, PersonId, EdgeKind.MentionedIn))).Match(
            arrived: paging => _paging = paging,
            failed: () => _failed = true,
            superseded: () => { });
        _loading = false;
    }
}
