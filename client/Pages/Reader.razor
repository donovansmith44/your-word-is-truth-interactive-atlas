@page "/"
@page "/read/{Book}/{Chapter:int}"
@using System.Text.RegularExpressions
@implements IAsyncDisposable
@inject AtlasClient Atlas
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Bible Explorer &mdash; @BookName @_chapterNum</PageTitle>

@* Outer wrapper exists ONLY so a keydown/keyup while focus is ANYWHERE
   inside -- a verse-num button just clicked, or the popover panel once its
   own FocusAsync() lands -- bubbles to ONE pair of handlers regardless of
   exactly where focus is at that instant (OnPageKeyDown/OnPageKeyUp below).
   .reader-page and ExplorerPopover are otherwise unrelated SIBLINGS in the
   DOM (Blazor renders a conditional block as a sibling, not a child, of the
   element before it), so neither one alone could catch a keydown/keyup
   whose focus target is inside the OTHER.

   Fix round 1 finding: this used to ALSO close any open popover the instant
   Shift went down, to get ExplorerPopover's own click-outside-to-close
   backdrop (position:fixed, inset:0 -- physically covers every verse-num
   underneath it) out of the way before a shift-click's second click. That
   over-fired on Shift+Tab (ordinary backward tab traversal through the
   popover's own controls, which also sends a Shift keydown) and slammed the
   popover shut on plain keyboard navigation. Replaced with a narrower
   mechanism: OnPageKeyDown/OnPageKeyUp only track whether Shift is
   currently held (`_shiftHeld`), toggling the `reader-shift-active` class
   below, which app.css turns into `pointer-events: none` on
   `.popover-backdrop` alone -- the popover itself no longer closes on
   keydown at all, so Tab's own default focus-traversal behavior (never
   prevented here) proceeds normally through an open popover exactly like
   it would anywhere else. The backdrop being un-clickable for the instant
   Shift is held is a deliberate, narrow trade (click-outside-to-close is
   briefly unavailable), not an oversight -- see OnVerseNumClick's own
   comment for how the range-forming shift-click itself still closes the
   popover afterward, unchanged.

   `reader-shift-active` reacts to Shift released OUTSIDE this window too
   (alt-tab away, switch browser tabs) via reader.js's watchShiftRelease --
   see OnAfterRenderAsync/DisposeAsync below -- so it can never get stuck on
   if this page's own keyup never fires. Otherwise purely structural -- no
   visual effect of its own; .reader-page keeps its own min-height:100vh
   (vh units are viewport-relative regardless of ancestor nesting) and
   .popover keeps its own position:fixed centering (an unstyled wrapper
   introduces no new containing block). *@
<div class="@(_shiftHeld ? "reader-shift-active" : null)" @onkeydown="OnPageKeyDown" @onkeyup="OnPageKeyUp">
    <div class="reader-page" data-testid="reader-root">
        <ScripturePicker OnApply="ApplyScriptureRef" ThemeClass="picker-parchment" />

        @if (ChapterMatchesRoute)
        {
            <article class="reader-column">
                <h1 class="chapter-head">
                    <span class="chapter-head-book">@BookName</span>
                    <span class="chapter-head-num">@_chapterNum</span>
                </h1>

                @foreach (var v in _chapter!.Verses)
                {
                    <p class="verse-line" data-testid="verse-line-@v.Verse" id="v@(v.Verse)">
                        <button type="button" class="verse-num" data-testid="verse-num-@v.Verse" @onclick="@(e => OnVerseNumClick(e, v.Verse))">@v.Verse</button>
                        <span class="verse-text">@v.Text</span>
                        <button type="button" class="verse-explore" data-testid="verse-explore-@v.Verse"
                                aria-label="@($"Explore {_book}.{_chapterNum}.{v.Verse}")" @onclick="() => SetAnchorAndOpen(v.Verse)">&#8756;</button>
                    </p>
                }
            </article>
        }
        else if (_errorMessage is null)
        {
            <p class="reader-loading">Loading&hellip;</p>
        }

        <nav aria-label="Chapter navigation">
            @if (PrevTarget is { } prev)
            {
                <a class="reader-prev" data-testid="reader-prev" href="@($"/read/{prev.Book}/{prev.Chapter}")">&lsaquo; @prev.Name @prev.Chapter</a>
            }
            @if (NextTarget is { } next)
            {
                <a class="reader-next" data-testid="reader-next" href="@($"/read/{next.Book}/{next.Chapter}")">@next.Name @next.Chapter &rsaquo;</a>
            }
        </nav>

        @if (_passageRange is { } range)
        {
            <button type="button" class="passage-chip" data-testid="passage-chip" @onclick="OpenPassage">@PassageRef(range)</button>
        }

        @if (_errorMessage is not null)
        {
            <div class="toast" data-testid="toast">
                <p class="toast-message">@_errorMessage</p>
            </div>
        }
    </div>

    @if (_activeNode is not null)
    {
        <ExplorerPopover @key="_activeNode" Root="_activeNode" OnClose="ClosePopover" />
    }
</div>

@code {
    private static readonly Regex VerseFragment = new(@"^#v(\d+)$", RegexOptions.Compiled);

    [Parameter] public string? Book { get; set; }
    [Parameter] public int? Chapter { get; set; }

    private List<BookTocEntry>? _toc;
    private string _book = "GEN";
    private int _chapterNum = 1;
    private ChapterOut? _chapter;
    private string? _loadedBook;
    private int? _loadedChapterNum;
    private string? _errorMessage;
    private IExplorable? _activeNode;

    // Passage selection (READ-5/Task 15). _anchorVerse is the last PLAIN
    // click (never a shift-click); it stays fixed across repeated shift-
    // clicks against different verses (standard shift-click UX: the anchor
    // only moves on a fresh plain click), so it's a real int? field, not
    // just "whatever OpenVerse last touched". _passageRange is null unless
    // a shift-click just formed a real range (V1<=V2, canonical order
    // regardless of click direction -- see OnVerseNumClick).
    private int? _anchorVerse;
    private (int From, int To)? _passageRange;

    private int _requestId;
    private string? _scrolledFragment;
    private IJSObjectReference? _readerJs;

    // Backdrop-inertness while Shift is held (fix round 1) -- see the
    // wrapper div's own comment above and OnPageKeyDown/OnPageKeyUp below.
    // _selfRef is only ever used for reader.js's watchShiftRelease ->
    // ResetShiftHeld bridge (the window-blur/tab-hidden safety net); never
    // passed anywhere else.
    private bool _shiftHeld;
    private DotNetObjectReference<Reader>? _selfRef;

    private string BookName => _toc?.FirstOrDefault(b => b.Code == _book)?.Name ?? _book;

    // Fix round 1 finding: _book/_chapterNum are updated to the NEW route's
    // values SYNCHRONOUSLY in OnParametersSetAsync, before LoadChapter's
    // await resolves -- Blazor renders once in between (the intermediate
    // render any non-synchronously-completing lifecycle await triggers),
    // and at THAT render _chapter still holds the PREVIOUS chapter's data.
    // Gating on "_chapter is not null" alone let that intermediate render
    // show the new heading over the old chapter's verse rows, and let
    // OnAfterRenderAsync try to scroll a fragment against the wrong
    // chapter's DOM (silently consuming _scrolledFragment so the real
    // scroll, once the correct chapter finally renders, was suppressed).
    //
    // _loadedBook/_loadedChapterNum (below) are stamped by LoadChapter
    // itself at the exact moment it assigns _chapter, from the SAME _book/
    // _chapterNum values that drove that fetch -- NOT from ChapterOut's own
    // Book field, which turns out to be the book's display NAME ("Genesis"),
    // not its canonical code ("GEN"); comparing that against _book would
    // never match and would wedge the page on "Loading..." forever (caught
    // by hand-testing this fix, not by READ-1..3, which never deep-link
    // into a chapter fast enough to observe the intermediate render).
    private bool ChapterMatchesRoute =>
        _chapter is not null && _loadedBook == _book && _loadedChapterNum == _chapterNum;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _toc = await Atlas.Books();
        }
        catch (Exception)
        {
            _errorMessage = "Couldn't load the book list — check your connection and try again.";
        }
    }

    // Runs on every navigation, including the very first one -- book/chapter
    // change (a genuinely new chapter, refetch + close any open popover) is
    // distinguished from a fragment-only change (e.g. the picker jumping to
    // a different verse anchor within the SAME chapter, or a re-render with
    // unchanged route params) which must NOT redundantly refetch or drop an
    // open popover. Checking _loadedBook/_loadedChapterNum here (not just
    // "_chapter is not null") matters for a case adjacent to fix round 1's
    // finding 1: if a fetch for this exact target previously FAILED,
    // _chapter still holds whatever chapter loaded before that (non-null,
    // but stale/mismatched) -- re-navigating to the same failed target must
    // still retry the fetch, not silently no-op because SOME chapter
    // happens to be loaded.
    protected override async Task OnParametersSetAsync()
    {
        var book = string.IsNullOrWhiteSpace(Book) ? "GEN" : Book.ToUpperInvariant();
        var chapterNum = Chapter ?? 1;

        // Chip-clearing rule: this component's own design choice (NOT a
        // verbatim quote from the Task 15 brief or design-direction.md --
        // the brief's actual, verbatim note on this interplay is quoted
        // below, at OnVerseNumClick) is that a new anchor or a navigation
        // each clear the chip. A new anchor is handled in SetAnchorAndOpen
        // (_passageRange = null there). Navigating is handled here:
        // OnParametersSetAsync only ever runs in response to a genuine
        // navigation the router dispatched to this page (initial load, or
        // any URL change matching this route, including a same-chapter
        // fragment-only jump from the picker), never from an unrelated
        // StateHasChanged elsewhere -- so unconditionally resetting here,
        // before the redundant-refetch guard below, clears the chip on
        // every kind of navigation, not only ones that also change chapter.
        _anchorVerse = null;
        _passageRange = null;

        if (book == _book && chapterNum == _chapterNum && _loadedBook == book && _loadedChapterNum == chapterNum)
        {
            return;
        }

        _book = book;
        _chapterNum = chapterNum;
        _activeNode = null;
        _scrolledFragment = null;
        await LoadChapter();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _readerJs = await JS.InvokeAsync<IJSObjectReference>("import", "./js/reader.js");

            // Fix round 1: Blazor has no binding for window.blur/
            // document.visibilitychange (releasing Shift while this
            // tab/window isn't focused never fires a DOM keyup ON THIS
            // PAGE at all), so this tiny JS-side watcher exists purely to
            // guarantee _shiftHeld can't get stuck true -- see reader.js's
            // own comment. ResetShiftHeld is the only [JSInvokable] this
            // page exposes, and _selfRef is disposed in DisposeAsync below.
            _selfRef = DotNetObjectReference.Create(this);
            await _readerJs.InvokeVoidAsync("watchShiftRelease", _selfRef);
        }

        if (!ChapterMatchesRoute || _readerJs is null)
        {
            return;
        }

        var fragment = new Uri(Nav.Uri).Fragment;
        if (fragment == _scrolledFragment)
        {
            return;
        }

        _scrolledFragment = fragment;
        var m = VerseFragment.Match(fragment);
        if (m.Success)
        {
            await _readerJs.InvokeVoidAsync("scrollToVerse", int.Parse(m.Groups[1].Value));
        }
    }

    private async Task LoadChapter()
    {
        var myRequest = ++_requestId;
        try
        {
            var chapter = await Atlas.Chapter(_book, _chapterNum);
            if (myRequest != _requestId)
            {
                return; // superseded by a newer navigation -- discard this stale response
            }

            // myRequest == _requestId here guarantees no newer navigation has
            // started since this fetch began (that would have changed _book/
            // _chapterNum AND bumped _requestId again) -- so the CURRENT
            // values of _book/_chapterNum are exactly what this fetch was for.
            _chapter = chapter;
            _loadedBook = _book;
            _loadedChapterNum = _chapterNum;
            _errorMessage = null;
        }
        catch (Exception)
        {
            if (myRequest != _requestId)
            {
                return;
            }

            _errorMessage = $"Couldn't load {_book} {_chapterNum} — check your connection and try again.";
        }
    }

    private void OpenVerse(int verseNum) => _activeNode = new VerseNode($"{_book}.{_chapterNum}.{verseNum}");

    private Task ClosePopover()
    {
        _activeNode = null;
        return Task.CompletedTask;
    }

    // Fix round 1 (replaces a prior version that closed any open popover
    // the instant Shift went down -- see the wrapper div's own comment for
    // why that over-fired on Shift+Tab). This pair only ever tracks
    // _shiftHeld; neither touches _activeNode. The original problem this
    // exists to solve is still real: ExplorerPopover's own backdrop is a
    // full-viewport, position:fixed div (by design -- click-outside-to-
    // close) that physically intercepts pointer events, so a plain click's
    // popover staying open would make a shift-click's SECOND click (on a
    // different verse-num) impossible to land at all -- it would just retry
    // against the intercepting backdrop until its actionability timeout,
    // never reaching OnVerseNumClick below. `reader-shift-active` (toggled
    // on the wrapper div above, see its own comment) turns that backdrop
    // `pointer-events: none` for exactly as long as Shift is held, so the
    // second click's pointer event passes through to the verse-num button
    // beneath it -- OnVerseNumClick's own existing shift-click branch then
    // closes the popover itself once a valid range actually forms (or
    // doesn't, if it fell through to the plain-click path -- see its
    // comment), same as before this fix round.
    //
    // Bound on this component's own wrapper div (not verse-num or the
    // popover panel individually) for the same reason the original version
    // was: the real test never waits for ExplorerPopover's own async
    // FocusAsync() to land before pressing Shift, so focus could still be
    // on the just-clicked verse-num button at that instant, or could
    // already be inside the popover panel -- only a common ancestor of BOTH
    // catches the bubbled keydown/keyup reliably regardless of which one
    // currently has focus.
    private void OnPageKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Shift")
        {
            _shiftHeld = true;
        }
    }

    private void OnPageKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Shift")
        {
            _shiftHeld = false;
        }
    }

    // reader.js's watchShiftRelease -> window.blur/document.visibilitychange
    // safety net (see OnAfterRenderAsync). The ONLY way _shiftHeld can go
    // stuck true is Shift being physically released while this tab/window
    // isn't the focused one -- no DOM keyup for it ever reaches this page
    // in that case. Resetting unconditionally (rather than trying to prove
    // Shift is truly no longer held) is always the safe direction: at worst
    // this fires once while Shift genuinely is still down (the user let go
    // specifically while alt-tabbed away), which just makes the backdrop
    // briefly clickable again a little early -- a real Shift keydown on
    // return sets _shiftHeld back to true immediately, same as any other
    // fresh keydown.
    [JSInvokable]
    public void ResetShiftHeld()
    {
        if (_shiftHeld)
        {
            _shiftHeld = false;
            StateHasChanged();
        }
    }

    // READ-2/READ-5 interplay (brief note, verbatim): "plain click closes
    // any popover, opens verse popover, sets anchor; shift-click suppresses
    // popover and shows the chip." A shift-click with no anchor yet (the
    // user shift-clicked before ever plain-clicking a verse this visit) has
    // nothing to form a range against -- falls through to the plain-click
    // path instead of silently doing nothing, so the shift-clicked verse
    // itself becomes a usable anchor for the NEXT shift-click. Same
    // fallback when the anchor and the shift-clicked verse are the SAME
    // verse (a degenerate "V-V" range), which would otherwise produce a
    // meaningless one-verse "passage".
    private void OnVerseNumClick(MouseEventArgs e, int verseNum)
    {
        if (e.ShiftKey && _anchorVerse is int anchor && anchor != verseNum)
        {
            _passageRange = (Math.Min(anchor, verseNum), Math.Max(anchor, verseNum));
            _activeNode = null; // suppress the popover -- the chip is the result of a shift-click, not a new popover
            return;
        }

        SetAnchorAndOpen(verseNum);
    }

    // The shared "plain click" behavior: verse-num's own non-shift path and
    // verse-explore's own click both funnel here -- the ∴ affordance is
    // always an explicit "open this verse" action regardless of any
    // modifier key held, never a range-selection gesture.
    private void SetAnchorAndOpen(int verseNum)
    {
        _anchorVerse = verseNum;
        _passageRange = null;
        OpenVerse(verseNum);
    }

    private string PassageRef((int From, int To) range) => $"{_book}.{_chapterNum}.{range.From}-{range.To}";

    // passage-chip click (READ-5): PassageNode takes its text directly
    // (concatenated from verses the reader already has in memory -- see
    // PassageNode.cs's own doc comment) rather than issuing a second
    // network round-trip for content this page already rendered.
    private void OpenPassage()
    {
        if (_passageRange is not { } range || _chapter is not { } chapter)
        {
            return;
        }

        var text = string.Join(" ", chapter.Verses
            .Where(v => v.Verse >= range.From && v.Verse <= range.To)
            .Select(v => v.Text));
        _activeNode = new PassageNode(PassageRef(range), text);
    }

    // ScripturePicker composes one of GEN / GEN.1 / GEN.1.5 / GEN.1.5-9 (the
    // 4 canonical ref shapes -- see ScripturePicker.Apply); this is the
    // reader's own NavigateReader-style dispatch for it (World's mount
    // instead sends the same ref straight into scripture-mode).
    private Task ApplyScriptureRef(string sref)
    {
        var parts = sref.Split('.');
        var book = parts[0];
        var chapterNum = parts.Length > 1 ? int.Parse(parts[1]) : 1;
        int? verse = null;
        if (parts.Length > 2)
        {
            var versePart = parts[2];
            var dash = versePart.IndexOf('-');
            verse = int.Parse(dash >= 0 ? versePart[..dash] : versePart);
        }

        Nav.NavigateTo($"/read/{book}/{chapterNum}" + (verse is int v ? $"#v{v}" : ""));
        return Task.CompletedTask;
    }

    private sealed record AdjacentChapter(string Book, string Name, int Chapter);

    private AdjacentChapter? PrevTarget => ComputeAdjacent(forward: false);
    private AdjacentChapter? NextTarget => ComputeAdjacent(forward: true);

    // Crosses book boundaries via the TOC: GEN.50 next -> EXO.1; EXO.1 prev
    // -> GEN.50; null (hidden) at GEN.1's prev and REV.22's next.
    private AdjacentChapter? ComputeAdjacent(bool forward)
    {
        if (_toc is null)
        {
            return null;
        }

        var idx = _toc.FindIndex(b => b.Code == _book);
        if (idx < 0)
        {
            return null;
        }

        var entry = _toc[idx];
        if (forward)
        {
            if (_chapterNum < entry.Chapters.Count)
            {
                return new AdjacentChapter(_book, entry.Name, _chapterNum + 1);
            }

            return idx + 1 < _toc.Count ? new AdjacentChapter(_toc[idx + 1].Code, _toc[idx + 1].Name, 1) : null;
        }

        if (_chapterNum > 1)
        {
            return new AdjacentChapter(_book, entry.Name, _chapterNum - 1);
        }

        if (idx == 0)
        {
            return null;
        }

        var prevEntry = _toc[idx - 1];
        return new AdjacentChapter(prevEntry.Code, prevEntry.Name, prevEntry.Chapters.Count);
    }

    public async ValueTask DisposeAsync()
    {
        if (_readerJs is not null)
        {
            try
            {
                // Removes reader.js's own window/document-level blur and
                // visibilitychange listeners (see watchShiftRelease's own
                // comment) BEFORE disposing the module reference itself --
                // those listeners are global (window/document, not scoped
                // to this component's own DOM), so leaving them wired past
                // this page's own lifetime would call back into a disposed
                // _selfRef on every future navigation's blur/visibility
                // event for as long as the browser tab stays open.
                await _readerJs.InvokeVoidAsync("unwatchShiftRelease");
                await _readerJs.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already gone during teardown -- nothing left to clean up JS-side.
            }
        }

        _selfRef?.Dispose();
    }
}
