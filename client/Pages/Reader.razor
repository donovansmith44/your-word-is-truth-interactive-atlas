@page "/"
@page "/read/{Book}/{Chapter:int}"
@using System.Text.RegularExpressions
@using BibleAtlas.Client.State
@using BibleAtlas.Client.Views
@implements IAsyncDisposable
@inject AtlasClient Atlas
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ViewStateService ViewState
@inject StateAtom<IReadOnlyList<ExplorationDescriptor>> SelectionAtom
@inject PaneScopes Panes
@inject StateAtom<ViewArrangement> ViewArrangementAtom

<PageTitle>Bible Explorer &mdash; @BookName @_chapterNum</PageTitle>

@* Wraps .reader-page and ExplorerPopover -- rendered as DOM siblings, not
   parent/child -- so a keydown/keyup anywhere inside either one bubbles to
   one shared handler pair below, regardless of which currently has focus. *@
<div class="@(_shiftHeld ? "reader-shift-active" : "")"
     @onkeydown="OnPageKeyDown" @onkeyup="OnPageKeyUp">
    <CompositionSplit HostName="@ViewNames.Reader" SplitModeOverride="@SplitMode"
                       OnFractionCommitted="OnDividerFractionCommitted" HostPaneClass="split-pane-reader"
                       OnArrangementChanged="OnViewArrangementChanged" @ref="_compositionSplit" Context="ctx">
        <div class="@($"reader-frame{(ctx.IsSplitOpen && ctx.IsHost ? " split-pane-frame" : "")}")" data-testid="reader-frame">
        <div class="@($"reader-page{ctx.HostPaneClassSuffix}{(ctx.IsSplitOpen ? " reader-page-split-scope" : "")}")" data-testid="reader-root">
        @if (!ctx.IsSplitOpen)
        {
            <button type="button" class="split-open split-open-parchment" data-testid="split-open-reader"
                    @onclick="ctx.InvokeHatch">
                Open the map beside the text
            </button>
            @if (ctx.Partners.Count > 1)
            {
                <button type="button" class="split-open split-open-parchment split-open-menu-toggle" data-testid="enter-split-menu-toggle"
                        aria-label="Choose what to open beside the text" aria-expanded="@(_splitMenuOpen ? "true" : "false")"
                        @onclick="() => _splitMenuOpen = !_splitMenuOpen">&#9662;</button>
                @if (_splitMenuOpen)
                {
                    <div class="enter-split-menu enter-split-menu-parchment" data-testid="enter-split-menu" role="menu">
                        @foreach (var guest in ctx.Partners)
                        {
                            var g = guest;
                            <button type="button" role="menuitem" class="enter-split-menu-item" data-testid="@($"enter-split-guest-{g}")"
                                    @onclick="async () => { _splitMenuOpen = false; await ctx.InvokeHatchWith.InvokeAsync(g); }">
                                @ctx.LabelOf(g)
                            </button>
                        }
                    </div>
                }
            }
        }
        else if (ctx.IsSameView && !ctx.IsHost)
        {
            <div class="split-atlas-controls" data-testid="split-reader-guest-controls">
                <button type="button" class="follow-chip" data-testid="reader-follow-chip"
                        aria-pressed="@(ctx.Follow ? "true" : "false")" @onclick="() => ctx.ToggleFollow.InvokeAsync()">
                    @(ctx.Follow ? "Following the other reader" : "Follow the other reader")
                </button>
                <button type="button" class="split-close split-close-parchment" data-testid="split-close-reader-guest"
                        aria-label="Close this reader" @onclick="() => ctx.RequestClose.InvokeAsync()">&times;</button>
            </div>
        }
        else if (ctx.IsHost)
        {
            <button type="button" class="split-close split-close-parchment" data-testid="split-close-reader"
                    aria-label="Close the reader, keep the map" @onclick="CloseReaderPane">
                &times;
            </button>
        }
        else
        {
            <button type="button" class="split-close split-close-parchment" data-testid="split-close-reader-guest"
                    aria-label="Close the reader" @onclick="ctx.RequestClose">
                &times;
            </button>
        }

        <ScripturePicker OnApply="ApplyScriptureRef" ThemeClass="picker-parchment" CurrentBook="@_book" CurrentChapter="@_chapterNum" />

        @if (ChapterMatchesRoute)
        {
            <article class="reader-column">
                <h1 class="chapter-head">
                    <button type="button" class="chapter-head-button explorable" data-testid="chapter-head"
                            aria-label="@($"Explore {_book}.{_chapterNum}")"
                            @onclick="OpenChapter" @onmouseenter="OnChapterHeadPointerEnter" @onmouseleave="OnChapterHeadPointerLeave">
                        <span class="chapter-head-book">@BookName</span>
                        <span class="chapter-head-num">@_chapterNum</span>
                    </button>
                    <button type="button" class="contents-open" data-testid="contents-open" aria-label="Contents"
                            title="Contents" @onclick="OpenContents">Contents</button>
                    @if (_showChapterPeek)
                    {
                        <div class="chapter-head-peek" data-testid="chapter-head-peek">
                            <p class="chapter-head-peek-position" data-testid="chapter-head-peek-position">@ChapterPeekPositionText</p>
                            @if (ChapterPeekHeadings.Count > 0)
                            {
                                <ul class="chapter-head-peek-headings">
                                    @foreach (var heading in ChapterPeekHeadings)
                                    {
                                        <li data-testid="@($"chapter-head-peek-heading-{heading.EventId}")">@heading.Title</li>
                                    }
                                </ul>
                            }
                        </div>
                    }
                </h1>

                @{ var xrefLetters = VerseLine.ComputeXrefLetters(_chapter!.Verses); }
                @foreach (var v in _chapter!.Verses)
                {
                    @if (v.Heading is { } heading)
                    {
                        <PericopeHeading Heading="@heading" OnExplore="OnLineExplore" />
                    }
                    <VerseLine Verse="@v" Unit="@_text!.Verse(v.Number)" Book="@_book" Chapter="@_chapterNum" OnExplore="OnLineExplore" Id="@($"v{v.Number}")"
                               RowClass="verse-line explorable" RowTestIdPrefix="verse-line"
                               VerseNumClass="verse-num" ShowVerseNumButton="true" VerseNumTestIdPrefix="verse-num"
                               OnVerseNumClick="@(e => OnVerseNumClick(e, v.Number))"
                               TextClass="verse-text" MentionClass="verse-mention"
                               XrefMarkerGlyph="@xrefLetters.GetValueOrDefault(v.Number, "")"
                               OnXrefClick="OpenVerseXrefEntryPersistent" OnXrefHoverEnter="OpenVerseXrefEntryHover"
                               OnXrefHoverLeave="OnXrefMarkerPointerLeave" OnToggleSelect="OnLineToggleSelect"
                               OnMentionToggleSelect="OnMentionToggleSelect" />
                }
            </article>
        }
        else if (_errorMessage is null)
        {
            <p class="reader-loading">Loading&hellip;</p>
        }

        <nav aria-label="Chapter navigation">
            @if (PrevTarget is { } prev)
            {
                <a class="reader-prev" data-testid="reader-prev" href="@ChapterHref(prev.Book, prev.Chapter, ctx)"
                   @onclick="@(() => OnChapterNavClick(prev.Book, prev.Chapter))" @onclick:preventDefault="@(ctx.IsSplitOpen && !ctx.IsHost)"
                   aria-label="@($"Previous chapter: {prev.Name} {prev.Chapter}")">&lsaquo;<span class="reader-nav-label"> @prev.Name @prev.Chapter</span></a>
            }
            @if (NextTarget is { } next)
            {
                <a class="reader-next" data-testid="reader-next" href="@ChapterHref(next.Book, next.Chapter, ctx)"
                   @onclick="@(() => OnChapterNavClick(next.Book, next.Chapter))" @onclick:preventDefault="@(ctx.IsSplitOpen && !ctx.IsHost)"
                   aria-label="@($"Next chapter: {next.Name} {next.Chapter}")"><span class="reader-nav-label">@next.Name @next.Chapter </span>&rsaquo;</a>
            }
        </nav>

        @if (_passageRange is { } range)
        {
            <button type="button" class="passage-chip" data-testid="passage-chip" @onclick="OpenPassage">@PassageRef(range)</button>
        }

        @if (_errorMessage is not null)
        {
            <div class="toast" data-testid="toast">
                <p class="toast-message">@_errorMessage</p>
            </div>
        }
        </div>
        </div>
    </CompositionSplit>

    @if (_contentsOpen)
    {
        <ContentsPanel Corpus="Corpus.Bible" CurrentRef="@($"{_book}.{_chapterNum}")" OnNavigate="OnContentsNavigate" OnClose="CloseContents" />
    }

    @if (_activeNode is not null)
    {
        <ExplorerPopover @key="_activeNode" Root="_activeNode" OnClose="ClosePopover"
                          InSplit="@(_compositionSplit?.IsSplitOpen == true && _compositionSplit?.IsHost == true)" OnNavigateWorldInSplit="NavigateWorldInSplit" PaneAnchor="@(_compositionSplit?.IsSplitOpen == true ? "reader" : null)"
                          VerseAnchorSelector="@(_xrefEntryVerse is int xv ? $"#v{xv}" : null)" ShowBackdrop="!_hoverOnlyOpen"
                          OnPanelPointerEnter="CancelHoverClose" OnPanelPointerLeave="OnPanelPointerLeaveHoverGuard" />
    }
</div>

@code {
    private static readonly Regex VerseFragment = new(@"^#v(\d+)$", RegexOptions.Compiled);

    [Parameter] public string? Book { get; set; }
    [Parameter] public int? Chapter { get; set; }

    [Parameter] public bool? SplitMode { get; set; }

    [CascadingParameter] public PaneId Pane { get; set; } = PaneId.Host;

    private StateAtom<Locus>? _locusAtomBacking;
    private StateAtom<Locus> LocusAtom => _locusAtomBacking ??= Panes.For(Pane).Locus;

    private bool _splitMenuOpen;

    private CompositionSplit? _compositionSplit;

    private List<CanonBook>? _toc;

    private Projection<Locus>? _locusBacking;
    private Projection<Locus> _locus => _locusBacking ??= new Projection<Locus>(LocusAtom);
    private string _book => _locus.Value.Book;
    private int _chapterNum => _locus.Value.Chapter;
    private Chapter? _chapter;
    private ChapterText? _text;
    private string? _loadedBook;
    private int? _loadedChapterNum;
    private string? _errorMessage;
    private IExplorable? _activeNode;

    private int? _anchorVerse;
    private (int From, int To)? _passageRange;

    private readonly RequestSeries _startup = new();
    private readonly RequestSeries _chapters = new();
    private string? _scrolledFragment;
    private IJSObjectReference? _readerJs;

    // At most once per component instance: this component is reused, not
    // recreated, across an in-session chapter change, so without this a
    // later navigation to a chapter that happens to match ViewState.Reader's
    // leftover Book/Chapter could restore a stale, unrelated scroll position.
    private bool _scrollRestoreAttempted;

    private bool _shiftHeld;
    private DotNetObjectReference<Reader>? _selfRef;

    private string BookName => _toc?.FirstOrDefault(b => b.Code == _book)?.Name ?? _book;

    private Task NavigateWorldInSplit(string query) => _compositionSplit?.NavigateGuestInSplit(query) ?? Task.CompletedTask;

    private void CloseReaderPane() => Nav.NavigateTo("/world");

    private void OnDividerFractionCommitted(double fraction) => ViewState.Map.DividerFraction = fraction;

    // Takes `ctx` as a parameter, not `_compositionSplit`: this href is
    // computed while CompositionSplit is still executing its own first
    // render (before Blazor assigns the @ref), so reading the ref here would
    // silently omit the split query on a fresh split-open's first paint.
    private string ChapterHref(string book, int chapter, CompositionSplitContext ctx) =>
        $"/read/{book}/{chapter}{SplitQuerySuffix(ctx.IsSplitOpen && ctx.IsHost)}";

    private string SplitQuerySuffix(bool isHostSplit) =>
        isHostSplit
            ? $"?{SplitUrlContract.SplitParam}={ViewNames.World}" +
              (ViewArrangementAtom.Value.Follow ? $"&{SplitUrlContract.FollowParam}={SplitUrlContract.FollowTrueValue}" : "")
            : "";

    // _loadedBook/_loadedChapterNum are stamped from the SAME _book/
    // _chapterNum that drove the fetch, never from Chapter's own Book
    // field -- that's the display name ("Genesis"), not the code ("GEN"),
    // so comparing against it would never match and would wedge the page
    // on "Loading..." forever.
    private bool ChapterMatchesRoute =>
        _chapter is not null && _loadedBook == _book && _loadedChapterNum == _chapterNum;

    protected override async Task OnInitializedAsync()
    {
        if (SplitMode is not null)
        {
            LocusAtom.Changed += OnLocusChangedAsGuest;
        }

        try
        {
            _toc = await _startup.Next().Fetch(() => Atlas.Books());
        }
        catch (Exception)
        {
            _errorMessage = "Couldn't load the book list — check your connection and try again.";
        }
    }

    private void OnLocusChangedAsGuest() => _ = RefreshAsGuestAsync();

    private async Task RefreshAsGuestAsync()
    {
        if (_loadedBook == _book && _loadedChapterNum == _chapterNum)
        {
            return;
        }

        ResetXrefEntryState();
        _activeNode = null;
        _scrolledFragment = null;
        await LoadChapter();
        StateHasChanged();
    }

    private void OnViewArrangementChanged()
    {
        StateHasChanged();
    }

    protected override async Task OnParametersSetAsync()
    {
        string book;
        int chapterNum;

        if (SplitMode is null)
        {
            book = string.IsNullOrWhiteSpace(Book) ? "GEN" : Book.ToUpperInvariant();
            chapterNum = Chapter ?? 1;
        }
        else
        {
            book = _book;
            chapterNum = _chapterNum;
        }

        _anchorVerse = null;
        _passageRange = null;

        if (book == _book && chapterNum == _chapterNum && _loadedBook == book && _loadedChapterNum == chapterNum)
        {
            return;
        }

        if (SplitMode is null)
        {
            LocusAtom.Dispatch(new SetLocus(book, chapterNum));
        }

        ResetXrefEntryState();
        _activeNode = null;
        _scrolledFragment = null;
        await LoadChapter();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _readerJs = await JS.InvokeAsync<IJSObjectReference>("import", "./js/reader.js");

            _selfRef = DotNetObjectReference.Create(this);
            await _readerJs.InvokeVoidAsync("watchShiftRelease", _selfRef);
        }

        // Rebinds on every render, not just firstRender: a split opened via a
        // hatch click, or a `?split=world` load, recreates `.reader-page`
        // across that shape change, which would otherwise leave this bound
        // to the old `window` scroll target.
        if (_readerJs is not null)
        {
            await _readerJs.InvokeVoidAsync("watchScroll", _selfRef);
        }

        if (!ChapterMatchesRoute || _readerJs is null)
        {
            return;
        }

        var fragment = new Uri(Nav.Uri).Fragment;
        if (fragment == _scrolledFragment)
        {
            return;
        }

        _scrolledFragment = fragment;
        var m = VerseFragment.Match(fragment);
        if (m.Success)
        {
            await _readerJs.InvokeVoidAsync("scrollToVerse", int.Parse(m.Groups[1].Value));
        }
        else if (!_scrollRestoreAttempted)
        {
            _scrollRestoreAttempted = true;
            if (ViewState.Reader.HasData && ViewState.Reader.Book == _book && ViewState.Reader.Chapter == _chapterNum)
            {
                await _readerJs.InvokeVoidAsync("setScrollY", ViewState.Reader.ScrollY);
            }
        }
    }

    private async Task LoadChapter()
    {
        var request = _chapters.Next();

        if (_loadedBook is { } prevBook && _loadedChapterNum is { } prevChapterNum)
        {
            ViewState.UnmountReaderChapter(prevBook, prevChapterNum);
        }

        // Nulled in the same breath as the unmount above: if the fetch below
        // fails, leaving these stale would let a later unmount (the next
        // LoadChapter, or DisposeAsync) spend the same mount credit a second
        // time, wrongly decrementing a count a sibling split-pane still
        // legitimately holds.
        _loadedBook = null;
        _loadedChapterNum = null;

        try
        {
            if (await request.Fetch(() => Atlas.Chapter(_book, _chapterNum), () => Atlas.ChapterText(_book, _chapterNum)) is not { } loaded)
            {
                return;
            }

            (_chapter, _text) = loaded;
            _loadedBook = _book;
            _loadedChapterNum = _chapterNum;
            _errorMessage = null;

            ViewState.MountReaderChapter(_loadedBook, _loadedChapterNum.Value);
        }
        catch (Exception)
        {
            if (request.Superseded)
            {
                return;
            }

            _errorMessage = $"Couldn't load {_book} {_chapterNum} — check your connection and try again.";
        }
    }

    private void OnLineExplore(IExplorable node)
    {
        ResetXrefEntryState();
        _activeNode = node;
    }

    private void OnLineToggleSelect(VerseNode node) => SelectionAtom.Dispatch(new ToggleSelection(ExplorationDescriptor.Capture(node)));

    private void OnMentionToggleSelect(IExplorable node) => SelectionAtom.Dispatch(new ToggleSelection(ExplorationDescriptor.Capture(node)));

    private void ResetXrefEntryState()
    {
        _xrefEntryVerse = null;
        _hoverOnlyOpen = false;
        CancelHoverCloseTimer();
    }

    private int? _xrefEntryVerse;

    private void OpenVerseXrefEntry(int verseNum, bool persistent)
    {
        var vref = $"{_book}.{_chapterNum}.{verseNum}";
        _xrefEntryVerse = verseNum;
        if (_activeNode is VerseNode { XrefEntryPoint: true } current && current.Title == vref)
        {
            if (persistent)
            {
                _hoverOnlyOpen = false;
                CancelHoverCloseTimer();
            }
            return;
        }

        _activeNode = new VerseNode(vref, xrefEntryPoint: true);
        _hoverOnlyOpen = !persistent;
        CancelHoverCloseTimer();
    }

    private void OpenVerseXrefEntryPersistent(int verseNum) => OpenVerseXrefEntry(verseNum, persistent: true);

    private void OpenVerseXrefEntryHover(int verseNum) => OpenVerseXrefEntry(verseNum, persistent: false);

    private bool _hoverOnlyOpen;

    private CancellationTokenSource? _hoverCloseCts;

    private void CancelHoverCloseTimer()
    {
        _hoverCloseCts?.Cancel();
        _hoverCloseCts = null;
    }

    private void OnXrefMarkerPointerLeave() => ScheduleHoverClose();

    private void OnPanelPointerLeaveHoverGuard() => ScheduleHoverClose();

    private void CancelHoverClose() => CancelHoverCloseTimer();

    private void ScheduleHoverClose()
    {
        if (!_hoverOnlyOpen)
        {
            return;
        }

        CancelHoverCloseTimer();
        var cts = new CancellationTokenSource();
        _hoverCloseCts = cts;
        _ = DelayedHoverClose(cts);
    }

    // 1000ms: tuned against a real, live-caught race -- shorter values got
    // eaten by the popover's own open animation plus real cursor transit
    // time before OnPanelPointerEnter could land, closing the popover
    // mid-transit.
    private async Task DelayedHoverClose(CancellationTokenSource cts)
    {
        try
        {
            await Task.Delay(1000, cts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (cts.IsCancellationRequested || !_hoverOnlyOpen)
        {
            return;
        }

        _activeNode = null;
        _xrefEntryVerse = null;
        _hoverOnlyOpen = false;
        await InvokeAsync(StateHasChanged);
    }

    private void OpenChapter()
    {
        var title = $"{_book}.{_chapterNum}";
        if (_activeNode is ChapterNode current && current.Title == title)
        {
            return;
        }

        CancelChapterPeekTimer();
        _showChapterPeek = false;
        ResetXrefEntryState();
        var totalChapters = _toc?.FirstOrDefault(b => b.Code == _book)?.Chapters.Count;
        _activeNode = new ChapterNode(_book, _chapterNum, totalChapters) { AlreadyLoaded = _chapter };
    }

    private bool _showChapterPeek;
    private CancellationTokenSource? _chapterPeekCts;

    private void OnChapterHeadPointerEnter()
    {
        CancelChapterPeekTimer();
        var cts = new CancellationTokenSource();
        _chapterPeekCts = cts;
        _ = DelayedChapterPeekShow(cts);
    }

    private void OnChapterHeadPointerLeave()
    {
        CancelChapterPeekTimer();
        if (_showChapterPeek)
        {
            _showChapterPeek = false;
            StateHasChanged();
        }
    }

    private void CancelChapterPeekTimer()
    {
        _chapterPeekCts?.Cancel();
        _chapterPeekCts = null;
    }

    private async Task DelayedChapterPeekShow(CancellationTokenSource cts)
    {
        try
        {
            await Task.Delay(DwellTiming.PeekDelayMs, cts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        if (cts.IsCancellationRequested)
        {
            return;
        }

        _showChapterPeek = true;
        StateHasChanged();
    }

    private string ChapterPeekPositionText
    {
        get
        {
            var total = _toc?.FirstOrDefault(b => b.Code == _book)?.Chapters.Count;
            return total is int t ? $"Chapter {_chapterNum} of {t}" : $"Chapter {_chapterNum}";
        }
    }

    private List<Heading> ChapterPeekHeadings =>
        _chapter?.Verses.Where(v => v.Heading is not null).Select(v => v.Heading!).GroupBy(h => h.EventId).Select(g => g.First()).Take(8).ToList()
        ?? new List<Heading>();

    private Task ClosePopover()
    {
        ResetXrefEntryState();
        _activeNode = null;
        return Task.CompletedTask;
    }

    private void OnPageKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Shift")
        {
            _shiftHeld = true;
        }
    }

    private void OnPageKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Shift")
        {
            _shiftHeld = false;
        }
    }

    [JSInvokable]
    public void ResetShiftHeld()
    {
        if (_shiftHeld)
        {
            _shiftHeld = false;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void OnScroll(double y)
    {
        ViewState.Reader.HasData = true;
        ViewState.Reader.Book = _book;
        ViewState.Reader.Chapter = _chapterNum;
        ViewState.Reader.ScrollY = y;
    }

    private void OnVerseNumClick(MouseEventArgs e, int verseNum)
    {
        if (e.ShiftKey && _anchorVerse is int anchor && anchor != verseNum)
        {
            _passageRange = (Math.Min(anchor, verseNum), Math.Max(anchor, verseNum));
            ResetXrefEntryState();
            _activeNode = null;
            return;
        }

        SetAnchor(verseNum);
    }

    private void SetAnchor(int verseNum)
    {
        _anchorVerse = verseNum;
        _passageRange = null;
    }

    private string PassageRef((int From, int To) range) => $"{_book}.{_chapterNum}.{range.From}-{range.To}";

    private void OpenPassage()
    {
        if (_passageRange is not { } range || _chapter is not { } chapter)
        {
            return;
        }

        ResetXrefEntryState();
        var text = string.Join(" ", chapter.Verses
            .Where(v => v.Number >= range.From && v.Number <= range.To)
            .Select(v => v.Text));
        _activeNode = new PassageNode(PassageRef(range), text);
    }

    private bool IsGuestMounted => _compositionSplit is { IsSplitOpen: true, IsHost: false };

    private bool _contentsOpen;

    private void OpenContents() => _contentsOpen = true;

    private void CloseContents() => _contentsOpen = false;

    private Task OnContentsNavigate(string sref)
    {
        _contentsOpen = false;
        return ApplyScriptureRef(sref);
    }

    private Task ApplyScriptureRef(string sref)
    {
        var parts = sref.Split('.');
        var book = parts[0];
        var chapterNum = parts.Length > 1 ? int.Parse(parts[1]) : 1;
        int? verse = null;
        if (parts.Length > 2)
        {
            var versePart = parts[2];
            var dash = versePart.IndexOf('-');
            verse = int.Parse(dash >= 0 ? versePart[..dash] : versePart);
        }

        if (IsGuestMounted)
        {
            LocusAtom.Dispatch(new SetLocus(book, chapterNum));
            return Task.CompletedTask;
        }

        var query = SplitQuerySuffix(_compositionSplit is { IsSplitOpen: true, IsHost: true });
        var fragment = verse is int v ? $"#v{v}" : "";
        Nav.NavigateTo($"/read/{book}/{chapterNum}{query}{fragment}");
        return Task.CompletedTask;
    }

    private void OnChapterNavClick(string book, int chapterNum)
    {
        if (IsGuestMounted)
        {
            LocusAtom.Dispatch(new SetLocus(book, chapterNum));
        }
    }

    private sealed record AdjacentChapter(string Book, string Name, int Chapter);

    private AdjacentChapter? PrevTarget => ComputeAdjacent(forward: false);
    private AdjacentChapter? NextTarget => ComputeAdjacent(forward: true);

    private AdjacentChapter? ComputeAdjacent(bool forward)
    {
        if (_toc is null)
        {
            return null;
        }

        var idx = _toc.FindIndex(b => b.Code == _book);
        if (idx < 0)
        {
            return null;
        }

        var entry = _toc[idx];
        if (forward)
        {
            if (_chapterNum < entry.Chapters.Count)
            {
                return new AdjacentChapter(_book, entry.Name, _chapterNum + 1);
            }

            return idx + 1 < _toc.Count ? new AdjacentChapter(_toc[idx + 1].Code, _toc[idx + 1].Name, 1) : null;
        }

        if (_chapterNum > 1)
        {
            return new AdjacentChapter(_book, entry.Name, _chapterNum - 1);
        }

        if (idx == 0)
        {
            return null;
        }

        var prevEntry = _toc[idx - 1];
        return new AdjacentChapter(prevEntry.Code, prevEntry.Name, prevEntry.Chapters.Count);
    }

    public async ValueTask DisposeAsync()
    {
        LocusAtom.Changed -= OnLocusChangedAsGuest;

        CancelHoverCloseTimer();

        if (_loadedBook is { } db && _loadedChapterNum is { } dc)
        {
            ViewState.UnmountReaderChapter(db, dc);
        }

        if (_readerJs is not null)
        {
            try
            {
                // Not a dispose-time scroll read: Blazor's own router resets
                // window scroll on navigation before DisposeAsync ever runs,
                // so reading scroll position here would reliably capture 0.
                // ViewState.Reader is already kept correct continuously by
                // OnScroll while this component was mounted; this just stops
                // the listener.
                await _readerJs.InvokeVoidAsync("unwatchScroll");

                // These reader.js listeners are global (window/document
                // scoped, not tied to this component's DOM), so they must be
                // unwired before disposing the module reference -- otherwise
                // they'd call back into a disposed _selfRef on every future
                // navigation's blur/visibility event.
                await _readerJs.InvokeVoidAsync("unwatchShiftRelease");
                await _readerJs.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _selfRef?.Dispose();
    }
}
