@using BibleAtlas.Client.Exploring

@foreach (var run in AnchoredText.Runs(Text, WordsOfChrist, Anchors))
{
    @if (run[0].IsWordsOfChrist)
    {
        <span class="words-of-christ">
            <MentionScan Pieces="@run" Verse="@Verse" ClassPrefix="@ClassPrefix" TestIdSuffix="@TestIdSuffix" OnExplore="OnExplore" OnToggleSelect="OnToggleSelect" />
        </span>
    }
    else
    {
        <MentionScan Pieces="@run" Verse="@Verse" ClassPrefix="@ClassPrefix" TestIdSuffix="@TestIdSuffix" OnExplore="OnExplore" OnToggleSelect="OnToggleSelect" />
    }
}

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<Anchor> Anchors { get; set; } = default!;

    [Parameter] public IReadOnlyList<WordsOfChristSpan> WordsOfChrist { get; set; } = Array.Empty<WordsOfChristSpan>();

    [Parameter, EditorRequired] public int Verse { get; set; }

    [Parameter, EditorRequired] public string ClassPrefix { get; set; } = default!;

    [Parameter] public string TestIdSuffix { get; set; } = "";

    [Parameter, EditorRequired] public EventCallback<PopoverOpening> OnExplore { get; set; }

    [Parameter] public EventCallback<NodeRef> OnToggleSelect { get; set; }
}
