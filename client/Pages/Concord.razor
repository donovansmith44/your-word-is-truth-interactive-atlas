@page "/concord"
@using BibleAtlas.Client.Contract
@using BibleAtlas.Client.Explore
@using BibleAtlas.Client.State
@using BibleAtlas.Client.Views
@inject IExplorableClient Graph
@inject AtlasClient Atlas
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Bible Explorer &mdash; Concord</PageTitle>

<CompositionSplit HostName="@ViewNames.Concord" SplitModeOverride="@SplitMode" HostPaneClass="split-pane-host" Context="ctx">
    <div class="@($"concord-page{ctx.HostPaneClassSuffix}")" data-testid="concord-page">
        <aside class="concord-sidebar" data-testid="concord-sidebar">
            <div class="concord-sidebar-section" data-testid="concord-sidebar-search">
                <p class="concord-sidebar-label">Go to</p>
                <form class="concord-picker" data-testid="concord-picker" @onsubmit="JumpToAsync">
                    <label class="concord-picker-field">
                        <span class="concord-picker-label">Part</span>
                        <input class="concord-picker-input" type="number" min="1" data-testid="concord-picker-part" @bind="_jumpPart" />
                    </label>
                    <label class="concord-picker-field">
                        <span class="concord-picker-label">Article</span>
                        <input class="concord-picker-input" type="number" min="1" data-testid="concord-picker-article" @bind="_jumpArticle" />
                    </label>
                    <label class="concord-picker-field">
                        <span class="concord-picker-label">Paragraph</span>
                        <input class="concord-picker-input" type="number" min="1" data-testid="concord-picker-paragraph" @bind="_jumpParagraph" />
                    </label>
                    <button type="submit" class="picker-apply" data-testid="concord-picker-go">Go</button>
                </form>
            </div>

            <nav class="concord-sidebar-section" data-testid="concord-sidebar-toc" aria-label="Book of Concord contents">
                <p class="concord-sidebar-label">Contents</p>
                @if (_contents is { } contentsModel)
                {
                    <ContentsTree Model="contentsModel" RootClickNavigates="true" TestId="concord-contents-tree"
                                  RootTestId="@(n => $"concord-toc-part-{PartOf(n.Locus)}")"
                                  RootClass="concord-toc-item" RootCurrentClass="concord-toc-item-current"
                                  OnNavigate="OnContentsNavigate" />
                }
                else
                {
                    <ul class="concord-toc-list">
                        @foreach (var doc in ConcordToc.Documents)
                        {
                            var isCurrent = doc.Part == CurrentPart;
                            <li>
                                <button type="button" class="@("concord-toc-item" + (isCurrent ? " concord-toc-item-current" : ""))"
                                        data-testid="@($"concord-toc-part-{doc.Part}")"
                                        aria-current="@(isCurrent ? "true" : null)"
                                        @onclick="@(() => JumpToPartAsync(doc.Part))">
                                    @doc.Title
                                </button>
                            </li>
                        }
                    </ul>
                }
            </nav>
        </aside>

        <div class="concord-reading">
            <article class="concord-column reader-column">
                <h1 class="concord-title">The Book of Concord</h1>
                <p class="concord-intro">
                    The Lutheran confessions of 1580 &mdash; the church's own
                    confession, subordinate to the Scripture it confesses.
                </p>

                @if (!ctx.IsSplitOpen)
                {
                    <div class="concord-controls">
                        <button type="button" class="split-open split-open-parchment" data-testid="split-open-concord"
                                @onclick="ctx.InvokeHatch">
                            Read beside the reader
                        </button>
                    </div>
                }

                <p class="concord-position" data-testid="concord-position">@_currentRef</p>

                @if (_error is not null)
                {
                    <div class="toast" data-testid="toast">
                        <p class="toast-message">@_error</p>
                    </div>
                }
                else if (_loading)
                {
                    <p class="concord-loading">Loading&hellip;</p>
                }
                else
                {
                    @foreach (var row in RenderRows)
                    {
                        if (row is PartHeadingRow ph)
                        {
                            <h2 class="concord-part-heading" data-testid="@($"concord-part-heading-{ph.Part}")">@ph.Title</h2>
                        }
                        else if (row is ArticleHeadingRow ah)
                        {
                            <h3 class="concord-article-heading" data-testid="@($"concord-article-heading-{ah.Part}-{ah.Article}")">Article @ah.Article</h3>
                        }
                        else if (row is UnitRow ur)
                        {
                            var unit = ur.Unit;
                            if (ConcordToc.IsExplorablePart(PartOf(unit.Locus)) && unit.EdgeSummary.Count > 0)
                            {
                                <div class="concord-unit explorable" data-testid="@($"concord-unit-{Slug(unit.Ref)}")"
                                     tabindex="0" role="button"
                                     @onclick="@(() => OnExplore(unit))" @onkeydown="@(e => OnUnitKeyDown(e, unit))">
                                    <span class="concord-unit-ref">@unit.Ref</span>
                                    <ScriptureRefText Text="@unit.Text" Citations="@unit.Anchors" ClassPrefix="concord-ref"
                                                       OwnerSlug="@Slug(unit.Ref)" OnExplore="OnExploreNode" />
                                </div>
                            }
                            else
                            {
                                <div class="concord-unit" data-testid="@($"concord-unit-{Slug(unit.Ref)}")">
                                    <span class="concord-unit-ref">@unit.Ref</span>
                                    <ScriptureRefText Text="@unit.Text" Citations="@unit.Anchors" ClassPrefix="concord-ref"
                                                       OwnerSlug="@Slug(unit.Ref)" OnExplore="OnExploreNode" />
                                </div>
                            }
                        }
                    }

                    <nav class="concord-nav" aria-label="Concord navigation">
                        @if (_prevRef is not null)
                        {
                            <button type="button" class="concord-nav-button" data-testid="concord-prev" @onclick="GoBackward">&lsaquo; Previous</button>
                        }
                        @if (_nextRef is not null)
                        {
                            <button type="button" class="concord-nav-button" data-testid="concord-next" @onclick="GoForward">Next &rsaquo;</button>
                        }
                    </nav>
                }
            </article>
        </div>
    </div>
</CompositionSplit>

@if (_opening is not null)
{
    <ExplorerPopover @key="_opening" Opening="_opening" OnClose="ClosePopover" />
}

@code {
    private const int PageSize = 20;
    private const string DefaultRef = "BoC 1.1.1";

    private abstract record ConcordRenderRow;
    private sealed record PartHeadingRow(int Part, string Title) : ConcordRenderRow;
    private sealed record ArticleHeadingRow(int Part, int Article) : ConcordRenderRow;
    private sealed record UnitRow(TextUnit Unit) : ConcordRenderRow;

    [Parameter] public bool? SplitMode { get; set; }

    private string _currentRef = DefaultRef;
    private List<TextUnit> _units = new();
    private string? _nextRef;
    private string? _prevRef;
    private bool _loading = true;
    private string? _error;
    private readonly RequestSeries _windows = new();
    private PopoverOpening? _opening;

    // Navigation here never triggers a Blazor route change, so the router's
    // automatic scroll-to-top never fires; this flag drives a manual reset instead.
    private bool _scrollResetPending;

    private int? _jumpPart;
    private int? _jumpArticle;
    private int? _jumpParagraph;

    private static string Slug(string reference) => reference.Replace(' ', '-').Replace('.', '-');

    private int? CurrentPart => _units.Count > 0 ? PartOf(_units[0].Locus) : null;

    private List<ConcordRenderRow> RenderRows
    {
        get
        {
            var rows = new List<ConcordRenderRow>();
            int? lastPart = null;
            int? lastArticle = null;
            foreach (var unit in _units)
            {
                var locus = (ConcordRef)unit.Locus;
                if (locus.Part != lastPart)
                {
                    rows.Add(new PartHeadingRow(locus.Part, ConcordToc.TitleOf(locus.Part)));
                    lastPart = locus.Part;
                    lastArticle = null;
                }
                if (locus.Article != lastArticle)
                {
                    rows.Add(new ArticleHeadingRow(locus.Part, locus.Article));
                    lastArticle = locus.Article;
                }
                rows.Add(new UnitRow(unit));
            }
            return rows;
        }
    }

    private static int PartOf(TextRef locus) => ((ConcordRef)locus).Part;

    private Task JumpToPartAsync(int part)
    {
        _currentRef = ConcordToc.StartRef(part);
        return LoadWindowAsync(_currentRef, WindowDir.Onward);
    }

    private ContentsTreeModel? _contents;
    private readonly RequestSeries _startup = new();

    private async Task LoadContentsAsync()
    {
        (await _startup.Next().Fetch(() => Atlas.Contents(Corpus.Concord))).Match(
            arrived: contents =>
            {
                _contents = ContentsTreeModel.From(contents);
                SyncContentsToPosition();
            },
            failed: () => _contents = null,
            superseded: () => { });
    }

    private void SyncContentsToPosition()
    {
        if (_contents is not { } model)
        {
            return;
        }

        var doc = model.Roots.FirstOrDefault(r => PartOf(r.Locus) == CurrentPart);
        if (doc is not null)
        {
            model.Expand(doc.Id);
            model.ExpandPathTo(_currentRef);
            if (model.CurrentId is null || !doc.Children.Any(c => c.Id == model.CurrentId))
            {
                model.ExpandPathTo(doc.Ref);
            }
        }
    }

    private Task OnContentsNavigate(ContentsTreeModel.Node node)
    {
        if (node is ContentsTreeModel.Root { Kind: ContentsRootKind.Document })
        {
            return JumpToPartAsync(PartOf(node.Locus));
        }

        var citation = node.Ref.StartsWith("BoC ", StringComparison.Ordinal) ? node.Ref["BoC ".Length..] : node.Ref;
        Nav.NavigateTo($"/concord?ref={Uri.EscapeDataString(citation)}");
        return Task.CompletedTask;
    }

    // SupplyParameterFromQuery can land after the first render, so this is
    // applied in both OnInitializedAsync and OnParametersSetAsync;
    // _appliedRefQuery guards against re-applying the same value twice.
    [SupplyParameterFromQuery(Name = "ref")]
    public string? RefQuery { get; set; }

    private string? _appliedRefQuery;

    private static string CitationOfQuery(string r) => r.StartsWith("BoC ", StringComparison.Ordinal) ? r : $"BoC {r}";

    protected override async Task OnParametersSetAsync()
    {
        if (RefQuery is { Length: > 0 } r && r != _appliedRefQuery)
        {
            _appliedRefQuery = r;
            _currentRef = CitationOfQuery(r);
            await LoadWindowAsync(_currentRef, WindowDir.Onward);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (RefQuery is { Length: > 0 } r)
        {
            _appliedRefQuery = r;
            _currentRef = CitationOfQuery(r);
        }

        await LoadWindowAsync(_currentRef, WindowDir.Onward);
        await LoadContentsAsync();
    }

    private Task JumpToAsync()
    {
        var part = _jumpPart is > 0 ? _jumpPart.Value : 1;
        var article = _jumpArticle is > 0 ? _jumpArticle.Value : 1;
        var paragraph = _jumpParagraph is > 0 ? _jumpParagraph.Value : 1;
        _currentRef = $"BoC {part}.{article}.{paragraph}";
        return LoadWindowAsync(_currentRef, WindowDir.Onward);
    }

    private Task GoForward() => _nextRef is { } next ? LoadWindowAsync(next, WindowDir.Onward) : Task.CompletedTask;

    private Task GoBackward() => _prevRef is { } prev ? LoadWindowAsync(prev, WindowDir.Backward) : Task.CompletedTask;

    private async Task LoadWindowAsync(string fromRef, WindowDir dir)
    {
        var request = _windows.Next();
        _loading = true;
        _error = null;
        _opening = null;
        _scrollResetPending = true;
        StateHasChanged();

        try
        {
            if ((await request.Fetch(() => Graph.Reading(fromRef, PageSize, dir, corpus: Corpus.Concord))).Match<TextWindow?>(
                    arrived: window => window,
                    failed: () =>
                    {
                        _error = "Couldn't load this part of the Book of Concord — check your connection and try again.";
                        return null;
                    },
                    superseded: () => null) is not { } window)
            {
                return;
            }

            _units = window.Units.ToList();

            // dir=backward's window ends at fromRef inclusive, so fromRef
            // reappears as the last row here; trim the duplicate and point
            // Next back at fromRef so paging forward doesn't skip it.
            if (dir == WindowDir.Backward && _units.Count > 0 && _units[^1].Ref == fromRef)
            {
                _units.RemoveAt(_units.Count - 1);
                _nextRef = fromRef;
            }
            else
            {
                _nextRef = window.Next;
            }

            _currentRef = _units.Count > 0 ? _units[0].Ref : fromRef;
            // DefaultRef is the corpus's true first paragraph; there's nothing earlier to page back to.
            _prevRef = _units.Count > 0 && _units[0].Ref != DefaultRef ? _units[0].Ref : null;
        }
        finally
        {
            if (!request.Superseded)
            {
                _loading = false;
                StateHasChanged();
            }
        }

        SyncContentsToPosition();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_scrollResetPending || _loading)
        {
            return;
        }

        _scrollResetPending = false;
        try
        {
            var readerJs = await JS.InvokeAsync<IJSObjectReference>("import", "./js/reader.js");
            await readerJs.InvokeVoidAsync("scrollToTop", "concord-page");
        }
        catch (Exception)
        {
        }
    }

    private void OnExplore(TextUnit unit) => _opening = new PopoverOpening.Legacy(new ConcordUnitNode(unit.Ref, unit.Text));

    private void OnUnitKeyDown(KeyboardEventArgs e, TextUnit unit)
    {
        if (e.Key == "Enter")
        {
            OnExplore(unit);
        }
    }

    private void OnExploreNode(PopoverOpening opening) => _opening = opening;

    private void ClosePopover() => _opening = null;
}
