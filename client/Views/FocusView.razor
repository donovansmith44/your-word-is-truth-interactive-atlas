@inject IExplorer Explorer

@if (_presented is { } presented)
{
    @foreach (var (group, _) in Offered<Affordance.UpCrumb>())
    {
        @foreach (var link in presented.Pages[group.Kind].Items)
        {
            <button type="button" class="focus-up explorable" data-testid="@($"{Handle}-up-{group.Kind.WireName()}-{link.Target.Id}")"
                    @onclick="() => OnFollow.InvokeAsync(link)">@link.Target.Label</button>
        }
    }

    @if (presented.Presentation is Presentation.Card card)
    {
        <div class="popover-section" data-testid="@($"{Handle}-section-card")">
            <p class="focus-title" data-testid="@($"{Handle}-card-title")">@card.Title</p>
            <dl class="focus-fields">
                @foreach (var field in card.Fields)
                {
                    <div class="focus-field" data-testid="@($"{Handle}-field-{field.Name}")"><dt>@field.Name</dt><dd>@field.Value</dd></div>
                }
            </dl>
        </div>
    }

    @foreach (var (group, _) in Offered<Affordance.Arrows>())
    {
        @foreach (var link in presented.Pages[group.Kind].Items)
        {
            @if (group.Kind == EdgeKind.FollowsIn)
            {
                <button type="button" class="focus-arrow explorable" data-testid="@($"{Handle}-next")"
                        @onclick="() => OnFollow.InvokeAsync(link)">@link.Target.Label &rsaquo;</button>
            }
            else
            {
                <button type="button" class="focus-arrow explorable" data-testid="@($"{Handle}-prev")"
                        @onclick="() => OnFollow.InvokeAsync(link)">&lsaquo; @link.Target.Label</button>
            }
        }
    }

    @foreach (var (group, _) in Offered<Affordance.InlineChildren>())
    {
        <div class="popover-section" data-testid="@($"{Handle}-children-{group.Kind.WireName()}")">
            @foreach (var link in presented.Pages[group.Kind].Items)
            {
                <button type="button" class="focus-child explorable" data-testid="@($"{Handle}-child-{group.Kind.WireName()}-{link.Target.Id}")"
                        @onclick="() => OnFollow.InvokeAsync(link)">@link.Target.Label</button>
            }
        </div>
    }

    @foreach (var (group, list) in Offered<Affordance.SectionList>())
    {
        var section = $"{Handle}-section-{group.Kind.WireName()}";
        <div class="popover-section" data-testid="@section">
            <p class="catechism-section-heading" data-testid="@($"{section}-heading")">@group.Kind.WireName() (@group.Count)</p>
            @foreach (var link in presented.Pages[group.Kind].Items.Take(presented.Shown[group.Kind]))
            {
                <button type="button" class="focus-link @Register(list.Style)" data-testid="@($"{Handle}-link-{group.Kind.WireName()}-{link.Target.Id}")"
                        @onclick="() => OnFollow.InvokeAsync(link)">@link.Target.Label</button>
            }
            <RevealControls Total="group.Count" Default="list.InitialClamp" Step="list.InitialClamp" Shown="presented.Shown[group.Kind]"
                            ShownChanged="shown => Reveal(presented, group.Kind, shown)"
                            MoreTestId="@($"{section}-more")" CollapseTestId="@($"{section}-collapse")" />
        </div>
    }
}

@code {
    [Parameter, EditorRequired] public Explorable Node { get; set; } = default!;

    [Parameter, EditorRequired] public Surface Surface { get; set; }

    [Parameter, EditorRequired] public EventCallback<Link> OnFollow { get; set; }

    private readonly RequestSeries _series = new();
    private Explorable? _node;
    private Presented? _presented;

    private sealed record Presented(Presentation? Presentation, Dictionary<EdgeKind, Page<Link>> Pages, Dictionary<EdgeKind, int> Shown);

    protected override async Task OnParametersSetAsync()
    {
        if (_node == Node)
        {
            return;
        }

        _node = Node;
        _presented = null;
        var request = _series.Next();
        if (await request.Fetch(() => Explorer.Present(Node, Surface), () => Task.WhenAll(Node.Groups.Select(group => Node.Links(group.Kind)))) is not var (presentation, firstPages))
        {
            return;
        }

        var pages = await Task.WhenAll(Node.Groups.Zip(firstPages, (group, first) => Filled(request, group.Kind, first, InitiallyShown(group))));
        if (request.Superseded)
        {
            return;
        }

        _presented = new Presented(
            presentation,
            Node.Groups.Zip(pages).ToDictionary(pair => pair.First.Kind, pair => pair.Second),
            Node.Groups.ToDictionary(group => group.Kind, InitiallyShown));
    }

    private static int InitiallyShown(FrontierGroup group) =>
        Affordances.Of(group.Kind) is Affordance.SectionList list ? list.InitialClamp : group.Count;

    private async Task Reveal(Presented presented, EdgeKind kind, int shown)
    {
        presented.Shown[kind] = shown;
        presented.Pages[kind] = await Filled(_series.Current, kind, presented.Pages[kind], shown);
    }

    private async Task<Page<Link>> Filled(Request request, EdgeKind kind, Page<Link> loaded, int wanted)
    {
        while (loaded.Items.Count < wanted && loaded.Next is int cursor && await request.Fetch(() => Node.Links(kind, cursor)) is { } page)
        {
            loaded = new Page<Link>([.. loaded.Items, .. page.Items], page.Next);
        }

        return loaded;
    }

    private IEnumerable<(FrontierGroup Group, T Affordance)> Offered<T>() where T : Affordance
    {
        foreach (var group in Node.Groups)
        {
            if (Affordances.Of(group.Kind) is T affordance)
            {
                yield return (group, affordance);
            }
        }
    }

    private string Handle => Surface switch
    {
        Surface.World => "world",
        Surface.Reader => "reader",
        Surface.Popover => "popover",
    };

    private static string Register(SectionStyle style) => style switch
    {
        SectionStyle.Standard => "explorable",
        SectionStyle.Quiet => "explorable-quiet",
    };
}
