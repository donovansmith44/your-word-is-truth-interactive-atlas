@using BibleAtlas.Client.Exploring

@if (Refs.Count > 0)
{
    <div class="popover-refs-list" data-testid="@TestIdPrefix">
        @foreach (var d in Refs)
        {
            <button type="button" class="popover-refs-list-item explorable" data-testid="@($"{TestIdPrefix}-{d.TestIdSuffix ?? d.Ref}")"
                    @onclick="@(() => OnExplore.InvokeAsync(d.Target))">@d.Ref</button>
        }
    </div>
}

@code {
    // TestIdSuffix defaults to Ref; callers whose display text is a curated label rather than
    // the ref itself (and so could churn) pass a stable id instead.
    public sealed record RefDescriptor(string Ref, PopoverOpening Target, string? TestIdSuffix = null);

    [Parameter, EditorRequired] public IReadOnlyList<RefDescriptor> Refs { get; set; } = Array.Empty<RefDescriptor>();
    [Parameter, EditorRequired] public string TestIdPrefix { get; set; } = default!;
    [Parameter, EditorRequired] public EventCallback<PopoverOpening> OnExplore { get; set; }
}
