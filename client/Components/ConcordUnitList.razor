@using BibleAtlas.Client.Explore

@if (Items.Count > 0)
{
    <div class="popover-catechism-list">
        @foreach (var unit in Items)
        {
            var citation = CitationOf(unit);
            <button type="button" class="popover-catechism-item explorable" data-testid="@($"concord-link-{Slug(citation)}")"
                    @onclick="() => OnExplore.InvokeAsync(new ConcordUnitNode(citation))">
                @citation
            </button>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<NodeRefDto> Items { get; set; } = Array.Empty<NodeRefDto>();
    [Parameter, EditorRequired] public EventCallback<IExplorable> OnExplore { get; set; }

    private static string CitationOf(NodeRefDto unit) =>
        unit.Id.StartsWith("text-unit:", StringComparison.Ordinal) ? unit.Id["text-unit:".Length..] : unit.Label;

    private static string Slug(string citation) => citation.Replace(' ', '-').Replace('.', '-');
}
