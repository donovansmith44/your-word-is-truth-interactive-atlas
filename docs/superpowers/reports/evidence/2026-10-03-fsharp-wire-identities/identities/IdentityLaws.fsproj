<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><IsTestProject>true</IsTestProject><IsPackable>false</IsPackable><TreatWarningsAsErrors>true</TreatWarningsAsErrors></PropertyGroup>
  <ItemGroup>
    <Compile Include="obj/Wire.g.fs" />
    <Compile Include="../../../../../../client-fsharp.Tests/ContractIdentityLaws.fs" Link="ContractIdentityLaws.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../../../../client-fsharp.ContractGenerator/BibleAtlas.FSharp.ContractGenerator.fsproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../../../../../client.ContractGenerator/BibleAtlas.Client.ContractGenerator.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.SystemTextJson" Version="1.4.36" />
    <PackageReference Include="FSharp.Compiler.Service" Version="43.12.401" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="FsCheck.Xunit" Version="3.4.0" />
  </ItemGroup>
  <Target Name="GenerateWireIdentityProbe" BeforeTargets="CoreCompile" DependsOnTargets="ResolveProjectReferences">
    <Exec Command="dotnet &quot;$(MSBuildProjectDirectory)/../../../../../../client-fsharp.ContractGenerator/bin/$(Configuration)/net10.0/BibleAtlas.FSharp.ContractGenerator.dll&quot; &quot;$(MSBuildProjectDirectory)/../../../../../../contracts/openapi.yaml&quot; &quot;$(MSBuildProjectDirectory)/obj/Wire.g.fs&quot;" />
  </Target>
</Project>
