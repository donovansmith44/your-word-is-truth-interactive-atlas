@using BibleAtlas.Client.Explore

@foreach (var (piece, index) in Numbered(AnchoredText.Segments(Text, Citations)))
{
    @if (piece.Anchor is { } citation)
    {
        var verse = NodeIds.LocalPart(citation.Node);
        <span class="@ClassPrefix" data-testid="@($"{ClassPrefix}-{OwnerSlug}-{index}")"
              tabindex="0" role="button" aria-label="@($"Explore {piece.Text}")"
              @onclick="() => Open(verse)" @onclick:stopPropagation="true"
              @onkeydown="@(e => OnKeyDown(e, verse))" @onkeydown:stopPropagation="true">@piece.Text</span>
    }
    else
    {
        @piece.Text
    }
}

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyList<Anchor> Citations { get; set; } = default!;
    [Parameter, EditorRequired] public string ClassPrefix { get; set; } = default!;

    [Parameter, EditorRequired] public string OwnerSlug { get; set; } = default!;

    [Parameter, EditorRequired] public EventCallback<PopoverOpening> OnExplore { get; set; }

    private static IEnumerable<(TextPiece Piece, int Index)> Numbered(IReadOnlyList<TextPiece> pieces)
    {
        var cited = 0;
        return pieces.Select(piece => (piece, piece.Anchor is null ? 0 : cited++));
    }

    private Task Open(string verse) => OnExplore.InvokeAsync(new PopoverOpening.Legacy(new VerseNode(verse)));

    private Task OnKeyDown(KeyboardEventArgs e, string verse) => e.Key == "Enter" ? Open(verse) : Task.CompletedTask;
}
