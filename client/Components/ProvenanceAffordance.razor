@if (_ids.Count > 0)
{
    <span class="@RootClass" data-testid="@TestId">
        <button type="button"
                class="popover-provenance-button@(_open ? " is-open" : "")"
                data-testid="@ButtonTestId"
                aria-expanded="@(_open ? "true" : "false")"
                aria-controls="@_panelId"
                aria-label="@ButtonLabel"
                title="@ButtonLabel"
                @onclick="Toggle"
                @onclick:stopPropagation="true"
                @onkeydown="OnKeyDown"
                @onkeydown:stopPropagation="true">?</button>

        @if (_open)
        {
            <span class="popover-provenance-panel" id="@_panelId" role="note" data-testid="@PanelTestId">
                @foreach (var p in _resolved)
                {
                    @if (p.Status == Explore.ProvenanceStatus.RegistryUnavailable)
                    {
                        @* An infrastructure fault (the source list failed to load), not an
                           unrecognized id -- said as one, not the other. *@
                        <span class="popover-provenance-unavailable" data-testid="@UnavailableTestId">
                            The source list could not be loaded, so this cannot be named right now.
                            Its source id is &quot;@p.Id&quot;.
                        </span>
                    }
                    else if (p.Status == Explore.ProvenanceStatus.Unresolved)
                    {
                        <span class="popover-provenance-error" data-testid="@UnresolvedTestId">
                            @if (string.IsNullOrWhiteSpace(p.Id))
                            {
                                @:This item was served with no source at all. Please report it.
                            }
                            else
                            {
                                @:Unrecognized source "@p.Id". Please report it.
                            }
                        </span>
                    }
                    else
                    {
                        <span class="popover-provenance-entry" data-testid="@EntryTestId(p)">
                            <span class="popover-provenance-title">Sourced from @p.Title</span>
                            <span class="popover-provenance-what">@p.WhatItIs</span>
                            @if (ProvenanceResolver.ConfidenceNote(p.Confidence) is { } note)
                            {
                                <span class="popover-provenance-confidence" data-testid="@ConfidenceTestId(p)">@note</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(p.Locator))
                            {
                                <span class="popover-provenance-locator" data-testid="@LocatorTestId(p)">Locator: @p.Locator</span>
                            }
                            <span class="popover-provenance-license">License: @p.License</span>
                        </span>
                    }
                }
            </span>
        }
    </span>
}

@code {
    // An empty/null list renders nothing at all; a list containing a blank id is still one
    // entry (not filtered out), so a promised-but-missing attribution renders the loud notice
    // rather than silently vanishing.
    [Parameter, EditorRequired] public IReadOnlyList<string>? Provenance { get; set; }

    [Parameter, EditorRequired] public string TestId { get; set; } = default!;

    [Parameter, EditorRequired] public string ButtonLabel { get; set; } = default!;

    [Parameter] public string Register { get; set; } = HeaderRegister;

    // Passed in rather than injected so this component stays pure and synchronously
    // renderable off the caller's already-awaited fetch. Null means the registry hasn't
    // resolved yet or failed to load -- resolved as RegistryUnavailable, not "unrecognized".
    [Parameter] public SourcesDocumentOut? Sources { get; set; }

    public const string HeaderRegister = "header";
    public const string RowRegister = "row";

    private bool _open;
    private readonly string _panelId = "prov-" + Guid.NewGuid().ToString("N")[..8];
    private IReadOnlyList<string> _ids = Array.Empty<string>();
    private IReadOnlyList<ResolvedProvenance> _resolved = Array.Empty<ResolvedProvenance>();

    private string RootClass => Register == RowRegister
        ? "popover-provenance popover-provenance--row"
        : "popover-provenance";

    private string ButtonTestId => TestId + "-button";
    private string PanelTestId => TestId + "-panel";
    private string UnresolvedTestId => TestId + "-unresolved";
    private string UnavailableTestId => TestId + "-unavailable";
    private string EntryTestId(ResolvedProvenance p) => TestId + "-entry-" + p.Id;
    private string ConfidenceTestId(ResolvedProvenance p) => TestId + "-confidence-" + p.Id;
    private string LocatorTestId(ResolvedProvenance p) => TestId + "-locator-" + p.Id;

    protected override void OnParametersSet()
    {
        // A blank/whitespace id is normalized, not filtered out -- it still renders as one
        // loud entry rather than disappearing or being confused with a genuinely empty list.
        _ids = (Provenance ?? Array.Empty<string>()).Select(Explore.ProvenanceResolver.NormalizeId).Distinct().ToList();
        _resolved = ProvenanceResolver.ResolveAll(Sources, _ids);
    }

    private void Toggle() => _open = !_open;

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _open = false;
        }
    }
}
