@using BibleAtlas.Client.Contracts
@using BibleAtlas.Client.State
@using BibleAtlas.Client.Views
@implements IDisposable
@inject StateAtom<ViewArrangement> ViewArrangementAtom
@inject PaneScopes Panes
@inject ViewRegistry Registry
@inject IJSRuntime JS
@inject NavigationManager Nav

@if (!IsGuestMount && !LayoutKinds.IsKnown(Composition.Layout.Kind))
{
    <div class="toast" data-testid="composition-error">
        <p class="toast-message">Unrecognized arrangement layout "@Composition.Layout.Kind" -- ICompositionLayout.Kind is out of vocabulary.</p>
    </div>
}
else if (!IsSplitOpen)
{
    @ChildContent(BuildContext())
}
else if (IsHost)
{
    @* branching here changes render-tree shape, not just CSS classes -- any JS that captures a DOM node inside ChildContent must rebind on every render (idempotent, self-cleaning), never firstRender-only, or it will silently end up bound to an orphaned node the instant this branch flips *@
    <div class="split-view" style="--split-reader-width:@(_widthPx.ToString(System.Globalization.CultureInfo.InvariantCulture))px;--app-header-height:@(_headerHeightPx.ToString(System.Globalization.CultureInfo.InvariantCulture))px;" data-testid="split-view">
        @ChildContent(BuildContext())
        <SplitDivider WidthPx="_widthPx" WidthPxChanged="w => _widthPx = w" OnCommitted="OnDividerCommitted" />
        <div class="split-pane-guest">
            <CascadingValue Value="@PaneId.Guest" IsFixed="true">
                @Registry.Get(Composition.Members[1].Name).Mount(new ViewMountContext(
                    SplitMode: true,
                    OnRequestClose: EventCallback.Factory.Create(this, RequestCloseAsync),
                    RegisterQueryHandler: h => _guestQueryHandler = h))
            </CascadingValue>
        </div>
    </div>
}
else
{
    @ChildContent(BuildContext())
}

@code {
    [Parameter, EditorRequired]
    public string HostName { get; set; } = null!;

    [Parameter]
    public bool? SplitModeOverride { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment<CompositionSplitContext> ChildContent { get; set; } = null!;

    [Parameter]
    public EventCallback<double> OnFractionCommitted { get; set; }

    [Parameter]
    public string? HostPaneClass { get; set; }

    [Parameter]
    public Action? OnArrangementChanged { get; set; }

    [SupplyParameterFromQuery(Name = SplitUrlContract.SplitParam)]
    [Parameter]
    public string? SplitQuery { get; set; }

    [SupplyParameterFromQuery(Name = SplitUrlContract.GuestParam)]
    public string? GuestQuery { get; set; }

    [SupplyParameterFromQuery(Name = SplitUrlContract.FollowParam)]
    [Parameter]
    public string? FollowQuery { get; set; }

    private bool _splitQueryConsumed;

    private double _widthPx = 704;
    private bool _dividerRestoreAttempted;
    private readonly AsyncMemo<IJSObjectReference> _js = new();
    private Func<string, Task>? _guestQueryHandler;

    private double _headerHeightPx = 56;

    private bool IsGuestMount => SplitModeOverride == true;

    private ViewArrangement? _lastArrangement;
    private IViewComposition? _lastComposition;

    private IViewComposition Composition
    {
        get
        {
            // the atom swaps in a new instance on every real change, never mutating one in place -- reference equality is exact here, not an approximation
            if (!ReferenceEquals(_lastArrangement, ViewArrangementAtom.Value))
            {
                _lastArrangement = ViewArrangementAtom.Value;
                _lastComposition = Registry.ComposeFrom(_lastArrangement);
            }

            return _lastComposition!;
        }
    }

    public bool IsSplitOpen => IsGuestMount || Composition.IsHostedBy(HostName);

    public bool IsHost => !IsGuestMount;

    protected override void OnInitialized()
    {
        ViewArrangementAtom.Changed += HandleArrangementChanged;
    }

    private void HandleArrangementChanged()
    {
        ReconcilePane();
        SyncSplitUrl();
        StateHasChanged();
        OnArrangementChanged?.Invoke();
    }

    private IDisposable? _paneLink;
    private StateAtom<Locus>? _watchedGuestLocus;

    private bool IsSameViewHost => !IsGuestMount && Composition.IsHostedBy(HostName) && PaneScopes.IsSameViewSplit(ViewArrangementAtom.Value);

    private void ReconcilePane()
    {
        if (IsGuestMount)
        {
            return;
        }

        var sameView = IsSameViewHost;
        var wantLink = sameView && ViewArrangementAtom.Value.Follow;
        if (!wantLink && _paneLink is not null)
        {
            _paneLink.Dispose();
            _paneLink = null;
        }

        if (wantLink && _paneLink is null)
        {
            var caps = Registry.CapabilitiesOf(HostName);
            _paneLink = Panes.Link(PaneId.Host, PaneId.Guest, PaneScopes.LinkableVia(HostName, HostName, caps, caps));
        }

        if (sameView && (Registry.CapabilitiesOf(HostName) & ViewCapabilities.BearsLocus) != 0)
        {
            var guestLocus = Panes.For(PaneId.Guest).Locus;
            if (!ReferenceEquals(_watchedGuestLocus, guestLocus))
            {
                UnwatchGuestLocus();
                _watchedGuestLocus = guestLocus;
                guestLocus.Changed += SyncSplitUrl;
            }
        }
        else
        {
            UnwatchGuestLocus();
        }

        if (!IsSplitOpen)
        {
            Panes.ResetGuest();
        }
    }

    private void UnwatchGuestLocus()
    {
        if (_watchedGuestLocus is not null)
        {
            _watchedGuestLocus.Changed -= SyncSplitUrl;
            _watchedGuestLocus = null;
        }
    }

    private void SeedGuestFromQuery()
    {
        if (GuestQuery is not { } q || !IsSameViewHost)
        {
            return;
        }

        var dot = q.LastIndexOf('.');
        if (dot > 0 && int.TryParse(q[(dot + 1)..], out var chapter) && chapter > 0)
        {
            Panes.For(PaneId.Guest).Locus.Dispatch(new SetLocus(q[..dot], chapter));
        }
    }

    protected override void OnParametersSet()
    {
        if (IsGuestMount || _splitQueryConsumed)
        {
            return;
        }

        _splitQueryConsumed = true;

        if (SplitQuery is { } guestName && Registry.TryGet(guestName, out _))
        {
            ViewArrangementAtom.Dispatch(new EnterSplit(HostName, guestName, FollowQuery == SplitUrlContract.FollowTrueValue, DefaultDividerFraction: null));
            ReconcilePane();
            SeedGuestFromQuery();
        }
        else
        {
            ViewArrangementAtom.Dispatch(new EnterSingle(HostName));
        }
    }

    private void SyncSplitUrl()
    {
        if (IsGuestMount)
        {
            return;
        }

        var guestName = IsSplitOpen ? Composition.Members[1].Name : null;
        var follow = IsSplitOpen && ViewArrangementAtom.Value.Follow;
        var guestRef = IsSameViewHost && !follow && (Registry.CapabilitiesOf(HostName) & ViewCapabilities.BearsLocus) != 0
            ? Panes.For(PaneId.Guest).Locus.Value.Ref
            : null;
        var uri = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            [SplitUrlContract.SplitParam] = guestName,
            [SplitUrlContract.FollowParam] = follow ? SplitUrlContract.FollowTrueValue : null,
            [SplitUrlContract.GuestParam] = guestRef,
        });

        // Nav.NavigateTo must never be called from a component lifecycle's synchronous prefix (before the first await) -- doing so can re-enter Blazor's navigation pipeline and throw inside its own location-changed handling. This no-op check keeps every reachable call site here safe.
        if (uri == Nav.Uri)
        {
            return;
        }

        Nav.NavigateTo(uri, replace: true);
    }

    public void Dispose()
    {
        ViewArrangementAtom.Changed -= HandleArrangementChanged;
        _paneLink?.Dispose();
        _paneLink = null;
        UnwatchGuestLocus();
    }

    public Func<string, Task> NavigateGuestInSplit => query => _guestQueryHandler?.Invoke(query) ?? Task.CompletedTask;

    private CompositionSplitContext BuildContext() => new(
        IsSplitOpen,
        IsHost,
        EventCallback.Factory.Create(this, InvokeHatchAsync),
        EventCallback.Factory.Create(this, RequestCloseAsync),
        IsSplitOpen && IsHost && !string.IsNullOrEmpty(HostPaneClass) ? $" {HostPaneClass}" : "",
        EventCallback.Factory.Create<string>(this, InvokeHatchWithAsync),
        EnterSplitHatchOf(HostName)?.PartnerViews,
        EnterSplitHatchOf(HostName) is { } hatch ? hatch.GuestLabel : null,
        IsSplitOpen && PaneScopes.IsSameViewSplit(ViewArrangementAtom.Value),
        IsSplitOpen && ViewArrangementAtom.Value.Follow,
        EventCallback.Factory.Create(this, ToggleFollowAsync));

    private Task ToggleFollowAsync()
    {
        ViewArrangementAtom.Dispatch(new ToggleFollow(!ViewArrangementAtom.Value.Follow));
        return Task.CompletedTask;
    }

    private EnterSplitHatch? EnterSplitHatchOf(string view) =>
        Registry.Get(view).EscapeHatches.OfType<EnterSplitHatch>().FirstOrDefault();

    private Task InvokeHatchAsync() =>
        Registry.Get(HostName).EscapeHatches.First(h => h.Kind == HatchKinds.EnterSplit).Invoke();

    private Task InvokeHatchWithAsync(string guest) =>
        EnterSplitHatchOf(HostName)?.InvokeWith(guest) ?? Task.CompletedTask;

    private Task RequestCloseAsync()
    {
        ViewArrangementAtom.Dispatch(new CloseGuest());
        return Task.CompletedTask;
    }

    private async Task OnDividerCommitted((double WidthPx, double? Fraction) result)
    {
        _widthPx = result.WidthPx;
        if (result.Fraction is { } fraction)
        {
            ViewArrangementAtom.Dispatch(new SetDivider(fraction));
            if (OnFractionCommitted.HasDelegate)
            {
                await OnFractionCommitted.InvokeAsync(fraction);
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsSplitOpen && IsHost && !_dividerRestoreAttempted)
        {
            _dividerRestoreAttempted = true;
            var fraction = ViewArrangementAtom.Value.DividerFraction ?? ViewArrangement.InitialDividerFraction;
            try
            {
                var js = await _js.Get(() => JS.InvokeAsync<IJSObjectReference>("import", "./js/reader.js").AsTask());

                var headerHeight = await js.InvokeAsync<double>("getElementHeight", ".app-header");
                if (headerHeight > 0)
                {
                    _headerHeightPx = headerHeight;
                }

                var rect = await js.InvokeAsync<PaneRect?>("getPaneRect", ".split-view");
                if (rect is { Width: > 0 } r)
                {
                    var minWidthPx = 200.0;
                    // the ceiling floors at the same 200 the lower bound uses, so a sub-400px container can never invert min/max into a Math.Clamp throw
                    var maxWidthPx = Math.Max(minWidthPx, r.Width - 200);
                    _widthPx = Math.Clamp(fraction * r.Width, minWidthPx, maxWidthPx);
                    StateHasChanged();
                }
            }
            catch (Exception)
            {
            }
        }
        else if (!IsSplitOpen)
        {
            _dividerRestoreAttempted = false;
        }
    }
}
