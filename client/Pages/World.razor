@page "/world"
@using System.Globalization
@implements IAsyncDisposable
@implements IMapEvents
@inject AtlasClient Atlas
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ViewStateService ViewState

<PageTitle>Bible Explorer &mdash; World</PageTitle>

<div class="world-page @(SplitMode ? "split-pane-atlas" : null)" data-testid="@(SplitMode ? "split-pane-atlas" : null)">
    <div id="world-map" class="world-map" data-testid="world-map" @ref="_mapEl"></div>

    @* Batch H: the split affordances -- mutually exclusive by construction
       (SplitMode is only ever true for the pane a HOST already embedded, so
       "open" and "close/follow" never both apply to the same instance).
       !SplitMode (standalone /world, unchanged today) gets the "Read beside
       the map" affordance; SplitMode (embedded guest) gets the follow chip
       and its own close button instead -- see their own comments below. *@
    @if (!SplitMode)
    {
        <button type="button" class="split-open split-open-dusk" data-testid="split-open-world" @onclick="OpenReadBesideMap">
            Read beside the map
        </button>
    }
    else
    {
        @* A shared positioning wrapper -- not just the two buttons placed
           independently -- because their combined width depends on
           FollowRef's own text ("Following GEN.12" vs "Following EXO.3"),
           which a fixed pixel offset for the second button can't account
           for; the flex wrapper lays them out naturally instead. *@
        <div class="split-atlas-controls" data-testid="split-atlas-controls">
            <button type="button" class="follow-chip" data-testid="follow-chip"
                    aria-pressed="@(_follow ? "true" : "false")" @onclick="ToggleFollow">
                @(_follow && FollowRef is not null ? $"Following {FollowRef}" : "Follow the text")
            </button>
            <button type="button" class="split-close split-close-dusk" data-testid="split-close-atlas"
                    aria-label="Close the map, keep reading" @onclick="() => OnRequestClose.InvokeAsync()">
                &times;
            </button>
        </div>
    }

    <ScripturePicker OnApply="ApplyScriptureRef" ThemeClass="picker-dusk" />

    @if (_scene is not null && _scene.Places.Count == 0)
    {
        <p class="world-empty">No recorded events in this window &mdash; drag the timeline or choose a scripture.</p>
    }

    @{ var hoverPlace = _hoverPlace; }
    @if (hoverPlace is not null)
    {
        <PlaceCard Place="hoverPlace" X="_hoverX" Y="_hoverY"
                   WindowFrom="@(_scriptureRef is null ? _from : (int?)null)"
                   WindowTo="@(_scriptureRef is null ? _to : (int?)null)"
                   OnPointerEnter="CardPointerEnter" OnPointerLeave="CardPointerLeave"
                   OnOpenPlace="OpenPlaceFromCard" OnExploreNode="OpenExploreNode"
                   Pinned="@(_pinnedPlaceId is not null)" Narratives="_scene?.Narratives"
                   OnGoToPlace="GoToAdjacent" OnClosePin="ClosePinnedCard" />
    }

    @if (_hoverArrowText is not null)
    {
        <div class="arrow-tip" data-testid="arrow-tip"
             style="left: @_arrowX.ToString(CultureInfo.InvariantCulture)px; top: @_arrowY.ToString(CultureInfo.InvariantCulture)px;">
            @_hoverArrowText
        </div>
    }

    @if (_eras is not null)
    {
        <TimeSlider Eras="_eras" From="_from" To="_to"
                    Disabled="@(_scriptureRef is not null)" OnWindowChange="HandleWindowChange" OnWindowDrag="HandleWindowDrag" />
    }

    @* Batch H: suppressed while following -- the follow-chip above is
       already the ONE control for "you're locked to the reader's chapter,
       click to stop" in that state; showing mode-chip's OWN "Return to
       time" alongside it would be a second, redundant way to do the exact
       same thing. Not suppressed when SplitMode but NOT following (a
       manually-applied ref while free-browsing the pane) -- there the two
       chips say genuinely different things (which ref you're viewing vs.
       whether you're following) and both stay useful. *@
    @if (_scriptureRef is not null && !(SplitMode && _follow))
    {
        <div class="mode-chip" data-testid="mode-chip">
            <span class="mode-chip-label">Scripture</span>
            <span class="mode-chip-ref">@_scriptureRef</span>
            <button type="button" class="mode-chip-return" data-testid="mode-chip-return" @onclick="ReturnToTime">
                Return to time
            </button>
        </div>
    }

    @if (_scene is not null && _scene.Narratives.Count > 0)
    {
        <Legend Narratives="_scene.Narratives" IsolatedId="@_isolated" OnIsolate="HandleIsolate" />
    }

    @if (_errorMessage is not null)
    {
        <div class="toast" data-testid="toast">
            <p class="toast-message">@_errorMessage</p>
        </div>
    }
</div>

@* Rendered as a SIBLING of .world-page, not nested inside it -- same
   placement Reader.razor already uses for its own ExplorerPopover (see that
   file's own header comment on why: keydown/keyup bubbling to one shared
   handler pair, and a position:fixed backdrop/panel that must reach the
   full viewport). Historically ALSO load-bearing for a second reason now
   retired: a mini-map (Task 15's <MiniWorld>, reachable via WORLD-8's
   place-history flow into a VerseNode's own map chip) was meant to stay a
   "daylight" figure regardless of which page opened it -- nesting the
   popover inside .world-page would have made its embedded Leaflet tile pane
   a DOM descendant of ".world-page .leaflet-tile-pane", picking up the dusk
   page's own sepia warmth filter by CSS accident. O1 (2026-08-23) retired
   that mini-map entirely (MiniWorld.razor gone with it -- see
   ExplorerPopover.razor's own header comment), so this placement is kept
   for the FIRST reason alone now, not reverted -- it is correct on its own
   terms regardless. *@
@if (_activeNode is not null)
{
    <ExplorerPopover @key="_activeNode" Root="_activeNode" OnClose="ClosePopover"
                      InSplit="SplitMode" OnNavigateWorldInSplit="ApplyExternalQuery" PaneAnchor="@(SplitMode ? "atlas" : null)" />
}

@code {
    // No window specified at all (bare "/world"): Batch C / CONTRACT
    // amendment (design-direction.md + user feedback 2026-08-19) -- default
    // to a Gospel-era window, replacing the old full-span default. The full
    // 10-era timeline lights up to 167 places at once (see
    // tests/ux/playwright.config.ts's own WORLD-1 timing comment) -- an
    // overwhelming first screen, and exactly what the zoom-tiered label
    // density (map.js) exists to soften but shouldn't have to paper over on
    // the very first paint. Gospels is a small, richly-narrated, broadly-
    // recognizable window -- a focused start rather than an arbitrary
    // slice. Deep links with an explicit ?from=&to=/?ref= are completely
    // untouched by this (SyncFromQuery only ever reads these two constants
    // when BOTH FromQuery and ToQuery are absent), so this is purely a
    // "what a bare /world shows" change.
    //
    // FIX ROUND 1 CORRECTION (review finding I-1): DefaultTo was 29,
    // originally chosen to match data/curated/eras.toml's own "gospels"
    // era EXACTLY ([-5, 29]) -- calibrated to the OLD, mixed Theographic/
    // AD-33 dating scale. Now that HOTFIX-4's own nt_calibration reconciles
    // every surviving Theographic-scale NT event onto the single AD-33
    // Passion anchor, the Gospel narrative's own real end (the Ascension,
    // pw_mount_of_olives) is year 33, not 29 -- a default window ending at
    // 29 silently excluded the entire Passion Week/Resurrection/Ascension
    // from the very first screen a visitor sees, which is also why Sidon
    // (anchored, post-calibration, only by rob_syrophoenician_woman at year
    // 32 -- inside [-5, 29] only by coincidence before this fix, and by
    // design now) went dark under a merge that moved its own anchor's year.
    // Extended to 33 -- the real, calibrated Gospel-era end -- not
    // re-coupled to eras.toml's own "gospels" preset (unconsumed by any
    // client UI today, verified; decoupling here avoids widening this
    // fix's own blast radius into a file/concept this fix round did not
    // audit for other consumers).
    private const int DefaultFrom = -5;
    private const int DefaultTo = 33;

    [SupplyParameterFromQuery(Name = "from")]
    [Parameter]
    public string? FromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "to")]
    [Parameter]
    public string? ToQuery { get; set; }

    // Scripture mode (Task 13, WORLD-6/NAV-1). Non-null exactly when a
    // scripture ref -- not a time window -- is driving the scene; every
    // other piece of mode state (TimeSlider's Disabled, mode-chip's render,
    // which fetch SyncFromQuery kicks below) branches on this one field.
    [SupplyParameterFromQuery(Name = "ref")]
    [Parameter]
    public string? RefQuery { get; set; }

    // Batch H (split-view study): true exactly when this instance is the
    // embedded ATLAS PANE of a split (always hosted by Reader.razor, per
    // this batch's own design -- see the report's layout section for why
    // Reader is always the split's host/orchestrator, never World). Gates
    // every split-specific behavior below: the follow chip/close button
    // (markup), which half of OnParametersSetAsync runs (query-string
    // SyncFromQuery vs. FollowRef-reactive SyncFollowRef), and the
    // ApplyScriptureRef/HandleWindowChange/ReturnToTime SplitMode branches
    // (the pane's host URL never carries ref=/from=/to= at all). Standalone
    // /world never sets this -- every behavior it gates is unreachable
    // there, so standalone behavior is untouched byte-for-byte.
    [Parameter] public bool SplitMode { get; set; }

    // Batch H: the split HOST's own current chapter ref ("GEN.12"), fed down
    // fresh every time Reader.razor's own _book/_chapterNum change (a normal
    // parameter re-render -- Reader stays the SAME component instance across
    // chapter-to-chapter navigation, so this arrives as an ordinary changed
    // parameter, not a fresh component). Applied via the EXACT SAME
    // DebouncedLoadScriptureScene /world?ref= already uses (SyncFollowRef
    // below) -- ONLY while following (_follow); a null value (should never
    // happen in practice -- Reader always has a current chapter once loaded,
    // but SplitMode is set before that first load resolves) simply means
    // "nothing to follow yet."
    [Parameter] public string? FollowRef { get; set; }

    // Batch H: the atlas pane's own close button (data-testid
    // split-close-atlas) invokes this -- Reader.razor wires it to set its
    // own _splitOpen = false, returning to "full reader" per the brief.
    // World itself has no notion of what closing even means beyond "tell
    // whoever embedded me."
    [Parameter] public EventCallback OnRequestClose { get; set; }

    private List<EraDto>? _eras;
    private Scene? _scene;
    private string? _errorMessage;
    private string? _scriptureRef;

    // Atlas plate detail (design-direction.md, ADDED PER USER FEEDBACK
    // 2026-08-18; data model replaced by Batch B2's own per-polity
    // timerange borders): the last successfully-fetched polity list and
    // the curated landmark list (fetched once in OnInitializedAsync,
    // pushed to the map once it exists). Both stay null until their first
    // successful fetch and are never reset to null afterward -- a later
    // failed refetch just leaves the prior (still-honest, if slightly
    // stale) value in place, same "last good state stays" philosophy the
    // toast already uses for _scene.
    private PolitiesOut? _polities;
    private List<LandmarkDto>? _landmarks;

    // Guards PushLandmarksIfReady below against double-pushing -- unlike
    // _scene/_polities (each refetched on every window change, with their
    // own natural "only apply if this fetch is still current" logic),
    // landmarks are fetched exactly ONCE, so the race between "the fetch
    // resolves" and "the map gets created" needs an explicit once-only
    // flag instead of reusing that machinery.
    private bool _landmarksPushed;

    // Batch R requirement 1 ("borders become part of the plate"): the
    // curated land mask, fetched once (like _landmarks above) and pushed to
    // the map exactly once -- same "whichever of the fetch or the map's own
    // creation resolves second" race/guard as _landmarksPushed.
    private LandMaskOut? _landMask;
    private bool _landMaskPushed;

    // Batch M requirement 3a: the FULL, unfiltered polity roster (every era
    // of every polity -- the whole atlas span necessarily intersects every
    // one of them) the morph engine's own client-side `lookup` needs to
    // answer an arbitrary drag-time window with zero network latency. Same
    // "fetch once, push once, whichever of the fetch/map-creation race
    // resolves second" shape as _landMask/_landMaskPushed immediately
    // above -- deliberately a SEPARATE fetch from the per-window
    // Atlas.Polities(from, to) call LoadPolitiesFor already makes (that one
    // drives the SETTLED display only; this one is static for the life of
    // the page, like the land mask).
    private PolitiesOut? _polityRoster;
    private bool _polityRosterPushed;

    // The most recently APPLIED time-mode window -- i.e. the last from/to
    // SyncFromQuery validated, which is exactly "the window to return to"
    // (WORLD-6's mode-chip-return). Only the time-mode branch below ever
    // assigns these, so arriving directly on a scripture deep link (never
    // having had a time-mode URL this session) correctly leaves them at the
    // whole-span default, per the brief.
    private int _from = DefaultFrom;
    private int _to = DefaultTo;
    private CancellationTokenSource? _fetchCts;

    private ElementReference _mapEl;
    private MapInterop? _mapInterop;

    // Fit-camera policy (fix round 1: replaces a plain "has any scene ever
    // been fit" bool, which caused a real bug -- see the finding this
    // fixes). null = nothing fit yet; "time"/"scripture" = the mode of the
    // MOST RECENT fit. A load re-fits the camera when its own mode differs
    // from _lastFitMode (covers both "first scene of the page's life" --
    // null never equals either mode -- and "the mode just changed", which
    // is exactly what mode-chip-return needs: after any scripture visit,
    // returning to time mode must re-fit even though a time-mode scene had
    // already been fit once before, earlier in the session) OR when the
    // load itself is scripture mode (DebouncedLoadScriptureScene always
    // fits, unconditionally, on every load -- see its own comment; it also
    // stamps this field so a LATER return to time mode is correctly
    // detected as a mode change). Ordinary same-mode time-window changes
    // (slider drag, era click, readout Enter) still never re-fit -- Task
    // 10's original policy, preserved for that one case.
    private string? _lastFitMode;

    // Hover-card state. IMapEvents.OnPlaceHover/OnPlaceLeave below are
    // invoked from map.js (via MapEventsSink), not through Blazor's own
    // event dispatch, so each one calls StateHasChanged() itself.
    private ScenePlace? _hoverPlace;
    private double _hoverX;
    private double _hoverY;
    private CancellationTokenSource? _closeCts;

    // Batch G1 requirement 3 (click-to-pin): non-null exactly when a marker
    // (lit or quiet) has been clicked and its card should stay open
    // regardless of hover state, closing only via Escape, the card's own
    // close button, or a click elsewhere on the map. _hoverPlace/_hoverX/
    // _hoverY are STILL what the card actually renders from (unchanged
    // rendering path) -- this field is purely the "is the currently-shown
    // card pinned, and to what" flag every close/hover path below checks.
    // OnPlaceHover/OnPlaceClick/GoToAdjacent are the only writers; CloseCardNow
    // is the ONE place that clears it, so a fully-closed card can never
    // leave this field pointing at nothing shown (see its own comment).
    private string? _pinnedPlaceId;

    // Requirement 0c (user 2026-08-19: "hover interactions on both the map
    // and the Bible are extremely fickle. FIX IT."): the real, root-caused
    // bug behind that report -- reproduced properly here, in source, not
    // the demo-only hotpatch's document-query workaround. The pointer's
    // physical journey off a marker and onto the card it's already
    // pointing at is TWO separate DOM events on TWO separate elements
    // (Leaflet's marker `mouseout`, dispatched to .NET via an async JS
    // interop call -- MapInterop/map.js's wireEvents -- and PlaceCard's own
    // `@onpointerenter`, dispatched through Blazor's own, also-async event
    // pipeline) with NO ordering guarantee between them. The marker's own
    // leave can resolve in C# AFTER the card's enter already ran: if
    // OnPlaceLeave always scheduled a close regardless, that LATE-arriving
    // schedule has nothing left to cancel it (the card's own enter, which
    // would have cancelled it, already fired in the past), and the card
    // closes out from under a pointer that is legitimately still sitting on
    // it. `_pointerOverCard` closes that race: it's the one piece of state
    // both sides can check that doesn't depend on event ORDER, only on
    // where the pointer physically is RIGHT NOW -- see OnPlaceLeave and
    // CardPointerEnter/CardPointerLeave below for the two halves of the fix.
    private bool _pointerOverCard;

    // arrow-tip state (WORLD-4/contract "arrow-tip"). Text is precomputed
    // (rather than a place/arrow reference resolved in markup) so a stale
    // key that no longer resolves against the current scene just clears the
    // tip instead of throwing mid-render.
    private string? _hoverArrowText;
    private double _arrowX;
    private double _arrowY;

    // Legend isolate (WORLD-4). Legend.razor is a controlled component --
    // this is the single source of truth it renders aria-pressed from, and
    // the value HandleIsolate below forwards to MapInterop.SetIsolate.
    // Reset to null whenever a new scene loads (DebouncedLoadScene) so the
    // legend never shows a narrative "pressed" after a window change wipes
    // out whatever isolate the user had set on the PREVIOUS scene. The
    // arrows' own data-faded attributes are reset back to "false" the same
    // way, independently -- ArrowLayer.setArrows (map.js) does that
    // unconditionally for every existing path, including ones that survive
    // the change under the same narrative:order key, so the two stay in
    // sync without this field needing to call MapInterop.SetIsolate(null)
    // itself on every load.
    private string? _isolated;

    // WORLD-8/Task 15: PlaceCard's title promotes the hover card's content
    // into a real ExplorerPopover -- same @key-per-instance pattern
    // Reader.razor already uses so a different node always remounts a
    // fresh popover (breadcrumb stack included) rather than diffing into
    // an existing one. Batch D removed PlaceCard's OTHER, older route into
    // a popover (the verse-group index rows) along with the rows
    // themselves -- see PlaceCard.razor's own file header.
    private IExplorable? _activeNode;

    // Batch H (split-view study, follow mode). _follow defaults true (the
    // brief's "follow mode default ON") and is only ever MEANINGFUL while
    // SplitMode -- standalone /world never reads or writes it. Restored from
    // ViewState.Map.Follow on a SplitMode instance's own first
    // OnParametersSetAsync pass (_splitInitialized guards that pass running
    // more than once); captured back into ViewState.Map.Follow on dispose,
    // but ONLY for a SplitMode instance (see DisposeAsync's own comment for
    // why a standalone visit must never overwrite it).
    private bool _follow = true;
    private bool _splitInitialized;
    private string? _lastFollowRef;

    // Batch H (view-state round-trip): non-null exactly when a saved camera
    // (center/zoom) is waiting to be applied once the map instance exists --
    // set by RestoreMapState, consumed by PushPendingCameraIfReady. Mirrors
    // _landmarks/_landmarksPushed's own "whichever resolves second" pattern
    // for the identical underlying race: OnAfterRenderAsync's own
    // MapInterop.Create call is asynchronous, so a restore decided in
    // OnInitializedAsync/OnParametersSetAsync can easily land before the map
    // itself exists yet.
    private (double Lat, double Lon, double Zoom)? _pendingCamera;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _eras = await Atlas.Eras();
        }
        catch (Exception)
        {
            // No eras means no usable slider; surface it the same way as any
            // other fetch failure rather than crashing the page.
            _errorMessage = "Couldn't load the timeline eras -- check your connection and try again.";
        }

        try
        {
            _landmarks = await Atlas.Landmarks();
        }
        catch (Exception)
        {
            // Landmarks are map decoration, not load-bearing -- same silent,
            // non-fatal treatment as borders (design-direction.md's Atlas
            // plate detail): the map still works fine with no labels.
        }

        try
        {
            _landMask = await Atlas.LandMask();
        }
        catch (Exception)
        {
            // Batch R requirement 1: a failed land-mask fetch degrades to NO
            // clip at all (BorderLayer.setLandMask is simply never called --
            // see PushLandMaskIfReady below) -- washes fall back to their
            // pre-Batch-R, unclipped rendering rather than the page breaking.
        }

        try
        {
            // Batch M requirement 3a: the full atlas span -- every era of
            // every polity necessarily intersects [-4004,100] (the same
            // span PlaceNode's own "Show on /world" chip already uses,
            // Explore/PlaceNode.cs), so this single call returns the
            // COMPLETE roster the morph engine needs, via the exact same
            // endpoint/DTO LoadPolitiesFor's own per-window fetch already
            // uses.
            _polityRoster = await Atlas.Polities(-4004, 100);
        }
        catch (Exception)
        {
            // Not load-bearing for the settled display (LoadPolitiesFor's
            // own per-window fetch is independent) -- a failed roster fetch
            // just means the morph engine has nothing to scrub with; a drag
            // simply shows no live morph until the NEXT settle, same
            // graceful-degrade spirit as a failed land-mask fetch above.
        }

        // If OnInitializedAsync's own await above didn't complete
        // synchronously (the normal case -- it's a real network fetch),
        // Blazor already rendered once with _mapInterop still unset, so
        // OnAfterRenderAsync(firstRender: true) can fire and find
        // _mapInterop non-null BEFORE this line ever runs (confirmed: this
        // is exactly the race a naive "OnInitializedAsync always finishes
        // before the first render" assumption misses -- Blazor's own
        // contract is the opposite: an incomplete OnInitializedAsync task
        // gets an interim render, not a delayed one). Covers that case;
        // OnAfterRenderAsync's own call covers the reverse ordering.
        await PushLandmarksIfReady();
        await PushLandMaskIfReady();
        await PushPolityRosterIfReady();
    }

    // Batch R requirement 1: pushes the curated land mask to the map exactly
    // once -- same "whichever of the fetch or the map's own creation
    // resolves second" race/guard as PushLandmarksIfReady just below.
    private async Task PushLandMaskIfReady()
    {
        if (_landMaskPushed || _landMask is null || _mapInterop is null)
        {
            return;
        }

        _landMaskPushed = true;
        await _mapInterop.SetLandMask(_landMask.Rings);
    }

    // Batch M requirement 3a: pushes the full polity roster to the map
    // exactly once -- same race/guard shape as PushLandMaskIfReady above.
    private async Task PushPolityRosterIfReady()
    {
        if (_polityRosterPushed || _polityRoster is null || _mapInterop is null)
        {
            return;
        }

        _polityRosterPushed = true;
        await _mapInterop.SetPolitiesRoster(_polityRoster.Polities);
    }

    // Pushes the curated landmark list to the map exactly once, whichever
    // of OnInitializedAsync's fetch or OnAfterRenderAsync's map-creation
    // happens to resolve second (see _landmarksPushed's own comment).
    private async Task PushLandmarksIfReady()
    {
        if (_landmarksPushed || _landmarks is null || _mapInterop is null)
        {
            return;
        }

        _landmarksPushed = true;
        await _mapInterop.SetLandmarks(_landmarks);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_eras is null)
        {
            return;
        }

        // Batch H: SplitMode branches to a COMPLETELY separate path --
        // SyncFollowRef below, never SyncFromQuery -- since this instance's
        // host URL (/read/{Book}/{Chapter}) never carries ref=/from=/to= at
        // all; reading them here would just see three permanently-absent
        // query keys and fall into SyncFromQuery's own "bare /world"
        // branch, silently ignoring FollowRef entirely. Standalone
        // (!SplitMode) behavior below this check is completely untouched.
        if (SplitMode)
        {
            await SyncFollowRef();
            return;
        }

        await SyncFromQuery();
    }

    // Batch H: the SplitMode counterpart to SyncFromQuery -- reacts to
    // FollowRef parameter changes (the split host's own current chapter,
    // see FollowRef's own doc comment) instead of the URL's query string.
    // The FIRST call (per instance) also restores follow/window state from
    // the shared ViewState -- _splitInitialized guards that one-time part
    // only; FollowRef-change reactivity below it runs on every call.
    private async Task SyncFollowRef()
    {
        if (!_splitInitialized)
        {
            _splitInitialized = true;
            _follow = ViewState.Map.Follow;
            _lastFollowRef = FollowRef;

            if (_follow && FollowRef is not null)
            {
                await EnterScriptureMode(FollowRef);
            }
            else if (ViewState.Map.HasData)
            {
                await RestoreMapState();
            }
            else
            {
                await EnterTimeMode(_from, _to);
            }

            return;
        }

        if (FollowRef == _lastFollowRef)
        {
            return;
        }

        _lastFollowRef = FollowRef;
        if (_follow && FollowRef is not null)
        {
            await EnterScriptureMode(FollowRef);
        }
    }

    // Batch H fix round 2 (review Critical-1, take 2): pushes THIS instance's
    // current window/ref/follow into the shared ViewState the MOMENT they
    // change, rather than only at dispose time. Fix round 2's first attempt
    // reordered DisposeAsync so these same five fields were written into
    // ViewState BEFORE the method's own first await (the camera's, since
    // removed -- see DisposeAsync's own comment) -- sound C# async
    // reasoning (a synchronous prefix of an async method runs inline, in
    // the caller's own call stack), but EMPIRICALLY still lost the exact
    // same race live (a regression test written against that fix stayed
    // red): Blazor's renderer does not guarantee an outgoing component's
    // DisposeAsync is even CALLED before an incoming component's own
    // OnParametersSetAsync reads shared state, on a navigation that
    // disposes one component and mounts another in the same step --
    // ordering between the two is simply undocumented/unguaranteed, so no
    // fix confined to DisposeAsync (sync or not) can close it. Removing the
    // dispose-time write from the critical path entirely -- syncing
    // continuously instead -- is what actually works, because it no longer
    // matters when, or even whether, DisposeAsync gets called relative to
    // the new instance's mount. Exactly the same fix shape already proven
    // for OnCameraChanged (map.js's moveend/zoomend) and reader.js's own
    // watchScroll/OnScroll.
    private void SyncViewState()
    {
        ViewState.Map.HasData = true;
        ViewState.Map.From = _from;
        ViewState.Map.To = _to;
        ViewState.Map.ScriptureRef = _scriptureRef;
        if (SplitMode)
        {
            // Follow is a split-only concept -- a standalone /world visit
            // has no toggle chip to ever change it FROM, so only a
            // SplitMode instance writes this half of the state, keeping
            // whatever the user last explicitly set even across an
            // intervening standalone visit (see MapViewState.Follow's own
            // doc comment).
            ViewState.Map.Follow = _follow;
        }
    }

    // Batch H: the shared "enter scripture mode" sequence every direct
    // (non-URL) scene-loading call site below needs -- SyncFromQuery's own
    // ref-branch already inlines these exact three steps (stamp
    // _scriptureRef, hide the polity layer, THEN fetch -- fix round 1,
    // finding 5's own ordering, preserved here); this is the same sequence,
    // factored out so every SplitMode call site (which never goes through
    // SyncFromQuery at all -- see FollowRef's own doc comment) gets it too,
    // rather than each one re-deriving/risking missing a step.
    // SyncFromQuery's own two call sites are intentionally left as they
    // are (not refactored onto this) -- battle-tested, unrelated to this
    // batch's own risk surface -- but each now makes its own SyncViewState
    // call directly (fix round 2), so every path that sets _scriptureRef/
    // _from/_to stays covered either way.
    private async Task EnterScriptureMode(string sref)
    {
        _scriptureRef = sref;
        SyncViewState();
        if (_mapInterop is not null)
        {
            await _mapInterop.SetPolitiesVisible(false);
        }

        await DebouncedLoadScriptureScene(sref);
    }

    // Batch H: the time-mode counterpart to EnterScriptureMode above.
    // Unlike scripture mode, no extra polities call is needed here --
    // DebouncedLoadScene's own LoadPolitiesFor already unconditionally
    // restores SetPolitiesVisible(true) before its fetch even starts (see
    // that method's own doc comment), so a bare _scriptureRef=null plus the
    // ordinary time-mode load is the complete, correct sequence.
    private Task EnterTimeMode(int from, int to)
    {
        _scriptureRef = null;
        _from = from;
        _to = to;
        SyncViewState();
        return DebouncedLoadScene(from, to);
    }

    // Batch H (view-state round-trip): restores whatever the LAST live
    // World instance -- standalone OR the split pane, ONE shared map state,
    // per the brief -- left behind, in place of a fresh default. A saved
    // scripture ref restores into scripture mode via the SAME
    // DebouncedLoadScriptureScene every /world?ref= visit already uses,
    // which always fits/recenters on its own (a scripture jump is a
    // deliberate destination, not a snapshot to recreate pixel-for-pixel --
    // its own camera is deliberately NOT restored, matching a fresh
    // /world?ref= deep link's own behavior). A saved time window restores
    // via DebouncedLoadScene with _lastFitMode pre-stamped "time" so its
    // usual auto-fit is suppressed -- see that field's own comment for why
    // "the load's own mode already equals _lastFitMode" is what skips it --
    // then the saved camera (center/zoom) is queued via _pendingCamera
    // instead, applied once the map instance actually exists.
    private async Task RestoreMapState()
    {
        if (ViewState.Map.ScriptureRef is { } sref)
        {
            await EnterScriptureMode(sref);
            return;
        }

        _lastFitMode = "time"; // suppress the load's own usual auto-fit -- see this field's own comment
        await EnterTimeMode(ViewState.Map.From, ViewState.Map.To);

        if (ViewState.Map.CenterLat is double lat && ViewState.Map.CenterLon is double lon && ViewState.Map.Zoom is double zoom)
        {
            _pendingCamera = (lat, lon, zoom);
            await PushPendingCameraIfReady();
        }
    }

    // Consumes _pendingCamera the moment the map instance actually exists --
    // see that field's own comment for the exact race this covers (the same
    // "whichever resolves second" shape PushLandmarksIfReady already uses).
    private async Task PushPendingCameraIfReady()
    {
        if (_pendingCamera is not { } cam || _mapInterop is null)
        {
            return;
        }

        _pendingCamera = null;
        await _mapInterop.SetCamera(cam.Lat, cam.Lon, cam.Zoom);
    }

    // follow-chip (Batch H). Toggling OFF frees the pane to full time-mode
    // -- reloads the last-applied time window (_from/_to) exactly like
    // ReturnToTime's own effect, via DebouncedLoadScene directly (SplitMode
    // has no URL to round-trip through, see ReturnToTime's own SplitMode
    // branch). Toggling back ON re-syncs to FollowRef, the SAME mechanism a
    // chapter change already uses (SyncFollowRef) -- both directions reuse
    // the one system-wide scene-loading primitive, never a parallel path.
    private async Task ToggleFollow()
    {
        _follow = !_follow;
        // fix round 2: syncs the flipped Follow value even in the
        // (practically unreachable -- Reader.razor always supplies a real
        // FollowRef in SplitMode -- but defensively worth covering) edge
        // case where toggling ON finds FollowRef null and neither branch
        // below would otherwise call a SyncViewState-carrying helper at all.
        SyncViewState();
        if (_follow)
        {
            if (FollowRef is not null)
            {
                await EnterScriptureMode(FollowRef);
            }
        }
        else
        {
            await EnterTimeMode(_from, _to);
        }
    }

    // Batch H ("no nested-popup rule" + the SplitMode ApplyScriptureRef/
    // HandleWindowChange/ReturnToTime branches): applies a NavigateWorld-
    // shaped query string ("ref=X" or "from=X&to=Y", the EXACT shape
    // ExplorationTarget.NavigateWorld.Query already carries, values already
    // escaped) directly to THIS pane's own state, bypassing the URL
    // entirely -- the mechanism a SplitMode instance needs for every manual
    // "look at something specific" action, since its own OnParametersSetAsync
    // never reads the URL's query string at all (see SyncFollowRef's own
    // comment: there is no ref=/from=/to= on /read's route to read).
    // Reused identically by ExplorerPopover's own OnNavigateWorldInSplit
    // callback (a popover chip clicked from EITHER pane while a split is
    // showing) and by this component's own picker/slider/mode-chip-return
    // handlers once SplitMode -- one method, every manual-override path.
    // Turns follow OFF first: an explicit "go look at this" action always
    // supersedes following (mirrors ToggleFollow's own "toggling off frees
    // the pane" semantics) -- there is nothing left to stay synced to once
    // the pane shows something the reader didn't ask for; a later chapter
    // change leaves it off until the user turns following back on
    // themselves, per the brief's own explicit-toggle precedence.
    public async Task ApplyExternalQuery(string query)
    {
        _follow = false;
        StateHasChanged(); // snappy chip feedback -- see this method's own doc comment; the load below still runs its own debounce/fetch on top of this

        var parts = query.Split('&')
            .Select(p => p.Split('=', 2))
            .Where(kv => kv.Length == 2)
            .ToDictionary(kv => kv[0], kv => Uri.UnescapeDataString(kv[1]));

        if (parts.TryGetValue("ref", out var sref))
        {
            await EnterScriptureMode(sref);
            return;
        }

        if (parts.TryGetValue("from", out var fromText) && parts.TryGetValue("to", out var toText)
            && int.TryParse(fromText, out var from) && int.TryParse(toText, out var to))
        {
            await EnterTimeMode(from, to);
        }
    }

    // "Read beside the map" (Batch H, standalone /world only -- SplitMode
    // never renders this button). Lands directly in split, per the brief
    // ("both land in the same split layout"): ?split=1 tells Reader.razor to
    // set its own _splitOpen = true on arrival (see its own SplitQuery
    // param). The reader's own last-known position (ViewState.Reader) picks
    // which chapter to open beside -- GEN 1 if this session never visited
    // the reader at all yet (ReaderViewState's own field defaults).
    private void OpenReadBesideMap()
    {
        Nav.NavigateTo($"/read/{ViewState.Reader.Book}/{ViewState.Reader.Chapter}?split=1");
    }

    // The Leaflet map can only be created once #world-map is actually in
    // the DOM, i.e. after the component's first render. If a scene fetch
    // already resolved by then (DebouncedLoadScene below skips pushing it
    // because _mapInterop was still null at the time), push it now instead
    // -- whichever of the two finishes second is the one that actually
    // calls SetScene/FitScene, so a scene is never dropped and never
    // applied twice.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _mapInterop = await MapInterop.Create(JS, _mapEl, mini: false, this);
        if (_scene is not null)
        {
            await _mapInterop.SetScene(_scene);
            // _scriptureRef is already set (SyncFromQuery sets it synchronously,
            // before either fetch method's first await) by the time a scene can
            // possibly be non-null here, so it accurately names which mode
            // produced _scene.
            var thisMode = _scriptureRef is not null ? "scripture" : "time";
            // Batch H fix (self-review, a real bug the view-state round-trip
            // test itself caught): this branch used to fit UNCONDITIONALLY,
            // regardless of _lastFitMode -- correct under the ORIGINAL
            // assumption that a scene already loaded by first-render could
            // only mean "the very first scene of the page's life" (nothing
            // else ever set _scene before this ran). RestoreMapState breaks
            // that assumption: it pre-stamps _lastFitMode to the mode it's
            // ABOUT to load, specifically so DebouncedLoadScene's OWN
            // fit-check skips its auto-fit and a restored camera (applied
            // via _pendingCamera below) isn't immediately overwritten by
            // one -- but this race can land the OTHER way too (the scene
            // finishes loading, via that same debounced fetch, before this
            // method's own await MapInterop.Create resolves), reaching this
            // branch instead with _lastFitMode already correctly set and
            // the fit already correctly skipped once. Fitting AGAIN here,
            // unconditionally, undid that -- confirmed live: a restored
            // time-mode camera came back at a different zoom than what was
            // saved. Same "skip when this mode already fit" check
            // DebouncedLoadScene's own branch uses.
            if (_lastFitMode != thisMode)
            {
                await _mapInterop.FitScene();
            }

            _lastFitMode = thisMode;
        }

        // Same "already resolved before the map existed" race as _scene
        // above, for polities: only push them if we're not (by now) in
        // scripture mode -- a deep link straight into scripture mode must
        // never show a polity-border layer it never asked for, matching
        // DebouncedLoadScriptureScene's own SetPolitiesVisible(false).
        if (_polities is not null && _scriptureRef is null)
        {
            await _mapInterop.SetPolitiesVisible(true);
            await _mapInterop.SetPolities(_polities.Polities, _from, _to);
        }

        // Landmarks: same "whichever resolves second" race as _scene/
        // _polities above, just fetched once in OnInitializedAsync instead
        // of on every window change -- see PushLandmarksIfReady/
        // _landmarksPushed's own comments for why a naive "OnInitializedAsync
        // always finishes before the first render" assumption is wrong.
        await PushLandmarksIfReady();
        // Batch R requirement 1: same "whichever resolves second" race, for
        // the land mask.
        await PushLandMaskIfReady();
        // Batch M requirement 3a: same race, for the morph engine's own roster.
        await PushPolityRosterIfReady();

        // Batch H: same race, for a restored camera (view-state round-trip)
        // -- see _pendingCamera's own comment.
        await PushPendingCameraIfReady();
    }

    // Single path for every window/ref change, whether it comes from the
    // user (slider drag / era click / readout Enter / picker apply / mode-
    // chip-return, via HandleWindowChange/ApplyScriptureRef/ReturnToTime
    // below) or directly from a URL (deep link, browser reload,
    // back/forward): all of them change the query string, which re-supplies
    // FromQuery/ToQuery/RefQuery and re-runs this method through
    // OnParametersSetAsync. RefQuery wins whenever present -- applying the
    // picker/deep-linking into scripture mode REPLACES from/to in the URL
    // (never both at once, see ApplyScriptureRef/ReturnToTime), so checking
    // it first is enough to fully separate the two branches below.
    private async Task SyncFromQuery()
    {
        if (!string.IsNullOrEmpty(RefQuery))
        {
            _scriptureRef = RefQuery;
            SyncViewState(); // fix round 2 -- see SyncViewState's own comment

            // Fix round 1 (finding 5): hide the polity-border LAYER the
            // moment scripture mode is entered -- unconditionally, right
            // where _scriptureRef itself is set, before the scene fetch
            // below even starts. Previously this only happened in
            // DebouncedLoadScriptureScene's SUCCESS branch, so a failed
            // scripture fetch left the vector layer painting with no time
            // window to justify it.
            if (_mapInterop is not null)
            {
                await _mapInterop.SetPolitiesVisible(false);
            }

            await DebouncedLoadScriptureScene(RefQuery);
            return;
        }

        _scriptureRef = null;

        if (FromQuery is null && ToQuery is null)
        {
            if (_scene is null)
            {
                // Batch H (view-state round-trip): a bare /world visit
                // restores wherever the LAST live World instance (this
                // session) left the atlas, rather than always defaulting to
                // the Gospels era -- "full-page /world and the split pane
                // share ONE map state" (the brief). A deep link WITH an
                // explicit from=/to=/ref= (below/above) is completely
                // unaffected -- this only ever applies to the truly bare
                // "/world" case, unchanged from before this batch otherwise.
                if (ViewState.Map.HasData)
                {
                    await RestoreMapState();
                }
                else
                {
                    SyncViewState(); // fix round 2 -- see SyncViewState's own comment
                    await DebouncedLoadScene(_from, _to);
                }
            }

            return;
        }

        if (!int.TryParse(FromQuery, out var from) || !int.TryParse(ToQuery, out var to))
        {
            _errorMessage = "That link's time window isn't valid. Showing the last window -- try the slider.";
            return;
        }

        if (from == 0 || to == 0)
        {
            _errorMessage = "Year 0 doesn't exist on this timeline (1 BC is followed by AD 1). Showing the last window -- try the slider.";
            return;
        }

        if (from > to)
        {
            _errorMessage = "That time window is backwards -- the start year is after the end year. Showing the last window -- try the slider.";
            return;
        }

        _from = from;
        _to = to;
        SyncViewState(); // fix round 2 -- see SyncViewState's own comment
        await DebouncedLoadScene(from, to);
    }

    // Batch M requirement 3a: true for exactly the duration of an in-
    // progress drag-morph gesture -- set by HandleWindowDrag's own first
    // call since the last settle, cleared by HandleWindowChange below
    // (release, or -- harmlessly, since it's simply already false there --
    // an era click/readout Enter that never had a morph running at all).
    private bool _dragMorphing;

    // Batch M requirement 3a: fired on EVERY pointermove while a slider
    // handle is down (TimeSlider.razor's own OnWindowDrag) -- drives the
    // morph engine's own rAF-throttled evaluator (map.js's BorderLayer,
    // requestMorphFrame/_evaluateMorphFrame -- see that file's own comment
    // for the full CPU evaluator interface / GPU swap seam). Never touches
    // the URL or _from/_to (those stay "the last COMMITTED window," per
    // their own field comment, until release) -- this is a purely visual,
    // transient scrub.
    //
    // Fix round 1 (Critical C1): `window` IS the full, current live window
    // already -- TimeSlider.razor's own OnHandlePointerDown seeds BOTH
    // `_dragFrom`/`_dragTo` from the last committed From/To at drag start,
    // and only the actively-dragged one ever moves on subsequent
    // pointermoves (OnTrackPointerMove) -- so `window.From`/`window.To`
    // here are exactly the pair to hand the morph engine every frame, the
    // same pair HandleWindowChange below already correctly passes to
    // SettleMorph on release. The pre-fix-round code instead derived an
    // "anchor" from `_from`/`_to` -- the SAME handle's own PRE-DRAG value,
    // not the OTHER handle's current one -- so the per-frame lookup window
    // silently excluded anything beyond the still-committed edge for the
    // whole gesture (six of twelve real polities in the review's own
    // live-verified replay; see the batch report's own "Fix round 1"
    // section). `probeYear` (still needed, separately from the full pair)
    // is specifically whichever edge is actually moving -- the one
    // `animate` sweeps against.
    private async Task HandleWindowDrag((int From, int To) window)
    {
        if (_mapInterop is null || _polityRoster is null)
        {
            return; // morph engine has nothing to scrub with yet -- degrades to no live morph, same graceful-degrade spirit as a failed roster fetch
        }

        int probeYear;
        if (window.From != _from)
        {
            probeYear = window.From;
        }
        else if (window.To != _to)
        {
            probeYear = window.To;
        }
        else
        {
            return; // no-op drag tick (e.g. the very first pointerdown before any real movement) -- nothing changed
        }

        if (!_dragMorphing)
        {
            _dragMorphing = true;
            await _mapInterop.BeginMorph();
        }
        await _mapInterop.MorphFrame(window.From, window.To, probeYear);
    }

    // Batch H: SplitMode has no ref=/from=/to= on its own host URL at all
    // (/read's route never carries them -- see SyncFollowRef's own comment)
    // -- so a SplitMode instance applies a window/ref change DIRECTLY via
    // ApplyExternalQuery instead of a Nav.NavigateTo that nothing would ever
    // read back. Standalone (!SplitMode) behavior is completely unchanged.
    private async Task HandleWindowChange((int From, int To) window)
    {
        // Batch M requirement 3a: "on release, settle into the static
        // layered-era presentation" -- settles INSTANTLY, locally, before
        // this method's own navigation/URL-driven reload even starts (see
        // MapInterop.SettleMorph's own comment for why the two can never
        // disagree). A no-op whenever this window change ISN'T the tail end
        // of a drag (era click, readout Enter) -- _dragMorphing is simply
        // already false there.
        if (_dragMorphing)
        {
            _dragMorphing = false;
            if (_mapInterop is not null)
            {
                await _mapInterop.SettleMorph(window.From, window.To);
            }
        }

        if (SplitMode)
        {
            await ApplyExternalQuery($"from={window.From}&to={window.To}");
            return;
        }

        var uri = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["from"] = window.From,
            ["to"] = window.To,
        });
        Nav.NavigateTo(uri, replace: true);
    }

    // ScripturePicker.OnApply (Task 13/WORLD-6). The picker itself is
    // world-agnostic (see its own file header) -- this is the one place
    // that decides applying it means entering /world's scripture mode.
    // `ref` REPLACES from/to in the URL (both explicitly nulled out, not
    // just left stale/ignored) so the two modes are never simultaneously
    // present in the query string -- SyncFromQuery's own RefQuery-first
    // check depends on that invariant. Batch H: SplitMode branch, same
    // reasoning as HandleWindowChange above.
    private Task ApplyScriptureRef(string sref)
    {
        if (SplitMode)
        {
            return ApplyExternalQuery($"ref={Uri.EscapeDataString(sref)}");
        }

        var uri = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["ref"] = sref,
            ["from"] = null,
            ["to"] = null,
        });
        Nav.NavigateTo(uri, replace: true);
        return Task.CompletedTask;
    }

    // mode-chip-return (WORLD-6). _from/_to are already exactly "the last
    // applied time-mode window" (see their own field comment) -- restoring
    // it is just navigating back to it, symmetric with ApplyScriptureRef
    // above (ref explicitly nulled out this time). Batch H: SplitMode
    // branch, same reasoning as HandleWindowChange above -- reachable there
    // only while SplitMode && !_follow (the mode-chip itself is suppressed
    // while following, see its own markup comment).
    private Task ReturnToTime()
    {
        if (SplitMode)
        {
            return ApplyExternalQuery($"from={_from}&to={_to}");
        }

        var uri = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["from"] = _from,
            ["to"] = _to,
            ["ref"] = null,
        });
        Nav.NavigateTo(uri, replace: true);
        return Task.CompletedTask;
    }

    // WORLD-4: Legend.razor already decided the new value (null = clear,
    // otherwise the narrative to isolate) -- this just stores it (so Legend
    // re-renders aria-pressed correctly, per the IsolatedId parameter below)
    // and forwards it to the map. No explicit StateHasChanged() needed here
    // (unlike OnPlaceHover/OnArrowHover/etc. below, which DO need it): this
    // handler is invoked through Blazor's own EventCallback machinery
    // (Legend's button click -> Legend.Toggle -> OnIsolate.InvokeAsync,
    // still routed through IHandleEvent even though the InvokeAsync call
    // itself is nested inside Legend's handler rather than a raw DOM
    // dispatch), which re-renders the receiving component -- World -- on
    // its own; OnPlaceHover/OnArrowHover are invoked from map.js via plain
    // JS interop, entirely outside that pipeline, which is why those need
    // the explicit call instead. Confirmed by removing it and polling
    // aria-pressed with a throwaway Playwright script: it still updated
    // correctly (~8ms after the click).
    private async Task HandleIsolate(string? narrativeId)
    {
        _isolated = narrativeId;
        if (_mapInterop is not null)
        {
            await _mapInterop.SetIsolate(narrativeId);
        }
    }

    // Debounced (60ms), latest-wins: a burst of window changes (fast
    // dragging, rapid era clicks) cancels any fetch still in its debounce
    // wait, and a fetch that was already in flight when superseded has its
    // result discarded on return rather than clobbering newer state -- there
    // is no way to cancel the HTTP call itself (AtlasClient.SceneTime takes
    // no CancellationToken), only to ignore a stale response.
    //
    // Batch PERF-2a: was 150ms. Server-side re-measurement (127.0.0.1,
    // bypassing this machine's own slow "localhost" hostname resolution --
    // see batch-perf2a-report.md) found compose_time_scene + JSON + loopback
    // transfer already at ~4-8ms for real windows (up to the 456KB full-span
    // payload), not the ~220ms the controller's own probe had attributed to
    // it -- that reading was the SAME hostname-resolution artifact, not
    // server cost (a live release-mode server has always measured ~5ms avg/
    // ~8ms worst case over loopback -- see this repo's own playwright.config.ts
    // comment, unchanged by this batch). With the fetch itself effectively
    // free, 150ms of the felt lag was pure debounce wait for no benefit;
    // 60ms -- the low end of the brief's 50-75ms range -- still comfortably
    // coalesces a fast drag's own per-frame window changes (each still lands
    // well under 60ms apart) into one fetch, same coalescing behavior as
    // before, just a shorter wait before it fires.
    private async Task DebouncedLoadScene(int from, int to)
    {
        await JS.InvokeVoidAsync("performance.mark", "atlas:scene-start");
        _fetchCts?.Cancel();
        var cts = new CancellationTokenSource();
        _fetchCts = cts;

        try
        {
            await Task.Delay(60, cts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        try
        {
            var scene = await Atlas.SceneTime(from, to);
            if (cts.IsCancellationRequested)
            {
                return;
            }

            _scene = scene;
            _errorMessage = null;
            _isolated = null;

            if (_mapInterop is not null)
            {
                await _mapInterop.SetScene(scene);
                // Batch PERF-2a: additive-only browser perf mark -- the "scene
                // rendered" end of the end-to-end slider-adjustment timing
                // measured against "atlas:scene-start" above (see
                // batch-perf2a-report.md). Placed here (not after the
                // FitScene branch below) because an ordinary same-mode window
                // change -- the only case a real slider tick ever hits --
                // never runs FitScene at all (see that branch's own doc
                // comment), so this is already the last map-affecting step of
                // a normal adjustment. Never read by any CONTRACT test; pure
                // Performance-API bookkeeping, invisible to the DOM.
                await JS.InvokeVoidAsync("performance.mark", "atlas:scene-rendered");

                // Fix round 1: re-fit whenever the LAST fit was a different
                // mode -- covers both "first scene ever" (_lastFitMode is
                // still null) and "just returned from scripture mode"
                // (_lastFitMode is "scripture"). An ordinary same-mode
                // window change (slider drag, era click, readout Enter)
                // leaves _lastFitMode == "time" already, so this correctly
                // stays a no-op there, preserving Task 10's original
                // "don't yank the camera on every slider tick" policy.
                if (_lastFitMode != "time")
                {
                    await _mapInterop.FitScene();
                    _lastFitMode = "time";
                }
            }
        }
        catch (Exception)
        {
            if (!cts.IsCancellationRequested)
            {
                // Keep the last good _scene as-is -- never blank the page.
                _errorMessage = $"Couldn't load {YearText.FormatRange(from, to)} -- check your connection and try again.";
            }
        }
        finally
        {
            StateHasChanged();
        }

        // Polities share this same debounce/cancellation (`cts`) but are a
        // fully independent try/catch from the scene fetch above -- a
        // polities failure must never surface as the scene's own error
        // toast (design-direction.md's Atlas plate detail: "failures
        // NON-fatal -- no toast, just skip borders, log-free"). Skipped
        // entirely (not just skipped-on-map-push) when this call was
        // already superseded, same as the scene fetch would have been.
        if (!cts.IsCancellationRequested)
        {
            await LoadPolitiesFor(from, to, cts);
        }
    }

    // Fetches the polity-border list for [from,to] and pushes it to the
    // map. Unconditionally restores the layer's visibility FIRST, before
    // the fetch even starts: entering/being in time mode should always
    // show *some* polity layer (the last successfully fetched list, stale
    // or not) rather than staying hidden from a previous scripture-mode
    // visit just because this particular refresh failed. Silent on failure
    // per the batch brief -- no toast, no logging, just keep showing
    // whatever was already there.
    private async Task LoadPolitiesFor(int from, int to, CancellationTokenSource cts)
    {
        // Fix round 1 (finding 3, carried from the retired border-tag
        // model): this restore used to run AFTER the fetch resolved,
        // inside the try's success branch only -- so a transient fetch
        // failure right after returning from scripture mode left the layer
        // hidden with nothing left to un-hide it until the NEXT successful
        // fetch. Unconditional, before the fetch even starts, matching
        // MapInterop.SetPolitiesVisible's own doc comment.
        if (_mapInterop is not null)
        {
            await _mapInterop.SetPolitiesVisible(true);
        }

        try
        {
            var polities = await Atlas.Polities(from, to);
            if (cts.IsCancellationRequested)
            {
                return;
            }

            _polities = polities;

            if (_mapInterop is not null)
            {
                await _mapInterop.SetPolities(polities.Polities, from, to);
            }
        }
        catch (Exception)
        {
            // Silent per design-direction.md's Atlas plate detail -- skip
            // this update, keep showing whatever polities (if any) are
            // already on the map. Visibility was already restored above,
            // independent of this failure.
        }
        finally
        {
            StateHasChanged();
        }
    }

    // Same debounce/latest-wins/toast machinery as DebouncedLoadScene above,
    // sharing the SAME _fetchCts field -- entering scripture mode cancels
    // whatever time-mode fetch was still in flight (its debounce delay or
    // its own await Atlas.SceneTime), and vice versa, so a slower fetch from
    // the mode the user just left can never resolve later and clobber the
    // scene the user actually switched to. Unlike DebouncedLoadScene, FitScene
    // runs on EVERY successful load here, not just the first ever -- a
    // scripture pick is a deliberate jump to a specific (often distant)
    // place, the same spirit as a fresh deep link, not a continuous slider
    // tick that should leave the user's current pan/zoom alone.
    private async Task DebouncedLoadScriptureScene(string sref)
    {
        _fetchCts?.Cancel();
        var cts = new CancellationTokenSource();
        _fetchCts = cts;

        try
        {
            await Task.Delay(150, cts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        try
        {
            var scene = await Atlas.SceneScripture(sref);
            if (cts.IsCancellationRequested)
            {
                return;
            }

            _scene = scene;
            _errorMessage = null;
            _isolated = null;

            if (_mapInterop is not null)
            {
                await _mapInterop.SetScene(scene);
                await _mapInterop.FitScene();

                // Atlas plate detail: "Scripture mode: hide the border
                // layer AND the tag (no time context)" -- the tag hides
                // itself via the @if in the markup (keyed off _scriptureRef,
                // already non-null by now); the layer's hide now happens in
                // SyncFromQuery, unconditionally, the moment _scriptureRef
                // is set (fix round 1, finding 5 -- see that comment), so it
                // still happens even when this fetch fails. DebouncedLoadScene's
                // LoadBordersFor restores the layer on a later return to time mode.

                // Stamp the mode even though this branch always fits
                // regardless of the PRIOR value -- a later time-mode load
                // needs to see "scripture" here to know IT must re-fit too
                // (see DebouncedLoadScene's own _lastFitMode check).
                _lastFitMode = "scripture";
            }
        }
        catch (Exception)
        {
            if (!cts.IsCancellationRequested)
            {
                // Keep the last good _scene as-is -- never blank the page.
                _errorMessage = $"Couldn't load {sref} -- check your connection and try again.";
            }
        }
        finally
        {
            StateHasChanged();
        }
    }

    // IMapEvents -- called from map.js via MapEventsSink, so these run
    // outside Blazor's own UI-event dispatch and must trigger their own
    // re-render.
    public void OnPlaceHover(string id, double x, double y)
    {
        // Batch G1 requirement 3: "hover behavior unchanged for UNPINNED
        // browsing" -- once a card is pinned it OWNS the display slot
        // exclusively; an ordinary hover on some OTHER marker while pinned
        // does nothing (no preview swap) until the pin itself changes
        // (clicking a different marker re-pins to it, per OnPlaceClick
        // below) or is explicitly closed. Simpler and more predictable than
        // a transient hover-preview-over-a-pin, and keeps this method's own
        // pre-existing hover-persistence logic completely untouched for the
        // unpinned case this guard doesn't touch.
        if (_pinnedPlaceId is not null)
        {
            return;
        }

        _closeCts?.Cancel();
        var place = _scene?.Places.FirstOrDefault(p => p.Id == id) ?? QuietAsScenePlace(id);
        if (place is null)
        {
            return;
        }

        _hoverPlace = place;
        _hoverX = x;
        _hoverY = y;
        StateHasChanged();
    }

    // Batch E2: a quiet dot (map.js's own quiet-marker-{id}) reports through
    // the SAME OnPlaceHover interop call a lit marker's own marker-{id} does
    // (map.js's wireEvents is shared between the two icon kinds -- see its
    // own comment) -- this is the one place that decides what "the SAME
    // place card" (batch-e2-brief.md Requirement 3) means for an id that
    // isn't in _scene.Places: a synthetic ScenePlace built from the scene's
    // own QuietPlaces entry, with Events left empty. PlaceCard.razor reads
    // that empty list as its own signal to render the quiet line instead of
    // verse content (see its own comment) -- SCENE-2 guarantees every REAL
    // lit ScenePlace already has >=1 event, so an empty Events list can only
    // ever mean this synthetic path, never a genuinely lit place. Name is
    // set to DisplayName (QuietPlace carries no separate plain "name" field
    // at all -- the wire payload stays deliberately lean, see wire.rs's own
    // QuietPlace comment) and Brightness to 0 (an unlit place has no glow to
    // report, and nothing downstream of this synthetic object -- PlaceCard,
    // OpenPlaceFromCard's PlaceNode -- ever reads Brightness off it anyway).
    private ScenePlace? QuietAsScenePlace(string id)
    {
        var quiet = _scene?.QuietPlaces.FirstOrDefault(p => p.Id == id);
        return quiet is null ? null : new ScenePlace(quiet.Id, quiet.DisplayName, quiet.DisplayName, quiet.Lat, quiet.Lon, 0, new List<SceneEvent>());
    }

    // Requirement 0c: does NOT unconditionally schedule a close anymore --
    // see _pointerOverCard's own comment for the exact race this guards
    // against. If the pointer is (as far as this component currently
    // knows) already over the card, a marker-leave arriving late tells us
    // nothing new: the card's own eventual OnPointerLeave (CardPointerLeave
    // below) is what will actually close it once the pointer leaves THAT.
    // Batch G1: while pinned, this still schedules exactly as before (no
    // extra guard needed here) -- ScheduleCardClose itself is the ONE choke
    // point that refuses to actually close a pinned card, so every caller
    // (this one and CardPointerLeave below) stays simple.
    public void OnPlaceLeave()
    {
        if (_pointerOverCard)
        {
            return;
        }

        ScheduleCardClose();
    }

    // Batch G1 requirement 3: click a marker (lit or quiet) -> pin its card
    // open. WORLD-1/WORLD-2's own original hover-only design (and Batch
    // E2's own "click is a no-op today, deferred to Batch G1" note on the
    // quiet side) is superseded by this -- the click IS now the pinning
    // gesture, for both marker kinds identically. Resolves the place the
    // exact same way OnPlaceHover does (lit ScenePlace, or a synthetic
    // QuietAsScenePlace) so a pinned card renders with identical content to
    // a hovered one, per CONTRACT's own hover/pin content-parity promise.
    // Clicking a DIFFERENT marker while one is already pinned simply
    // re-pins to the new one -- no special-casing needed, this assignment
    // is unconditional.
    public void OnPlaceClick(string id, double x, double y)
    {
        var place = _scene?.Places.FirstOrDefault(p => p.Id == id) ?? QuietAsScenePlace(id);
        if (place is null)
        {
            return;
        }

        _closeCts?.Cancel();
        _pinnedPlaceId = id;
        _hoverPlace = place;
        _hoverX = x;
        _hoverY = y;
        StateHasChanged();
    }

    // arrow-tip (WORLD-4/contract "arrow-tip"). `key` is "{narrative}:{order}"
    // per the ArrowLayer contract (map.js), matching the
    // arrow-{narrative}-{order} testid exactly -- split on the LAST colon
    // (never the first) so this stays correct even if a narrative id ever
    // contained one; `order` itself never does.
    public void OnArrowHover(string key, double x, double y)
    {
        var split = key.LastIndexOf(':');
        if (split < 0 || !int.TryParse(key[(split + 1)..], out var order))
        {
            return;
        }

        var narrativeId = key[..split];
        var arrow = _scene?.Arrows.FirstOrDefault(a => a.Narrative == narrativeId && a.Order == order);
        if (arrow is null)
        {
            return;
        }

        var narrativeName = _scene?.Narratives.FirstOrDefault(n => n.Id == arrow.Narrative)?.Name ?? arrow.Narrative;
        // Batch E: DisplayName (the scene's own period-resolved name), not
        // the place's default Name -- same swap as the marker label/card
        // title, so this text never contradicts what's shown elsewhere in
        // the SAME scene (e.g. never "The Conquest: Luz -> Jericho" when
        // the map itself currently labels that marker "Bethel").
        var fromName = _scene?.Places.FirstOrDefault(p => p.Id == arrow.FromPlace)?.DisplayName ?? arrow.FromPlace;
        var toName = _scene?.Places.FirstOrDefault(p => p.Id == arrow.ToPlace)?.DisplayName ?? arrow.ToPlace;

        _hoverArrowText = $"{narrativeName}: {fromName} → {toName}";
        _arrowX = x;
        _arrowY = y;
        StateHasChanged();
    }

    public void OnArrowLeave()
    {
        _hoverArrowText = null;
        StateHasChanged();
    }

    // Arrow clicks are reported by map.js per the interop contract but have
    // no behavior yet -- out of scope for WORLD-3/WORLD-4 (hover only).
    // Documented no-op rather than omitted so the IMapEvents contract stays
    // satisfied without silently swallowing future intent -- unlike
    // OnPlaceClick (Batch G1 gave marker clicks real behavior: pinning),
    // arrow clicks remain exactly as they were.
    public void OnArrowClick(string key, double x, double y)
    {
    }

    // Batch G1 requirement 3: a genuine map-background click (map.js's own
    // stopPropagation on every marker/arrow click guarantees this never
    // ALSO fires for one of those in the same gesture -- see map.js's own
    // comment) closes a pinned card, per the brief's "closes via Escape, an
    // X, or clicking elsewhere on the map." A no-op when nothing is pinned
    // (an ordinary click on empty map/terrain/borders has never had any
    // effect, and still doesn't).
    public void OnMapClick()
    {
        if (_pinnedPlaceId is null)
        {
            return;
        }

        CloseCardNow();
        StateHasChanged();
    }

    // Batch G1 requirement 3: Escape closes a pinned card -- but ONLY when
    // no popover is currently open, so a single Escape press closes exactly
    // the TOPMOST layer: ExplorerPopover already has its own Escape handler
    // (OnKeyDown -> RequestClose, scoped to the popover panel); this method
    // deliberately steps aside while _activeNode is non-null rather than
    // ALSO closing the pin in the same keypress, so a user backing out of a
    // popover opened from a pinned card's own content (a verse, a date, the
    // title) doesn't lose the pin underneath it in the same press. A SECOND
    // Escape, once the popover is gone, closes the pin.
    public void OnEscapePressed()
    {
        if (_activeNode is not null || _pinnedPlaceId is null)
        {
            return;
        }

        CloseCardNow();
        StateHasChanged();
    }

    // Batch H fix round 2 (view-state round-trip, review Critical-1): fired
    // on every Leaflet moveend/zoomend (map.js's init()) -- keeps
    // ViewState.Map's camera fields continuously current instead of reading
    // them once, awaited, at dispose time (see DisposeAsync's own comment
    // for the exact race that read lost). Purely a write-through into the
    // shared service, nothing on THIS component's own render output depends
    // on it, so no StateHasChanged() -- same shape as Reader.razor's own
    // OnScroll. Fires for the very first auto-fit too, not just user drags/
    // zooms (map.js's own comment on why), so there's no gap for "opened
    // and closed without ever touching the map."
    public void OnCameraChanged(double lat, double lon, double zoom)
    {
        ViewState.Map.CenterLat = lat;
        ViewState.Map.CenterLon = lon;
        ViewState.Map.Zoom = zoom;
    }

    // Batch M requirement 4: a delta-bearing polity-era-boundary ring was
    // clicked (or Enter-activated) -- map.js's own BorderLayer._makeDeltaHit
    // already resolved every field this needs (its own in-memory roster),
    // so this is a direct construction, no fetch. Opens the SAME
    // ExplorerPopover every other explorable element on this page opens
    // (OpenExploreNode's own "close any pinned card, push the node" shape),
    // even though a delta ring has no hover-card precursor to close --
    // CloseCardNow is harmless when nothing is pinned.
    public void OnPolityDeltaClick(string polityName, string kind, int titleFromYear, int titleToYear, string? eventText, string[] verses, string? refNote)
    {
        _activeNode = new PolityDeltaNode(polityName, kind, titleFromYear, titleToYear, eventText, verses, refNote);
        CloseCardNow();
        StateHasChanged();
    }

    // PlaceCard.OnOpenPlace (WORLD-8/Task 15): closes the hover card
    // immediately (rather than leaving it to the pointer-leave timer) since
    // its content is now shown, promoted, inside the popover that's about
    // to open -- avoids two parchment artifacts (hover card + popover)
    // ever visibly overlapping for the delay window.
    private Task OpenPlaceFromCard()
    {
        if (_hoverPlace is { } place)
        {
            // Batch R requirement 3 (PlaceDatesSection/PlaceBlurbSection):
            // the SAME WindowFrom/WindowTo the <PlaceCard> markup above
            // already computes for its own blurb/dates fetch -- the popover's
            // own PlaceNode resolves against the identical window so its
            // blurb section never contradicts what the hover card it was
            // promoted from just showed.
            var windowFrom = _scriptureRef is null ? _from : (int?)null;
            var windowTo = _scriptureRef is null ? _to : (int?)null;
            _activeNode = new PlaceNode(place.Id, place.DisplayName, windowFrom, windowTo);
        }

        CloseCardNow();
        return Task.CompletedTask;
    }

    // Batch E: PlaceCard.OnExploreNode -- a date affordance (established/
    // destroyed) was activated. Same "promote into a real popover, close
    // the hover card so the two parchment artifacts never overlap" pattern
    // as OpenPlaceFromCard above, just with a caller-supplied node (a
    // YearNode PlaceCard already constructed, having the DateClaimOut in
    // hand) instead of building a PlaceNode here. Batch G1 requirement 1b
    // reuses this SAME callback for card verse/passage clicks (VerseNode/
    // PassageNode) -- "follow that exact pattern for layering/close
    // behavior" per the brief -- so a pinned card is superseded (fully
    // closed, including its own pin, via CloseCardNow) exactly the same way
    // an unpinned one already was; no separate handling needed for either.
    private Task OpenExploreNode(IExplorable node)
    {
        _activeNode = node;
        CloseCardNow();
        return Task.CompletedTask;
    }

    private Task ClosePopover()
    {
        _activeNode = null;
        return Task.CompletedTask;
    }

    // PlaceCard.OnClosePin (Batch G1 requirement 3): the card's own "X" --
    // present only while pinned (see PlaceCard.razor's own Pinned param) --
    // and CONTRACT's own Escape/click-elsewhere paths (OnEscapePressed/
    // OnMapClick below) all funnel here.
    private Task ClosePinnedCard()
    {
        CloseCardNow();
        return Task.CompletedTask;
    }

    // PlaceCard.OnGoToPlace (Batch G1 requirement 3, narrative traversal):
    // fired with the adjacent place's own id by a ‹ previous event / next
    // event › control. Resolves it the same way a marker click would (lit
    // or quiet -- arrows only ever connect LIT places per ARROW-1, so in
    // practice this always resolves via the lit branch, but mirroring
    // OnPlaceClick's own full resolution costs nothing and stays correct
    // even if that invariant ever loosens) and, if it resolves, pans the
    // map there and re-pins. A place that doesn't resolve at all (off-
    // window -- e.g. a scripture-mode scene whose own lit set doesn't
    // include the adjacent place, or theoretically any other gap) no-ops
    // gracefully, per the brief: "if the adjacent place is off-window...
    // no-op gracefully."
    private async Task GoToAdjacent(string placeId)
    {
        var place = _scene?.Places.FirstOrDefault(p => p.Id == placeId) ?? QuietAsScenePlace(placeId);
        if (place is null || _mapInterop is null)
        {
            return;
        }

        var (x, y) = await _mapInterop.PanToPlace(place.Lat, place.Lon);
        _closeCts?.Cancel();
        _pinnedPlaceId = placeId;
        _hoverPlace = place;
        _hoverX = x;
        _hoverY = y;
    }

    // The one choke point for "the card is now fully gone" -- ALWAYS clears
    // _pinnedPlaceId alongside _hoverPlace (Batch G1), never just one or the
    // other: a fully-closed card can never stay "pinned" underneath nothing
    // shown (a real, latent bug this guards against -- see _pinnedPlaceId's
    // own field comment -- OnPlaceHover's own pinned-guard would otherwise
    // silently ignore every future hover on ANY marker, forever, the moment
    // something closed the card via a path that forgot to also clear this).
    private void CloseCardNow()
    {
        _closeCts?.Cancel();
        _hoverPlace = null;
        _pointerOverCard = false;
        _pinnedPlaceId = null;
    }

    // The place card stays open while the pointer is over the marker OR
    // the card itself: leaving either one schedules a close (OnPlaceLeave
    // above / CardPointerLeave below), entering either one (OnPlaceHover
    // above / CardPointerEnter below) cancels a pending close. This gives
    // the pointer room to cross the gap between a marker and its card --
    // which never sit at the same screen point -- without the card
    // flickering shut.
    //
    // Requirement 0c: the grace window is 350ms, up from 150ms -- the
    // SECOND half of the fickleness fix, alongside _pointerOverCard itself.
    // 150ms was tight enough that an ordinary, unhurried pointer move
    // across the marker-to-card gap could occasionally still lose the
    // race even with _pointerOverCard's own fix in place (the card's own
    // OnPointerEnter has to actually finish its async Blazor dispatch
    // before the close fires); 350ms gives that real margin without
    // reading as a delay a user would ever notice on a deliberate
    // pointer-leaves-both close (CONTRACT's own "closes within ~1s" bar
    // for requirement 0c's acceptance test).
    // Batch G1 requirement 3: the ONE choke point that refuses to schedule
    // a close at all while pinned ("stays through mouse-leave" -- a marker's
    // own real mouseout still fires OnPlaceLeave regardless of pin state,
    // map.js has no notion of pinning; this is where that gets stopped).
    // Both of this method's own callers (OnPlaceLeave, CardPointerLeave)
    // stay unchanged/unguarded themselves -- simpler than duplicating the
    // same check at every call site.
    private void ScheduleCardClose()
    {
        if (_pinnedPlaceId is not null)
        {
            return;
        }

        _closeCts?.Cancel();
        var cts = new CancellationTokenSource();
        _closeCts = cts;
        _ = CloseCardAfterDelay(cts);
    }

    // PlaceCard.OnPointerEnter: the pointer has physically entered the
    // card. Cancels any pending close (same as the pre-0c CancelCardClose
    // this replaces) AND records that fact in _pointerOverCard, so a
    // late-arriving marker-leave (OnPlaceLeave above) knows not to
    // schedule a fresh close out from under it -- see _pointerOverCard's
    // own comment for the full race this closes.
    private void CardPointerEnter()
    {
        _pointerOverCard = true;
        _closeCts?.Cancel();
    }

    // PlaceCard.OnPointerLeave: the pointer has physically left the card.
    // Clears _pointerOverCard (a later marker-leave, if one arrives, is
    // now free to schedule its own close again) and schedules the close
    // itself -- same as the pre-0c ScheduleCardClose wiring this replaces,
    // just also keeping _pointerOverCard honest.
    private void CardPointerLeave()
    {
        _pointerOverCard = false;
        ScheduleCardClose();
    }

    private async Task CloseCardAfterDelay(CancellationTokenSource cts)
    {
        try
        {
            await Task.Delay(350, cts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (cts.IsCancellationRequested)
        {
            return;
        }

        _hoverPlace = null;
        _pointerOverCard = false;
        StateHasChanged();
    }

    // Batch H (view-state round-trip), fix round 2 (review Critical-1):
    // ViewState.Map is NOT captured here at all anymore -- neither the
    // window/ref/follow fields nor the camera. Fix round 2's FIRST attempt
    // moved the five non-camera fields into this method's own synchronous
    // prefix (before its one await, _mapInterop.DisposeAsync()), reasoning
    // that a synchronous prefix of an async method always runs inline in
    // the caller's own call stack -- sound in isolation, but EMPIRICALLY
    // still lost the exact race it was meant to close (a regression test
    // written against that fix stayed red): Blazor's renderer does not
    // guarantee an outgoing component's DisposeAsync is even CALLED before
    // an incoming component's own OnParametersSetAsync reads shared state,
    // on a navigation that disposes one component and mounts another in
    // the same step. No fix confined to DisposeAsync, sync or not, can
    // close a race whose losing side is "not yet invoked at all." The
    // actual fix -- SyncViewState(), called continuously the moment
    // _scriptureRef/_from/_to/_follow change (EnterScriptureMode/
    // EnterTimeMode/SyncFromQuery's own inline branches -- see
    // SyncViewState's own comment) and OnCameraChanged below (a Leaflet
    // moveend/zoomend listener, map.js's init()) for the camera -- removes
    // DisposeAsync from the critical path entirely, mirroring reader.js's
    // own watchScroll/OnScroll exactly. By the time ANY instance disposes,
    // whatever it had worth capturing is already in ViewState.
    public async ValueTask DisposeAsync()
    {
        _fetchCts?.Cancel();
        _closeCts?.Cancel();

        if (_mapInterop is not null)
        {
            await _mapInterop.DisposeAsync();
        }
    }
}
