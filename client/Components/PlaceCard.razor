@using System.Globalization
@using BibleAtlas.Client.Explore
@using VerseRun = BibleAtlas.Client.Explore.PassageGrouping.VerseRun
@inject AtlasClient Atlas
@inject IJSRuntime JS

<div class="place-card"
     data-testid="place-card"
     data-pinned="@(Pinned ? "true" : "false")"
     data-flip="@(_flipped ? "true" : "false")"
     @ref="_cardEl"
     style="left: @X.ToString(CultureInfo.InvariantCulture)px; top: @Y.ToString(CultureInfo.InvariantCulture)px; --card-dx: @(CardDxCss)px; --card-dy: @(CardDyCss); --card-dy-from: @(CardDyFromCss); --card-dy-adjust: @(CardDyAdjustCss)px;"
     @onpointerenter="OnPointerEnter"
     @onpointerleave="OnPointerLeave">
    <div class="place-card-scroll">
        <div class="place-card-head">
            <button type="button" class="place-card-title explorable" data-testid="place-card-title" @onclick="() => OnOpenPlace.InvokeAsync()">@Place.DisplayName</button>
            @if (Pinned)
            {
                <button type="button" class="place-card-close" data-testid="place-card-close"
                        aria-label="Close" @onclick="() => OnClosePin.InvokeAsync()">&times;</button>
            }
        </div>

        @{
            var verses = MergedVerses();
            var visible = VisibleGroups(Groups(verses), _shownCount);
        }
        @if (verses.Count == 0)
        {
            <p class="place-card-quiet" data-testid="place-card-quiet">No recorded events in this window &mdash; drag the timeline.</p>
        }
        else
        {
            @foreach (var g in visible)
            {
                @if (g.IsPassage)
                {
                    var blockVerses = verses.GetRange(g.Start, g.Length);
                    var span = SpanRef(blockVerses[0], blockVerses[^1]);
                    <div class="place-card-passage explorable" data-testid="hover-passage-@span"
                         tabindex="0" role="button" aria-label="@($"Explore passage {span}")"
                         @onclick="() => ExplorePassage(span, blockVerses)"
                         @onkeydown="@(e => OnPassageKeyDown(e, span, blockVerses))">
                        <span class="place-card-passage-ref">@span</span>
                        <span class="place-card-passage-text">
                            @foreach (var vref in blockVerses)
                            {
                                <span class="place-card-passage-verse explorable" data-testid="hover-verse-@vref"
                                      tabindex="0" role="button" aria-label="@($"Explore {vref}")"
                                      @onclick="() => ExploreVerse(vref)" @onclick:stopPropagation="true"
                                      @onkeydown="@(e => OnVerseKeyDown(e, vref))" @onkeydown:stopPropagation="true"
                                      ><sup class="place-card-verse-num">@VerseNumOf(vref)</sup>@VerseText(vref) </span>
                            }
                        </span>
                    </div>
                }
                else
                {
                    var vref = verses[g.Start];
                    <div class="place-card-verse explorable" data-testid="hover-verse-@vref"
                         tabindex="0" role="button" aria-label="@($"Explore {vref}")"
                         @onclick="() => ExploreVerse(vref)" @onkeydown="@(e => OnVerseKeyDown(e, vref))">
                        <span class="place-card-verse-ref">@vref</span>
                        <span class="place-card-verse-text">@VerseText(vref)</span>
                    </div>
                }
            }
        }
    </div>

    @if (_shownCount > _initialShownCount || _shownCount < verses.Count)
    {
        <div class="place-card-controls">
            @if (_shownCount > _initialShownCount)
            {
                <button type="button" class="place-card-collapse" data-testid="place-card-collapse"
                        aria-label="Show fewer verses" @onclick="Collapse">&#9652;</button>
            }
            @if (_shownCount < verses.Count)
            {
                <button type="button" class="place-card-more" data-testid="place-card-more"
                        aria-label="Show more verses" @onclick="ShowMore">&#9662;</button>
            }
        </div>
    }

    @if (_history?.Blurb is { } blurb)
    {
        <p class="place-card-blurb" data-testid="place-card-blurb">@blurb</p>
    }

    @if (_dates.Count > 0)
    {
        <div class="place-card-dates" data-testid="place-card-dates">
            @foreach (var (date, index) in _dates.Select((date, index) => (date, index)))
            {
                @if (index > 0)
                {
                    <span class="place-card-dates-sep" aria-hidden="true">&middot;</span>
                }
                <button type="button" class="place-card-date explorable" data-testid="@($"place-card-date-{date.Label.ToLowerInvariant()}")"
                        aria-label="@($"Explore {date.Label.ToLowerInvariant()} date: {date.Claim.Label}")"
                        @onclick="() => ExploreDate(date)">
                    <span class="place-card-date-label">@date.Label</span>
                    <span class="place-card-date-value">@date.Claim.Label</span>
                    <span class="place-card-date-explore" aria-hidden="true">Explore</span>
                </button>
            }
        </div>
    }

    @* NarrativeRows() itself doesn't check Pinned; gating here is required or an
       unpinned hover shows the same traversal controls a click-to-pin should unlock. *@
    @{ var narrativeRows = NarrativeRows(); }
    @if (Pinned && narrativeRows.Count > 0)
    {
        <div class="place-card-narratives" data-testid="place-card-narratives">
            @foreach (var row in narrativeRows)
            {
                <div class="place-card-narrative-row">
                    <span class="place-card-narrative-swatch" style="background-color: @row.Color;" aria-hidden="true"></span>
                    <span class="place-card-narrative-name">@row.Name</span>
                    @if (row.PrevPlaceId is { } prevId)
                    {
                        <button type="button" class="place-card-nav-event" data-testid="card-prev-event-@row.NarrativeId"
                                aria-label="@($"Previous event in {row.Name}")"
                                @onclick="() => OnGoToPlace.InvokeAsync(prevId)">&lsaquo; previous event</button>
                    }
                    @if (row.NextPlaceId is { } nextId)
                    {
                        <button type="button" class="place-card-nav-event" data-testid="card-next-event-@row.NarrativeId"
                                aria-label="@($"Next event in {row.Name}")"
                                @onclick="() => OnGoToPlace.InvokeAsync(nextId)">next event &rsaquo;</button>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public ScenePlace Place { get; set; } = default!;
    [Parameter] public double X { get; set; }
    [Parameter] public double Y { get; set; }
    [Parameter] public EventCallback OnPointerEnter { get; set; }
    [Parameter] public EventCallback OnPointerLeave { get; set; }

    [Parameter] public int? WindowFrom { get; set; }
    [Parameter] public int? WindowTo { get; set; }

    [Parameter] public EventCallback<IExplorable> OnExploreNode { get; set; }

    [Parameter] public EventCallback OnOpenPlace { get; set; }

    [Parameter] public bool Pinned { get; set; }
    [Parameter] public IReadOnlyList<SceneNarrative>? Narratives { get; set; }
    [Parameter] public EventCallback<string> OnGoToPlace { get; set; }
    [Parameter] public EventCallback OnClosePin { get; set; }

    private const int PassageInitialMax = 4;
    private const int PassageStep = 5;
    private const int LoneInitialMax = 2;
    private const int LoneStep = 2;

    private string? _lastPlaceId;
    private int _shownCount;
    private int _initialShownCount;
    private readonly Dictionary<string, string> _verseText = new();

    private History? _history;
    private IReadOnlyList<PlaceDate> _dates = [];

    private List<NarrativePosition> _narrativePositions = new();

    private ElementReference _cardEl;

    // Card height isn't final until verse text, history, and narrative fetches all settle
    // (blurb/dates are conditionally present) -- placement measurement waits for this.
    private bool _contentReady;

    // Distinct from _lastPlaceId: this measurement is async and can still be in flight for
    // an older place after _lastPlaceId has already moved on (see OnAfterRenderAsync's stale-result guard).
    private string? _placedForId;
    private readonly RequestSeries _place = new();
    private readonly RequestSeries _chapters = new();
    private double _dxPx;
    private bool _flipped;

    private double _dyAdjustPx;

    // app.css reads these four vars unconditionally with no CSS-side var() fallback,
    // so each must always resolve to a concrete value even before the first measurement.
    private bool IsFlippedNow => _placedForId == Place.Id && _flipped;
    private string CardDxCss => (_placedForId == Place.Id ? _dxPx : 0).ToString(CultureInfo.InvariantCulture);
    private string CardDyCss => VerticalCss(CardPlacement.GapPx);

    private string CardDyFromCss => VerticalCss(CardPlacement.GapPx - 8);

    private string CardDyAdjustCss => (_placedForId == Place.Id ? _dyAdjustPx : 0).ToString(CultureInfo.InvariantCulture);

    private string VerticalCss(double gapPx)
    {
        var gap = gapPx.ToString(CultureInfo.InvariantCulture);
        return IsFlippedNow ? $"{gap}px" : $"calc(-100% - {gap}px)";
    }

    // A verse can legitimately anchor more than one event at the same place
    // (e.g. two narrative beats both citing the crossing verse), so dedupe by id.
    private List<string> MergedVerses()
    {
        var seen = new HashSet<string>();
        var result = new List<string>();

        foreach (var e in Place.Events)
        {
            foreach (var g in e.VerseGroups)
            {
                foreach (var v in g.Verses)
                {
                    if (seen.Add(v))
                    {
                        result.Add(v);
                    }
                }
            }
        }

        return result;
    }

    // Adjacency is checked purely by list position, never a fresh sort of the verses.
    private static List<VerseRun> Groups(List<string> verses) => PassageGrouping.Groups(verses);

    private static int InitialShownCount(List<string> verses)
    {
        if (verses.Count == 0)
        {
            return 0;
        }

        var first = Groups(verses)[0];
        return first.IsPassage ? Math.Min(PassageInitialMax, first.Length) : Math.Min(LoneInitialMax, verses.Count);
    }

    // A pure function of (groups, shownCount), recomputed fresh every render: a group only
    // 1 verse into its reveal renders as a lone verse and upgrades to a passage block
    // automatically once a later click reveals a 2nd verse, with no reveal-history state to keep in sync.
    private static List<VerseRun> VisibleGroups(List<VerseRun> groups, int shownCount)
    {
        var visible = new List<VerseRun>();
        foreach (var g in groups)
        {
            if (g.Start >= shownCount)
            {
                break;
            }

            visible.Add(new VerseRun(g.Start, Math.Min(g.Length, shownCount - g.Start)));
        }

        return visible;
    }

    private static string SpanRef(string firstVref, string lastVref) => PassageGrouping.SpanRef(firstVref, lastVref);

    private static int VerseNumOf(string vref) => CanonRef.ParseVerse(vref).Verse;

    private string VerseText(string vref) => _verseText.TryGetValue(vref, out var text) ? text : "";

    // Awaiting the fetch here (rather than firing it unobserved) is deliberate: Blazor renders
    // once synchronously right after this method's synchronous prefix runs, then again when the
    // awaited task completes -- so refs paint immediately and VerseText(vref) reads "" until then.
    protected override async Task OnParametersSetAsync()
    {
        if (Place.Id == _lastPlaceId)
        {
            return;
        }

        _lastPlaceId = Place.Id;
        _verseText.Clear();
        _history = null;
        _dates = [];
        // _contentReady must reset explicitly: leaving it true from a previous place would let
        // a measurement fire against this place's synchronous-prefix-only render, before its
        // own blurb/dates have had any chance to load.
        _contentReady = false;
        var verses = MergedVerses();
        _initialShownCount = InitialShownCount(verses);
        _shownCount = _initialShownCount;
        await Task.WhenAll(LoadChaptersFor(verses.Take(_shownCount)), LoadHistory(), LoadNarrativePositions());

        _contentReady = true;
    }

    // Measures once per place (the _placedForId guard) and never again for that open: placement
    // is a snapshot decided at open time, not re-measured just because ShowMore/Collapse changes height.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_contentReady || _placedForId == Place.Id)
        {
            return;
        }

        // Captured before the await: if a newer place supersedes this one while measuring is
        // still in flight, comparing against the current Place.Id below detects that and drops the stale result.
        var placeId = Place.Id;
        CardMeasurement measurement;
        try
        {
            measurement = await MapInterop.MeasureCardPlacement(JS, _cardEl);
        }
        catch (Exception)
        {
            return;
        }

        if (placeId != Place.Id)
        {
            return;
        }

        var (dx, dyAdjust, flipped) = CardPlacement.Compute(X, Y, measurement.Width, measurement.Height, measurement.ContainerWidth, measurement.ContainerHeight);
        _dxPx = dx;
        _dyAdjustPx = dyAdjust;
        _flipped = flipped;
        _placedForId = placeId;
        StateHasChanged();
    }

    private async Task LoadHistory()
    {
        var request = _place.Next();
        try
        {
            if (await request.Fetch(() => Atlas.PlaceHistory(Place.Id, WindowFrom, WindowTo)) is not { } detail)
            {
                return;
            }

            _history = detail.History;
            if (await request.Fetch(() => Atlas.NodeCard(NodeIds.Of(NodeKind.Place, Place.Id))) is not { } card)
            {
                return;
            }

            _dates = PlaceDates.Of(card.Place);
        }
        catch (Exception)
        {
        }
    }

    // Reads narrative positions via the same full-chain resolver the verse popover uses (not
    // the scene's windowed Arrows): a windowed derivation can disagree with the popover on
    // adjacency when a narrative's legs straddle an out-of-window gap.
    // Skips synthetic "mention-{place}" event ids (scripture-mode placeholders) since they're
    // not real events and the endpoint would 404 for them.
    private async Task LoadNarrativePositions()
    {
        var eventIds = Place.Events.Select(e => e.Id).Where(id => !id.StartsWith("mention-", StringComparison.Ordinal)).ToList();
        if (eventIds.Count == 0)
        {
            _narrativePositions = new List<NarrativePosition>();
            return;
        }

        try
        {
            var results = await Task.WhenAll(eventIds.Select(Atlas.NarrativeEventPositions));
            _narrativePositions = results.SelectMany(r => r.Narrative).ToList();
        }
        catch (Exception)
        {
            _narrativePositions = new List<NarrativePosition>();
        }
    }

    private Task ExploreDate(PlaceDate date) => OnExploreNode.InvokeAsync(new YearNode(Place.Id, date));

    private Task ExploreVerse(string vref) => OnExploreNode.InvokeAsync(new VerseNode(vref));

    private Task ExplorePassage(string span, List<string> blockVerses) =>
        OnExploreNode.InvokeAsync(new PassageNode(span, string.Join(" ", blockVerses.Select(VerseText))));

    private Task OnVerseKeyDown(KeyboardEventArgs e, string vref) =>
        e.Key == "Enter" ? ExploreVerse(vref) : Task.CompletedTask;

    private Task OnPassageKeyDown(KeyboardEventArgs e, string span, List<string> blockVerses) =>
        e.Key == "Enter" ? ExplorePassage(span, blockVerses) : Task.CompletedTask;

    private async Task ShowMore()
    {
        var verses = MergedVerses();
        if (_shownCount >= verses.Count)
        {
            return;
        }

        var group = Groups(verses).First(g => _shownCount >= g.Start && _shownCount < g.Start + g.Length);
        var step = group.IsPassage ? PassageStep : LoneStep;
        var oldShown = _shownCount;
        _shownCount = Math.Min(_shownCount + step, verses.Count);
        await LoadChaptersFor(verses.Skip(oldShown).Take(_shownCount - oldShown));
    }

    private void Collapse()
    {
        _shownCount = _initialShownCount;
    }

    // Tie-break for a place revisited more than once by the same narrative: first-encountered
    // wins, in Place.Events' own display order.
    private sealed record NarrativeAdjacency(string NarrativeId, string Name, string Color, string? PrevPlaceId, string? NextPlaceId);

    // Legend color only covers narratives with an arrow somewhere in-window; this fallback
    // keeps an isolated leg's row rendering (name/traversal) even without a color match.
    private const string DefaultNarrativeColor = "#8A8A8A";

    private List<NarrativeAdjacency> NarrativeRows()
    {
        var rows = new List<NarrativeAdjacency>();
        var seenNarratives = new HashSet<string>();

        foreach (var e in Place.Events)
        {
            foreach (var position in _narrativePositions.Where(p => p.EventId == e.Id))
            {
                if (!seenNarratives.Add(position.NarrativeId))
                {
                    continue; // first-encountered wins
                }

                var color = Narratives?.FirstOrDefault(n => n.Id == position.NarrativeId)?.Color ?? DefaultNarrativeColor;
                rows.Add(new NarrativeAdjacency(
                    position.NarrativeId,
                    position.NarrativeName,
                    color,
                    AdjacentPlaceId(position.Prior),
                    AdjacentPlaceId(position.Following)));
            }
        }

        return rows;
    }

    private static string? AdjacentPlaceId(NarrativeAdjacentEvent? adjacent) =>
        adjacent?.Places is { Count: > 0 } places ? places[0] : null;

    // Populates every verse from each fetched chapter, not just the requested ones --
    // several requested verses sharing a chapter then cost exactly one fetch.
    private async Task LoadChaptersFor(IEnumerable<string> vrefs)
    {
        var pairs = vrefs.Select(CanonRef.ParseVerse).Select(p => (p.Book, p.Chapter)).Distinct().ToList();
        if (pairs.Count == 0)
        {
            return;
        }

        try
        {
            if (await _chapters.Next().Fetch(() => Task.WhenAll(pairs.Select(p => Atlas.Chapter(p.Book, p.Chapter)))) is not { } chapters)
            {
                return;
            }

            foreach (var chapter in chapters)
            {
                // chapter.Ref is the code-based ref (e.g. "JDG.3"); chapter.Book is the display
                // name (e.g. "Judges") -- keying off Book here silently produces "Judges.3.7",
                // which never matches a verse ref like "JDG.3.7".
                foreach (var v in chapter.Verses)
                {
                    _verseText[$"{chapter.Ref}.{v.Number}"] = v.Text;
                }
            }
        }
        catch (Exception)
        {
        }
    }
}
