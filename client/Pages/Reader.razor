@page "/"
@page "/read/{Book}/{Chapter:int}"
@using System.Text.RegularExpressions
@using BibleAtlas.Client.State
@using BibleAtlas.Client.Views
@implements IAsyncDisposable
@inject AtlasClient Atlas
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ViewStateService ViewState
@inject StateAtom<IReadOnlyList<ExplorationDescriptor>> SelectionAtom
@inject StateAtom<Locus> LocusAtom
@inject StateAtom<ViewArrangement> ViewArrangementAtom
@inject ViewRegistry Registry

<PageTitle>Bible Explorer &mdash; @BookName @_chapterNum</PageTitle>

@* Outer wrapper exists ONLY so a keydown/keyup while focus is ANYWHERE
   inside -- a verse-num button just clicked, or the popover panel once its
   own FocusAsync() lands -- bubbles to ONE pair of handlers regardless of
   exactly where focus is at that instant (OnPageKeyDown/OnPageKeyUp below).
   .reader-page and ExplorerPopover are otherwise unrelated SIBLINGS in the
   DOM (Blazor renders a conditional block as a sibling, not a child, of the
   element before it), so neither one alone could catch a keydown/keyup
   whose focus target is inside the OTHER.

   Fix round 1 finding: this used to ALSO close any open popover the instant
   Shift went down, to get ExplorerPopover's own click-outside-to-close
   backdrop (position:fixed, inset:0 -- physically covers every verse-num
   underneath it) out of the way before a shift-click's second click. That
   over-fired on Shift+Tab (ordinary backward tab traversal through the
   popover's own controls, which also sends a Shift keydown) and slammed the
   popover shut on plain keyboard navigation. Replaced with a narrower
   mechanism: OnPageKeyDown/OnPageKeyUp only track whether Shift is
   currently held (`_shiftHeld`), toggling the `reader-shift-active` class
   below, which app.css turns into `pointer-events: none` on
   `.popover-backdrop` alone -- the popover itself no longer closes on
   keydown at all, so Tab's own default focus-traversal behavior (never
   prevented here) proceeds normally through an open popover exactly like
   it would anywhere else. The backdrop being un-clickable for the instant
   Shift is held is a deliberate, narrow trade (click-outside-to-close is
   briefly unavailable), not an oversight -- see OnVerseNumClick's own
   comment for how the range-forming shift-click itself still closes the
   popover afterward, unchanged.

   `reader-shift-active` reacts to Shift released OUTSIDE this window too
   (alt-tab away, switch browser tabs) via reader.js's watchShiftRelease --
   see OnAfterRenderAsync/DisposeAsync below -- so it can never get stuck on
   if this page's own keyup never fires. Otherwise purely structural -- no
   visual effect of its own; .reader-page keeps its own min-height:100vh
   (vh units are viewport-relative regardless of ancestor nesting) and
   .popover keeps its own position:fixed centering (an unstyled wrapper
   introduces no new containing block). *@
@* Batch H (split-view study): this SAME outer wrapper -- pre-existing,
   originally just the Shift-tracking scope (see OnPageKeyDown/OnPageKeyUp
   below) -- doubles as .split-view's own flex container once _splitOpen.
   A position:fixed element (ExplorerPopover's own backdrop/panel) is
   removed from normal flow regardless of its DOM parent's own display,
   so adding display:flex here never affects them -- they still render
   exactly like "normal", full-viewport, per the brief. *@
@* Batch VC-1: the split-view flex-container classing/testid/width-var is
   now gated on `_splitOpen && _isHost` -- only the HOST lays out
   [own content][divider][guest]; a GUEST-mounted Reader (sources+reader)
   is just an ordinary content block sized by ITS OWN host's flex layout.

   THIS OUTER DIV -- not the inner .reader-page below -- is Reader.razor's
   own ROOT element, and Blazor components introduce no DOM element of
   their own: when CompositionHost mounts Reader as a GUEST, THIS div lands
   as the actual flex ITEM inside the HOST's own .split-view container
   (Sources.razor's, for the sources+reader pairing) -- one level ABOVE
   .reader-page. So .split-pane-guest (the sizing class, `flex: 1 1 auto`)
   belongs HERE, on the true flex item, while .reader-page's own
   .split-pane-reader stays reserved for the case THIS div itself is the
   flex CONTAINER (hosting). Getting this one level wrong was caught before
   ever reaching Playwright -- see ReaderPaneClass's own comment for the
   matching other half. *@
<div class="@(_shiftHeld ? "reader-shift-active" : "") @(_splitOpen && _isHost ? "split-view" : "") @(_splitOpen && !_isHost ? "split-pane-guest" : "")"
     style="--split-reader-width:@(_splitReaderWidthPx.ToString(System.Globalization.CultureInfo.InvariantCulture))px;"
     @onkeydown="OnPageKeyDown" @onkeyup="OnPageKeyUp" data-testid="@(_splitOpen && _isHost ? "split-view" : null)">
    <div class="@ReaderPaneClass" data-testid="reader-root">
        @* Batch VC-1 (R4): the "Open the map beside the text" button is now
           an INVOCATION of Reader's own declared enter-split hatch
           (ViewRegistry, Kind "enter-split") -- see InvokeEnterSplitHatch's
           own comment. The two close affordances stay split by ROLE, not by
           a Reader-specific "am I split" flag alone: HOST's own self-close
           (CloseReaderPane, unchanged -- "close the reader, keep the map,"
           byte-identical to pre-VC-1) vs. GUEST's own close (dispatches the
           generic CloseGuest intent via OnRequestClose, the SAME wiring
           World.razor's own split-close-atlas button already uses). *@
        @if (!_splitOpen)
        {
            <button type="button" class="split-open split-open-parchment" data-testid="split-open-reader"
                    @onclick="InvokeEnterSplitHatch">
                Open the map beside the text
            </button>
        }
        else if (_isHost)
        {
            <button type="button" class="split-close split-close-parchment" data-testid="split-close-reader"
                    aria-label="Close the reader, keep the map" @onclick="CloseReaderPane">
                &times;
            </button>
        }
        else
        {
            <button type="button" class="split-close split-close-parchment" data-testid="split-close-reader-guest"
                    aria-label="Close the reader" @onclick="() => OnRequestClose.InvokeAsync()">
                &times;
            </button>
        }

        @* Owner bug B4, verbatim: "the chapter nav box in the top right of
           the reader is always stuck on genesis and doesn't follow the
           focus chapter." CurrentBook/CurrentChapter feed ScripturePicker's
           own new sync parameters (null on World's OWN mount -- unaffected,
           see that component's own doc comment) -- Blazor's ordinary
           parameter diffing pushes the new values down on every Reader.razor
           re-render, so route changes, prev/next nav, AND a picker-applied
           jump (which itself lands here as a route change) are all reflected
           the SAME way, no per-trigger special case. *@
        <ScripturePicker OnApply="ApplyScriptureRef" ThemeClass="picker-parchment" CurrentBook="@_book" CurrentChapter="@_chapterNum" />

        @if (ChapterMatchesRoute)
        {
            <article class="reader-column">
                <h1 class="chapter-head">
                    @* Batch G1 requirement 1: the chapter header becomes
                       explorable the same way (.explorable, see app.css) --
                       a real <button> wrapping the existing book/num spans
                       (the wrapping-button fallback design-direction.md
                       prefers, and here it works cleanly: nothing else
                       inside the header needs its own separate click
                       target). The outer <h1> itself stays a plain,
                       unmodified heading -- App.razor's FocusOnNavigate
                       still finds and focuses IT, not this button, so
                       document-outline semantics are untouched. *@
                    @* CHAP-HOVER-1 (owner defect report, 2026-08-24,
                       verbatim: "chapter headers in the reader give a hover
                       box that i have to x out of if i so much as tickle
                       the chapter button. that is awful."): M-D3/U4's own
                       @onmouseenter -> OpenChapter(persistent:false) (a
                       hover that opened the FULL ExplorerPopover card
                       instantly, backdrop-less but still title/chips/close-
                       button and all -- see git history for the retired
                       shape) is GONE. Respec'd to the SAME dwell grammar
                       decision 4 gives the traversal arrows: a bare/short
                       hover does NOTHING; a dwell past DwellTiming.PeekDelayMs
                       reveals a TRANSIENT, non-interactive peek
                       (_showChapterPeek below) with no close button at all;
                       pointer-leave dismisses it outright, no grace period
                       (this peek is a passive glance, never something a user
                       needs to travel INTO, unlike the xref marker's own
                       marker-to-panel transit concern). CLICK is now the
                       ONLY path into the real card (OpenChapter, simplified
                       below -- no more `persistent` parameter, since a
                       hover-opened-then-upgraded case no longer exists). *@
                    <button type="button" class="chapter-head-button explorable" data-testid="chapter-head"
                            aria-label="@($"Explore {_book}.{_chapterNum}")"
                            @onclick="OpenChapter" @onmouseenter="OnChapterHeadPointerEnter" @onmouseleave="OnChapterHeadPointerLeave">
                        <span class="chapter-head-book">@BookName</span>
                        <span class="chapter-head-num">@_chapterNum</span>
                    </button>
                    @if (_showChapterPeek)
                    {
                        <div class="chapter-head-peek" data-testid="chapter-head-peek">
                            <p class="chapter-head-peek-position" data-testid="chapter-head-peek-position">@ChapterPeekPositionText</p>
                            @if (ChapterPeekHeadings.Count > 0)
                            {
                                <ul class="chapter-head-peek-headings">
                                    @foreach (var heading in ChapterPeekHeadings)
                                    {
                                        <li data-testid="@($"chapter-head-peek-heading-{heading.EventId}")">@heading.Title</li>
                                    }
                                </ul>
                            }
                        </div>
                    }
                </h1>

                @* Batch M-D4 ("the recursive reader"): every verse of this
                   chapter now renders through VerseLine.razor -- the ONE
                   canonical verse-line component decision 1 asks for,
                   shared with MiniReaderExpand.razor's own expanded body
                   (see that file's own call site) -- rather than this loop
                   hand-building verse-num/mention/xref-marker markup of its
                   own. Heading interleaving (PericopeHeading.razor,
                   likewise shared) stays the CALLER's own job -- a verse
                   line's identity doesn't include whatever heading happens
                   to sit above it (see VerseLine.razor's own header
                   comment). Shares this SAME code path for the split-view
                   reader pane (Reader.razor is reused, not copied, for
                   both -- SPLIT-1). *@
                @{ var xrefLetters = VerseLine.ComputeXrefLetters(_chapter!.Verses); }
                @foreach (var v in _chapter!.Verses)
                {
                    @if (v.Heading is { } heading)
                    {
                        <PericopeHeading Heading="@heading" OnExplore="OnLineExplore" />
                    }
                    @* Batch G1 requirement 1 (design-direction.md's REVISED
                       interaction rule): the ∴ button DIES. THE VERSE LINE
                       is the explorable element -- hover/focus darkens it
                       (.explorable) with cursor:pointer, click (anywhere on
                       the line) opens the verse's ExplorerPopover.
                       Verse-NUMBER clicks stay a SEPARATE gesture on a
                       SEPARATE target (.verse-num, not .explorable --
                       anchor+extend passage-range mechanics only, no
                       popover -- see OnVerseNumClick/SetAnchor below).
                       M-D3 (R3)/Batch M-D2: the xref superscript's own
                       click/focus (commit, OpenVerseXrefEntryPersistent)
                       vs. hover (preview, OpenVerseXrefEntryHover, eligible
                       for OnXrefMarkerPointerLeave's own debounced
                       auto-dismiss) stay two deliberately different
                       callbacks, unchanged -- VerseLine.razor's own header
                       comment has the full "why hover stays Reader-page-only"
                       story now that the SAME component also renders inside
                       the popover's own mini-reader, which deliberately
                       leaves OnXrefHoverEnter/OnXrefHoverLeave unbound. *@
                    <VerseLine Verse="@v" Book="@_book" Chapter="@_chapterNum" OnExplore="OnLineExplore" Id="@($"v{v.Verse}")"
                               RowClass="verse-line explorable" RowTestIdPrefix="verse-line"
                               VerseNumClass="verse-num" ShowVerseNumButton="true" VerseNumTestIdPrefix="verse-num"
                               OnVerseNumClick="@(e => OnVerseNumClick(e, v.Verse))"
                               TextClass="verse-text" MentionClass="verse-mention"
                               XrefMarkerGlyph="@xrefLetters.GetValueOrDefault(v.Verse, "")"
                               OnXrefClick="OpenVerseXrefEntryPersistent" OnXrefHoverEnter="OpenVerseXrefEntryHover"
                               OnXrefHoverLeave="OnXrefMarkerPointerLeave" OnToggleSelect="OnLineToggleSelect" />
                }
            </article>
        }
        else if (_errorMessage is null)
        {
            <p class="reader-loading">Loading&hellip;</p>
        }

        <nav aria-label="Chapter navigation">
            @if (PrevTarget is { } prev)
            {
                <a class="reader-prev" data-testid="reader-prev" href="@ChapterHref(prev.Book, prev.Chapter)" aria-label="@($"Previous chapter: {prev.Name} {prev.Chapter}")">&lsaquo;<span class="reader-nav-label"> @prev.Name @prev.Chapter</span></a>
            }
            @if (NextTarget is { } next)
            {
                <a class="reader-next" data-testid="reader-next" href="@ChapterHref(next.Book, next.Chapter)" aria-label="@($"Next chapter: {next.Name} {next.Chapter}")"><span class="reader-nav-label">@next.Name @next.Chapter </span>&rsaquo;</a>
            }
        </nav>

        @if (_passageRange is { } range)
        {
            <button type="button" class="passage-chip" data-testid="passage-chip" @onclick="OpenPassage">@PassageRef(range)</button>
        }

        @if (_errorMessage is not null)
        {
            <div class="toast" data-testid="toast">
                <p class="toast-message">@_errorMessage</p>
            </div>
        }
    </div>

    @* Batch H: the atlas pane -- the EXISTING World.razor page componentry,
       reused directly as a child component (not a copy), narrowed to its
       own split-pane-atlas layout via SplitMode's markup branch. Batch
       ST-1: the FollowRef PARAMETER that used to carry this page's own
       current chapter down to World is RETIRED -- World now injects the
       SAME shared Locus atom directly (client/State/Locus.cs) and
       subscribes to its own Changed event, so "Reader navigation re-scenes
       the map automatically" now falls out of both pages sharing ONE
       atom, not a parameter Reader had to thread down (this is the actual
       SYNC-1 fix -- see the batch report for the full mechanism). *@
    @if (_splitOpen && _isHost)
    {
        @* Batch VC-1 (R3): Reader.razor's own hard-wired World embed is
           RETIRED -- this now mounts WHICHEVER view the current
           ViewArrangement names as the guest, by NAME, via CompositionHost/
           ViewRegistry (never a hardcoded &lt;World .../&gt; tag). The
           divider itself (M-D3/B2's own SplitDivider, unchanged) stays
           OWNED here, alongside _splitReaderWidthPx -- see
           CompositionHost.razor's own header for why: SplitDivider's own
           pre-VC-1 doc comment already anticipated "a future second split
           host inherits the identical mechanic for free." *@
        <SplitDivider WidthPx="_splitReaderWidthPx" WidthPxChanged="w => _splitReaderWidthPx = w" OnCommitted="OnDividerCommitted" />
        <CompositionHost @ref="_compositionHost" HostName="@ViewNames.Reader" />
    }

    @if (_activeNode is not null)
    {
        @* M-D3 (R3): VerseAnchorSelector/OnPanelPointerEnter/OnPanelPointerLeave
           are ONLY meaningful while _activeNode was reached via a
           superscript entry point (_xrefEntryVerse is set) -- every other
           entry point (a plain verse-line click, a chip drill-in, a
           chapter/event/place push, ...) passes null/unbound, which
           ExplorerPopover's own parameter doc comments already establish
           as a correct no-op, keeping this component's pre-existing
           viewport/pane-centered behavior byte-for-byte unchanged there. *@
        <ExplorerPopover @key="_activeNode" Root="_activeNode" OnClose="ClosePopover"
                          InSplit="@(_splitOpen && _isHost)" OnNavigateWorldInSplit="NavigateWorldInSplit" PaneAnchor="@(_splitOpen ? "reader" : null)"
                          VerseAnchorSelector="@(_xrefEntryVerse is int xv ? $"#v{xv}" : null)" ShowBackdrop="!_hoverOnlyOpen"
                          OnPanelPointerEnter="CancelHoverClose" OnPanelPointerLeave="OnPanelPointerLeaveHoverGuard" />
    }
</div>

@code {
    private static readonly Regex VerseFragment = new(@"^#v(\d+)$", RegexOptions.Compiled);

    [Parameter] public string? Book { get; set; }
    [Parameter] public int? Chapter { get; set; }

    // Batch VC-1 (R1/R3): null = self-determine my role from the shared
    // ViewArrangement atom -- true whenever I am ROUTED to directly (the
    // common case: standalone /read/... or hosting a reader+world split,
    // exactly today's behavior). Explicit (true, with IsHost below) is how
    // ViewRegistrySetup's own mount closure tells THIS instance it is being
    // mounted as a GUEST (e.g. sources+reader, R4's proof) -- a routed
    // instance never receives this parameter at all (Blazor's router only
    // ever feeds route/query parameters), so the null branch is exactly the
    // pre-VC-1 self-determined path, byte-unchanged in shape.
    [Parameter] public bool? SplitMode { get; set; }

    // Meaningful only while SplitMode is explicit (guest-mounted) -- always
    // false there (a guest is never a host); ignored when SplitMode is null
    // (self-determined mounts are always host -- Reader.razor is never
    // ROUTED as anyone's guest).
    [Parameter] public bool IsHost { get; set; }

    // The generic "close ME" callback CompositionHost wires when mounting
    // this instance as a guest -- dispatches CloseGuest on the shared atom.
    // Unused (EventCallback.Empty) when self-determined/host, since the
    // host's own self-close (CloseReaderPane) never needs it.
    [Parameter] public EventCallback OnRequestClose { get; set; }

    // Batch H (split-view study): "Read beside the map" (World.razor)
    // navigates here with ?split=1 so the two entry points ("Open the map
    // beside the text" here, "Read beside the map" there) land in the SAME
    // split layout, per the brief -- read once, on arrival, by
    // OnParametersSetAsync (_splitQueryConsumed guards that so a LATER,
    // unrelated OnParametersSetAsync call -- e.g. a plain chapter nav that
    // happens to leave a stale ?split=1 sitting in the URL, see this
    // param's own consumption site for the full reasoning -- can never
    // reopen a split the user already explicitly closed).
    [SupplyParameterFromQuery(Name = "split")]
    [Parameter]
    public string? SplitQuery { get; set; }

    // Batch H: local, in-memory split-open state -- NOT query/route driven
    // beyond the one-shot SplitQuery arrival above. Reader.razor is reused
    // (never recreated) across ordinary chapter-to-chapter navigation (see
    // ComputeAdjacent's own plain /read/... links), so this field -- and
    // therefore an open split -- survives that navigation for free. Batch
    // ST-1: World.razor now reacts to the shared Locus atom directly
    // (LocusAtom.Changed), not a re-rendered FollowRef parameter, so this
    // continues to need no extra plumbing on Reader's own side either.
    // Reader.razor is the split's ONLY ever host/orchestrator (World.razor
    // is always the embedded guest, never the other way around -- see
    // World.razor's own OnRequestClose param and the batch report's layout
    // section for why).
    //
    // Batch ST-2 (R4/R6): no longer an independent field -- a pure
    // projection of the shared ViewArrangement atom. Batch VC-1: reads the
    // SplitMode PARAMETER when explicitly supplied (guest-mounted), else
    // self-determines from the atom exactly as ST-2 shipped it (routed
    // host/standalone) -- "cannot desync because there's nothing to desync
    // FROM" still holds either way, just from two different sources
    // depending on which role this instance is playing.
    private bool _splitOpen => SplitMode ?? (ViewArrangementAtom.Value is { LayoutKind: LayoutKinds.SplitH } a && a.Members.Count > 0 && a.Members[0] == ViewNames.Reader);

    // Batch VC-1: true for every self-determined (routed) mount -- Reader is
    // never routed as anyone's guest -- and for an explicit guest-mount only
    // when IsHost was itself explicitly true (not reachable in this batch's
    // own registrations, kept general rather than assumed-impossible).
    private bool _isHost => SplitMode is null || IsHost;

    // Batch VC-1: .split-pane-reader (the sizing class) applies HERE only
    // while hosting -- this div is the true flex ITEM of the outer wrapper
    // (itself the flex container) in that case. While GUEST-mounted, the
    // OUTER wrapper div is the flex item instead (see its own comment,
    // markup above) -- this inner div stays a plain "reader-page", filling
    // that outer div's own natural content flow.
    private string ReaderPaneClass => _splitOpen && _isHost ? "reader-page split-pane-reader" : "reader-page";

    private bool _splitQueryConsumed;

    // Batch VC-1: the local CompositionHost this instance embeds while
    // hosting (see the markup above) -- @ref gives access to its own
    // NavigateGuestInSplit for the generalized "no nested-popup rule"
    // (NavigateWorldInSplit below). Null while !(_splitOpen && _isHost) --
    // CompositionHost isn't in the DOM at all then.
    private CompositionHost? _compositionHost;

    // M-D3/B2: the reader pane's own drag-adjustable width (SplitDivider.razor),
    // read by the outer wrapper's own --split-reader-width custom property
    // (app.css's own .split-pane-reader rule reads it via var()) -- a plain
    // field, not ViewStateService, for the SAME "Reader.razor is reused
    // across chapter navigation, so a plain field already survives it for
    // free" reasoning _splitOpen's own comment above gives; also matches
    // _splitOpen's own persistence TIER (session-local, resets on a fresh
    // page load) rather than reaching for cross-session persistence nothing
    // else about split-view has either. 704px matches this app's own
    // pre-existing 55%-of-1280px default look (a common real viewport
    // width) closely enough that a first-ever split-open, before any drag,
    // is visually indistinguishable from the static split this batch
    // replaces -- see SplitDivider.razor's own header comment for the full
    // mechanism this value now feeds.
    private double _splitReaderWidthPx = 704;

    // Fix round 1 (S-3/Q-2/Adjudication C): guards RestoreDividerWidthFromAtom
    // (OnAfterRenderAsync below) to at most once per split-open transition --
    // set true the moment a restore attempt is made (success or fail-soft
    // failure, either way there is nothing left to retry against THIS
    // opening), reset false the moment _splitOpen goes false again so a
    // LATER reopen gets its own fresh attempt.
    private bool _dividerRestoreAttempted;

    private List<BookTocEntry>? _toc;

    // Batch ST-1 (SYNC-1 fix): _book/_chapterNum are now THIN READS of the
    // shared Locus atom (client/State/Locus.cs), never independently
    // assigned -- Reader.razor is this app's ONE writer of Locus (every
    // chapter-navigation path -- picker Apply, reader-prev/next, deep
    // links, "read in context" hatches -- already funnels through
    // OnParametersSetAsync below, the single choke point that now
    // dispatches SetLocus instead of assigning these directly). _locus
    // wraps LocusAtom in a real Projection<Locus> (rather than reading
    // LocusAtom.Value directly) so this page's own reads go through the
    // SAME IProjection<T> seam the compiled contract declares for
    // consumers -- see client/State/Projection.cs's own header comment.
    //
    // Fix round 1 (Q-6, trivia): a lazy property over a nullable backing
    // field, not `null!`-then-assigned-in-OnInitializedAsync -- LocusAtom
    // is available the instant DI injection completes, so first access is
    // safe regardless of exactly which lifecycle method triggers it,
    // rather than depending on "OnInitializedAsync's own synchronous
    // prefix runs before the first render" (see World.razor's matching
    // field for the fuller reasoning).
    private Projection<Locus>? _locusBacking;
    private Projection<Locus> _locus => _locusBacking ??= new Projection<Locus>(LocusAtom);
    private string _book => _locus.Value.Book;
    private int _chapterNum => _locus.Value.Chapter;
    private ChapterOut? _chapter;
    private string? _loadedBook;
    private int? _loadedChapterNum;
    private string? _errorMessage;
    private IExplorable? _activeNode;

    // Passage selection (READ-5/Task 15). _anchorVerse is the last PLAIN
    // click (never a shift-click); it stays fixed across repeated shift-
    // clicks against different verses (standard shift-click UX: the anchor
    // only moves on a fresh plain click), so it's a real int? field, not
    // just "whatever OpenVerse last touched". _passageRange is null unless
    // a shift-click just formed a real range (V1<=V2, canonical order
    // regardless of click direction -- see OnVerseNumClick).
    private int? _anchorVerse;
    private (int From, int To)? _passageRange;

    private int _requestId;
    private string? _scrolledFragment;
    private IJSObjectReference? _readerJs;

    // Batch H (view-state round-trip): guards the ViewState.Reader scroll
    // restore (OnAfterRenderAsync below) to at most ONCE per component
    // INSTANCE -- the first chapter this instance ever renders, never a
    // LATER in-session chapter navigation (this component is reused, not
    // recreated, across those -- see _splitOpen's own comment). Without
    // this, returning (in-session) to a chapter that happens to numerically
    // match whatever ViewState.Reader.Book/Chapter was left over from a
    // PRIOR, unrelated visit could restore a stale, unrelated scroll
    // position instead of that chapter's own natural top.
    private bool _scrollRestoreAttempted;

    // Backdrop-inertness while Shift is held (fix round 1) -- see the
    // wrapper div's own comment above and OnPageKeyDown/OnPageKeyUp below.
    // _selfRef is only ever used for reader.js's watchShiftRelease ->
    // ResetShiftHeld bridge (the window-blur/tab-hidden safety net); never
    // passed anywhere else.
    private bool _shiftHeld;
    private DotNetObjectReference<Reader>? _selfRef;

    private string BookName => _toc?.FirstOrDefault(b => b.Code == _book)?.Name ?? _book;

    // Batch ST-1: CurrentRef (the split host's own current chapter ref,
    // "GEN.12") is GONE -- it existed only to feed World.razor's own
    // FollowRef parameter, now retired (see the <World> tag's own comment
    // above). World reads the shared Locus atom directly for the identical
    // information, no longer needing Reader to compute/push it.

    // ExplorerPopover.OnNavigateWorldInSplit ("no nested-popup rule"): a
    // popover chip that would otherwise open a second full /world instead
    // hands its query straight to the ALREADY-EMBEDDED atlas pane, in
    // place. Batch VC-1: generalized through CompositionHost's own
    // NavigateGuestInSplit (a delegate handoff, not a typed @ref to World
    // specifically -- see that component's own header) -- _compositionHost
    // is null only in the impossible case this callback fires while
    // !(_splitOpen && _isHost) (InSplit gates ExplorerPopover's own choice
    // to invoke this at all) or before CompositionHost's own @ref has
    // landed; the null-coalesce is pure defensive belt-and-suspenders, not
    // an expected path.
    private Task NavigateWorldInSplit(string query) => _compositionHost?.NavigateGuestInSplit(query) ?? Task.CompletedTask;

    // Batch VC-1 (R4): "Open the map beside the text" is now an invocation
    // of Reader's own declared enter-split hatch (ViewRegistry, Kind
    // "enter-split") -- see EnterSplitHatch/ViewRegistrySetup for the
    // (dispatch EnterSplit + sync ?split=1) behavior this replaces,
    // byte-identical to pre-VC-1's own OpenSplit.
    private Task InvokeEnterSplitHatch() =>
        Registry.Get(ViewNames.Reader).EscapeHatches.First(h => h.Kind == HatchKinds.EnterSplit).Invoke();

    // split-close-reader ("close the reader pane -> full /world" per the
    // brief). A bare navigate -- the atlas pane's own CURRENT position
    // (follow ref/window/camera) is captured into ViewState.Map by its own
    // DisposeAsync as part of THIS navigation tearing it down, and the
    // fresh standalone World instance that mounts at /world reads it
    // straight back (RestoreMapState) -- the same view-state round-trip
    // machinery already does the work; this method doesn't need to know
    // the atlas's own current state at all.
    private void CloseReaderPane() => Nav.NavigateTo("/world");

    // Batch F2 requirement 6c ("if i am in split screen mode and refresh,
    // the split screen mode shalt not be ceased on account of refresh"):
    // both split entry points now keep the URL's own ?split=1 continuously
    // in sync with _splitOpen -- the HOUSE PATTERN this app already uses
    // everywhere state must survive a dispose+mount navigation (sync
    // continuously AT THE POINT OF MUTATION, never captured lazily/at
    // dispose time -- ViewStateService.SyncViewState/World.razor's
    // OnCameraChanged/reader.js's watchScroll are the existing models).
    // OpenSplit is the reader's OWN "Open the map beside the text" entry
    // point (World.razor's OWN "Read beside the map" already builds
    // ?split=1 into its target URL directly -- see OpenReadBesideMap there
    // -- so it needs no equivalent change). CloseSplitAtlas is the embedded
    // atlas pane's own close button (World.razor's split-close-atlas,
    // wired via OnRequestClose) -- "closing the split cleans the param."
    // Batch ST-2 (R4): dispatches EnterSplit instead of a direct field write
    // -- _splitOpen is now a projection (see its own comment). DefaultFollow
    // sources from ViewState.Map.Follow, the SAME restoration pattern
    // World.RestoreMapState already uses for TimeWindow (ViewStateService
    // remains the PERSISTENCE layer beneath the atom -- see EnterSplit's own
    // doc comment) -- preserves a same-session "last explicit Follow choice"
    // across a close/reopen, matching this app's pre-ST-2 behavior exactly
    // (ViewState.Map.Follow is written continuously by World.SyncViewState
    // whenever Follow -- itself now an atom projection there too -- changes,
    // so this read is always the last live value, never stale). Only takes
    // effect if the atom is NOT already Split (EnterSplit's own Apply is a
    // no-op otherwise, preserving whatever's already there).
    //
    // Fix round 1 (Adjudication C, S-3/Q-2): DividerFraction's own
    // cross-remount survival mechanism -- unchanged, see ViewArrangement.cs's
    // own EnterSplit doc comment.
    //
    // Batch VC-1: OpenSplit/CloseSplitAtlas (the pre-VC-1 direct dispatch
    // methods) are RETIRED as separate methods -- OpenSplit's own body lives
    // on now as EnterSplitReaderHostsWorld inside ViewRegistrySetup (invoked
    // via InvokeEnterSplitHatch above); CloseSplitAtlas's own job (dispatch
    // + SyncSplitUrl) is now the generic OnRequestClose wiring CompositionHost
    // supplies to the GUEST it mounts, PLUS the resync below -- moved onto
    // OnViewArrangementChanged so it fires no matter WHICH dispatch site
    // changed the arrangement (this batch adds a second one: the guest's own
    // CloseGuest dispatch, which this page never calls directly).
    //
    // A query-string-only navigation (book/chapter route params unchanged)
    // -- OnParametersSetAsync's own book/chapterNum-unchanged early-return
    // means this never re-fetches the chapter or disturbs scroll/popover
    // state; SplitQuery's own one-shot consumption (_splitQueryConsumed) is
    // already spent for this instance by the time either dispatch site
    // above ever runs, so this is the ONLY thing that keeps the URL
    // truthful about _splitOpen from here on. replace:true -- a pure state
    // reflection, not a new history entry to back-button through. A no-op
    // (SplitMode explicit, i.e. guest-mounted -- e.g. sources+reader) never
    // touches the URL at all, since Reader-as-guest owns no route/query of
    // its own to keep in sync.
    private void SyncSplitUrl()
    {
        if (SplitMode is not null)
        {
            return; // guest-mounted -- no route/query of my own to keep in sync (see this method's own comment)
        }

        var uri = Nav.GetUriWithQueryParameters(new Dictionary<string, object?> { ["split"] = _splitOpen ? "1" : null });
        Nav.NavigateTo(uri, replace: true);
    }

    // Batch ST-2 (R4): SplitDivider's own OnCommitted callback -- fires ONCE
    // per completed gesture (drag-end or a keyboard nudge), never a live drag
    // frame ("DividerFraction commits on drag END only"). _splitReaderWidthPx
    // -- the ACTUAL render source for the divider's pixel position, UNCHANGED
    // since before this batch -- is updated unconditionally; the atom (and,
    // fix round 1, ViewState.Map.DividerFraction) only receive the fraction
    // when SplitDivider's own measurement succeeded (Fraction is null on a
    // failed/unavailable measurement -- same fail-soft spirit
    // SplitDivider's own EnsureMaxWidthAsync already uses elsewhere).
    //
    // Fix round 1 (S-3/Q-2/Adjudication C, review): DividerFraction is no
    // longer write-only. ViewState.Map.DividerFraction is written here (the
    // SAME persistence-beneath-the-atom role MapViewState.Follow already
    // plays) so a FRESH EnterSplit dispatch (OpenSplit/the SplitQuery block)
    // can seed a brand-new Split arm with it, and RestoreDividerWidthFromAtom
    // (OnAfterRenderAsync below) reads the atom's own Split.DividerFraction
    // back into _splitReaderWidthPx on every split-open transition -- see
    // that method's own comment for the cross-remount mechanism this now
    // genuinely supports.
    private void OnDividerCommitted((double WidthPx, double? Fraction) result)
    {
        _splitReaderWidthPx = result.WidthPx;
        if (result.Fraction is { } fraction)
        {
            ViewArrangementAtom.Dispatch(new SetDivider(fraction));
            ViewState.Map.DividerFraction = fraction;
        }
    }

    // Fix round 1 (S-3/Q-2/Adjudication C, review -- "the requirement was
    // weakened, not met"): the read side of DividerFraction. Called once per
    // split-open transition, from OnAfterRenderAsync, specifically AFTER the
    // render that applies `.split-view`'s own CSS class has already
    // committed -- `.split-view`'s measurable content-box width does not
    // exist before that, so this cannot run any earlier in the lifecycle
    // (the same reason SplitDivider's own EnsureMaxWidthAsync only ever
    // measures on a real pointerdown/keydown, never at construction).
    // Measures via the SAME `getPaneRect` reader.js already exports for
    // SplitDivider's own use, fails soft to whatever _splitReaderWidthPx
    // already holds on a failed/unavailable measurement -- the identical
    // stance EnsureMaxWidthAsync takes.
    private async Task RestoreDividerWidthFromAtom(double fraction)
    {
        try
        {
            var rect = await _readerJs!.InvokeAsync<PaneRectDto?>("getPaneRect", ".split-view");
            if (rect is { Width: > 0 } r)
            {
                // A light sanity floor (not SplitDivider's own precise
                // MinWidthPx/DividerWidthPx constants, which are private to
                // that component) -- good enough for an INITIAL restore; the
                // very next real drag/nudge re-clamps to the exact bounds
                // via SplitDivider's own EnsureMaxWidthAsync regardless.
                _splitReaderWidthPx = Math.Clamp(fraction * r.Width, 200, r.Width - 200);
                StateHasChanged();
            }
        }
        catch (Exception)
        {
            // Fail soft -- keep whatever _splitReaderWidthPx already holds
            // (the untouched local field from a same-instance reopen, or the
            // 704px default on a genuine cross-remount), same graceful-
            // degrade spirit SplitDivider's own EnsureMaxWidthAsync uses.
        }
    }

    // reader.js's own getPaneRect return shape -- a second, independently-
    // declared copy of SplitDivider.razor's own private PaneRectDto (that
    // one is file-scoped private too, so this file needs its own -- same
    // "one shape, many callers, no shared type" precedent SplitDivider's own
    // header comment already establishes for ExplorerPopover's analogous
    // VerseAnchorRectDto/PaneRectDto pair).
    private sealed record PaneRectDto(double Left, double Top, double Width, double Height);

    // reader-prev/reader-next (Batch R requirement 6/HOTFIX NAV-4) -- their
    // own hrefs are plain <a> tags (Blazor's router intercepts same-origin
    // clicks on them client-side, see this component's own file header:
    // "Reader.razor is REUSED, not recreated, across an ordinary chapter-
    // to-chapter navigation"), so keeping split open across chapter nav
    // (SPLIT-1's own promise) requires THIS href to already carry ?split=1
    // when a split is open -- otherwise the URL silently drops it on the
    // very next chapter turn, and a refresh right after would lose split
    // state even though _splitOpen itself is still (correctly) true.
    // Batch VC-1: guarded on _isHost too -- a guest-mounted instance
    // (sources+reader) has no ?split=1 of its own to propagate; prev/next
    // there is a plain chapter link, disclosed to leave the sources+reader
    // split (navigating to standalone /read/...) rather than trying to keep
    // an arrangement its own route knows nothing about alive across a real
    // navigation.
    private string ChapterHref(string book, int chapter) => _splitOpen && _isHost ? $"/read/{book}/{chapter}?split=1" : $"/read/{book}/{chapter}";

    // Fix round 1 finding: _book/_chapterNum are updated to the NEW route's
    // values SYNCHRONOUSLY in OnParametersSetAsync, before LoadChapter's
    // await resolves -- Blazor renders once in between (the intermediate
    // render any non-synchronously-completing lifecycle await triggers),
    // and at THAT render _chapter still holds the PREVIOUS chapter's data.
    // Gating on "_chapter is not null" alone let that intermediate render
    // show the new heading over the old chapter's verse rows, and let
    // OnAfterRenderAsync try to scroll a fragment against the wrong
    // chapter's DOM (silently consuming _scrolledFragment so the real
    // scroll, once the correct chapter finally renders, was suppressed).
    //
    // _loadedBook/_loadedChapterNum (below) are stamped by LoadChapter
    // itself at the exact moment it assigns _chapter, from the SAME _book/
    // _chapterNum values that drove that fetch -- NOT from ChapterOut's own
    // Book field, which turns out to be the book's display NAME ("Genesis"),
    // not its canonical code ("GEN"); comparing that against _book would
    // never match and would wedge the page on "Loading..." forever (caught
    // by hand-testing this fix, not by READ-1..3, which never deep-link
    // into a chapter fast enough to observe the intermediate render).
    private bool ChapterMatchesRoute =>
        _chapter is not null && _loadedBook == _book && _loadedChapterNum == _chapterNum;

    protected override async Task OnInitializedAsync()
    {
        // Fix round 1 (Q-3, Important -- review): _splitOpen is a LIVE read
        // of ViewArrangementAtom.Value, but until this fix Reader never
        // subscribed to its own Changed event -- correct today only because
        // every arrangement change Reader itself must re-render for
        // originates in Reader's OWN event handlers (OpenSplit/
        // CloseSplitAtlas/the SplitQuery block), which Blazor already
        // re-renders after. The moment a LATER batch dispatches an
        // arrangement change from anywhere else (World's own
        // OpenReadBesideMap not dispatching at all today is exactly the
        // kind of asymmetry that makes this fragile), the split host would
        // silently stop re-rendering. Subscribed symmetrically with World.razor
        // now -- unsubscribed in DisposeAsync below.
        ViewArrangementAtom.Changed += OnViewArrangementChanged;

        try
        {
            _toc = await Atlas.Books();
        }
        catch (Exception)
        {
            _errorMessage = "Couldn't load the book list — check your connection and try again.";
        }
    }

    // Fix round 1 (Q-3): a plain re-render -- Reader has no side effect of
    // its own to run here (unlike World's OWN ViewArrangementAtom.Changed
    // subscriber, OnViewArrangementChanged, which also drives the
    // SyncToken/follow re-sync -- that stays World's job).
    //
    // Batch VC-1: NOW also resyncs the URL (SyncSplitUrl, a no-op when
    // guest-mounted) -- moved here from the individual OpenSplit/
    // CloseSplitAtlas dispatch sites (both retired) so the URL stays
    // truthful regardless of WHICH dispatch site changed the arrangement,
    // including the new one this batch adds: a guest's own CloseGuest
    // dispatch, which this page never calls directly (it is wired as the
    // GUEST's own OnRequestClose, not Reader's).
    private void OnViewArrangementChanged()
    {
        SyncSplitUrl();
        StateHasChanged();
    }

    // Runs on every navigation, including the very first one -- book/chapter
    // change (a genuinely new chapter, refetch + close any open popover) is
    // distinguished from a fragment-only change (e.g. the picker jumping to
    // a different verse anchor within the SAME chapter, or a re-render with
    // unchanged route params) which must NOT redundantly refetch or drop an
    // open popover. Checking _loadedBook/_loadedChapterNum here (not just
    // "_chapter is not null") matters for a case adjacent to fix round 1's
    // finding 1: if a fetch for this exact target previously FAILED,
    // _chapter still holds whatever chapter loaded before that (non-null,
    // but stale/mismatched) -- re-navigating to the same failed target must
    // still retry the fetch, not silently no-op because SOME chapter
    // happens to be loaded.
    protected override async Task OnParametersSetAsync()
    {
        string book;
        int chapterNum;

        // Batch VC-1: this whole route-reactive branch only applies to a
        // SELF-DETERMINED mount (SplitMode is null -- standalone /read/...
        // or hosting a reader+world split, ROUTED here by Blazor's own
        // router). A guest-mounted instance (SplitMode explicit -- e.g.
        // sources+reader, R4's proof) has no Book/Chapter route parameters
        // at all (nothing routed it) and MUST NOT touch Locus -- it renders
        // whatever the shared atom already holds, exactly like World already
        // does for an embedded pane (see the else-branch below).
        if (SplitMode is null)
        {
            // Batch H: consumed exactly once per component instance (never
            // re-applied on a later, unrelated OnParametersSetAsync call) --
            // World.razor's own "Read beside the map" link is the only writer
            // of ?split=1, and only on the FIRST navigation TO this instance;
            // the guard means a user who explicitly closes split (leaving the
            // stale query key sitting in an unchanged URL, since closing is a
            // local field flip, not a Nav.NavigateTo -- see the split-close-atlas
            // button's own handler) can never have it silently reopened by some
            // later, unrelated re-render.
            if (!_splitQueryConsumed)
            {
                _splitQueryConsumed = true;

                // Batch ST-2 (R4): asserts this fresh Reader.razor instance's own
                // arrangement, always -- not just on the ?split=1 case -- so the
                // atom correctly reflects reality regardless of whatever
                // arrangement a PRIOR instance/page this session left it in (the
                // standalone counterpart to this is World.OnParametersSetAsync's
                // own EnterWorldOnly/EnterSingle dispatch). Batch VC-1: the
                // EnterSplit(host,guest) shape replaces ST-2's own single-arg
                // EnterSplit -- reader/world, positionally, exactly as OpenSplit's
                // own retired body always dispatched.
                ViewArrangementAtom.Dispatch(SplitQuery == "1"
                    ? new EnterSplit(ViewNames.Reader, ViewNames.World, ViewState.Map.Follow, ViewState.Map.DividerFraction)
                    : new EnterSingle(ViewNames.Reader));
            }

            book = string.IsNullOrWhiteSpace(Book) ? "GEN" : Book.ToUpperInvariant();
            chapterNum = Chapter ?? 1;
        }
        else
        {
            book = _book;
            chapterNum = _chapterNum;
        }

        // Chip-clearing rule: this component's own design choice (NOT a
        // verbatim quote from the Task 15 brief or design-direction.md --
        // the brief's actual, verbatim note on this interplay is quoted
        // below, at OnVerseNumClick) is that a new anchor or a navigation
        // each clear the chip. A new anchor is handled in SetAnchorAndOpen
        // (_passageRange = null there). Navigating is handled here:
        // OnParametersSetAsync only ever runs in response to a genuine
        // navigation the router dispatched to this page (initial load, or
        // any URL change matching this route, including a same-chapter
        // fragment-only jump from the picker), never from an unrelated
        // StateHasChanged elsewhere -- so unconditionally resetting here,
        // before the redundant-refetch guard below, clears the chip on
        // every kind of navigation, not only ones that also change chapter.
        _anchorVerse = null;
        _passageRange = null;

        if (book == _book && chapterNum == _chapterNum && _loadedBook == book && _loadedChapterNum == chapterNum)
        {
            return;
        }

        // Batch ST-1 (SYNC-1 fix): the ONE choke point that used to assign
        // _book/_chapterNum directly now dispatches SetLocus onto the
        // shared atom instead -- _book/_chapterNum (above) are thin reads
        // of it, so this single Dispatch is the whole migration for every
        // navigation path that lands here (picker Apply's own NavigateTo,
        // reader-prev/next, deep links, "read in context" hatches -- see
        // the batch report's own divergent-copy retirement table). Origin
        // left null: this IS the user-originated write (there is no link
        // deriving Locus FROM anything -- Locus is this app's one leaf
        // atom no other atom ever drives). Batch VC-1: skipped for a
        // guest-mounted instance (SplitMode explicit) -- book/chapterNum
        // there are ALREADY read straight off Locus above, so a dispatch
        // would be a redundant, always-no-op write at best.
        if (SplitMode is null)
        {
            LocusAtom.Dispatch(new SetLocus(book, chapterNum));
        }

        // M-D3/U6: this Reader.razor instance is now actively showing
        // exactly this chapter -- see ViewStateService.MountedReaderChapter's
        // own doc comment for why this is deliberately separate from
        // ViewState.Reader (below, a couple hundred lines down) and cleared
        // in DisposeAsync.
        ViewState.MountedReaderChapter = (_book, _chapterNum);
        ResetXrefEntryState();
        _activeNode = null;
        _scrolledFragment = null;
        await LoadChapter();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _readerJs = await JS.InvokeAsync<IJSObjectReference>("import", "./js/reader.js");

            // Fix round 1: Blazor has no binding for window.blur/
            // document.visibilitychange (releasing Shift while this
            // tab/window isn't focused never fires a DOM keyup ON THIS
            // PAGE at all), so this tiny JS-side watcher exists purely to
            // guarantee _shiftHeld can't get stuck true -- see reader.js's
            // own comment. _selfRef is disposed in DisposeAsync below.
            _selfRef = DotNetObjectReference.Create(this);
            await _readerJs.InvokeVoidAsync("watchShiftRelease", _selfRef);

            // Batch H (view-state round-trip): continuously reports scroll
            // position into ViewState.Reader (OnScroll below) -- NOT a
            // dispose-time read. See reader.js's own watchScroll comment
            // for the real, confirmed race a dispose-time read loses to
            // (Blazor's own router resets window scroll on navigation
            // before DisposeAsync ever runs).
            await _readerJs.InvokeVoidAsync("watchScroll", _selfRef);

            // Batch R requirement 6 (chapter nav always visible, middle-
            // aligned, even as i scroll): see reader.js's own
            // watchChapterNavCenter comment for why this needs a JS-side
            // listener at all (a plain CSS `top` value can't, by itself,
            // stay viewport-centered through `.reader-page`'s own
            // pre-existing `contain: layout` containing-block substitution).
            await _readerJs.InvokeVoidAsync("watchChapterNavCenter");
        }

        // Fix round 1 (S-3/Q-2/Adjudication C, review): restores
        // _splitReaderWidthPx from the atom's own Split.DividerFraction, once
        // per split-open transition -- see RestoreDividerWidthFromAtom's own
        // comment for the full mechanism and why this specifically closes
        // the "cross-remount" gap the review found (DividerFraction was
        // write-only before this round). Independent of ChapterMatchesRoute
        // -- this has nothing to do with which chapter loaded.
        if (_splitOpen && _isHost && !_dividerRestoreAttempted && _readerJs is not null)
        {
            _dividerRestoreAttempted = true;
            if (ViewArrangementAtom.Value is { LayoutKind: LayoutKinds.SplitH, DividerFraction: { } fraction })
            {
                await RestoreDividerWidthFromAtom(fraction);
            }
        }
        else if (!_splitOpen)
        {
            _dividerRestoreAttempted = false;
        }

        if (!ChapterMatchesRoute || _readerJs is null)
        {
            return;
        }

        var fragment = new Uri(Nav.Uri).Fragment;
        if (fragment == _scrolledFragment)
        {
            return;
        }

        _scrolledFragment = fragment;
        var m = VerseFragment.Match(fragment);
        if (m.Success)
        {
            await _readerJs.InvokeVoidAsync("scrollToVerse", int.Parse(m.Groups[1].Value));
        }
        else if (!_scrollRestoreAttempted)
        {
            // Batch H (view-state round-trip): no verse fragment driving
            // scroll this navigation -- see _scrollRestoreAttempted's own
            // comment for why this only ever runs once per component
            // instance. Only restores when genuinely RETURNING to the exact
            // chapter last left (Book AND Chapter both match) -- landing on
            // a DIFFERENT chapter (HasData true but a mismatch) correctly
            // falls through to no special scroll at all, an ordinary
            // top-of-page start like any other fresh navigation.
            _scrollRestoreAttempted = true;
            if (ViewState.Reader.HasData && ViewState.Reader.Book == _book && ViewState.Reader.Chapter == _chapterNum)
            {
                await _readerJs.InvokeVoidAsync("setScrollY", ViewState.Reader.ScrollY);
            }
        }
    }

    private async Task LoadChapter()
    {
        var myRequest = ++_requestId;
        try
        {
            var chapter = await Atlas.Chapter(_book, _chapterNum);
            if (myRequest != _requestId)
            {
                return; // superseded by a newer navigation -- discard this stale response
            }

            // myRequest == _requestId here guarantees no newer navigation has
            // started since this fetch began (that would have changed _book/
            // _chapterNum AND bumped _requestId again) -- so the CURRENT
            // values of _book/_chapterNum are exactly what this fetch was for.
            _chapter = chapter;
            _loadedBook = _book;
            _loadedChapterNum = _chapterNum;
            _errorMessage = null;
        }
        catch (Exception)
        {
            if (myRequest != _requestId)
            {
                return;
            }

            _errorMessage = $"Couldn't load {_book} {_chapterNum} — check your connection and try again.";
        }
    }

    // Batch M-D4: the ONE handler every VerseLine/MentionText/
    // PericopeHeading instance in this page's own chapter body calls via
    // its shared OnExplore parameter -- REPLACES the pre-M-D4 OpenVerse/
    // OpenEvent/OpenPlaceMention/OpenPersonMention quartet, which were four
    // near-identical bodies (reset xref-entry state, then assign a
    // differently-typed node to _activeNode) differing only in WHICH
    // IExplorable each one constructed; that construction now lives in the
    // component that already owns the data to build its own node
    // (VerseLine's own VerseNode, MentionText's own PlaceNode/PersonNode,
    // PericopeHeading's own EventNode), so this page only needs the ONE
    // shape every one of them shares. M-D3 (R3)'s own reasoning for the
    // reset is unchanged: an ordinary explore is never verse-anchored or
    // hover-dismissible (see the <ExplorerPopover> tag's own comment); a
    // stale value here would otherwise wrongly verse-anchor (or auto-close)
    // a DIFFERENT, unrelated popover opened right after a superscript one.
    private void OnLineExplore(IExplorable node)
    {
        ResetXrefEntryState();
        _activeNode = node;
    }

    // Batch G2 decision 6: VerseLine's own Ctrl/Cmd-click gesture -- never
    // touches _activeNode/ResetXrefEntryState (no popover opens; the plain-
    // click path above is completely untouched by this branch existing).
    // Batch ST-3 (R2): dispatches directly onto the shared Selection atom --
    // SelectionTrayService no longer exposes a Toggle method (see that
    // file's own updated header).
    private void OnLineToggleSelect(VerseNode node) => SelectionAtom.Dispatch(new ToggleSelection(ExplorationDescriptor.Capture(node)));

    // Shared by every popover-opening method that is NOT a superscript
    // entry point (OnLineExplore/OpenChapter/OpenPassage/ClosePopover) --
    // one place, so a future new entry point can't forget this the way a
    // hand-copied three-line reset at each call site risks.
    private void ResetXrefEntryState()
    {
        _xrefEntryVerse = null;
        _hoverOnlyOpen = false;
        CancelHoverCloseTimer();
    }

    // Batch M-D2's own owner-specified lettering scheme (i/j/k, >3 -> the
    // many-marker) now lives in VerseLine.razor -- shared by both containers
    // instead of this page's own private copy; see that component's own
    // header comment.

    // Batch M-D2: the superscript's own entry point into THE composable
    // popover (owner decree, never a parallel interface) -- constructs the
    // SAME VerseNode a plain verse-line click does (OnLineExplore/
    // VerseLine.razor), just with XrefEntryPoint=true (a parameter on the
    // one abstraction; see that class's own doc comment).
    // Guarded against a redundant remount: ExplorerPopover is keyed by
    // `_activeNode` itself (Reader.razor's own <ExplorerPopover @key=...>),
    // and VerseNode has no value equality (a plain class), so reassigning
    // to a FRESH instance naming the SAME verse -- e.g. re-entering the
    // marker that's already driving the open popover, or focus firing right
    // after a click already did -- would otherwise tear down and rebuild
    // the whole popover (losing scroll position, re-fetching) for no actual
    // change; this no-ops instead, same as any other idempotent open.
    //
    // M-D3 (R3): also stamps _xrefEntryVerse (the ExplorerPopover's own
    // VerseAnchorSelector source, see that tag's own comment) -- unlike
    // XrefEntryPoint (a property ON the pushed VerseNode, so it survives
    // exactly as long as THAT node is Current, per XrefEntryPoint's own
    // "the emphasis correctly does not propagate past the one hop that
    // opened it" rule), _xrefEntryVerse is Reader.razor's OWN field: it
    // must stay stable for the WHOLE popover session (verse-anchoring a
    // drill-in two hops deep, e.g. an xref target's own further xref,
    // would anchor over a DIFFERENT verse than the one still on screen,
    // which is wrong) -- so only the methods that OPEN a fresh popover
    // touch it; PushAsync/Back never do.
    private int? _xrefEntryVerse;

    private void OpenVerseXrefEntry(int verseNum, bool persistent)
    {
        var vref = $"{_book}.{_chapterNum}.{verseNum}";
        _xrefEntryVerse = verseNum;
        if (_activeNode is VerseNode { XrefEntryPoint: true } current && current.Title == vref)
        {
            if (persistent)
            {
                _hoverOnlyOpen = false;
                CancelHoverCloseTimer();
            }
            return;
        }

        _activeNode = new VerseNode(vref, xrefEntryPoint: true);
        _hoverOnlyOpen = !persistent;
        CancelHoverCloseTimer();
    }

    // A click or keyboard focus -- "click AND hover both open it," but only
    // THIS path (plus keyboard focus, below) makes the popover PERSISTENT:
    // same dismiss contract as every other popover in this app (backdrop
    // click / Escape / the close button), never an implicit mouseleave.
    private void OpenVerseXrefEntryPersistent(int verseNum) => OpenVerseXrefEntry(verseNum, persistent: true);

    // A genuine mouse hover, and ONLY a hover -- eligible for the auto-
    // dismiss grace period OnXrefMarkerPointerLeave/CancelHoverClose below
    // schedule/cancel. See FeatureFlags.XrefSuperscripts's own doc comment
    // for the owner's exact complaint this exists to fix ("a hover menu
    // that i have to x out of comes up automatically").
    private void OpenVerseXrefEntryHover(int verseNum) => OpenVerseXrefEntry(verseNum, persistent: false);

    // M-D3 (R3): "no auto-modal that must be X'd out" -- true for exactly
    // as long as the CURRENT popover was opened by a mouse hover and has
    // NOT since been made persistent by a click or keyboard focus
    // (OpenVerseXrefEntry's own `persistent` branch clears this the instant
    // either fires, even on an idempotent re-open of the same verse).
    private bool _hoverOnlyOpen;

    // Debounces the auto-dismiss so moving the pointer FROM the marker
    // THROUGH the gap INTO the popover panel (ExplorerPopover's own
    // OnPanelPointerEnter, wired to CancelHoverCloseTimer below) never
    // closes it mid-transit -- a real, expected mouse path for "now read
    // the xrefs the hover already opened," not a dismiss signal. A fresh
    // CancellationTokenSource per scheduled close (never reused) -- the
    // standard, race-free way to debounce in C# without a stale timer
    // firing after a newer one has already superseded it.
    private CancellationTokenSource? _hoverCloseCts;

    private void CancelHoverCloseTimer()
    {
        _hoverCloseCts?.Cancel();
        _hoverCloseCts = null;
    }

    // Wired to BOTH the marker's own @onmouseleave (below) and
    // ExplorerPopover's own OnPanelPointerLeave (the <ExplorerPopover> tag
    // above, via OnPanelPointerLeaveHoverGuard) -- either edge of "the
    // pointer just left something that was keeping a hover-only popover
    // open" schedules the SAME short grace-period close, cancelled by
    // CancelHoverCloseTimer the instant the pointer re-enters EITHER the
    // marker (OpenVerseXrefEntryHover, called again on re-enter) or the
    // panel (OnPanelPointerEnter -> CancelHoverClose below).
    private void OnXrefMarkerPointerLeave() => ScheduleHoverClose();

    // ExplorerPopover.OnPanelPointerLeave's own callback target -- same
    // schedule, only while THIS popover is still hover-only (a persistent
    // one, or any non-xref popover, must never be touched by pointer
    // leave at all -- OnPanelPointerEnter/Leave are wired unconditionally
    // on every ExplorerPopover instance, per that component's own doc
    // comment, so the gate belongs here, the one place that knows both
    // _hoverOnlyOpen and which node kind is actually current).
    private void OnPanelPointerLeaveHoverGuard() => ScheduleHoverClose();

    // ExplorerPopover.OnPanelPointerEnter's own callback target.
    private void CancelHoverClose() => CancelHoverCloseTimer();

    private void ScheduleHoverClose()
    {
        if (!_hoverOnlyOpen)
        {
            return; // persistent (click/focus) or no popover at all -- pointer leave is a no-op
        }

        CancelHoverCloseTimer();
        var cts = new CancellationTokenSource();
        _hoverCloseCts = cts;
        _ = DelayedHoverClose(cts);
    }

    // 1000ms: a real, live-caught fix, tuned twice -- an earlier draft used
    // 250ms, long enough on paper for "a real mouse transit from the marker
    // into the popover panel," but too tight in practice: the panel's own
    // open animation (app.css popover-in, 120ms) plus genuine cursor travel
    // time together routinely ATE the whole window before
    // OnPanelPointerEnter ever landed, closing the popover mid-transit --
    // caught not as a test artifact but as a real interaction bug
    // (reader-xref-superscripts.spec.ts's own pre-existing "expansion
    // reveals the rest" case, moving the mouse from the marker to the
    // popover's own "show more" button deeper inside the panel, hit the
    // race and timed out entirely once the popover vanished out from under
    // the click). 500ms still wasn't a reliable floor: reaching a control
    // further inside the panel (not just its own near edge) costs more
    // transit time, and a loaded test/CI environment's own real wall-clock
    // overhead for the browser's move+actionability sequence can still
    // exceed a tight margin even when the APPLICATION logic is correct.
    // 1000ms still reads as "followed the hover, not stuck open by
    // accident" for a real user (a mouse trip of a few dozen pixels is
    // over almost immediately; nothing here is EVER held open for a full
    // second by ordinary use) while giving real, repeatable margin over
    // both the animation and slower, multi-step cursor travel. Re-checks
    // _hoverOnlyOpen after the delay (not just the cancellation token) -- a
    // click could have landed during the delay window and made the SAME
    // popover persistent without ever cancelling a leave that was already
    // in flight from an earlier, unrelated marker.
    private async Task DelayedHoverClose(CancellationTokenSource cts)
    {
        try
        {
            await Task.Delay(1000, cts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        // M-D3 fix round: widened from the original xref-only `_activeNode is
        // not VerseNode { XrefEntryPoint: true }` to plain `!_hoverOnlyOpen`.
        // CHAP-HOVER-1: `_hoverOnlyOpen` is set by exactly ONE caller again
        // now (OpenVerseXrefEntry) -- OpenChapter's own former hover case,
        // which used to set it too, is retired whole (that surface's own
        // dwell peek, above, never touches ExplorerPopover/_activeNode at
        // all, see OnChapterHeadPointerEnter's own doc comment), but the
        // plain `!_hoverOnlyOpen` check here stays exactly correct
        // regardless: every OTHER Open* method still resets it to false via
        // ResetXrefEntryState before assigning a DIFFERENT node, so by
        // construction it can only still be true here if _activeNode is
        // still the SAME xref-hover-opened node this timer was scheduled
        // for.
        if (cts.IsCancellationRequested || !_hoverOnlyOpen)
        {
            return;
        }

        _activeNode = null;
        _xrefEntryVerse = null;
        _hoverOnlyOpen = false;
        await InvokeAsync(StateHasChanged);
    }

    // Batch M-D4: OnXrefMarkerKeyDown/OpenEvent/OnHeadingKeyDown/
    // OpenPlaceMention/OpenPersonMention/OnPlaceMentionKeyDown/
    // OnPersonMentionKeyDown/Blink all deleted from this page -- each was
    // either a keydown-checks-Enter wrapper VerseLine.razor/
    // PericopeHeading.razor/MentionText.razor now owns internally, or (for
    // OpenEvent/OpenPlaceMention/OpenPersonMention) a reset-then-assign body
    // OnLineExplore above already generalizes, or (Blink) the one-liner
    // MentionText.razor now owns as the single copy instead of two. Grep-
    // proven dead: no remaining reference to any of these seven names in
    // this file.

    // Batch G1 requirement 1: the chapter header's own explore target
    // (chapter-head-button's @onclick/@onmouseenter -- M-D3 U4/B3 added the
    // hover trigger, matching R3's own click-AND-hover precedent; see this
    // method's own call sites). ChapterNode's own content is the M-D3
    // metadata-and-context card now, never the chapter's own text -- see
    // that class's own doc comment. TotalChapters (for "Chapter N of M")
    // and AlreadyLoaded (this page's own already-fetched _chapter, so
    // opening the heading of the chapter you're CURRENTLY reading costs no
    // extra round trip) both come straight off this page's own state.
    // M-D3 (R3): ResetXrefEntryState, same reasoning as OnLineExplore
    // above.
    //
    // CHAP-HOVER-1: simplified from the former `OpenChapter(bool persistent)`
    // -- CLICK is now the ONLY entry point (decision 5: "today's [sticky,
    // x-dismissable] behavior moves here exclusively"), so the
    // `persistent`/`_hoverOnlyOpen` upgrade dance M-D3/U4's own hover-opens-
    // quietly design needed is gone with it; opening this card always means
    // the real, backdrop-shown, persistent popover (ShowBackdrop="!_hoverOnlyOpen"
    // below reads `false` here via ResetXrefEntryState's own reset, exactly
    // like every OTHER non-xref explore in this app). Still guards a
    // redundant remount the same way OpenVerseXrefEntry does (re-entering a
    // chapter whose popover is already open no-ops rather than tearing down
    // and rebuilding ExplorerPopover, which is keyed by _activeNode's own
    // reference).
    private void OpenChapter()
    {
        var title = $"{_book}.{_chapterNum}";
        if (_activeNode is ChapterNode current && current.Title == title)
        {
            return; // already open on this exact chapter -- no-op
        }

        CancelChapterPeekTimer();
        _showChapterPeek = false; // a click always supersedes any peek still showing/mid-dwell -- never both at once
        ResetXrefEntryState();
        var totalChapters = _toc?.FirstOrDefault(b => b.Code == _book)?.Chapters.Count;
        _activeNode = new ChapterNode(_book, _chapterNum, totalChapters) { AlreadyLoaded = _chapter };
    }

    // CHAP-HOVER-1's own dwell timer -- deliberately NOT ExplorerPopover/
    // _activeNode at all (unlike the retired hover-opens-the-real-card
    // design): the peek is a separate, lightweight, read-only rendering
    // (the <div class="chapter-head-peek"> sibling in the markup above),
    // computed directly from data this page ALREADY holds in memory
    // (_chapter/_toc -- the chapter being read IS the chapter chapter-head
    // names, so no network fetch is needed just to peek at it). Same
    // CancellationTokenSource/Task.Delay shape as this page's own
    // pre-existing xref-hover-close timer (ScheduleHoverClose/
    // DelayedHoverClose below) -- for the OPEN side instead of the close
    // side, sharing only the ONE numeric constant (DwellTiming.PeekDelayMs)
    // decision 5 requires, not the mechanism itself (the two dwell
    // directions have genuinely different cancellation shapes: this one
    // fires ONCE and stays until pointer-leave; that one re-arms on every
    // leave and can be cancelled by a re-enter).
    private bool _showChapterPeek;
    private CancellationTokenSource? _chapterPeekCts;

    private void OnChapterHeadPointerEnter()
    {
        CancelChapterPeekTimer();
        var cts = new CancellationTokenSource();
        _chapterPeekCts = cts;
        _ = DelayedChapterPeekShow(cts);
    }

    private void OnChapterHeadPointerLeave()
    {
        CancelChapterPeekTimer();
        if (_showChapterPeek)
        {
            _showChapterPeek = false;
            StateHasChanged();
        }
    }

    private void CancelChapterPeekTimer()
    {
        _chapterPeekCts?.Cancel();
        _chapterPeekCts = null;
    }

    private async Task DelayedChapterPeekShow(CancellationTokenSource cts)
    {
        try
        {
            await Task.Delay(DwellTiming.PeekDelayMs, cts.Token);
        }
        catch (TaskCanceledException)
        {
            return; // left before the dwell delay elapsed -- the tickle test's own "nothing happens" case
        }

        if (cts.IsCancellationRequested)
        {
            return;
        }

        _showChapterPeek = true;
        StateHasChanged();
    }

    // The peek's own content -- plain data reads off _chapter/_toc (no
    // fetch, no IPopoverSectionContext, nothing explorable inside it: a
    // peek is a glance, never a second way to drill in -- clicking THROUGH
    // it does nothing, only clicking chapter-head itself commits). Position
    // text mirrors ChapterCardSection's own "Chapter N of M" wording
    // (chapter-card-position, the STICKY card's own testid) so the two
    // don't read as two different facts, just two different affordances
    // for the identical one.
    private string ChapterPeekPositionText
    {
        get
        {
            var total = _toc?.FirstOrDefault(b => b.Code == _book)?.Chapters.Count;
            return total is int t ? $"Chapter {_chapterNum} of {t}" : $"Chapter {_chapterNum}";
        }
    }

    // Same dedupe-by-event-id rule ChapterCardSection's own headings list
    // uses (a titled container can anchor more than one verse in this
    // chapter; each must appear once, not once per anchoring verse) --
    // capped at 8 for the same reason that card's own list is (a long
    // acrostic psalm's own many sections), never fetched: `_chapter` is
    // already this exact chapter's own already-loaded ChapterOut.
    private List<HeadingDto> ChapterPeekHeadings =>
        _chapter?.Verses.Where(v => v.Heading is not null).Select(v => v.Heading!).GroupBy(h => h.EventId).Select(g => g.First()).Take(8).ToList()
        ?? new List<HeadingDto>();

    private Task ClosePopover()
    {
        ResetXrefEntryState();
        _activeNode = null;
        return Task.CompletedTask;
    }

    // Fix round 1 (replaces a prior version that closed any open popover
    // the instant Shift went down -- see the wrapper div's own comment for
    // why that over-fired on Shift+Tab). This pair only ever tracks
    // _shiftHeld; neither touches _activeNode. The original problem this
    // exists to solve is still real: ExplorerPopover's own backdrop is a
    // full-viewport, position:fixed div (by design -- click-outside-to-
    // close) that physically intercepts pointer events, so a plain click's
    // popover staying open would make a shift-click's SECOND click (on a
    // different verse-num) impossible to land at all -- it would just retry
    // against the intercepting backdrop until its actionability timeout,
    // never reaching OnVerseNumClick below. `reader-shift-active` (toggled
    // on the wrapper div above, see its own comment) turns that backdrop
    // `pointer-events: none` for exactly as long as Shift is held, so the
    // second click's pointer event passes through to the verse-num button
    // beneath it -- OnVerseNumClick's own existing shift-click branch then
    // closes the popover itself once a valid range actually forms (or
    // doesn't, if it fell through to the plain-click path -- see its
    // comment), same as before this fix round.
    //
    // Bound on this component's own wrapper div (not verse-num or the
    // popover panel individually) for the same reason the original version
    // was: the real test never waits for ExplorerPopover's own async
    // FocusAsync() to land before pressing Shift, so focus could still be
    // on the just-clicked verse-num button at that instant, or could
    // already be inside the popover panel -- only a common ancestor of BOTH
    // catches the bubbled keydown/keyup reliably regardless of which one
    // currently has focus.
    private void OnPageKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Shift")
        {
            _shiftHeld = true;
        }
    }

    private void OnPageKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Shift")
        {
            _shiftHeld = false;
        }
    }

    // reader.js's watchShiftRelease -> window.blur/document.visibilitychange
    // safety net (see OnAfterRenderAsync). The ONLY way _shiftHeld can go
    // stuck true is Shift being physically released while this tab/window
    // isn't the focused one -- no DOM keyup for it ever reaches this page
    // in that case. Resetting unconditionally (rather than trying to prove
    // Shift is truly no longer held) is always the safe direction: at worst
    // this fires once while Shift genuinely is still down (the user let go
    // specifically while alt-tabbed away), which just makes the backdrop
    // briefly clickable again a little early -- a real Shift keydown on
    // return sets _shiftHeld back to true immediately, same as any other
    // fresh keydown.
    [JSInvokable]
    public void ResetShiftHeld()
    {
        if (_shiftHeld)
        {
            _shiftHeld = false;
            StateHasChanged();
        }
    }

    // reader.js's watchScroll (view-state round-trip) -- fired continuously
    // (rAF-throttled) for as long as this component is mounted. Stamps
    // Book/Chapter alongside ScrollY on every call, not just once, so
    // ViewState.Reader always describes "the current chapter's own current
    // scroll" -- correct even across an in-session chapter change (the
    // SAME Reader instance, and therefore the SAME listener, stays wired
    // straight through one, per OnParametersSetAsync's own reuse). No
    // StateHasChanged -- this never affects Reader's own rendering.
    [JSInvokable]
    public void OnScroll(double y)
    {
        ViewState.Reader.HasData = true;
        ViewState.Reader.Book = _book;
        ViewState.Reader.Chapter = _chapterNum;
        ViewState.Reader.ScrollY = y;
    }

    // READ-2/READ-5 interplay -- REVISED, Batch G1 requirement 1
    // ("selection and exploration are separate gestures on separate
    // targets"): a plain verse-num click ONLY sets the anchor now (no
    // popover -- that's the verse LINE's job, see VerseLine.razor's own
    // OnLineKeyDown/@onclick); shift-click still suppresses any anchor update
    // and shows the passage-chip, unchanged. A shift-click with no anchor
    // yet (the user shift-clicked before ever plain-clicking a verse this
    // visit) has nothing to form a range against -- falls through to the
    // plain-click path instead of silently doing nothing, so the shift-
    // clicked verse itself becomes a usable anchor for the NEXT shift-
    // click. Same fallback when the anchor and the shift-clicked verse are
    // the SAME verse (a degenerate "V-V" range), which would otherwise
    // produce a meaningless one-verse "passage".
    private void OnVerseNumClick(MouseEventArgs e, int verseNum)
    {
        if (e.ShiftKey && _anchorVerse is int anchor && anchor != verseNum)
        {
            _passageRange = (Math.Min(anchor, verseNum), Math.Max(anchor, verseNum));
            ResetXrefEntryState();
            _activeNode = null; // suppress the popover -- the chip is the result of a shift-click, not a new popover
            return;
        }

        SetAnchor(verseNum);
    }

    // The shared "plain click" behavior: sets the anchor only, per this
    // batch's own separation of selection (verse-num) from exploration
    // (the verse line, VerseLine.razor's own OnExplore) -- deliberately does
    // NOT open a popover
    // (that was the pre-Batch-G1 behavior, shared with the now-dead ∴
    // button; see this method's own git history for the prior version).
    // Does not touch _activeNode either way, so an already-open popover
    // (e.g. from a just-clicked verse LINE) is left exactly as it was --
    // ExplorerPopover's own backdrop already intercepts a plain click on a
    // DIFFERENT verse-num while it's open anyway (click-outside-to-close),
    // same pre-existing behavior this change doesn't alter.
    private void SetAnchor(int verseNum)
    {
        _anchorVerse = verseNum;
        _passageRange = null;
    }

    // Batch M-D4: OnVerseLineKeyDown deleted -- VerseLine.razor's own
    // OnLineKeyDown is the identical Enter-only check, now shared by both
    // containers instead of this page's own private copy.

    private string PassageRef((int From, int To) range) => $"{_book}.{_chapterNum}.{range.From}-{range.To}";

    // passage-chip click (READ-5): PassageNode takes its text directly
    // (concatenated from verses the reader already has in memory -- see
    // PassageNode.cs's own doc comment) rather than issuing a second
    // network round-trip for content this page already rendered.
    private void OpenPassage()
    {
        if (_passageRange is not { } range || _chapter is not { } chapter)
        {
            return;
        }

        ResetXrefEntryState();
        var text = string.Join(" ", chapter.Verses
            .Where(v => v.Verse >= range.From && v.Verse <= range.To)
            .Select(v => v.Text));
        _activeNode = new PassageNode(PassageRef(range), text);
    }

    // ScripturePicker composes one of GEN / GEN.1 / GEN.1.5 / GEN.1.5-9 (the
    // 4 canonical ref shapes -- see ScripturePicker.Apply); this is the
    // reader's own NavigateReader-style dispatch for it (World's mount
    // instead sends the same ref straight into scripture-mode).
    private Task ApplyScriptureRef(string sref)
    {
        var parts = sref.Split('.');
        var book = parts[0];
        var chapterNum = parts.Length > 1 ? int.Parse(parts[1]) : 1;
        int? verse = null;
        if (parts.Length > 2)
        {
            var versePart = parts[2];
            var dash = versePart.IndexOf('-');
            verse = int.Parse(dash >= 0 ? versePart[..dash] : versePart);
        }

        // Batch F2 requirement 6c: query (?split=1, when open) BEFORE the
        // fragment -- standard URL syntax, path?query#fragment -- so a
        // picker jump made while split is open doesn't silently drop it
        // (same reasoning as ChapterHref above).
        var query = _splitOpen ? "?split=1" : "";
        var fragment = verse is int v ? $"#v{v}" : "";
        Nav.NavigateTo($"/read/{book}/{chapterNum}{query}{fragment}");
        return Task.CompletedTask;
    }

    private sealed record AdjacentChapter(string Book, string Name, int Chapter);

    private AdjacentChapter? PrevTarget => ComputeAdjacent(forward: false);
    private AdjacentChapter? NextTarget => ComputeAdjacent(forward: true);

    // Crosses book boundaries via the TOC: GEN.50 next -> EXO.1; EXO.1 prev
    // -> GEN.50; null (hidden) at GEN.1's prev and REV.22's next.
    private AdjacentChapter? ComputeAdjacent(bool forward)
    {
        if (_toc is null)
        {
            return null;
        }

        var idx = _toc.FindIndex(b => b.Code == _book);
        if (idx < 0)
        {
            return null;
        }

        var entry = _toc[idx];
        if (forward)
        {
            if (_chapterNum < entry.Chapters.Count)
            {
                return new AdjacentChapter(_book, entry.Name, _chapterNum + 1);
            }

            return idx + 1 < _toc.Count ? new AdjacentChapter(_toc[idx + 1].Code, _toc[idx + 1].Name, 1) : null;
        }

        if (_chapterNum > 1)
        {
            return new AdjacentChapter(_book, entry.Name, _chapterNum - 1);
        }

        if (idx == 0)
        {
            return null;
        }

        var prevEntry = _toc[idx - 1];
        return new AdjacentChapter(prevEntry.Code, prevEntry.Name, prevEntry.Chapters.Count);
    }

    public async ValueTask DisposeAsync()
    {
        // Fix round 1 (Q-3): unsubscribe from the SHARED (app-lifetime)
        // ViewArrangement atom before this instance goes away -- same
        // reasoning World.razor's own equivalent unsubscribe gives (the atom
        // outlives this component; leaving the subscription wired would call
        // back into a disposed component on every future arrangement
        // dispatch, from ANY page).
        ViewArrangementAtom.Changed -= OnViewArrangementChanged;

        // M-D3 (R3): cancels any in-flight hover-close delay -- without
        // this, DelayedHoverClose's own await could resolve AFTER this
        // component is disposed (a real navigation-away-while-hovering
        // case) and call StateHasChanged on a torn-down component.
        CancelHoverCloseTimer();

        // M-D3/U6: this instance is no longer actively showing anything --
        // clear the "currently mounted" signal (UNLIKE ViewState.Reader,
        // which deliberately stays set as a persistent "last known
        // position" record). Guarded on OUR OWN book/chapter still being
        // the current value, not unconditionally null'd -- a genuinely
        // concurrent dispose+mount (e.g. a split-view instance tearing down
        // while a fresh standalone one is already mounting) must never let
        // the OLD instance's own teardown clobber the NEW instance's
        // already-current value.
        if (ViewState.MountedReaderChapter is { } cur && cur.Book == _book && cur.Chapter == _chapterNum)
        {
            ViewState.MountedReaderChapter = null;
        }

        if (_readerJs is not null)
        {
            try
            {
                // Batch H (view-state round-trip): NOT a dispose-time
                // getScrollY read -- see reader.js's own watchScroll comment
                // for the real, confirmed race that loses (Blazor's own
                // router resets window scroll on navigation before
                // DisposeAsync ever runs, so a read here would reliably
                // capture 0). ViewState.Reader is already correct by this
                // point, kept that way continuously by OnScroll while this
                // component was mounted -- this call just stops the
                // listener, same "unwire before disposing the module"
                // ordering unwatchShiftRelease below already follows.
                await _readerJs.InvokeVoidAsync("unwatchScroll");

                // Batch R requirement 6: unwires watchChapterNavCenter's own
                // scroll/resize listeners -- same "unwire before disposing
                // the module" ordering every other reader.js watcher here
                // already follows.
                await _readerJs.InvokeVoidAsync("unwatchChapterNavCenter");

                // Removes reader.js's own window/document-level blur and
                // visibilitychange listeners (see watchShiftRelease's own
                // comment) BEFORE disposing the module reference itself --
                // those listeners are global (window/document, not scoped
                // to this component's own DOM), so leaving them wired past
                // this page's own lifetime would call back into a disposed
                // _selfRef on every future navigation's blur/visibility
                // event for as long as the browser tab stays open.
                await _readerJs.InvokeVoidAsync("unwatchShiftRelease");
                await _readerJs.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already gone during teardown -- nothing left to clean up JS-side.
            }
        }

        _selfRef?.Dispose();
    }
}
