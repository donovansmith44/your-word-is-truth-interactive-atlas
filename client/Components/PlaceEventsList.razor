@using BibleAtlas.Client.Explore

@{
    var shown = _showAll ? Events : Events.Take(Cap);
}
@foreach (var e in shown)
{
    var ev = e;
    <button type="button" class="popover-event-row popover-event-row-button explorable" data-testid="@($"place-event-{ev.Id}")"
            @onclick="@(e => OnRowClick(e, ev))">
        <span class="popover-event-label">@ev.Label</span>
        <span class="popover-event-years">@YearText.FormatRange(ev.When.FromYear, ev.When.ToYear)</span>
    </button>
}

@if (Events.Count > Cap)
{
    @if (!_showAll)
    {
        <button type="button" class="popover-passage-reveal" data-testid="place-events-more" aria-label="@($"Show {Events.Count - Cap} more events")"
                @onclick="() => _showAll = true">&#9662;</button>
    }
    else
    {
        <button type="button" class="popover-passage-reveal" data-testid="place-events-collapse" aria-label="Show fewer events"
                @onclick="() => _showAll = false">&#9652;</button>
    }
}

@code {
    [Parameter, EditorRequired] public string PlaceId { get; set; } = default!;
    [Parameter, EditorRequired] public string PlaceName { get; set; } = default!;
    [Parameter, EditorRequired] public List<SceneEvent> Events { get; set; } = new();
    [Parameter] public int Cap { get; set; } = 10;
    [Parameter, EditorRequired] public EventCallback<IExplorable> OnExplore { get; set; }

    [Parameter] public EventCallback<IExplorable> OnToggleSelect { get; set; }

    private bool _showAll;

    private Task OnRowClick(MouseEventArgs e, SceneEvent ev)
    {
        var node = new TimeAndPlaceNode(PlaceId, PlaceName, ev.Id, ev.When, ev.Label, ev.VerseGroups);
        return e.CtrlKey || e.MetaKey ? OnToggleSelect.InvokeAsync(node) : OnExplore.InvokeAsync(node);
    }
}
