@using BibleAtlas.Client.Exploring
@inject AtlasClient Atlas
@inject IJSRuntime JS
@inject ViewStateService ViewState

@if (!_expanded)
{
    @CompactContent
}
else
{
    <div class="popover-reader" data-testid="@($"popover-verse-reader{TestIdSuffix}")" @onclick:stopPropagation="true">
        @if (_error is not null)
        {
            <p class="popover-meta">@_error</p>
        }
        else if (_chapter is null)
        {
            <p class="popover-meta">Loading&hellip;</p>
        }
        else
        {
            var xrefLetters = VerseLine.ComputeXrefLetters(_chapter.Verses);
            @foreach (var v in _chapter.Verses)
            {
                var isFocal = v.Number >= FocalFromVerse && v.Number <= FocalToVerse;
                @if (v.Heading is { } heading)
                {
                    <PericopeHeading Heading="@heading" TestIdSuffix="@TestIdSuffix" OnExplore="OnExplore" />
                }
                <VerseLine Verse="@v" Unit="@_text!.Verse(v.Number)" OnExplore="OnExplore"
                           Focal="@isFocal" Id="@(v.Number == FocalFromVerse ? _focalDomId : null)"
                           RowClass="popover-reader-verse explorable" RowTestIdPrefix="popover-reader-verse" TestIdSuffix="@TestIdSuffix"
                           VerseNumClass="popover-reader-verse-num" ShowVerseNumButton="false"
                           TextClass="popover-reader-verse-text" MentionClass="popover-reader-mention"
                           XrefMarkerTestIdPrefix="popover-reader-xref-marker"
                           XrefMarkerGlyph="@xrefLetters.GetValueOrDefault(v.Number, "")"
                           OnXrefClick="@(vn => OnExplore.InvokeAsync(new PopoverOpening.Explore(new NodePosition(_text!.Verse(vn).Node))))" />
            }
        }
    </div>
}

@if (!AlreadyInCurrentReaderChapter)
{
    <RevealControls OffersAll="false" Total="1" Default="0" Step="1" Shown="@(_expanded ? 1 : 0)" ShownChanged="OnShownChanged"
                     MoreTestId="@($"popover-verse-expand{TestIdSuffix}")" CollapseTestId="@($"popover-verse-collapse{TestIdSuffix}")"
                     RevealNoun="verses"
                     MoreLabel="Read the whole chapter"
                     CollapseLabel="Show just this verse" />
}

@code {
    [Parameter, EditorRequired] public string Book { get; set; } = default!;
    [Parameter] public int Chapter { get; set; }
    [Parameter] public int FocalFromVerse { get; set; }
    [Parameter] public int FocalToVerse { get; set; }
    [Parameter, EditorRequired] public RenderFragment CompactContent { get; set; } = default!;
    [Parameter] public string TestIdSuffix { get; set; } = "";

    [Parameter, EditorRequired] public EventCallback<PopoverOpening> OnExplore { get; set; }

    private bool AlreadyInCurrentReaderChapter => ViewState.IsReaderChapterMounted(Book, Chapter);

    private bool _expanded;
    private Chapter? _chapter;
    private ChapterText? _text;
    private readonly RequestSeries _chapters = new();
    private string? _error;
    private bool _scrolledThisExpand;
    private readonly AsyncMemo<IJSObjectReference> _readerJs = new();

    private readonly string _focalDomId = $"popover-reader-focal-{Guid.NewGuid():N}";

    private async Task OnShownChanged(int shown)
    {
        _expanded = shown == 1;
        if (_expanded && _chapter is null)
        {
            _error = null;
            (await _chapters.Next().Fetch(() => Atlas.Chapter(Book, Chapter), () => Atlas.ChapterText(Book, Chapter))).Match(
                arrived: loaded => (_chapter, _text) = loaded,
                failed: () => _error = "Couldn't load the chapter — check your connection and try again.",
                superseded: () => { });
        }

        if (_expanded)
        {
            _scrolledThisExpand = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_expanded || _scrolledThisExpand || _chapter is null || _error is not null)
        {
            return;
        }

        _scrolledThisExpand = true;
        try
        {
            var readerJs = await _readerJs.Get(() => JS.InvokeAsync<IJSObjectReference>("import", "./js/reader.js").AsTask());
            await readerJs.InvokeVoidAsync("scrollFocalRowIntoView", _focalDomId);
        }
        catch (Exception)
        {
        }
    }
}
