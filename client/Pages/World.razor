    private Task OpenPlaceFromCard()
    {
        if (_hoverPlace is { } place)
        {
            var windowFrom = _scriptureRef is null ? _from : (int?)null;
            var windowTo = _scriptureRef is null ? _to : (int?)null;
            _activeNode = new PlaceNode(place.Id, place.DisplayName, windowFrom, windowTo);
        }

        CloseCardNow();
        return Task.CompletedTask;
    }

    private Task OpenExploreNode(IExplorable node)
    {
        _activeNode = node;
        CloseCardNow();
        return Task.CompletedTask;
    }

    private Task ClosePopover()
    {
        _activeNode = null;
        return Task.CompletedTask;
    }

    private Task ClosePinnedCard()
    {
        CloseCardNow();
        return Task.CompletedTask;
    }

    private async Task GoToAdjacent(string placeId)
    {
        var place = _scene?.Places.FirstOrDefault(p => p.Id == placeId) ?? QuietAsScenePlace(placeId);
        if (place is null || _mapInterop is null)
        {
            return;
        }

        var (x, y) = await _mapInterop.PanToPlace(place.Lat, place.Lon);
        _closeCts?.Cancel();
        _pinnedPlaceId = placeId;
        _hoverPlace = place;
        _hoverX = x;
        _hoverY = y;
        _chooserPlaces = null;
    }

    // The one choke point for "the card is fully gone": always clears
    // _pinnedPlaceId alongside _hoverPlace. Clearing only one would leave
    // OnPlaceHover's pinned-guard silently ignoring every future hover.
    private void CloseCardNow()
    {
        _closeCts?.Cancel();
        _hoverPlace = null;
        _chooserPlaces = null;
        _pointerOverCard = false;
        _pinnedPlaceId = null;
    }

    private void ScheduleCardClose()
    {
        if (_pinnedPlaceId is not null)
        {
            return;
        }

        _closeCts?.Cancel();
        var cts = new CancellationTokenSource();
        _closeCts = cts;
        _ = CloseCardAfterDelay(cts);
    }

    private void CardPointerEnter()
    {
        _pointerOverCard = true;
        _closeCts?.Cancel();
    }

    private void CardPointerLeave()
    {
        _pointerOverCard = false;
        ScheduleCardClose();
    }

    private async Task CloseCardAfterDelay(CancellationTokenSource cts)
    {
        try
        {
            await Task.Delay(350, cts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (cts.IsCancellationRequested)
        {
            return;
        }

        _hoverPlace = null;
        _chooserPlaces = null;
        _pointerOverCard = false;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        _fetchCts?.Cancel();
        _closeCts?.Cancel();

        LocusAtom.Changed -= OnLocusChanged;
        _followRunner.Dispose();

        TimeWindowAtom.Changed -= OnTimeWindowChanged;
        ViewArrangementAtom.Changed -= OnViewArrangementChanged;

        DisableFollowScene();

        if (_mapInterop is not null)
        {
            await _mapInterop.DisposeAsync();
        }
    }
}
