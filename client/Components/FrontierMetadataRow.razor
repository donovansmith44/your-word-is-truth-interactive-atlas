@* EVT-3 Ticket 3 (owner verbatim, EVENT-TIMEPLACE-1: "At the top, right
   below the header of the 'event' frontier, I want Time: and Place: ...
   They're both explorable elements."): ONE reusable frontier-metadata row
   -- a small-caps LABEL ("Time:"/"Place:") beside one or more explorable
   VALUE chips the caller composes. Reusable anywhere a frontier carries
   time/place facts (the owner's own composability bar: "any kind bearing
   them composes them") -- NOT Event-only markup; any future capability-bearing
   kind (IHasTimeAndPlace) reaches this the same way
   EventDateAndPlacesSection does, never a second hand-rolled row. *@
<div class="popover-frontier-metadata-row" data-testid="@TestId">
    <span class="popover-frontier-metadata-label">@Label</span>
    <span class="popover-frontier-metadata-values">@ChildContent</span>
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = default!;
    [Parameter, EditorRequired] public string TestId { get; set; } = default!;
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;
}
