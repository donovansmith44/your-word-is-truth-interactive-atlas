    private void Open(NodeRef node) => Open(new PopoverOpening.Explore(new NodePosition(node)));

    private void Open(PopoverOpening opening)
    {
        _chooserPlaces = null;
        _opening = opening;
        StateHasChanged();
    }

    private void CloseChooser()
    {
        if (_chooserPlaces is null)
        {
            return;
        }

        _chooserPlaces = null;
        StateHasChanged();
    }

    private Task ClosePopover()
    {
        _opening = null;
        return Task.CompletedTask;
    }

    private void AdoptAHandedOverExploration()
    {
        if (ExplorationAtom.Value is ExplorationState.Open { Exploration.Current: var current }
            && !Ownership.IsHeld(AtomNames.Exploration)
            && HomeSurfaces.Of(current.Kind) == Surface.World)
        {
            _opening = new PopoverOpening.Explore(current.Identity);
        }
    }

    private async Task PresentTheFocus(ExplorationState state)
    {
        var request = _focus.Next();
        try
        {
            if (state is not ExplorationState.Open { Exploration.Current: var current })
            {
                await Apply(Unfocused);
            }
            else
            {
                await (await request.Fetch(() => Presenter.Present(new PresentationRequest(current, Surface.World)))).Match(
                    arrived: presentation => presentation is Presentation.Geography geography ? Apply(geography) : Task.CompletedTask,
                    failed: () => { },
                    superseded: () => { });
            }
        }
        catch (Exception)
        {
        }
    }

    private static readonly Presentation.Geography Unfocused = new(new Frame.Current(), new Emphasis.None());

    private async Task Apply(Presentation.Geography geography)
    {
        _frame = geography.Frame;
        _emphasis = geography.Emphasis;
        if (_mapInterop is not null)
        {
            await _mapInterop.Emphasize(_emphasis);
        }

        await _frame.Match(current: () => Task.CompletedTask, bounded: (window, _, _) => ShowWindow(window));
        StateHasChanged();
    }

    private Task ShowWindow(TimeRange window) =>
        _scriptureRef is null && window.From.Value == _from && window.To.Value == _to
            ? Task.CompletedTask
            : MoveWindow(window.From.Value, window.To.Value);

    private TimeRange? Bounds => _frame.Match<TimeRange?>(current: () => null, bounded: (window, _, _) => window);

    private TimeRange? Band => _emphasis.Match<TimeRange?>(none: () => null, site: (_, _, _) => null, territory: (_, reign) => reign);

    private IReadOnlyCollection<ArrowDirection> Crossings =>
        Enum.GetValues<ArrowDirection>().Where(direction => CrossingTo(direction) is not null).ToList();

    private Link? CrossingTo(ArrowDirection direction) =>
        _frame.Match(current: () => null, bounded: (_, previous, next) => direction switch
        {
            ArrowDirection.Previous => previous,
            ArrowDirection.Next => next,
        });

    private async Task Cross(ArrowDirection direction)
    {
        if (CrossingTo(direction) is not { } link || ExplorationAtom.Value is not ExplorationState.Open { Exploration: var from })
        {
            return;
        }

        (await _crossing.Next().Walk(() => Crossing.Walk(link.Kind).Run(Explorer, from))).Match(
            arrived: walked => ExplorationAtom.Dispatch(new ExplorationIntent.Arrive(from, walked.Trail)),
            failed: () => _errorMessage = $"Couldn't reach {Positions.Of(link.Target).Label} -- check your connection and try again.",
            superseded: () => { });
    }

    public async ValueTask DisposeAsync()
    {
        _scenes.Stop();
        _focus.Stop();
        _crossing.Stop();
        _presentFocusClaim?.Dispose();

        LocusAtom.Changed -= OnLocusChanged;
        _followRunner.Dispose();

        TimeWindowAtom.Changed -= OnTimeWindowChanged;
        ViewArrangementAtom.Changed -= OnViewArrangementChanged;

        DisableFollowScene();

        if (_mapInterop is not null)
        {
            await _mapInterop.DisposeAsync();
        }
    }
