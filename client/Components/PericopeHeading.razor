@using BibleAtlas.Client.Explore

<h2 class="pericope-heading @(Heading.IsContinuation ? "pericope-heading-continuation" : "") @(Heading.Kind == "general" ? "explorable-quiet" : "explorable")"
    data-testid="@($"pericope-heading-{Heading.EventId}{TestIdSuffix}")" data-continuation="@(Heading.IsContinuation ? "true" : "false")"
    tabindex="0" role="button" aria-label="@(Heading.IsContinuation ? $"Explore {Heading.Title} (continued)" : $"Explore {Heading.Title}")"
    @onclick="Open" @onkeydown="@(e => OnKeyDown(e))">
    @if (Heading.IsContinuation)
    {
        <span class="pericope-heading-continuation-marker" data-testid="@($"pericope-heading-continuation-marker-{Heading.EventId}{TestIdSuffix}")">continued</span>
    }
    @Heading.Title
</h2>

@code {
    [Parameter, EditorRequired] public HeadingDto Heading { get; set; } = default!;

    [Parameter] public string TestIdSuffix { get; set; } = "";

    [Parameter, EditorRequired] public EventCallback<IExplorable> OnExplore { get; set; }

    private Task Open() => OnExplore.InvokeAsync(new EventNode(Heading.EventId, Heading.Title, Heading.Kind));

    private Task OnKeyDown(KeyboardEventArgs e) => e.Key == "Enter" ? Open() : Task.CompletedTask;
}
