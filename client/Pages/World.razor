@page "/world"
@using System.Globalization
@using BibleAtlas.Client.Contracts
@using BibleAtlas.Client.Geography
@using BibleAtlas.Client.State
@using BibleAtlas.Client.Views
@implements IAsyncDisposable
@implements IMapEvents
@inject AtlasClient Atlas
@inject IMapSource Maps
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ViewStateService ViewState
@inject StateAtom<IReadOnlyList<NodeRef>> SelectionAtom
@inject PaneScopes Panes
@inject StateAtom<ViewArrangement> ViewArrangementAtom
@inject EffectRegistry Effects
@inject ViewRegistry Registry
@inject StateAtom<ExplorationState> ExplorationAtom
@inject OwnershipRegistry Ownership
@inject IExplorer Explorer
@inject IPresenter Presenter

<PageTitle>Bible Explorer &mdash; World</PageTitle>

<CompositionSplit HostName="@ViewNames.World" SplitModeOverride="@(SplitMode ? true : (bool?)null)" HostPaneClass="split-pane-world" Context="ctx">
<div class="@($"world-frame{(ctx.IsSplitOpen && ctx.IsHost ? " split-pane-frame" : "")}")" data-testid="world-frame">
<div class="world-page @(SplitMode ? "split-pane-atlas" : null)" data-testid="@(SplitMode ? "split-pane-atlas" : null)">
    <div id="world-map" class="world-map" data-testid="world-map" @ref="_mapEl"></div>

    @if (!SplitMode && !ctx.IsSplitOpen)
    {
        <button type="button" class="split-open split-open-dusk" data-testid="split-open-world" @onclick="InvokeEnterSplitHatch">
            Read beside the map
        </button>
        @if (ctx.Partners.Count > 1)
        {
            <button type="button" class="split-open split-open-dusk split-open-menu-toggle" data-testid="enter-split-menu-toggle"
                    aria-label="Choose what to open beside the map" aria-expanded="@(_splitMenuOpen ? "true" : "false")"
                    @onclick="() => _splitMenuOpen = !_splitMenuOpen">&#9662;</button>
            @if (_splitMenuOpen)
            {
                <div class="enter-split-menu enter-split-menu-dusk" data-testid="enter-split-menu" role="menu">
                    @foreach (var guest in ctx.Partners)
                    {
                        var g = guest;
                        <button type="button" role="menuitem" class="enter-split-menu-item" data-testid="@($"enter-split-guest-{g}")"
                                @onclick="async () => { _splitMenuOpen = false; await ctx.InvokeHatchWith.InvokeAsync(g); }">
                            @ctx.LabelOf(g)
                        </button>
                    }
                </div>
            }
        }
    }
    else
    {
        <div class="split-atlas-controls" data-testid="split-atlas-controls">
            <button type="button" class="follow-chip" data-testid="follow-chip"
                    aria-pressed="@(_followAny ? "true" : "false")" @onclick="OnAnyFollowClick">
                @(_sameViewSplit ? (_paneFollow ? "Sharing the time window" : "Share the time window") : (_follow ? $"Following {_locus.Value.Ref}" : "Follow the text"))
            </button>
            <button type="button" class="split-close split-close-dusk" data-testid="split-close-atlas"
                    aria-label="Close the map, keep reading" @onclick="() => OnRequestClose.InvokeAsync()">
                &times;
            </button>
        </div>
    }

    @* One scripture selector while following the reader -- this picker
       returns once follow is released. Keep this condition shaped as
       `!(SplitMode && ...)`: a client.Tests source scan requires that
       exact form on any non-Reader page. *@
    @if (!(SplitMode && _followAny))
    {
        <ScripturePicker OnApply="ApplyScriptureRef" ThemeClass="picker-dusk"
                          CurrentBook="@_locus.Value.Book" CurrentChapter="@_locus.Value.Chapter"
                          SyncToken="@_pickerSyncToken" />
    }

    @if (_scene is not null && _scene.Places.Count == 0)
    {
        <p class="world-empty">No recorded events in this window &mdash; drag the timeline or choose a scripture.</p>
    }

    @{ var chooserPlaces = _chooserPlaces; }
    @if (chooserPlaces is not null)
    {
        <PlaceChooser Places="chooserPlaces" X="_chooserX" Y="_chooserY" OnPick="PickChooserPlace" />
    }

    @if (_hoverArrowText is not null)
    {
        <div class="arrow-tip" data-testid="arrow-tip"
             style="left: @_arrowX.ToString(CultureInfo.InvariantCulture)px; top: @_arrowY.ToString(CultureInfo.InvariantCulture)px;">
            @_hoverArrowText
        </div>
    }

    @if (_eras is not null)
    {
        <TimeSlider Eras="_eras" From="_from" To="_to" Window="_timeWindow"
                    Bounds="Bounds" Band="Band" Crossings="Crossings" OnCross="Cross"
                    Disabled="@(_scriptureRef is not null)" OnWindowChange="HandleWindowChange" OnWindowDrag="HandleWindowDrag" />
    }

    @if (_scriptureRef is not null && !(SplitMode && _followAny))
    {
        <div class="mode-chip" data-testid="mode-chip">
            <span class="mode-chip-label">Scripture</span>
            <span class="mode-chip-ref">@_scriptureRef</span>
            <button type="button" class="mode-chip-return" data-testid="mode-chip-return" @onclick="ReturnToTime">
                Return to time
            </button>
        </div>
    }

    @if (_scene is not null && _scene.Narratives.Count > 0)
    {
        <Legend Narratives="_scene.Narratives" IsolatedId="@_isolated" OnIsolate="HandleIsolate" />
    }

    @if (_errorMessage is not null)
    {
        <div class="toast" data-testid="toast">
            <p class="toast-message">@_errorMessage</p>
        </div>
    }
</div>
</div>
</CompositionSplit>

@if (_opening is { } opening)
{
    <ExplorerPopover @key="opening" Opening="opening" OnClose="ClosePopover" HostedByWorld="true" ShowBackdrop="false"
                      InSplit="SplitMode" OnNavigateWorldInSplit="ApplyExternalQuery" PaneAnchor="@(SplitMode ? "atlas" : null)" />
}

@code {
    private const int DefaultFrom = -5;
    private const int DefaultTo = 33;

    [SupplyParameterFromQuery(Name = "from")]
    [Parameter]
    public string? FromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "to")]
    [Parameter]
    public string? ToQuery { get; set; }

    [SupplyParameterFromQuery(Name = "ref")]
    [Parameter]
    public string? RefQuery { get; set; }

    [SupplyParameterFromQuery(Name = "place")]
    [Parameter]
    public string? PlaceQuery { get; set; }

    [Parameter] public bool SplitMode { get; set; }

    [CascadingParameter] public PaneId Pane { get; set; } = PaneId.Host;

    private StateAtom<Locus>? _locusAtomBacking2;
    private StateAtom<Locus> LocusAtom => _locusAtomBacking2 ??= Panes.For(Pane).Locus;
    private StateAtom<TimeWindow>? _timeWindowAtomBacking;
    private StateAtom<TimeWindow> TimeWindowAtom => _timeWindowAtomBacking ??= Panes.For(Pane).TimeWindow;

    private bool _splitMenuOpen;

    private bool _sameViewSplit => PaneScopes.IsSameViewSplit(ViewArrangementAtom.Value);

    private bool _paneFollow => _sameViewSplit && ViewArrangementAtom.Value.Follow;

    private bool _followAny => _follow || _paneFollow;

    private Task OnAnyFollowClick() => _sameViewSplit ? OnTogglePaneFollowClick() : OnToggleFollowClick();

    private Task OnTogglePaneFollowClick()
    {
        ViewArrangementAtom.Dispatch(new ToggleFollow(!ViewArrangementAtom.Value.Follow));
        return Task.CompletedTask;
    }

    private Task InvokeEnterSplitHatchWith(string guest) =>
        Registry.Get(ViewNames.World).EscapeHatches.OfType<EnterSplitHatch>().First().InvokeWith(guest);

    [Parameter] public EventCallback OnRequestClose { get; set; }

    [Parameter] public Action<Func<string, Task>>? RegisterQueryHandler { get; set; }

    private List<Era>? _eras;
    private Scene? _scene;
    private TimeRange? _timeWindow;
    private string? _errorMessage;
    private string? _scriptureRef;

    private IReadOnlyList<Polity>? _polities;
    private IReadOnlyList<Landmark>? _landmarks;

    private bool _landmarksPushed;

    private LandMask? _landMask;
    private bool _landMaskPushed;

    private IReadOnlyList<Polity>? _polityRoster;
    private bool _polityRosterPushed;

    private int _from = DefaultFrom;
    private int _to = DefaultTo;
    private readonly RequestSeries _scenes = new();
    private readonly RequestSeries _startup = new();

    private ElementReference _mapEl;
    private MapInterop? _mapInterop;

    private SceneMode? _lastFitMode;

    private List<PlaceChooser.Choice>? _chooserPlaces;
    private double _chooserX;
    private double _chooserY;

    private string? _hoverArrowText;
    private double _arrowX;
    private double _arrowY;

    private string? _isolated;

    private PopoverOpening? _opening;

    private Frame _frame = new Frame.Current();
    private Emphasis _emphasis = new Emphasis.None();
    private readonly RequestSeries _focus = new();
    private readonly RequestSeries _crossing = new();
    private EffectClaim? _presentFocusClaim;

    private bool _follow =>
        ViewArrangementAtom.Value is { LayoutKind: LayoutKinds.SplitH, Follow: true } a
        && a.Members.Any(m => (Registry.CapabilitiesOf(m) & ViewCapabilities.BearsLocus) != 0)
        && a.Members.Any(m => (Registry.CapabilitiesOf(m) & ViewCapabilities.BearsWindow) != 0);

    // ViewArrangementAtom is a shared, page-independent DI singleton:
    // without this guard, a standalone /world instance's own subscription
    // would also fire -- and claim "follow-scene" -- whenever ANY page
    // dispatches Follow=true, not just this one.
    private bool _followEffectsLive => SplitMode;

    private bool _splitInitialized;

    private Projection<Locus>? _locusBacking;
    private Projection<Locus> _locus => _locusBacking ??= new Projection<Locus>(LocusAtom);
    private FollowTextLink _followLink = null!;
    private StateLinkRunner<Locus, TimeWindow> _followRunner = null!;

    private int _pickerSyncToken;

    private bool _lastKnownFollow;

    private DelegateEffect<TimeWindow>? _followSceneEffectBacking;
    private DelegateEffect<TimeWindow> _followSceneEffect => _followSceneEffectBacking ??= new DelegateEffect<TimeWindow>(
        EffectNames.FollowScene, TimeWindowAtom, value => value is ScriptureMode, value => RunScriptureModeEffectAndSurfaceFaults(((ScriptureMode)value).Ref));

    private EffectClaim? _followSceneClaim;

    private (double Lat, double Lon, double Zoom)? _pendingCamera;

    protected override async Task OnInitializedAsync()
    {
        RegisterQueryHandler?.Invoke(ApplyExternalQuery);

        SyncTimeWindowProjection();

        _followLink = new FollowTextLink(LocusAtom, TimeWindowAtom, () => _followEffectsLive && _follow);
        _followRunner = new StateLinkRunner<Locus, TimeWindow>(_followLink.Name, _followLink, LocusAtom, TimeWindowAtom);
        LocusAtom.Changed += OnLocusChanged;

        TimeWindowAtom.Changed += OnTimeWindowChanged;

        _lastKnownFollow = _follow;
        ViewArrangementAtom.Changed += OnViewArrangementChanged;

        AdoptAHandedOverExploration();
        _presentFocusClaim = Effects.Claim(new DelegateEffect<ExplorationState>(EffectNames.PresentFocus, ExplorationAtom, _ => true, PresentTheFocus));

        (await _startup.Next().Fetch(() => Atlas.Eras())).Match(
            arrived: eras => _eras = eras,
            failed: () => _errorMessage = "Couldn't load the timeline eras -- check your connection and try again.",
            superseded: () => { });
        (await _startup.Next().Fetch(() => Atlas.Landmarks())).Match(arrived: landmarks => _landmarks = landmarks, failed: () => { }, superseded: () => { });
        (await _startup.Next().Fetch(() => Atlas.LandMask())).Match(arrived: mask => _landMask = mask, failed: () => { }, superseded: () => { });
        (await _startup.Next().Fetch(() => Maps.Roster())).Match(arrived: roster => _polityRoster = roster, failed: () => { }, superseded: () => { });

        await PushLandmarksIfReady();
        await PushLandMaskIfReady();
        await PushPolityRosterIfReady();
    }

    private async Task PushLandMaskIfReady()
    {
        if (_landMaskPushed || _landMask is null || _mapInterop is null)
        {
            return;
        }

        _landMaskPushed = true;
        await _mapInterop.SetLandMask(_landMask);
    }

    private async Task PushPolityRosterIfReady()
    {
        if (_polityRosterPushed || _polityRoster is null || _mapInterop is null)
        {
            return;
        }

        _polityRosterPushed = true;
        await _mapInterop.SetPolitiesRoster(_polityRoster);
    }

    private async Task PushLandmarksIfReady()
    {
        if (_landmarksPushed || _landmarks is null || _mapInterop is null)
        {
            return;
        }

        _landmarksPushed = true;
        await _mapInterop.SetLandmarks(_landmarks);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_eras is null)
        {
            return;
        }

        if (SplitMode)
        {
            await InitializeSplitModeIfNeeded();
            return;
        }

        await SyncFromQuery();
    }

    private async Task InitializeSplitModeIfNeeded()
    {
        if (_splitInitialized)
        {
            return;
        }

        _splitInitialized = true;

        if (_follow)
        {
            await EnableFollowScene();
        }
        else if (ViewState.Map.HasData)
        {
            await RestoreMapState();
        }
        else
        {
            await EnterTimeMode(_from, _to);
        }
    }

    private void OnLocusChanged()
    {
        StateHasChanged();
    }

    private void OnTimeWindowChanged()
    {
        SyncTimeWindowProjection();
        StateHasChanged();
    }

    private void SyncTimeWindowProjection()
    {
        switch (TimeWindowAtom.Value)
        {
            case TimeMode tm:
                _scriptureRef = null;
                _from = tm.From;
                _to = tm.To;
                break;
            case ScriptureMode sm:
                _scriptureRef = sm.Ref;
                break;
        }
    }

    private void OnViewArrangementChanged()
    {
        var nowFollowing = _follow;
        if (_followEffectsLive && nowFollowing && !_lastKnownFollow)
        {
            _pickerSyncToken++;
            _ = EnableFollowScene();
        }
        else if (!nowFollowing && _lastKnownFollow)
        {
            DisableFollowScene();
        }

        _lastKnownFollow = nowFollowing;
        StateHasChanged();
    }

    private async Task EnableFollowScene()
    {
        _followSceneClaim?.Dispose();
        _followRunner.SyncNow();
        _followSceneClaim = Effects.Claim(_followSceneEffect);

        if (_followSceneClaim.ReconcileTask is { } task)
        {
            await task;
        }
    }

    private void DisableFollowScene()
    {
        _followSceneClaim?.Dispose();
        _followSceneClaim = null;
    }

    private async Task RunScriptureModeEffectAndSurfaceFaults(string sref)
    {
        try
        {
            await RunScriptureModeEffect(sref);
        }
        catch (Exception)
        {
            _errorMessage = $"Couldn't load {sref} -- check your connection and try again.";
            StateHasChanged();
        }
    }

    // Writes continuously, on every change, rather than once at dispose
    // time: Blazor gives no ordering guarantee between an outgoing
    // component's DisposeAsync and an incoming one's OnParametersSetAsync,
    // so capturing state only at dispose can lose it entirely on a
    // same-step navigation.
    private void SyncViewState()
    {
        ViewState.Map.HasData = true;
        ViewState.Map.From = _from;
        ViewState.Map.To = _to;
        ViewState.Map.ScriptureRef = _scriptureRef;
        if (SplitMode)
        {
            ViewState.Map.Follow = _follow;
        }
    }

    // Releases any "follow-scene" claim before dispatching directly: while
    // that effect is claimed, any change landing in ScriptureMode also
    // materializes through the registry, so skipping this release would
    // double-fetch.
    private Task EnterScriptureMode(string sref)
    {
        Effects.Release(EffectNames.FollowScene);
        TimeWindowAtom.Dispatch(new SetScriptureWindow(sref));
        return RunScriptureModeEffect(sref);
    }

    private async Task RunScriptureModeEffect(string sref)
    {
        SyncTimeWindowProjection();
        SyncViewState();
        if (_mapInterop is not null)
        {
            await _mapInterop.SetPolitiesVisible(false);
        }

        await DebouncedLoadScriptureScene(sref);
    }

    private Task EnterTimeMode(int from, int to, string? focusPlaceId = null)
    {
        TimeWindowAtom.Dispatch(new SetTimeWindow(from, to));
        return RunTimeModeEffect(from, to, focusPlaceId);
    }

    private Task RunTimeModeEffect(int from, int to, string? focusPlaceId = null)
    {
        SyncTimeWindowProjection();
        SyncViewState();
        return DebouncedLoadScene(from, to, focusPlaceId);
    }

    private async Task RestoreMapState()
    {
        if (ViewState.Map.ScriptureRef is { } sref)
        {
            await EnterScriptureMode(sref);
            return;
        }

        _lastFitMode = SceneMode.Time;
        await EnterTimeMode(ViewState.Map.From, ViewState.Map.To);

        if (ViewState.Map.CenterLat is double lat && ViewState.Map.CenterLon is double lon && ViewState.Map.Zoom is double zoom)
        {
            _pendingCamera = (lat, lon, zoom);
            await PushPendingCameraIfReady();
        }
    }

    private async Task PushPendingCameraIfReady()
    {
        if (_pendingCamera is not { } cam || _mapInterop is null)
        {
            return;
        }

        _pendingCamera = null;
        await _mapInterop.SetCamera(cam.Lat, cam.Lon, cam.Zoom);
    }

    private async Task OnToggleFollowClick()
    {
        var newFollow = !_follow;
        ViewArrangementAtom.Dispatch(new ToggleFollow(newFollow));
        SyncViewState();

        if (!newFollow)
        {
            await EnterTimeMode(_from, _to);
            return;
        }

        if (_followSceneClaim?.ReconcileTask is { } task)
        {
            await task;
        }
    }

    public async Task ApplyExternalQuery(string query)
    {
        ViewArrangementAtom.Dispatch(new ToggleFollow(false));
        StateHasChanged();

        var parts = query.Split('&')
            .Select(p => p.Split('=', 2))
            .Where(kv => kv.Length == 2)
            .ToDictionary(kv => kv[0], kv => Uri.UnescapeDataString(kv[1]));

        if (parts.TryGetValue("ref", out var sref))
        {
            await EnterScriptureMode(sref);
            return;
        }

        if (parts.TryGetValue("from", out var fromText) && parts.TryGetValue("to", out var toText)
            && int.TryParse(fromText, out var from) && int.TryParse(toText, out var to))
        {
            parts.TryGetValue("place", out var placeId);
            await EnterTimeMode(from, to, placeId);
        }
    }

    private Task InvokeEnterSplitHatch() =>
        Registry.Get(ViewNames.World).EscapeHatches.First(h => h.Kind == HatchKinds.EnterSplit).Invoke();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _mapInterop = await MapInterop.Create(JS, _mapEl, mini: false, this);
        if (_scene is not null)
        {
            await _mapInterop.SetScene(_scene);
            var thisMode = _scriptureRef is not null ? SceneMode.Scripture : SceneMode.Time;
            if (_lastFitMode != thisMode)
            {
                await _mapInterop.FitScene();
            }

            _lastFitMode = thisMode;
        }

        if (_polities is not null && _scriptureRef is null)
        {
            await _mapInterop.SetPolitiesVisible(true);
            await _mapInterop.SetPolities(_polities, _from, _to);
        }

        await PushLandmarksIfReady();
        await PushLandMaskIfReady();
        await PushPolityRosterIfReady();

        await PushPendingCameraIfReady();

        await _mapInterop.Emphasize(_emphasis);
    }

    private async Task SyncFromQuery()
    {
        if (!string.IsNullOrEmpty(RefQuery))
        {
            await EnterScriptureMode(RefQuery);
            return;
        }

        if (FromQuery is null && ToQuery is null)
        {
            if (_scene is null)
            {
                if (ViewState.Map.HasData)
                {
                    await RestoreMapState();
                }
                else
                {
                    await EnterTimeMode(_from, _to);
                }
            }

            return;
        }

        if (!int.TryParse(FromQuery, out var from) || !int.TryParse(ToQuery, out var to))
        {
            _errorMessage = "That link's time window isn't valid. Showing the last window -- try the slider.";
            return;
        }

        if (from == 0 || to == 0)
        {
            _errorMessage = "Year 0 doesn't exist on this timeline (1 BC is followed by AD 1). Showing the last window -- try the slider.";
            return;
        }

        if (from > to)
        {
            _errorMessage = "That time window is backwards -- the start year is after the end year. Showing the last window -- try the slider.";
            return;
        }

        await EnterTimeMode(from, to, PlaceQuery);
    }

    private bool _dragMorphing;

    private async Task HandleWindowDrag((int From, int To) window)
    {
        if (_mapInterop is null || _polityRoster is null)
        {
            return;
        }

        int probeYear;
        if (window.From != _from)
        {
            probeYear = window.From;
        }
        else if (window.To != _to)
        {
            probeYear = window.To;
        }
        else
        {
            return;
        }

        if (!_dragMorphing)
        {
            _dragMorphing = true;
            await _mapInterop.BeginMorph();
        }
        await _mapInterop.MorphFrame(window.From, window.To, probeYear);
    }

    private async Task HandleWindowChange((int From, int To) window)
    {
        if (_dragMorphing)
        {
            _dragMorphing = false;
            if (_mapInterop is not null)
            {
                await _mapInterop.SettleMorph(window.From, window.To);
            }
        }

        await MoveWindow(window.From, window.To);
    }

    private async Task MoveWindow(int from, int to)
    {
        if (SplitMode)
        {
            await ApplyExternalQuery($"from={from}&to={to}");
            return;
        }

        var uri = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["from"] = from,
            ["to"] = to,
            ["ref"] = null,
        });
        Nav.NavigateTo(uri, replace: true);
    }

    private Task ApplyScriptureRef(string sref)
    {
        if (SplitMode)
        {
            return ApplyExternalQuery($"ref={Uri.EscapeDataString(sref)}");
        }

        var uri = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["ref"] = sref,
            ["from"] = null,
            ["to"] = null,
        });
        Nav.NavigateTo(uri, replace: true);
        return Task.CompletedTask;
    }

    private Task ReturnToTime() => MoveWindow(_from, _to);

    private async Task HandleIsolate(string? narrativeId)
    {
        _isolated = narrativeId;
        if (_mapInterop is not null)
        {
            await _mapInterop.SetIsolate(narrativeId);
        }
    }

    private async Task DebouncedLoadScene(int from, int to, string? focusPlaceId = null)
    {
        await JS.InvokeVoidAsync("performance.mark", "atlas:scene-start");
        var request = _scenes.Next();

        try
        {
            await Task.Delay(60, request.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        try
        {
            await (await request.Fetch(() => Maps.During(from, to))).Match(
                arrived: layers => ShowTimeScene(layers, from, to, focusPlaceId),
                failed: () => _errorMessage = TimeWindowUnloaded,
                superseded: () => { });
        }
        catch (Exception)
        {
            if (!request.Superseded)
            {
                _errorMessage = TimeWindowUnloaded;
            }
        }
        finally
        {
            StateHasChanged();
        }
    }

    private const string TimeWindowUnloaded = "Couldn't load that time window -- check your connection and try again.";

    private async Task ShowTimeScene(MapLayers layers, int from, int to, string? focusPlaceId)
    {
        var scene = layers.Scene;
        _scene = scene;
        _polities = layers.Polities;
        _timeWindow = scene.Window;
        _errorMessage = null;
        _isolated = null;

        if (_mapInterop is not null)
        {
            await _mapInterop.SetScene(scene);
            await _mapInterop.SetPolitiesVisible(true);
            await _mapInterop.SetPolities(layers.Polities, from, to);
            await JS.InvokeVoidAsync("performance.mark", "atlas:scene-rendered");

            if (_lastFitMode != SceneMode.Time)
            {
                await _mapInterop.FitScene();
                _lastFitMode = SceneMode.Time;
            }

            if (focusPlaceId is not null)
            {
                var focusPlace = scene.Places.FirstOrDefault(p => p.Id == focusPlaceId);
                if (focusPlace is not null)
                {
                    await _mapInterop.PanToPlace(focusPlace.Lat, focusPlace.Lon);
                }
            }
        }
    }

    private async Task DebouncedLoadScriptureScene(string sref)
    {
        var request = _scenes.Next();

        try
        {
            await Task.Delay(150, request.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        try
        {
            await (await request.Fetch(() => Maps.For(sref))).Match(
                arrived: ShowScriptureScene,
                failed: () => _errorMessage = ScriptureUnloaded(sref),
                superseded: () => { });
        }
        catch (Exception)
        {
            if (!request.Superseded)
            {
                _errorMessage = ScriptureUnloaded(sref);
            }
        }
        finally
        {
            StateHasChanged();
        }

        await LabelTheSlidersWindow(request);
    }

    private static string ScriptureUnloaded(string sref) => $"Couldn't load {sref} -- check your connection and try again.";

    private async Task ShowScriptureScene(MapLayers layers)
    {
        _scene = layers.Scene;
        _errorMessage = null;
        _isolated = null;

        if (_mapInterop is not null)
        {
            await _mapInterop.SetScene(layers.Scene);
            await _mapInterop.FitScene();

            _lastFitMode = SceneMode.Scripture;
        }
    }

    private async Task LabelTheSlidersWindow(Request request)
    {
        (await SliderWindow.ServedFor(request, Atlas, _timeWindow, _from, _to)).Match(arrived: window => _timeWindow = window ?? _timeWindow, failed: () => { }, superseded: () => { });
        StateHasChanged();
    }

