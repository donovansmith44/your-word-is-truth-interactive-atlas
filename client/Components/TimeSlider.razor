@* Each band renders at an exact flex: 0 0 {px}px width from SliderScale.EraWidths (the same
   numbers the handles' pixel math uses) -- flex-grow with a min-width-percentage drifted
   enough, once the track shrank, for a released handle to land on the wrong era's button. *@

<div class="slider" data-testid="slider" aria-disabled="@(Disabled ? "true" : "false")">
    <input class="slider-readout"
           data-testid="slider-readout"
           value="@_readoutText"
           spellcheck="false"
           aria-label="Time window"
           @oninput="OnReadoutInput"
           @onkeydown="OnReadoutKeyDown" />

    <div class="slider-track"
         @onpointermove="OnTrackPointerMove"
         @onpointerup="OnTrackPointerUp"
         @onpointercancel="OnTrackPointerUp"
         @onpointerleave="OnTrackPointerUp">
        @for (var i = 0; i < Eras.Count; i++)
        {
            var era = Eras[i];
            var active = EffectiveFrom <= era.ToYear && EffectiveTo >= era.FromYear;
            var bandWidthPx = EraWidthsPx[i].ToString(System.Globalization.CultureInfo.InvariantCulture);
            <button type="button"
                    class="slider-era"
                    data-testid="slider-era-@era.Id"
                    data-active="@(active ? "true" : "false")"
                    style="flex: 0 0 @(bandWidthPx)px;@(_dragTarget is not null ? " pointer-events: none;" : "")"
                    title="@era.Name"
                    @onclick="() => ApplyEra(era)">
                @era.Name
            </button>
        }

        @if (Eras.Count > 0)
        {
            <div class="slider-handle slider-handle-from"
                 style="left: @(HandleX(EffectiveFrom).ToString(System.Globalization.CultureInfo.InvariantCulture))px;@(_dragTarget is not null ? " pointer-events: none;" : "")"
                 role="slider"
                 tabindex="0"
                 aria-label="Window start year"
                 aria-valuenow="@EffectiveFrom"
                 aria-valuemin="@Eras[0].FromYear"
                 aria-valuemax="@Eras[^1].ToYear"
                 aria-valuetext="@YearText.Format(EffectiveFrom)"
                 @onpointerdown="@(() => OnHandlePointerDown("from"))"
                 @onkeydown="@(e => OnHandleKeyDown("from", e))"></div>
            <div class="slider-handle slider-handle-to"
                 style="left: @(HandleX(EffectiveTo).ToString(System.Globalization.CultureInfo.InvariantCulture))px;@(_dragTarget is not null ? " pointer-events: none;" : "")"
                 role="slider"
                 tabindex="0"
                 aria-label="Window end year"
                 aria-valuenow="@EffectiveTo"
                 aria-valuemin="@Eras[0].FromYear"
                 aria-valuemax="@Eras[^1].ToYear"
                 aria-valuetext="@YearText.Format(EffectiveTo)"
                 @onpointerdown="@(() => OnHandlePointerDown("to"))"
                 @onkeydown="@(e => OnHandleKeyDown("to", e))"></div>
        }
    </div>
</div>

@code {
    // Must equal .slider-track's content-box width (app.css) exactly, so a pointer's OffsetX
    // maps 1:1 onto SliderScale's pixel space with no DOM measurement needed. app.css gives
    // .slider-track `box-sizing: content-box` specifically so its literal width:520px isn't
    // shrunk by the 1px border the way the project-wide border-box reset would (leaving
    // OffsetX 2px short and making the final era's last year(s) unreachable by drag). Update
    // this constant together with app.css if either ever changes.
    private const double TrackWidthPx = 520.0;

    private const double SnapThresholdPx = 6.0;

    [Parameter] public List<EraDto> Eras { get; set; } = new();
    [Parameter] public int From { get; set; }
    [Parameter] public int To { get; set; }
    [Parameter] public EventCallback<(int From, int To)> OnWindowChange { get; set; }

    // Fires on every pointermove while dragging (unlike OnWindowChange, which only fires at
    // commit) -- drives World.razor's live morph preview at the raw event frequency;
    // coalescing to one frame happens downstream (map.js), not here.
    [Parameter] public EventCallback<(int From, int To)> OnWindowDrag { get; set; }

    // aria-disabled rather than native disabled, so the control stays focusable for assistive
    // tech; every handler below independently no-ops on Disabled since CSS can only block
    // pointer events, not a keyboard path.
    [Parameter] public bool Disabled { get; set; }

    private string _readoutText = "";
    private int _lastFrom = int.MinValue;
    private int _lastTo = int.MinValue;

    private string? _dragTarget; // "from" | "to" | null when idle
    private int _dragFrom;
    private int _dragTo;

    private int EffectiveFrom => _dragTarget is not null ? _dragFrom : From;
    private int EffectiveTo => _dragTarget is not null ? _dragTo : To;

    private double[] EraWidthsPx => SliderScale.EraWidths(Eras, TrackWidthPx);

    protected override void OnParametersSet()
    {
        // Resync only when From/To actually change, so a keystroke mid-edit in the readout is
        // never clobbered before Enter is pressed.
        if (From != _lastFrom || To != _lastTo)
        {
            _lastFrom = From;
            _lastTo = To;
            _readoutText = YearText.FormatRange(From, To);
        }
    }

    private void OnReadoutInput(ChangeEventArgs e)
    {
        if (Disabled)
        {
            return;
        }

        _readoutText = e.Value?.ToString() ?? "";
    }

    private async Task OnReadoutKeyDown(KeyboardEventArgs e)
    {
        if (Disabled || e.Key != "Enter")
        {
            return;
        }

        if (YearText.TryParse(_readoutText, out var from, out var to))
        {
            await OnWindowChange.InvokeAsync((from, to));
        }
    }

    private async Task ApplyEra(EraDto era)
    {
        if (Disabled)
        {
            return;
        }

        await OnWindowChange.InvokeAsync((era.FromYear, era.ToYear));
    }

    private void OnHandlePointerDown(string which)
    {
        if (Disabled)
        {
            return;
        }

        _dragTarget = which;
        _dragFrom = From;
        _dragTo = To;
    }

    private async Task OnTrackPointerMove(PointerEventArgs e)
    {
        if (_dragTarget is null || Eras.Count == 0)
        {
            return;
        }

        var year = SliderScale.XToYear(e.OffsetX, Eras, TrackWidthPx);
        if (_dragTarget == "from")
        {
            _dragFrom = Math.Min(year, _dragTo);
        }
        else
        {
            _dragTo = Math.Max(year, _dragFrom);
        }

        await OnWindowDrag.InvokeAsync((_dragFrom, _dragTo));
    }

    // Snaps only at release, never during the drag itself, so the brush visibly tracks the
    // pointer right up to release; a mid-era release keeps the exact dragged year.
    private async Task OnTrackPointerUp(PointerEventArgs e)
    {
        if (_dragTarget is null)
        {
            return;
        }

        var (from, to) = (_dragFrom, _dragTo);
        if (_dragTarget == "from")
        {
            from = Math.Min(SnapToEraBoundary(from, e.OffsetX), to);
        }
        else
        {
            to = Math.Max(SnapToEraBoundary(to, e.OffsetX), from);
        }

        _dragTarget = null;
        if (from != From || to != To)
        {
            await OnWindowChange.InvokeAsync((from, to));
        }
    }

    // Checks both FromYear and ToYear of every era (adjacent eras' boundary years differ by
    // one, not shared -- e.g. primeval ends -2167, patriarchs starts -2166). Compares against
    // the raw release pixel, not the already-year-quantized draggedYear, since that's the
    // more precise signal for where the pointer actually let go.
    private int SnapToEraBoundary(int draggedYear, double releaseOffsetX)
    {
        int? nearestYear = null;
        var nearestDist = double.MaxValue;
        foreach (var era in Eras)
        {
            foreach (var boundary in new[] { era.FromYear, era.ToYear })
            {
                var boundaryX = SliderScale.YearToX(boundary, Eras, TrackWidthPx);
                var dist = Math.Abs(boundaryX - releaseOffsetX);
                if (dist < nearestDist)
                {
                    nearestDist = dist;
                    nearestYear = boundary;
                }
            }
        }

        return nearestYear is int boundaryYear && nearestDist <= SnapThresholdPx ? boundaryYear : draggedYear;
    }

    private async Task OnHandleKeyDown(string which, KeyboardEventArgs e)
    {
        var delta = e.Key switch { "ArrowLeft" => -1, "ArrowRight" => 1, _ => 0 };
        if (Disabled || delta == 0 || Eras.Count == 0)
        {
            return;
        }

        var from = From;
        var to = To;
        if (which == "from")
        {
            from = ClampToSpan(NudgeYear(From, delta));
            if (from > to)
            {
                from = to;
            }
        }
        else
        {
            to = ClampToSpan(NudgeYear(To, delta));
            if (to < from)
            {
                to = from;
            }
        }

        if (from != From || to != To)
        {
            await OnWindowChange.InvokeAsync((from, to));
        }
    }

    // There is no year 0 (1 BC is immediately followed by AD 1); stepping by
    // one year must hop over it rather than land on it.
    private static int NudgeYear(int year, int delta)
    {
        var next = year + delta;
        return next == 0 ? next + delta : next;
    }

    private int ClampToSpan(int year) => Math.Clamp(year, Eras[0].FromYear, Eras[^1].ToYear);

    private double HandleX(int year) => Eras.Count == 0 ? 0 : SliderScale.YearToX(year, Eras, TrackWidthPx);
}
