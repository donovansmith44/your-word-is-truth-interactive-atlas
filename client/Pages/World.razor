@page "/world"
@using System.Globalization
@implements IAsyncDisposable
@implements IMapEvents
@inject AtlasClient Atlas
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Bible Explorer &mdash; World</PageTitle>

<div class="world-page">
    <div id="world-map" class="world-map" data-testid="world-map" @ref="_mapEl"></div>

    <ScripturePicker OnApply="ApplyScriptureRef" ThemeClass="picker-dusk" />

    @if (_scene is not null && _scene.Places.Count == 0)
    {
        <p class="world-empty">No recorded events in this window &mdash; drag the timeline or choose a scripture.</p>
    }

    @{ var hoverPlace = _hoverPlace; }
    @if (hoverPlace is not null)
    {
        <PlaceCard Place="hoverPlace" X="_hoverX" Y="_hoverY"
                   WindowFrom="@(_scriptureRef is null ? _from : (int?)null)"
                   WindowTo="@(_scriptureRef is null ? _to : (int?)null)"
                   OnPointerEnter="CardPointerEnter" OnPointerLeave="CardPointerLeave"
                   OnOpenPlace="OpenPlaceFromCard" OnExploreNode="OpenExploreNode"
                   Pinned="@(_pinnedPlaceId is not null)" Arrows="_scene?.Arrows" Narratives="_scene?.Narratives"
                   OnGoToPlace="GoToAdjacent" OnClosePin="ClosePinnedCard" />
    }

    @if (_hoverArrowText is not null)
    {
        <div class="arrow-tip" data-testid="arrow-tip"
             style="left: @_arrowX.ToString(CultureInfo.InvariantCulture)px; top: @_arrowY.ToString(CultureInfo.InvariantCulture)px;">
            @_hoverArrowText
        </div>
    }

    @if (_eras is not null)
    {
        <TimeSlider Eras="_eras" From="_from" To="_to"
                    Disabled="@(_scriptureRef is not null)" OnWindowChange="HandleWindowChange" />
    }

    @if (_scriptureRef is not null)
    {
        <div class="mode-chip" data-testid="mode-chip">
            <span class="mode-chip-label">Scripture</span>
            <span class="mode-chip-ref">@_scriptureRef</span>
            <button type="button" class="mode-chip-return" data-testid="mode-chip-return" @onclick="ReturnToTime">
                Return to time
            </button>
        </div>
    }

    @if (_scene is not null && _scene.Narratives.Count > 0)
    {
        <Legend Narratives="_scene.Narratives" IsolatedId="@_isolated" OnIsolate="HandleIsolate" />
    }

    @if (_errorMessage is not null)
    {
        <div class="toast" data-testid="toast">
            <p class="toast-message">@_errorMessage</p>
        </div>
    }
</div>

@* Rendered as a SIBLING of .world-page, not nested inside it -- same
   placement Reader.razor already uses for its own ExplorerPopover. Load-
   bearing, not just conventional: a mini-map (Task 15's <MiniWorld>, opened
   via WORLD-8's place-history flow) is meant to stay a "daylight" figure
   regardless of which page opened it (see MiniWorld.razor's own comment);
   nesting the popover inside .world-page would make its embedded Leaflet
   tile pane a DOM descendant of ".world-page .leaflet-tile-pane", picking
   up the dusk page's own sepia warmth filter by CSS accident. *@
@if (_activeNode is not null)
{
    <ExplorerPopover @key="_activeNode" Root="_activeNode" OnClose="ClosePopover" />
}

@code {
    // No window specified at all (bare "/world"): Batch C / CONTRACT
    // amendment (design-direction.md + user feedback 2026-08-19) -- default
    // to the "gospels" era EXACTLY ([-5, 29], data/curated/eras.toml),
    // replacing the old full-span default. The full 10-era timeline lights
    // up to 167 places at once (see tests/ux/playwright.config.ts's own
    // WORLD-1 timing comment) -- an overwhelming first screen, and exactly
    // what the zoom-tiered label density (map.js) exists to soften but
    // shouldn't have to paper over on the very first paint. Gospels is a
    // small, richly-narrated, broadly-recognizable window -- a focused
    // start rather than an arbitrary slice. Deep links with an explicit
    // ?from=&to=/?ref= are completely untouched by this (SyncFromQuery only
    // ever reads these two constants when BOTH FromQuery and ToQuery are
    // absent), so this is purely a "what a bare /world shows" change.
    private const int DefaultFrom = -5;
    private const int DefaultTo = 29;

    [SupplyParameterFromQuery(Name = "from")]
    [Parameter]
    public string? FromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "to")]
    [Parameter]
    public string? ToQuery { get; set; }

    // Scripture mode (Task 13, WORLD-6/NAV-1). Non-null exactly when a
    // scripture ref -- not a time window -- is driving the scene; every
    // other piece of mode state (TimeSlider's Disabled, mode-chip's render,
    // which fetch SyncFromQuery kicks below) branches on this one field.
    [SupplyParameterFromQuery(Name = "ref")]
    [Parameter]
    public string? RefQuery { get; set; }

    private List<EraDto>? _eras;
    private Scene? _scene;
    private string? _errorMessage;
    private string? _scriptureRef;

    // Atlas plate detail (design-direction.md, ADDED PER USER FEEDBACK
    // 2026-08-18; data model replaced by Batch B2's own per-polity
    // timerange borders): the last successfully-fetched polity list and
    // the curated landmark list (fetched once in OnInitializedAsync,
    // pushed to the map once it exists). Both stay null until their first
    // successful fetch and are never reset to null afterward -- a later
    // failed refetch just leaves the prior (still-honest, if slightly
    // stale) value in place, same "last good state stays" philosophy the
    // toast already uses for _scene.
    private PolitiesOut? _polities;
    private List<LandmarkDto>? _landmarks;

    // Guards PushLandmarksIfReady below against double-pushing -- unlike
    // _scene/_polities (each refetched on every window change, with their
    // own natural "only apply if this fetch is still current" logic),
    // landmarks are fetched exactly ONCE, so the race between "the fetch
    // resolves" and "the map gets created" needs an explicit once-only
    // flag instead of reusing that machinery.
    private bool _landmarksPushed;

    // The most recently APPLIED time-mode window -- i.e. the last from/to
    // SyncFromQuery validated, which is exactly "the window to return to"
    // (WORLD-6's mode-chip-return). Only the time-mode branch below ever
    // assigns these, so arriving directly on a scripture deep link (never
    // having had a time-mode URL this session) correctly leaves them at the
    // whole-span default, per the brief.
    private int _from = DefaultFrom;
    private int _to = DefaultTo;
    private CancellationTokenSource? _fetchCts;

    private ElementReference _mapEl;
    private MapInterop? _mapInterop;

    // Fit-camera policy (fix round 1: replaces a plain "has any scene ever
    // been fit" bool, which caused a real bug -- see the finding this
    // fixes). null = nothing fit yet; "time"/"scripture" = the mode of the
    // MOST RECENT fit. A load re-fits the camera when its own mode differs
    // from _lastFitMode (covers both "first scene of the page's life" --
    // null never equals either mode -- and "the mode just changed", which
    // is exactly what mode-chip-return needs: after any scripture visit,
    // returning to time mode must re-fit even though a time-mode scene had
    // already been fit once before, earlier in the session) OR when the
    // load itself is scripture mode (DebouncedLoadScriptureScene always
    // fits, unconditionally, on every load -- see its own comment; it also
    // stamps this field so a LATER return to time mode is correctly
    // detected as a mode change). Ordinary same-mode time-window changes
    // (slider drag, era click, readout Enter) still never re-fit -- Task
    // 10's original policy, preserved for that one case.
    private string? _lastFitMode;

    // Hover-card state. IMapEvents.OnPlaceHover/OnPlaceLeave below are
    // invoked from map.js (via MapEventsSink), not through Blazor's own
    // event dispatch, so each one calls StateHasChanged() itself.
    private ScenePlace? _hoverPlace;
    private double _hoverX;
    private double _hoverY;
    private CancellationTokenSource? _closeCts;

    // Batch G1 requirement 3 (click-to-pin): non-null exactly when a marker
    // (lit or quiet) has been clicked and its card should stay open
    // regardless of hover state, closing only via Escape, the card's own
    // close button, or a click elsewhere on the map. _hoverPlace/_hoverX/
    // _hoverY are STILL what the card actually renders from (unchanged
    // rendering path) -- this field is purely the "is the currently-shown
    // card pinned, and to what" flag every close/hover path below checks.
    // OnPlaceHover/OnPlaceClick/GoToAdjacent are the only writers; CloseCardNow
    // is the ONE place that clears it, so a fully-closed card can never
    // leave this field pointing at nothing shown (see its own comment).
    private string? _pinnedPlaceId;

    // Requirement 0c (user 2026-08-19: "hover interactions on both the map
    // and the Bible are extremely fickle. FIX IT."): the real, root-caused
    // bug behind that report -- reproduced properly here, in source, not
    // the demo-only hotpatch's document-query workaround. The pointer's
    // physical journey off a marker and onto the card it's already
    // pointing at is TWO separate DOM events on TWO separate elements
    // (Leaflet's marker `mouseout`, dispatched to .NET via an async JS
    // interop call -- MapInterop/map.js's wireEvents -- and PlaceCard's own
    // `@onpointerenter`, dispatched through Blazor's own, also-async event
    // pipeline) with NO ordering guarantee between them. The marker's own
    // leave can resolve in C# AFTER the card's enter already ran: if
    // OnPlaceLeave always scheduled a close regardless, that LATE-arriving
    // schedule has nothing left to cancel it (the card's own enter, which
    // would have cancelled it, already fired in the past), and the card
    // closes out from under a pointer that is legitimately still sitting on
    // it. `_pointerOverCard` closes that race: it's the one piece of state
    // both sides can check that doesn't depend on event ORDER, only on
    // where the pointer physically is RIGHT NOW -- see OnPlaceLeave and
    // CardPointerEnter/CardPointerLeave below for the two halves of the fix.
    private bool _pointerOverCard;

    // arrow-tip state (WORLD-4/contract "arrow-tip"). Text is precomputed
    // (rather than a place/arrow reference resolved in markup) so a stale
    // key that no longer resolves against the current scene just clears the
    // tip instead of throwing mid-render.
    private string? _hoverArrowText;
    private double _arrowX;
    private double _arrowY;

    // Legend isolate (WORLD-4). Legend.razor is a controlled component --
    // this is the single source of truth it renders aria-pressed from, and
    // the value HandleIsolate below forwards to MapInterop.SetIsolate.
    // Reset to null whenever a new scene loads (DebouncedLoadScene) so the
    // legend never shows a narrative "pressed" after a window change wipes
    // out whatever isolate the user had set on the PREVIOUS scene. The
    // arrows' own data-faded attributes are reset back to "false" the same
    // way, independently -- ArrowLayer.setArrows (map.js) does that
    // unconditionally for every existing path, including ones that survive
    // the change under the same narrative:order key, so the two stay in
    // sync without this field needing to call MapInterop.SetIsolate(null)
    // itself on every load.
    private string? _isolated;

    // WORLD-8/Task 15: PlaceCard's title promotes the hover card's content
    // into a real ExplorerPopover -- same @key-per-instance pattern
    // Reader.razor already uses so a different node always remounts a
    // fresh popover (breadcrumb stack included) rather than diffing into
    // an existing one. Batch D removed PlaceCard's OTHER, older route into
    // a popover (the verse-group index rows) along with the rows
    // themselves -- see PlaceCard.razor's own file header.
    private IExplorable? _activeNode;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _eras = await Atlas.Eras();
        }
        catch (Exception)
        {
            // No eras means no usable slider; surface it the same way as any
            // other fetch failure rather than crashing the page.
            _errorMessage = "Couldn't load the timeline eras -- check your connection and try again.";
        }

        try
        {
            _landmarks = await Atlas.Landmarks();
        }
        catch (Exception)
        {
            // Landmarks are map decoration, not load-bearing -- same silent,
            // non-fatal treatment as borders (design-direction.md's Atlas
            // plate detail): the map still works fine with no labels.
        }

        // If OnInitializedAsync's own await above didn't complete
        // synchronously (the normal case -- it's a real network fetch),
        // Blazor already rendered once with _mapInterop still unset, so
        // OnAfterRenderAsync(firstRender: true) can fire and find
        // _mapInterop non-null BEFORE this line ever runs (confirmed: this
        // is exactly the race a naive "OnInitializedAsync always finishes
        // before the first render" assumption misses -- Blazor's own
        // contract is the opposite: an incomplete OnInitializedAsync task
        // gets an interim render, not a delayed one). Covers that case;
        // OnAfterRenderAsync's own call covers the reverse ordering.
        await PushLandmarksIfReady();
    }

    // Pushes the curated landmark list to the map exactly once, whichever
    // of OnInitializedAsync's fetch or OnAfterRenderAsync's map-creation
    // happens to resolve second (see _landmarksPushed's own comment).
    private async Task PushLandmarksIfReady()
    {
        if (_landmarksPushed || _landmarks is null || _mapInterop is null)
        {
            return;
        }

        _landmarksPushed = true;
        await _mapInterop.SetLandmarks(_landmarks);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_eras is null)
        {
            return;
        }

        await SyncFromQuery();
    }

    // The Leaflet map can only be created once #world-map is actually in
    // the DOM, i.e. after the component's first render. If a scene fetch
    // already resolved by then (DebouncedLoadScene below skips pushing it
    // because _mapInterop was still null at the time), push it now instead
    // -- whichever of the two finishes second is the one that actually
    // calls SetScene/FitScene, so a scene is never dropped and never
    // applied twice.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _mapInterop = await MapInterop.Create(JS, _mapEl, mini: false, this);
        if (_scene is not null)
        {
            await _mapInterop.SetScene(_scene);
            await _mapInterop.FitScene();
            // _scriptureRef is already set (SyncFromQuery sets it synchronously,
            // before either fetch method's first await) by the time a scene can
            // possibly be non-null here, so it accurately names which mode
            // produced _scene.
            _lastFitMode = _scriptureRef is not null ? "scripture" : "time";
        }

        // Same "already resolved before the map existed" race as _scene
        // above, for polities: only push them if we're not (by now) in
        // scripture mode -- a deep link straight into scripture mode must
        // never show a polity-border layer it never asked for, matching
        // DebouncedLoadScriptureScene's own SetPolitiesVisible(false).
        if (_polities is not null && _scriptureRef is null)
        {
            await _mapInterop.SetPolitiesVisible(true);
            await _mapInterop.SetPolities(_polities.Polities);
        }

        // Landmarks: same "whichever resolves second" race as _scene/
        // _polities above, just fetched once in OnInitializedAsync instead
        // of on every window change -- see PushLandmarksIfReady/
        // _landmarksPushed's own comments for why a naive "OnInitializedAsync
        // always finishes before the first render" assumption is wrong.
        await PushLandmarksIfReady();
    }

    // Single path for every window/ref change, whether it comes from the
    // user (slider drag / era click / readout Enter / picker apply / mode-
    // chip-return, via HandleWindowChange/ApplyScriptureRef/ReturnToTime
    // below) or directly from a URL (deep link, browser reload,
    // back/forward): all of them change the query string, which re-supplies
    // FromQuery/ToQuery/RefQuery and re-runs this method through
    // OnParametersSetAsync. RefQuery wins whenever present -- applying the
    // picker/deep-linking into scripture mode REPLACES from/to in the URL
    // (never both at once, see ApplyScriptureRef/ReturnToTime), so checking
    // it first is enough to fully separate the two branches below.
    private async Task SyncFromQuery()
    {
        if (!string.IsNullOrEmpty(RefQuery))
        {
            _scriptureRef = RefQuery;

            // Fix round 1 (finding 5): hide the polity-border LAYER the
            // moment scripture mode is entered -- unconditionally, right
            // where _scriptureRef itself is set, before the scene fetch
            // below even starts. Previously this only happened in
            // DebouncedLoadScriptureScene's SUCCESS branch, so a failed
            // scripture fetch left the vector layer painting with no time
            // window to justify it.
            if (_mapInterop is not null)
            {
                await _mapInterop.SetPolitiesVisible(false);
            }

            await DebouncedLoadScriptureScene(RefQuery);
            return;
        }

        _scriptureRef = null;

        if (FromQuery is null && ToQuery is null)
        {
            if (_scene is null)
            {
                await DebouncedLoadScene(_from, _to);
            }

            return;
        }

        if (!int.TryParse(FromQuery, out var from) || !int.TryParse(ToQuery, out var to))
        {
            _errorMessage = "That link's time window isn't valid. Showing the last window -- try the slider.";
            return;
        }

        if (from == 0 || to == 0)
        {
            _errorMessage = "Year 0 doesn't exist on this timeline (1 BC is followed by AD 1). Showing the last window -- try the slider.";
            return;
        }

        if (from > to)
        {
            _errorMessage = "That time window is backwards -- the start year is after the end year. Showing the last window -- try the slider.";
            return;
        }

        _from = from;
        _to = to;
        await DebouncedLoadScene(from, to);
    }

    private Task HandleWindowChange((int From, int To) window)
    {
        var uri = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["from"] = window.From,
            ["to"] = window.To,
        });
        Nav.NavigateTo(uri, replace: true);
        return Task.CompletedTask;
    }

    // ScripturePicker.OnApply (Task 13/WORLD-6). The picker itself is
    // world-agnostic (see its own file header) -- this is the one place
    // that decides applying it means entering /world's scripture mode.
    // `ref` REPLACES from/to in the URL (both explicitly nulled out, not
    // just left stale/ignored) so the two modes are never simultaneously
    // present in the query string -- SyncFromQuery's own RefQuery-first
    // check depends on that invariant.
    private Task ApplyScriptureRef(string sref)
    {
        var uri = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["ref"] = sref,
            ["from"] = null,
            ["to"] = null,
        });
        Nav.NavigateTo(uri, replace: true);
        return Task.CompletedTask;
    }

    // mode-chip-return (WORLD-6). _from/_to are already exactly "the last
    // applied time-mode window" (see their own field comment) -- restoring
    // it is just navigating back to it, symmetric with ApplyScriptureRef
    // above (ref explicitly nulled out this time).
    private Task ReturnToTime()
    {
        var uri = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["from"] = _from,
            ["to"] = _to,
            ["ref"] = null,
        });
        Nav.NavigateTo(uri, replace: true);
        return Task.CompletedTask;
    }

    // WORLD-4: Legend.razor already decided the new value (null = clear,
    // otherwise the narrative to isolate) -- this just stores it (so Legend
    // re-renders aria-pressed correctly, per the IsolatedId parameter below)
    // and forwards it to the map. No explicit StateHasChanged() needed here
    // (unlike OnPlaceHover/OnArrowHover/etc. below, which DO need it): this
    // handler is invoked through Blazor's own EventCallback machinery
    // (Legend's button click -> Legend.Toggle -> OnIsolate.InvokeAsync,
    // still routed through IHandleEvent even though the InvokeAsync call
    // itself is nested inside Legend's handler rather than a raw DOM
    // dispatch), which re-renders the receiving component -- World -- on
    // its own; OnPlaceHover/OnArrowHover are invoked from map.js via plain
    // JS interop, entirely outside that pipeline, which is why those need
    // the explicit call instead. Confirmed by removing it and polling
    // aria-pressed with a throwaway Playwright script: it still updated
    // correctly (~8ms after the click).
    private async Task HandleIsolate(string? narrativeId)
    {
        _isolated = narrativeId;
        if (_mapInterop is not null)
        {
            await _mapInterop.SetIsolate(narrativeId);
        }
    }

    // Debounced (150ms), latest-wins: a burst of window changes (fast
    // dragging, rapid era clicks) cancels any fetch still in its debounce
    // wait, and a fetch that was already in flight when superseded has its
    // result discarded on return rather than clobbering newer state -- there
    // is no way to cancel the HTTP call itself (AtlasClient.SceneTime takes
    // no CancellationToken), only to ignore a stale response.
    private async Task DebouncedLoadScene(int from, int to)
    {
        _fetchCts?.Cancel();
        var cts = new CancellationTokenSource();
        _fetchCts = cts;

        try
        {
            await Task.Delay(150, cts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        try
        {
            var scene = await Atlas.SceneTime(from, to);
            if (cts.IsCancellationRequested)
            {
                return;
            }

            _scene = scene;
            _errorMessage = null;
            _isolated = null;

            if (_mapInterop is not null)
            {
                await _mapInterop.SetScene(scene);

                // Fix round 1: re-fit whenever the LAST fit was a different
                // mode -- covers both "first scene ever" (_lastFitMode is
                // still null) and "just returned from scripture mode"
                // (_lastFitMode is "scripture"). An ordinary same-mode
                // window change (slider drag, era click, readout Enter)
                // leaves _lastFitMode == "time" already, so this correctly
                // stays a no-op there, preserving Task 10's original
                // "don't yank the camera on every slider tick" policy.
                if (_lastFitMode != "time")
                {
                    await _mapInterop.FitScene();
                    _lastFitMode = "time";
                }
            }
        }
        catch (Exception)
        {
            if (!cts.IsCancellationRequested)
            {
                // Keep the last good _scene as-is -- never blank the page.
                _errorMessage = $"Couldn't load {YearText.FormatRange(from, to)} -- check your connection and try again.";
            }
        }
        finally
        {
            StateHasChanged();
        }

        // Polities share this same debounce/cancellation (`cts`) but are a
        // fully independent try/catch from the scene fetch above -- a
        // polities failure must never surface as the scene's own error
        // toast (design-direction.md's Atlas plate detail: "failures
        // NON-fatal -- no toast, just skip borders, log-free"). Skipped
        // entirely (not just skipped-on-map-push) when this call was
        // already superseded, same as the scene fetch would have been.
        if (!cts.IsCancellationRequested)
        {
            await LoadPolitiesFor(from, to, cts);
        }
    }

    // Fetches the polity-border list for [from,to] and pushes it to the
    // map. Unconditionally restores the layer's visibility FIRST, before
    // the fetch even starts: entering/being in time mode should always
    // show *some* polity layer (the last successfully fetched list, stale
    // or not) rather than staying hidden from a previous scripture-mode
    // visit just because this particular refresh failed. Silent on failure
    // per the batch brief -- no toast, no logging, just keep showing
    // whatever was already there.
    private async Task LoadPolitiesFor(int from, int to, CancellationTokenSource cts)
    {
        // Fix round 1 (finding 3, carried from the retired border-tag
        // model): this restore used to run AFTER the fetch resolved,
        // inside the try's success branch only -- so a transient fetch
        // failure right after returning from scripture mode left the layer
        // hidden with nothing left to un-hide it until the NEXT successful
        // fetch. Unconditional, before the fetch even starts, matching
        // MapInterop.SetPolitiesVisible's own doc comment.
        if (_mapInterop is not null)
        {
            await _mapInterop.SetPolitiesVisible(true);
        }

        try
        {
            var polities = await Atlas.Polities(from, to);
            if (cts.IsCancellationRequested)
            {
                return;
            }

            _polities = polities;

            if (_mapInterop is not null)
            {
                await _mapInterop.SetPolities(polities.Polities);
            }
        }
        catch (Exception)
        {
            // Silent per design-direction.md's Atlas plate detail -- skip
            // this update, keep showing whatever polities (if any) are
            // already on the map. Visibility was already restored above,
            // independent of this failure.
        }
        finally
        {
            StateHasChanged();
        }
    }

    // Same debounce/latest-wins/toast machinery as DebouncedLoadScene above,
    // sharing the SAME _fetchCts field -- entering scripture mode cancels
    // whatever time-mode fetch was still in flight (its debounce delay or
    // its own await Atlas.SceneTime), and vice versa, so a slower fetch from
    // the mode the user just left can never resolve later and clobber the
    // scene the user actually switched to. Unlike DebouncedLoadScene, FitScene
    // runs on EVERY successful load here, not just the first ever -- a
    // scripture pick is a deliberate jump to a specific (often distant)
    // place, the same spirit as a fresh deep link, not a continuous slider
    // tick that should leave the user's current pan/zoom alone.
    private async Task DebouncedLoadScriptureScene(string sref)
    {
        _fetchCts?.Cancel();
        var cts = new CancellationTokenSource();
        _fetchCts = cts;

        try
        {
            await Task.Delay(150, cts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        try
        {
            var scene = await Atlas.SceneScripture(sref);
            if (cts.IsCancellationRequested)
            {
                return;
            }

            _scene = scene;
            _errorMessage = null;
            _isolated = null;

            if (_mapInterop is not null)
            {
                await _mapInterop.SetScene(scene);
                await _mapInterop.FitScene();

                // Atlas plate detail: "Scripture mode: hide the border
                // layer AND the tag (no time context)" -- the tag hides
                // itself via the @if in the markup (keyed off _scriptureRef,
                // already non-null by now); the layer's hide now happens in
                // SyncFromQuery, unconditionally, the moment _scriptureRef
                // is set (fix round 1, finding 5 -- see that comment), so it
                // still happens even when this fetch fails. DebouncedLoadScene's
                // LoadBordersFor restores the layer on a later return to time mode.

                // Stamp the mode even though this branch always fits
                // regardless of the PRIOR value -- a later time-mode load
                // needs to see "scripture" here to know IT must re-fit too
                // (see DebouncedLoadScene's own _lastFitMode check).
                _lastFitMode = "scripture";
            }
        }
        catch (Exception)
        {
            if (!cts.IsCancellationRequested)
            {
                // Keep the last good _scene as-is -- never blank the page.
                _errorMessage = $"Couldn't load {sref} -- check your connection and try again.";
            }
        }
        finally
        {
            StateHasChanged();
        }
    }

    // IMapEvents -- called from map.js via MapEventsSink, so these run
    // outside Blazor's own UI-event dispatch and must trigger their own
    // re-render.
    public void OnPlaceHover(string id, double x, double y)
    {
        // Batch G1 requirement 3: "hover behavior unchanged for UNPINNED
        // browsing" -- once a card is pinned it OWNS the display slot
        // exclusively; an ordinary hover on some OTHER marker while pinned
        // does nothing (no preview swap) until the pin itself changes
        // (clicking a different marker re-pins to it, per OnPlaceClick
        // below) or is explicitly closed. Simpler and more predictable than
        // a transient hover-preview-over-a-pin, and keeps this method's own
        // pre-existing hover-persistence logic completely untouched for the
        // unpinned case this guard doesn't touch.
        if (_pinnedPlaceId is not null)
        {
            return;
        }

        _closeCts?.Cancel();
        var place = _scene?.Places.FirstOrDefault(p => p.Id == id) ?? QuietAsScenePlace(id);
        if (place is null)
        {
            return;
        }

        _hoverPlace = place;
        _hoverX = x;
        _hoverY = y;
        StateHasChanged();
    }

    // Batch E2: a quiet dot (map.js's own quiet-marker-{id}) reports through
    // the SAME OnPlaceHover interop call a lit marker's own marker-{id} does
    // (map.js's wireEvents is shared between the two icon kinds -- see its
    // own comment) -- this is the one place that decides what "the SAME
    // place card" (batch-e2-brief.md Requirement 3) means for an id that
    // isn't in _scene.Places: a synthetic ScenePlace built from the scene's
    // own QuietPlaces entry, with Events left empty. PlaceCard.razor reads
    // that empty list as its own signal to render the quiet line instead of
    // verse content (see its own comment) -- SCENE-2 guarantees every REAL
    // lit ScenePlace already has >=1 event, so an empty Events list can only
    // ever mean this synthetic path, never a genuinely lit place. Name is
    // set to DisplayName (QuietPlace carries no separate plain "name" field
    // at all -- the wire payload stays deliberately lean, see wire.rs's own
    // QuietPlace comment) and Brightness to 0 (an unlit place has no glow to
    // report, and nothing downstream of this synthetic object -- PlaceCard,
    // OpenPlaceFromCard's PlaceNode -- ever reads Brightness off it anyway).
    private ScenePlace? QuietAsScenePlace(string id)
    {
        var quiet = _scene?.QuietPlaces.FirstOrDefault(p => p.Id == id);
        return quiet is null ? null : new ScenePlace(quiet.Id, quiet.DisplayName, quiet.DisplayName, quiet.Lat, quiet.Lon, 0, new List<SceneEvent>());
    }

    // Requirement 0c: does NOT unconditionally schedule a close anymore --
    // see _pointerOverCard's own comment for the exact race this guards
    // against. If the pointer is (as far as this component currently
    // knows) already over the card, a marker-leave arriving late tells us
    // nothing new: the card's own eventual OnPointerLeave (CardPointerLeave
    // below) is what will actually close it once the pointer leaves THAT.
    // Batch G1: while pinned, this still schedules exactly as before (no
    // extra guard needed here) -- ScheduleCardClose itself is the ONE choke
    // point that refuses to actually close a pinned card, so every caller
    // (this one and CardPointerLeave below) stays simple.
    public void OnPlaceLeave()
    {
        if (_pointerOverCard)
        {
            return;
        }

        ScheduleCardClose();
    }

    // Batch G1 requirement 3: click a marker (lit or quiet) -> pin its card
    // open. WORLD-1/WORLD-2's own original hover-only design (and Batch
    // E2's own "click is a no-op today, deferred to Batch G1" note on the
    // quiet side) is superseded by this -- the click IS now the pinning
    // gesture, for both marker kinds identically. Resolves the place the
    // exact same way OnPlaceHover does (lit ScenePlace, or a synthetic
    // QuietAsScenePlace) so a pinned card renders with identical content to
    // a hovered one, per CONTRACT's own hover/pin content-parity promise.
    // Clicking a DIFFERENT marker while one is already pinned simply
    // re-pins to the new one -- no special-casing needed, this assignment
    // is unconditional.
    public void OnPlaceClick(string id, double x, double y)
    {
        var place = _scene?.Places.FirstOrDefault(p => p.Id == id) ?? QuietAsScenePlace(id);
        if (place is null)
        {
            return;
        }

        _closeCts?.Cancel();
        _pinnedPlaceId = id;
        _hoverPlace = place;
        _hoverX = x;
        _hoverY = y;
        StateHasChanged();
    }

    // arrow-tip (WORLD-4/contract "arrow-tip"). `key` is "{narrative}:{order}"
    // per the ArrowLayer contract (map.js), matching the
    // arrow-{narrative}-{order} testid exactly -- split on the LAST colon
    // (never the first) so this stays correct even if a narrative id ever
    // contained one; `order` itself never does.
    public void OnArrowHover(string key, double x, double y)
    {
        var split = key.LastIndexOf(':');
        if (split < 0 || !int.TryParse(key[(split + 1)..], out var order))
        {
            return;
        }

        var narrativeId = key[..split];
        var arrow = _scene?.Arrows.FirstOrDefault(a => a.Narrative == narrativeId && a.Order == order);
        if (arrow is null)
        {
            return;
        }

        var narrativeName = _scene?.Narratives.FirstOrDefault(n => n.Id == arrow.Narrative)?.Name ?? arrow.Narrative;
        // Batch E: DisplayName (the scene's own period-resolved name), not
        // the place's default Name -- same swap as the marker label/card
        // title, so this text never contradicts what's shown elsewhere in
        // the SAME scene (e.g. never "The Conquest: Luz -> Jericho" when
        // the map itself currently labels that marker "Bethel").
        var fromName = _scene?.Places.FirstOrDefault(p => p.Id == arrow.FromPlace)?.DisplayName ?? arrow.FromPlace;
        var toName = _scene?.Places.FirstOrDefault(p => p.Id == arrow.ToPlace)?.DisplayName ?? arrow.ToPlace;

        _hoverArrowText = $"{narrativeName}: {fromName} → {toName}";
        _arrowX = x;
        _arrowY = y;
        StateHasChanged();
    }

    public void OnArrowLeave()
    {
        _hoverArrowText = null;
        StateHasChanged();
    }

    // Arrow clicks are reported by map.js per the interop contract but have
    // no behavior yet -- out of scope for WORLD-3/WORLD-4 (hover only).
    // Documented no-op rather than omitted so the IMapEvents contract stays
    // satisfied without silently swallowing future intent -- unlike
    // OnPlaceClick (Batch G1 gave marker clicks real behavior: pinning),
    // arrow clicks remain exactly as they were.
    public void OnArrowClick(string key, double x, double y)
    {
    }

    // Batch G1 requirement 3: a genuine map-background click (map.js's own
    // stopPropagation on every marker/arrow click guarantees this never
    // ALSO fires for one of those in the same gesture -- see map.js's own
    // comment) closes a pinned card, per the brief's "closes via Escape, an
    // X, or clicking elsewhere on the map." A no-op when nothing is pinned
    // (an ordinary click on empty map/terrain/borders has never had any
    // effect, and still doesn't).
    public void OnMapClick()
    {
        if (_pinnedPlaceId is null)
        {
            return;
        }

        CloseCardNow();
        StateHasChanged();
    }

    // Batch G1 requirement 3: Escape closes a pinned card -- but ONLY when
    // no popover is currently open, so a single Escape press closes exactly
    // the TOPMOST layer: ExplorerPopover already has its own Escape handler
    // (OnKeyDown -> RequestClose, scoped to the popover panel); this method
    // deliberately steps aside while _activeNode is non-null rather than
    // ALSO closing the pin in the same keypress, so a user backing out of a
    // popover opened from a pinned card's own content (a verse, a date, the
    // title) doesn't lose the pin underneath it in the same press. A SECOND
    // Escape, once the popover is gone, closes the pin.
    public void OnEscapePressed()
    {
        if (_activeNode is not null || _pinnedPlaceId is null)
        {
            return;
        }

        CloseCardNow();
        StateHasChanged();
    }

    // PlaceCard.OnOpenPlace (WORLD-8/Task 15): closes the hover card
    // immediately (rather than leaving it to the pointer-leave timer) since
    // its content is now shown, promoted, inside the popover that's about
    // to open -- avoids two parchment artifacts (hover card + popover)
    // ever visibly overlapping for the delay window.
    private Task OpenPlaceFromCard()
    {
        if (_hoverPlace is { } place)
        {
            _activeNode = new PlaceNode(place.Id, place.DisplayName);
        }

        CloseCardNow();
        return Task.CompletedTask;
    }

    // Batch E: PlaceCard.OnExploreNode -- a date affordance (established/
    // destroyed) was activated. Same "promote into a real popover, close
    // the hover card so the two parchment artifacts never overlap" pattern
    // as OpenPlaceFromCard above, just with a caller-supplied node (a
    // YearNode PlaceCard already constructed, having the DateClaimOut in
    // hand) instead of building a PlaceNode here. Batch G1 requirement 1b
    // reuses this SAME callback for card verse/passage clicks (VerseNode/
    // PassageNode) -- "follow that exact pattern for layering/close
    // behavior" per the brief -- so a pinned card is superseded (fully
    // closed, including its own pin, via CloseCardNow) exactly the same way
    // an unpinned one already was; no separate handling needed for either.
    private Task OpenExploreNode(IExplorable node)
    {
        _activeNode = node;
        CloseCardNow();
        return Task.CompletedTask;
    }

    private Task ClosePopover()
    {
        _activeNode = null;
        return Task.CompletedTask;
    }

    // PlaceCard.OnClosePin (Batch G1 requirement 3): the card's own "X" --
    // present only while pinned (see PlaceCard.razor's own Pinned param) --
    // and CONTRACT's own Escape/click-elsewhere paths (OnEscapePressed/
    // OnMapClick below) all funnel here.
    private Task ClosePinnedCard()
    {
        CloseCardNow();
        return Task.CompletedTask;
    }

    // PlaceCard.OnGoToPlace (Batch G1 requirement 3, narrative traversal):
    // fired with the adjacent place's own id by a ‹ previous event / next
    // event › control. Resolves it the same way a marker click would (lit
    // or quiet -- arrows only ever connect LIT places per ARROW-1, so in
    // practice this always resolves via the lit branch, but mirroring
    // OnPlaceClick's own full resolution costs nothing and stays correct
    // even if that invariant ever loosens) and, if it resolves, pans the
    // map there and re-pins. A place that doesn't resolve at all (off-
    // window -- e.g. a scripture-mode scene whose own lit set doesn't
    // include the adjacent place, or theoretically any other gap) no-ops
    // gracefully, per the brief: "if the adjacent place is off-window...
    // no-op gracefully."
    private async Task GoToAdjacent(string placeId)
    {
        var place = _scene?.Places.FirstOrDefault(p => p.Id == placeId) ?? QuietAsScenePlace(placeId);
        if (place is null || _mapInterop is null)
        {
            return;
        }

        var (x, y) = await _mapInterop.PanToPlace(place.Lat, place.Lon);
        _closeCts?.Cancel();
        _pinnedPlaceId = placeId;
        _hoverPlace = place;
        _hoverX = x;
        _hoverY = y;
    }

    // The one choke point for "the card is now fully gone" -- ALWAYS clears
    // _pinnedPlaceId alongside _hoverPlace (Batch G1), never just one or the
    // other: a fully-closed card can never stay "pinned" underneath nothing
    // shown (a real, latent bug this guards against -- see _pinnedPlaceId's
    // own field comment -- OnPlaceHover's own pinned-guard would otherwise
    // silently ignore every future hover on ANY marker, forever, the moment
    // something closed the card via a path that forgot to also clear this).
    private void CloseCardNow()
    {
        _closeCts?.Cancel();
        _hoverPlace = null;
        _pointerOverCard = false;
        _pinnedPlaceId = null;
    }

    // The place card stays open while the pointer is over the marker OR
    // the card itself: leaving either one schedules a close (OnPlaceLeave
    // above / CardPointerLeave below), entering either one (OnPlaceHover
    // above / CardPointerEnter below) cancels a pending close. This gives
    // the pointer room to cross the gap between a marker and its card --
    // which never sit at the same screen point -- without the card
    // flickering shut.
    //
    // Requirement 0c: the grace window is 350ms, up from 150ms -- the
    // SECOND half of the fickleness fix, alongside _pointerOverCard itself.
    // 150ms was tight enough that an ordinary, unhurried pointer move
    // across the marker-to-card gap could occasionally still lose the
    // race even with _pointerOverCard's own fix in place (the card's own
    // OnPointerEnter has to actually finish its async Blazor dispatch
    // before the close fires); 350ms gives that real margin without
    // reading as a delay a user would ever notice on a deliberate
    // pointer-leaves-both close (CONTRACT's own "closes within ~1s" bar
    // for requirement 0c's acceptance test).
    // Batch G1 requirement 3: the ONE choke point that refuses to schedule
    // a close at all while pinned ("stays through mouse-leave" -- a marker's
    // own real mouseout still fires OnPlaceLeave regardless of pin state,
    // map.js has no notion of pinning; this is where that gets stopped).
    // Both of this method's own callers (OnPlaceLeave, CardPointerLeave)
    // stay unchanged/unguarded themselves -- simpler than duplicating the
    // same check at every call site.
    private void ScheduleCardClose()
    {
        if (_pinnedPlaceId is not null)
        {
            return;
        }

        _closeCts?.Cancel();
        var cts = new CancellationTokenSource();
        _closeCts = cts;
        _ = CloseCardAfterDelay(cts);
    }

    // PlaceCard.OnPointerEnter: the pointer has physically entered the
    // card. Cancels any pending close (same as the pre-0c CancelCardClose
    // this replaces) AND records that fact in _pointerOverCard, so a
    // late-arriving marker-leave (OnPlaceLeave above) knows not to
    // schedule a fresh close out from under it -- see _pointerOverCard's
    // own comment for the full race this closes.
    private void CardPointerEnter()
    {
        _pointerOverCard = true;
        _closeCts?.Cancel();
    }

    // PlaceCard.OnPointerLeave: the pointer has physically left the card.
    // Clears _pointerOverCard (a later marker-leave, if one arrives, is
    // now free to schedule its own close again) and schedules the close
    // itself -- same as the pre-0c ScheduleCardClose wiring this replaces,
    // just also keeping _pointerOverCard honest.
    private void CardPointerLeave()
    {
        _pointerOverCard = false;
        ScheduleCardClose();
    }

    private async Task CloseCardAfterDelay(CancellationTokenSource cts)
    {
        try
        {
            await Task.Delay(350, cts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (cts.IsCancellationRequested)
        {
            return;
        }

        _hoverPlace = null;
        _pointerOverCard = false;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        _fetchCts?.Cancel();
        _closeCts?.Cancel();
        if (_mapInterop is not null)
        {
            await _mapInterop.DisposeAsync();
        }
    }
}
