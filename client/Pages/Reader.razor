@page "/"
@page "/read/{Book}/{Chapter:int}"
@using System.Text.RegularExpressions
@implements IAsyncDisposable
@inject AtlasClient Atlas
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ViewStateService ViewState

<PageTitle>Bible Explorer &mdash; @BookName @_chapterNum</PageTitle>

@* Outer wrapper exists ONLY so a keydown/keyup while focus is ANYWHERE
   inside -- a verse-num button just clicked, or the popover panel once its
   own FocusAsync() lands -- bubbles to ONE pair of handlers regardless of
   exactly where focus is at that instant (OnPageKeyDown/OnPageKeyUp below).
   .reader-page and ExplorerPopover are otherwise unrelated SIBLINGS in the
   DOM (Blazor renders a conditional block as a sibling, not a child, of the
   element before it), so neither one alone could catch a keydown/keyup
   whose focus target is inside the OTHER.

   Fix round 1 finding: this used to ALSO close any open popover the instant
   Shift went down, to get ExplorerPopover's own click-outside-to-close
   backdrop (position:fixed, inset:0 -- physically covers every verse-num
   underneath it) out of the way before a shift-click's second click. That
   over-fired on Shift+Tab (ordinary backward tab traversal through the
   popover's own controls, which also sends a Shift keydown) and slammed the
   popover shut on plain keyboard navigation. Replaced with a narrower
   mechanism: OnPageKeyDown/OnPageKeyUp only track whether Shift is
   currently held (`_shiftHeld`), toggling the `reader-shift-active` class
   below, which app.css turns into `pointer-events: none` on
   `.popover-backdrop` alone -- the popover itself no longer closes on
   keydown at all, so Tab's own default focus-traversal behavior (never
   prevented here) proceeds normally through an open popover exactly like
   it would anywhere else. The backdrop being un-clickable for the instant
   Shift is held is a deliberate, narrow trade (click-outside-to-close is
   briefly unavailable), not an oversight -- see OnVerseNumClick's own
   comment for how the range-forming shift-click itself still closes the
   popover afterward, unchanged.

   `reader-shift-active` reacts to Shift released OUTSIDE this window too
   (alt-tab away, switch browser tabs) via reader.js's watchShiftRelease --
   see OnAfterRenderAsync/DisposeAsync below -- so it can never get stuck on
   if this page's own keyup never fires. Otherwise purely structural -- no
   visual effect of its own; .reader-page keeps its own min-height:100vh
   (vh units are viewport-relative regardless of ancestor nesting) and
   .popover keeps its own position:fixed centering (an unstyled wrapper
   introduces no new containing block). *@
@* Batch H (split-view study): this SAME outer wrapper -- pre-existing,
   originally just the Shift-tracking scope (see OnPageKeyDown/OnPageKeyUp
   below) -- doubles as .split-view's own flex container once _splitOpen.
   A position:fixed element (ExplorerPopover's own backdrop/panel) is
   removed from normal flow regardless of its DOM parent's own display,
   so adding display:flex here never affects them -- they still render
   exactly like "normal", full-viewport, per the brief. *@
<div class="@(_shiftHeld ? "reader-shift-active" : "") @(_splitOpen ? "split-view" : "")"
     @onkeydown="OnPageKeyDown" @onkeyup="OnPageKeyUp" data-testid="@(_splitOpen ? "split-view" : null)">
    <div class="@(_splitOpen ? "reader-page split-pane-reader" : "reader-page")" data-testid="reader-root">
        @if (!_splitOpen)
        {
            <button type="button" class="split-open split-open-parchment" data-testid="split-open-reader"
                    @onclick="OpenSplit">
                Open the map beside the text
            </button>
        }
        else
        {
            <button type="button" class="split-close split-close-parchment" data-testid="split-close-reader"
                    aria-label="Close the reader, keep the map" @onclick="CloseReaderPane">
                &times;
            </button>
        }

        <ScripturePicker OnApply="ApplyScriptureRef" ThemeClass="picker-parchment" />

        @if (ChapterMatchesRoute)
        {
            <article class="reader-column">
                <h1 class="chapter-head">
                    @* Batch G1 requirement 1: the chapter header becomes
                       explorable the same way (.explorable, see app.css) --
                       a real <button> wrapping the existing book/num spans
                       (the wrapping-button fallback design-direction.md
                       prefers, and here it works cleanly: nothing else
                       inside the header needs its own separate click
                       target). The outer <h1> itself stays a plain,
                       unmodified heading -- App.razor's FocusOnNavigate
                       still finds and focuses IT, not this button, so
                       document-outline semantics are untouched. *@
                    <button type="button" class="chapter-head-button explorable" data-testid="chapter-head"
                            aria-label="@($"Explore {_book}.{_chapterNum}")" @onclick="OpenChapter">
                        <span class="chapter-head-book">@BookName</span>
                        <span class="chapter-head-num">@_chapterNum</span>
                    </button>
                </h1>

                @foreach (var v in _chapter!.Verses)
                {
                    @* Batch T requirement 5 ("event titles throughout the
                       reader"): a quiet, small-caps pericope heading renders
                       immediately above this verse's own line whenever the
                       chapter fetch marked it a heading ANCHOR (server:
                       AtlasData::heading_for_verse) -- present ONLY for
                       covered books/narrative-event passages (conditional
                       presence: absent entirely for an uncovered book,
                       since no verse there is ever an anchor). Explorable,
                       same ONE-RULE treatment as chapter-head/verse-line --
                       opens a fresh EventNode. Shares this SAME code path
                       for the split-view reader pane (Reader.razor is
                       reused, not copied, for both -- SPLIT-1). *@
                    @if (v.Heading is { } heading)
                    {
                        @* Batch HOTFIX-4 requirement 6 (AFFORDANCE HONESTY):
                           a general-kind heading is NOT part of time
                           traversal (req 2) -- .explorable-quiet REPLACES
                           .explorable (never both) so it never looks like a
                           dated heading, which DOES traverse after req 1.
                           Same class, same rule, as VerseEventMembershipSection's
                           own row -- "one rule, no per-surface variant."
                           M-D1 requirement 1 (CHAPTER-BOUNDARY CONTINUATION):
                           IsContinuation adds .pericope-heading-continuation
                           (app.css's own "quiet via SCALE, distinct via
                           WORDING" precedent -- the SAME two-axis distinction
                           the PRIOR/FOLLOWING-IN-TIME rows already establish,
                           never conflated with the traversability axis above,
                           which stays orthogonal: a continuation heading can
                           be either kind, styled identically either way).
                           SAME click/keydown handler as a primary heading --
                           a continuation opens the identical EventNode, no
                           second affordance to wire (requirement 2's own
                           "heading click -> container node" law, reused, not
                           duplicated). *@
                        <h2 class="pericope-heading @(heading.IsContinuation ? "pericope-heading-continuation" : "") @(heading.Kind == "general" ? "explorable-quiet" : "explorable")"
                            data-testid="@($"pericope-heading-{heading.EventId}")" data-continuation="@(heading.IsContinuation ? "true" : "false")"
                            tabindex="0" role="button" aria-label="@(heading.IsContinuation ? $"Explore {heading.Title} (continued)" : $"Explore {heading.Title}")"
                            @onclick="() => OpenEvent(heading.EventId, heading.Title)"
                            @onkeydown="@(e => OnHeadingKeyDown(e, heading.EventId, heading.Title))">
                            @if (heading.IsContinuation)
                            {
                                <span class="pericope-heading-continuation-marker" data-testid="@($"pericope-heading-continuation-marker-{heading.EventId}")">continued</span>
                            }
                            @heading.Title
                        </h2>
                    }
                    @* Batch G1 requirement 1 (design-direction.md's REVISED
                       interaction rule): the ∴ button DIES. THE VERSE LINE
                       is the explorable element -- hover/focus darkens it
                       (.explorable) with cursor:pointer, click (anywhere on
                       the line) opens the verse's ExplorerPopover, same
                       behavior the ∴ had. Real interactive-element
                       semantics via role/tabindex/keydown (OnVerseLineKeyDown
                       below) since a wrapping <button> can't be used here
                       the way chapter-head's own button above can -- it
                       would illegally nest .verse-num's own real <button>
                       inside it. Verse-NUMBER clicks stay a SEPARATE gesture
                       on a SEPARATE target (.verse-num, not .explorable --
                       anchor+extend passage-range mechanics only, no popover
                       -- see OnVerseNumClick/SetAnchor below); its own click
                       AND keydown both stop propagation so activating it
                       (mouse or keyboard) never also bubbles into this row's
                       own click-opens-popover handler. *@
                    <div class="verse-line explorable" data-testid="verse-line-@v.Verse" id="v@(v.Verse)"
                         tabindex="0" role="button" aria-label="@($"Explore {_book}.{_chapterNum}.{v.Verse}")"
                         @onclick="() => OpenVerse(v.Verse)" @onkeydown="@(e => OnVerseLineKeyDown(e, v.Verse))">
                        <button type="button" class="verse-num" data-testid="verse-num-@v.Verse"
                                @onclick="@(e => OnVerseNumClick(e, v.Verse))" @onclick:stopPropagation="true"
                                @onkeydown:stopPropagation="true">@v.Verse</button>
                        @* Batch M-D2 (owner's cross-reference superscript
                           directive, 2026-08-21, verbatim: "little
                           superscripts visible near verses/passages to
                           which cross references apply... i,j,k to
                           represent multiple cross references to a single
                           element if there are > 3 xrefs, the superscript
                           should be `...`"). ONE cluster per verse (never
                           per-letter targets -- "hovering... the superscript
                           CLUSTER... opens the SAME composable popover,"
                           the controller brief's own words), driven purely
                           by the wire's own XrefCount (this verse's own
                           `cites` edge-summary count, ChapterOut.Verses[].XrefCount)
                           -- a PURE function of that one integer
                           (XrefMarkerText below), no per-render mutable
                           accumulator anywhere: the exact shape the house
                           pattern warns against (per-chapter superscript
                           lettering closures, "the shape that bit Batch N")
                           is sidestepped by construction, not guarded
                           against after the fact -- there is no shared
                           state to leak between verses OR between renders
                           in the first place. Entry point into THE ONE
                           composable popover (owner decree: never a
                           parallel interface) -- hover, keyboard focus, AND
                           click all open the identical ExplorerPopover,
                           xrefs section leading, 3 initial entries
                           (VerseNode.XrefEntryPoint; see
                           PopoverSectionProviders.CrossRefsSection's own
                           entry-point cap doc comment). Closing follows the
                           SAME mechanism every other popover already uses
                           (backdrop click / Escape / close button) --
                           deliberately NOT mouseleave, which would make a
                           hover-opened popover impossible to reach with the
                           mouse at all (see this batch's own CONTRACT note).
                           @onclick:stopPropagation -- the SAME "more
                           specific target always wins" rule verse-num's own
                           button already establishes one line up -- keeps
                           this from ALSO triggering the verse-line's own
                           click-opens-a-plain-popover handler. *@
                        @* GATED: FeatureFlags.XrefSuperscripts (owner
                           disable order 2026-08-23; M-D3's rework
                           re-enables -- see FeatureFlags.cs). *@
                        <span class="verse-text">@v.Text@if (FeatureFlags.XrefSuperscripts && v.XrefCount > 0)
                                                         {
                                                             <sup class="verse-xref-marker" data-testid="@($"verse-xref-marker-{v.Verse}")"
                                                                  tabindex="0" role="button" aria-label="@XrefMarkerAriaLabel(v)"
                                                                  @onclick="() => OpenVerseXrefEntry(v.Verse)" @onclick:stopPropagation="true"
                                                                  @onmouseenter="() => OpenVerseXrefEntry(v.Verse)"
                                                                  @onfocus="() => OpenVerseXrefEntry(v.Verse)"
                                                                  @onkeydown="@(e => OnXrefMarkerKeyDown(e, v.Verse))" @onkeydown:stopPropagation="true">@XrefMarkerText(v.XrefCount)</sup>
                                                         }</span>
                    </div>
                }
            </article>
        }
        else if (_errorMessage is null)
        {
            <p class="reader-loading">Loading&hellip;</p>
        }

        <nav aria-label="Chapter navigation">
            @if (PrevTarget is { } prev)
            {
                <a class="reader-prev" data-testid="reader-prev" href="@ChapterHref(prev.Book, prev.Chapter)" aria-label="@($"Previous chapter: {prev.Name} {prev.Chapter}")">&lsaquo;<span class="reader-nav-label"> @prev.Name @prev.Chapter</span></a>
            }
            @if (NextTarget is { } next)
            {
                <a class="reader-next" data-testid="reader-next" href="@ChapterHref(next.Book, next.Chapter)" aria-label="@($"Next chapter: {next.Name} {next.Chapter}")"><span class="reader-nav-label">@next.Name @next.Chapter </span>&rsaquo;</a>
            }
        </nav>

        @if (_passageRange is { } range)
        {
            <button type="button" class="passage-chip" data-testid="passage-chip" @onclick="OpenPassage">@PassageRef(range)</button>
        }

        @if (_errorMessage is not null)
        {
            <div class="toast" data-testid="toast">
                <p class="toast-message">@_errorMessage</p>
            </div>
        }
    </div>

    @* Batch H: the atlas pane -- the EXISTING World.razor page componentry,
       reused directly as a child component (not a copy), narrowed to its
       own split-pane-atlas layout via SplitMode's markup branch. FollowRef
       re-renders World with a new value every time _book/_chapterNum below
       change (this Reader instance is REUSED, not recreated, across
       chapter-to-chapter navigation -- see ComputeAdjacent's own <a href>
       targets, which stay plain /read/... links precisely because that
       reuse already keeps _splitOpen/this whole pane alive across it), so
       "Reader navigation re-scenes the map automatically" falls out of
       ordinary Blazor parameter diffing, no event bus needed. *@
    @if (_splitOpen)
    {
        <div class="split-divider" aria-hidden="true"></div>
        <World @ref="_worldPane" SplitMode="true" FollowRef="@CurrentRef" OnRequestClose="CloseSplitAtlas" />
    }

    @if (_activeNode is not null)
    {
        <ExplorerPopover @key="_activeNode" Root="_activeNode" OnClose="ClosePopover"
                          InSplit="_splitOpen" OnNavigateWorldInSplit="NavigateWorldInSplit" PaneAnchor="@(_splitOpen ? "reader" : null)" />
    }
</div>

@code {
    private static readonly Regex VerseFragment = new(@"^#v(\d+)$", RegexOptions.Compiled);

    [Parameter] public string? Book { get; set; }
    [Parameter] public int? Chapter { get; set; }

    // Batch H (split-view study): "Read beside the map" (World.razor)
    // navigates here with ?split=1 so the two entry points ("Open the map
    // beside the text" here, "Read beside the map" there) land in the SAME
    // split layout, per the brief -- read once, on arrival, by
    // OnParametersSetAsync (_splitQueryConsumed guards that so a LATER,
    // unrelated OnParametersSetAsync call -- e.g. a plain chapter nav that
    // happens to leave a stale ?split=1 sitting in the URL, see this
    // param's own consumption site for the full reasoning -- can never
    // reopen a split the user already explicitly closed).
    [SupplyParameterFromQuery(Name = "split")]
    [Parameter]
    public string? SplitQuery { get; set; }

    // Batch H: local, in-memory split-open state -- NOT query/route driven
    // beyond the one-shot SplitQuery arrival above. Reader.razor is reused
    // (never recreated) across ordinary chapter-to-chapter navigation (see
    // ComputeAdjacent's own plain /read/... links), so this field -- and
    // therefore an open split -- survives that navigation for free, with no
    // extra plumbing: World.razor's own FollowRef parameter re-renders with
    // each new CurrentRef automatically. Reader.razor is the split's ONLY
    // ever host/orchestrator (World.razor is always the embedded guest,
    // never the other way around -- see World.razor's own OnRequestClose
    // param and the batch report's layout section for why).
    private bool _splitOpen;
    private bool _splitQueryConsumed;
    private World? _worldPane;

    private List<BookTocEntry>? _toc;
    private string _book = "GEN";
    private int _chapterNum = 1;
    private ChapterOut? _chapter;
    private string? _loadedBook;
    private int? _loadedChapterNum;
    private string? _errorMessage;
    private IExplorable? _activeNode;

    // Passage selection (READ-5/Task 15). _anchorVerse is the last PLAIN
    // click (never a shift-click); it stays fixed across repeated shift-
    // clicks against different verses (standard shift-click UX: the anchor
    // only moves on a fresh plain click), so it's a real int? field, not
    // just "whatever OpenVerse last touched". _passageRange is null unless
    // a shift-click just formed a real range (V1<=V2, canonical order
    // regardless of click direction -- see OnVerseNumClick).
    private int? _anchorVerse;
    private (int From, int To)? _passageRange;

    private int _requestId;
    private string? _scrolledFragment;
    private IJSObjectReference? _readerJs;

    // Batch H (view-state round-trip): guards the ViewState.Reader scroll
    // restore (OnAfterRenderAsync below) to at most ONCE per component
    // INSTANCE -- the first chapter this instance ever renders, never a
    // LATER in-session chapter navigation (this component is reused, not
    // recreated, across those -- see _splitOpen's own comment). Without
    // this, returning (in-session) to a chapter that happens to numerically
    // match whatever ViewState.Reader.Book/Chapter was left over from a
    // PRIOR, unrelated visit could restore a stale, unrelated scroll
    // position instead of that chapter's own natural top.
    private bool _scrollRestoreAttempted;

    // Backdrop-inertness while Shift is held (fix round 1) -- see the
    // wrapper div's own comment above and OnPageKeyDown/OnPageKeyUp below.
    // _selfRef is only ever used for reader.js's watchShiftRelease ->
    // ResetShiftHeld bridge (the window-blur/tab-hidden safety net); never
    // passed anywhere else.
    private bool _shiftHeld;
    private DotNetObjectReference<Reader>? _selfRef;

    private string BookName => _toc?.FirstOrDefault(b => b.Code == _book)?.Name ?? _book;

    // Batch H: the split host's own current chapter ref ("GEN.12"), fed to
    // World.razor's FollowRef parameter -- see <World> above's own comment
    // for why re-rendering with a new value on every chapter change is
    // enough (no callback/event needed). Computed from _book/_chapterNum
    // directly (not gated on ChapterMatchesRoute/_chapter having actually
    // loaded yet) so the atlas pane's own fetch starts in PARALLEL with
    // this page's own chapter-text fetch, not after it.
    private string CurrentRef => $"{_book}.{_chapterNum}";

    // ExplorerPopover.OnNavigateWorldInSplit ("no nested-popup rule"): a
    // popover chip that would otherwise open a second full /world instead
    // hands its query straight to the ALREADY-EMBEDDED atlas pane, in
    // place. _worldPane is null only in the impossible case this callback
    // fires while _splitOpen is false (InSplit gates ExplorerPopover's own
    // choice to invoke this at all) or before <World>'s own @ref has
    // landed (a popover cannot exist yet at that point either -- opening
    // one is itself a later user action) -- the null-coalesce is pure
    // defensive belt-and-suspenders, not an expected path.
    private Task NavigateWorldInSplit(string query) => _worldPane?.ApplyExternalQuery(query) ?? Task.CompletedTask;

    // split-close-reader ("close the reader pane -> full /world" per the
    // brief). A bare navigate -- the atlas pane's own CURRENT position
    // (follow ref/window/camera) is captured into ViewState.Map by its own
    // DisposeAsync as part of THIS navigation tearing it down, and the
    // fresh standalone World instance that mounts at /world reads it
    // straight back (RestoreMapState) -- the same view-state round-trip
    // machinery already does the work; this method doesn't need to know
    // the atlas's own current state at all.
    private void CloseReaderPane() => Nav.NavigateTo("/world");

    // Batch F2 requirement 6c ("if i am in split screen mode and refresh,
    // the split screen mode shalt not be ceased on account of refresh"):
    // both split entry points now keep the URL's own ?split=1 continuously
    // in sync with _splitOpen -- the HOUSE PATTERN this app already uses
    // everywhere state must survive a dispose+mount navigation (sync
    // continuously AT THE POINT OF MUTATION, never captured lazily/at
    // dispose time -- ViewStateService.SyncViewState/World.razor's
    // OnCameraChanged/reader.js's watchScroll are the existing models).
    // OpenSplit is the reader's OWN "Open the map beside the text" entry
    // point (World.razor's OWN "Read beside the map" already builds
    // ?split=1 into its target URL directly -- see OpenReadBesideMap there
    // -- so it needs no equivalent change). CloseSplitAtlas is the embedded
    // atlas pane's own close button (World.razor's split-close-atlas,
    // wired via OnRequestClose) -- "closing the split cleans the param."
    private void OpenSplit()
    {
        _splitOpen = true;
        SyncSplitUrl();
    }

    private void CloseSplitAtlas()
    {
        _splitOpen = false;
        SyncSplitUrl();
    }

    // A query-string-only navigation (book/chapter route params unchanged)
    // -- OnParametersSetAsync's own book/chapterNum-unchanged early-return
    // means this never re-fetches the chapter or disturbs scroll/popover
    // state; SplitQuery's own one-shot consumption (_splitQueryConsumed) is
    // already spent for this instance by the time either caller above ever
    // runs, so this is the ONLY thing that keeps the URL truthful about
    // _splitOpen from here on. replace:true -- a pure state reflection, not
    // a new history entry to back-button through.
    private void SyncSplitUrl()
    {
        var uri = Nav.GetUriWithQueryParameters(new Dictionary<string, object?> { ["split"] = _splitOpen ? "1" : null });
        Nav.NavigateTo(uri, replace: true);
    }

    // reader-prev/reader-next (Batch R requirement 6/HOTFIX NAV-4) -- their
    // own hrefs are plain <a> tags (Blazor's router intercepts same-origin
    // clicks on them client-side, see this component's own file header:
    // "Reader.razor is REUSED, not recreated, across an ordinary chapter-
    // to-chapter navigation"), so keeping split open across chapter nav
    // (SPLIT-1's own promise) requires THIS href to already carry ?split=1
    // when a split is open -- otherwise the URL silently drops it on the
    // very next chapter turn, and a refresh right after would lose split
    // state even though _splitOpen itself is still (correctly) true.
    private string ChapterHref(string book, int chapter) => _splitOpen ? $"/read/{book}/{chapter}?split=1" : $"/read/{book}/{chapter}";

    // Fix round 1 finding: _book/_chapterNum are updated to the NEW route's
    // values SYNCHRONOUSLY in OnParametersSetAsync, before LoadChapter's
    // await resolves -- Blazor renders once in between (the intermediate
    // render any non-synchronously-completing lifecycle await triggers),
    // and at THAT render _chapter still holds the PREVIOUS chapter's data.
    // Gating on "_chapter is not null" alone let that intermediate render
    // show the new heading over the old chapter's verse rows, and let
    // OnAfterRenderAsync try to scroll a fragment against the wrong
    // chapter's DOM (silently consuming _scrolledFragment so the real
    // scroll, once the correct chapter finally renders, was suppressed).
    //
    // _loadedBook/_loadedChapterNum (below) are stamped by LoadChapter
    // itself at the exact moment it assigns _chapter, from the SAME _book/
    // _chapterNum values that drove that fetch -- NOT from ChapterOut's own
    // Book field, which turns out to be the book's display NAME ("Genesis"),
    // not its canonical code ("GEN"); comparing that against _book would
    // never match and would wedge the page on "Loading..." forever (caught
    // by hand-testing this fix, not by READ-1..3, which never deep-link
    // into a chapter fast enough to observe the intermediate render).
    private bool ChapterMatchesRoute =>
        _chapter is not null && _loadedBook == _book && _loadedChapterNum == _chapterNum;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _toc = await Atlas.Books();
        }
        catch (Exception)
        {
            _errorMessage = "Couldn't load the book list — check your connection and try again.";
        }
    }

    // Runs on every navigation, including the very first one -- book/chapter
    // change (a genuinely new chapter, refetch + close any open popover) is
    // distinguished from a fragment-only change (e.g. the picker jumping to
    // a different verse anchor within the SAME chapter, or a re-render with
    // unchanged route params) which must NOT redundantly refetch or drop an
    // open popover. Checking _loadedBook/_loadedChapterNum here (not just
    // "_chapter is not null") matters for a case adjacent to fix round 1's
    // finding 1: if a fetch for this exact target previously FAILED,
    // _chapter still holds whatever chapter loaded before that (non-null,
    // but stale/mismatched) -- re-navigating to the same failed target must
    // still retry the fetch, not silently no-op because SOME chapter
    // happens to be loaded.
    protected override async Task OnParametersSetAsync()
    {
        // Batch H: consumed exactly once per component instance (never
        // re-applied on a later, unrelated OnParametersSetAsync call) --
        // World.razor's own "Read beside the map" link is the only writer
        // of ?split=1, and only on the FIRST navigation TO this instance;
        // the guard means a user who explicitly closes split (leaving the
        // stale query key sitting in an unchanged URL, since closing is a
        // local field flip, not a Nav.NavigateTo -- see the split-close-atlas
        // button's own handler) can never have it silently reopened by some
        // later, unrelated re-render.
        if (!_splitQueryConsumed)
        {
            _splitQueryConsumed = true;
            if (SplitQuery == "1")
            {
                _splitOpen = true;
            }
        }

        var book = string.IsNullOrWhiteSpace(Book) ? "GEN" : Book.ToUpperInvariant();
        var chapterNum = Chapter ?? 1;

        // Chip-clearing rule: this component's own design choice (NOT a
        // verbatim quote from the Task 15 brief or design-direction.md --
        // the brief's actual, verbatim note on this interplay is quoted
        // below, at OnVerseNumClick) is that a new anchor or a navigation
        // each clear the chip. A new anchor is handled in SetAnchorAndOpen
        // (_passageRange = null there). Navigating is handled here:
        // OnParametersSetAsync only ever runs in response to a genuine
        // navigation the router dispatched to this page (initial load, or
        // any URL change matching this route, including a same-chapter
        // fragment-only jump from the picker), never from an unrelated
        // StateHasChanged elsewhere -- so unconditionally resetting here,
        // before the redundant-refetch guard below, clears the chip on
        // every kind of navigation, not only ones that also change chapter.
        _anchorVerse = null;
        _passageRange = null;

        if (book == _book && chapterNum == _chapterNum && _loadedBook == book && _loadedChapterNum == chapterNum)
        {
            return;
        }

        _book = book;
        _chapterNum = chapterNum;
        _activeNode = null;
        _scrolledFragment = null;
        await LoadChapter();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _readerJs = await JS.InvokeAsync<IJSObjectReference>("import", "./js/reader.js");

            // Fix round 1: Blazor has no binding for window.blur/
            // document.visibilitychange (releasing Shift while this
            // tab/window isn't focused never fires a DOM keyup ON THIS
            // PAGE at all), so this tiny JS-side watcher exists purely to
            // guarantee _shiftHeld can't get stuck true -- see reader.js's
            // own comment. _selfRef is disposed in DisposeAsync below.
            _selfRef = DotNetObjectReference.Create(this);
            await _readerJs.InvokeVoidAsync("watchShiftRelease", _selfRef);

            // Batch H (view-state round-trip): continuously reports scroll
            // position into ViewState.Reader (OnScroll below) -- NOT a
            // dispose-time read. See reader.js's own watchScroll comment
            // for the real, confirmed race a dispose-time read loses to
            // (Blazor's own router resets window scroll on navigation
            // before DisposeAsync ever runs).
            await _readerJs.InvokeVoidAsync("watchScroll", _selfRef);

            // Batch R requirement 6 (chapter nav always visible, middle-
            // aligned, even as i scroll): see reader.js's own
            // watchChapterNavCenter comment for why this needs a JS-side
            // listener at all (a plain CSS `top` value can't, by itself,
            // stay viewport-centered through `.reader-page`'s own
            // pre-existing `contain: layout` containing-block substitution).
            await _readerJs.InvokeVoidAsync("watchChapterNavCenter");
        }

        if (!ChapterMatchesRoute || _readerJs is null)
        {
            return;
        }

        var fragment = new Uri(Nav.Uri).Fragment;
        if (fragment == _scrolledFragment)
        {
            return;
        }

        _scrolledFragment = fragment;
        var m = VerseFragment.Match(fragment);
        if (m.Success)
        {
            await _readerJs.InvokeVoidAsync("scrollToVerse", int.Parse(m.Groups[1].Value));
        }
        else if (!_scrollRestoreAttempted)
        {
            // Batch H (view-state round-trip): no verse fragment driving
            // scroll this navigation -- see _scrollRestoreAttempted's own
            // comment for why this only ever runs once per component
            // instance. Only restores when genuinely RETURNING to the exact
            // chapter last left (Book AND Chapter both match) -- landing on
            // a DIFFERENT chapter (HasData true but a mismatch) correctly
            // falls through to no special scroll at all, an ordinary
            // top-of-page start like any other fresh navigation.
            _scrollRestoreAttempted = true;
            if (ViewState.Reader.HasData && ViewState.Reader.Book == _book && ViewState.Reader.Chapter == _chapterNum)
            {
                await _readerJs.InvokeVoidAsync("setScrollY", ViewState.Reader.ScrollY);
            }
        }
    }

    private async Task LoadChapter()
    {
        var myRequest = ++_requestId;
        try
        {
            var chapter = await Atlas.Chapter(_book, _chapterNum);
            if (myRequest != _requestId)
            {
                return; // superseded by a newer navigation -- discard this stale response
            }

            // myRequest == _requestId here guarantees no newer navigation has
            // started since this fetch began (that would have changed _book/
            // _chapterNum AND bumped _requestId again) -- so the CURRENT
            // values of _book/_chapterNum are exactly what this fetch was for.
            _chapter = chapter;
            _loadedBook = _book;
            _loadedChapterNum = _chapterNum;
            _errorMessage = null;
        }
        catch (Exception)
        {
            if (myRequest != _requestId)
            {
                return;
            }

            _errorMessage = $"Couldn't load {_book} {_chapterNum} — check your connection and try again.";
        }
    }

    private void OpenVerse(int verseNum) => _activeNode = new VerseNode($"{_book}.{_chapterNum}.{verseNum}");

    // Batch M-D2 (owner's cross-reference superscript directive): the
    // owner's own literal letters ("i,j,k") -- taken at face value as the
    // scheme itself (not merely an illustrative example of "some sequential
    // letters"), since a verse only ever needs 1-3 of them (>3 is always the
    // many-marker instead, never a 4th letter) -- CONTRACT-documented, see
    // this batch's own CONTRACT.md note. RESTART BOUNDARY: per VERSE, not
    // per chapter or globally -- "i,j,k to represent multiple cross
    // references to a SINGLE ELEMENT," the owner's own words; every verse
    // with 1-3 xrefs independently starts its own lettering at "i". A PURE
    // array index, never a mutable counter -- see the markup's own comment
    // above for why this sidesteps the Batch N closure-capture defect class
    // by construction.
    private static readonly string[] XrefLetters = { "i", "j", "k" };

    // The owner's own suggested many-marker ("...", or "something else that
    // would make sense") -- realized as the single Unicode HORIZONTAL
    // ELLIPSIS character (U+2026), not three ASCII periods, for typographic
    // correctness (the same glyph any serif font's own "..." ligature would
    // render, without depending on the font to supply that ligature).
    private const string XrefManyMarker = "…";

    private static string XrefMarkerText(int count) => count > 3 ? XrefManyMarker : string.Concat(XrefLetters.Take(count));

    private static string XrefMarkerAriaLabel(VerseOut v) =>
        v.XrefCount > 3 ? $"Many cross-references for verse {v.Verse}" : $"{v.XrefCount} cross-reference{(v.XrefCount == 1 ? "" : "s")} for verse {v.Verse}";

    // Batch M-D2: the superscript's own entry point into THE composable
    // popover (owner decree, never a parallel interface) -- constructs the
    // SAME VerseNode OpenVerse does, just with XrefEntryPoint=true (a
    // parameter on the one abstraction; see that class's own doc comment).
    // Guarded against a redundant remount: ExplorerPopover is keyed by
    // `_activeNode` itself (Reader.razor's own <ExplorerPopover @key=...>),
    // and VerseNode has no value equality (a plain class), so reassigning
    // to a FRESH instance naming the SAME verse -- e.g. re-entering the
    // marker that's already driving the open popover, or focus firing right
    // after a click already did -- would otherwise tear down and rebuild
    // the whole popover (losing scroll position, re-fetching) for no actual
    // change; this no-ops instead, same as any other idempotent open.
    private void OpenVerseXrefEntry(int verseNum)
    {
        var vref = $"{_book}.{_chapterNum}.{verseNum}";
        if (_activeNode is VerseNode { XrefEntryPoint: true } current && current.Title == vref)
        {
            return;
        }

        _activeNode = new VerseNode(vref, xrefEntryPoint: true);
    }

    private void OnXrefMarkerKeyDown(KeyboardEventArgs e, int verseNum)
    {
        if (e.Key == "Enter")
        {
            OpenVerseXrefEntry(verseNum);
        }
    }

    // Batch T requirement 5: a pericope heading's own explore target --
    // mirrors OpenVerse/OpenChapter's own "construct the node directly,
    // no fetch needed just to open the popover" shape exactly (EventNode's
    // own DetailAsync fetches the rest lazily, once the popover is open).
    private void OpenEvent(string eventId, string title) => _activeNode = new EventNode(eventId, title);

    private void OnHeadingKeyDown(KeyboardEventArgs e, string eventId, string title)
    {
        if (e.Key == "Enter")
        {
            OpenEvent(eventId, title);
        }
    }

    // Batch G1 requirement 1: the chapter header's own explore target
    // (chapter-head-button's @onclick) -- the ChapterNode type already
    // existed in client/Explore/ (spec node table row "Passage/Chapter/
    // Book"), unused by any UI surface before this batch.
    private void OpenChapter() => _activeNode = new ChapterNode(_book, _chapterNum);

    private Task ClosePopover()
    {
        _activeNode = null;
        return Task.CompletedTask;
    }

    // Fix round 1 (replaces a prior version that closed any open popover
    // the instant Shift went down -- see the wrapper div's own comment for
    // why that over-fired on Shift+Tab). This pair only ever tracks
    // _shiftHeld; neither touches _activeNode. The original problem this
    // exists to solve is still real: ExplorerPopover's own backdrop is a
    // full-viewport, position:fixed div (by design -- click-outside-to-
    // close) that physically intercepts pointer events, so a plain click's
    // popover staying open would make a shift-click's SECOND click (on a
    // different verse-num) impossible to land at all -- it would just retry
    // against the intercepting backdrop until its actionability timeout,
    // never reaching OnVerseNumClick below. `reader-shift-active` (toggled
    // on the wrapper div above, see its own comment) turns that backdrop
    // `pointer-events: none` for exactly as long as Shift is held, so the
    // second click's pointer event passes through to the verse-num button
    // beneath it -- OnVerseNumClick's own existing shift-click branch then
    // closes the popover itself once a valid range actually forms (or
    // doesn't, if it fell through to the plain-click path -- see its
    // comment), same as before this fix round.
    //
    // Bound on this component's own wrapper div (not verse-num or the
    // popover panel individually) for the same reason the original version
    // was: the real test never waits for ExplorerPopover's own async
    // FocusAsync() to land before pressing Shift, so focus could still be
    // on the just-clicked verse-num button at that instant, or could
    // already be inside the popover panel -- only a common ancestor of BOTH
    // catches the bubbled keydown/keyup reliably regardless of which one
    // currently has focus.
    private void OnPageKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Shift")
        {
            _shiftHeld = true;
        }
    }

    private void OnPageKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Shift")
        {
            _shiftHeld = false;
        }
    }

    // reader.js's watchShiftRelease -> window.blur/document.visibilitychange
    // safety net (see OnAfterRenderAsync). The ONLY way _shiftHeld can go
    // stuck true is Shift being physically released while this tab/window
    // isn't the focused one -- no DOM keyup for it ever reaches this page
    // in that case. Resetting unconditionally (rather than trying to prove
    // Shift is truly no longer held) is always the safe direction: at worst
    // this fires once while Shift genuinely is still down (the user let go
    // specifically while alt-tabbed away), which just makes the backdrop
    // briefly clickable again a little early -- a real Shift keydown on
    // return sets _shiftHeld back to true immediately, same as any other
    // fresh keydown.
    [JSInvokable]
    public void ResetShiftHeld()
    {
        if (_shiftHeld)
        {
            _shiftHeld = false;
            StateHasChanged();
        }
    }

    // reader.js's watchScroll (view-state round-trip) -- fired continuously
    // (rAF-throttled) for as long as this component is mounted. Stamps
    // Book/Chapter alongside ScrollY on every call, not just once, so
    // ViewState.Reader always describes "the current chapter's own current
    // scroll" -- correct even across an in-session chapter change (the
    // SAME Reader instance, and therefore the SAME listener, stays wired
    // straight through one, per OnParametersSetAsync's own reuse). No
    // StateHasChanged -- this never affects Reader's own rendering.
    [JSInvokable]
    public void OnScroll(double y)
    {
        ViewState.Reader.HasData = true;
        ViewState.Reader.Book = _book;
        ViewState.Reader.Chapter = _chapterNum;
        ViewState.Reader.ScrollY = y;
    }

    // READ-2/READ-5 interplay -- REVISED, Batch G1 requirement 1
    // ("selection and exploration are separate gestures on separate
    // targets"): a plain verse-num click ONLY sets the anchor now (no
    // popover -- that's the verse LINE's job, see OnVerseLineKeyDown/the
    // line's own @onclick); shift-click still suppresses any anchor update
    // and shows the passage-chip, unchanged. A shift-click with no anchor
    // yet (the user shift-clicked before ever plain-clicking a verse this
    // visit) has nothing to form a range against -- falls through to the
    // plain-click path instead of silently doing nothing, so the shift-
    // clicked verse itself becomes a usable anchor for the NEXT shift-
    // click. Same fallback when the anchor and the shift-clicked verse are
    // the SAME verse (a degenerate "V-V" range), which would otherwise
    // produce a meaningless one-verse "passage".
    private void OnVerseNumClick(MouseEventArgs e, int verseNum)
    {
        if (e.ShiftKey && _anchorVerse is int anchor && anchor != verseNum)
        {
            _passageRange = (Math.Min(anchor, verseNum), Math.Max(anchor, verseNum));
            _activeNode = null; // suppress the popover -- the chip is the result of a shift-click, not a new popover
            return;
        }

        SetAnchor(verseNum);
    }

    // The shared "plain click" behavior: sets the anchor only, per this
    // batch's own separation of selection (verse-num) from exploration
    // (the verse line, OpenVerse) -- deliberately does NOT open a popover
    // (that was the pre-Batch-G1 behavior, shared with the now-dead ∴
    // button; see this method's own git history for the prior version).
    // Does not touch _activeNode either way, so an already-open popover
    // (e.g. from a just-clicked verse LINE) is left exactly as it was --
    // ExplorerPopover's own backdrop already intercepts a plain click on a
    // DIFFERENT verse-num while it's open anyway (click-outside-to-close),
    // same pre-existing behavior this change doesn't alter.
    private void SetAnchor(int verseNum)
    {
        _anchorVerse = verseNum;
        _passageRange = null;
    }

    // The verse LINE's own keyboard equivalent (design-direction.md: "if
    // the line stays a div, role/tabindex/keydown must make it a genuine
    // button equivalent... Enter opens"). Deliberately Enter only, not
    // Space: Blazor's @onkeydown:preventDefault modifier is a static,
    // whole-element toggle, not conditional per key, so unconditionally
    // suppressing Space's native "scroll the page" default here would also
    // have to suppress Tab's own default focus-move -- a real regression a
    // Space-only omission avoids entirely. The brief's own text asks for
    // "Enter opens", not "Enter/Space".
    private void OnVerseLineKeyDown(KeyboardEventArgs e, int verseNum)
    {
        if (e.Key == "Enter")
        {
            OpenVerse(verseNum);
        }
    }

    private string PassageRef((int From, int To) range) => $"{_book}.{_chapterNum}.{range.From}-{range.To}";

    // passage-chip click (READ-5): PassageNode takes its text directly
    // (concatenated from verses the reader already has in memory -- see
    // PassageNode.cs's own doc comment) rather than issuing a second
    // network round-trip for content this page already rendered.
    private void OpenPassage()
    {
        if (_passageRange is not { } range || _chapter is not { } chapter)
        {
            return;
        }

        var text = string.Join(" ", chapter.Verses
            .Where(v => v.Verse >= range.From && v.Verse <= range.To)
            .Select(v => v.Text));
        _activeNode = new PassageNode(PassageRef(range), text);
    }

    // ScripturePicker composes one of GEN / GEN.1 / GEN.1.5 / GEN.1.5-9 (the
    // 4 canonical ref shapes -- see ScripturePicker.Apply); this is the
    // reader's own NavigateReader-style dispatch for it (World's mount
    // instead sends the same ref straight into scripture-mode).
    private Task ApplyScriptureRef(string sref)
    {
        var parts = sref.Split('.');
        var book = parts[0];
        var chapterNum = parts.Length > 1 ? int.Parse(parts[1]) : 1;
        int? verse = null;
        if (parts.Length > 2)
        {
            var versePart = parts[2];
            var dash = versePart.IndexOf('-');
            verse = int.Parse(dash >= 0 ? versePart[..dash] : versePart);
        }

        // Batch F2 requirement 6c: query (?split=1, when open) BEFORE the
        // fragment -- standard URL syntax, path?query#fragment -- so a
        // picker jump made while split is open doesn't silently drop it
        // (same reasoning as ChapterHref above).
        var query = _splitOpen ? "?split=1" : "";
        var fragment = verse is int v ? $"#v{v}" : "";
        Nav.NavigateTo($"/read/{book}/{chapterNum}{query}{fragment}");
        return Task.CompletedTask;
    }

    private sealed record AdjacentChapter(string Book, string Name, int Chapter);

    private AdjacentChapter? PrevTarget => ComputeAdjacent(forward: false);
    private AdjacentChapter? NextTarget => ComputeAdjacent(forward: true);

    // Crosses book boundaries via the TOC: GEN.50 next -> EXO.1; EXO.1 prev
    // -> GEN.50; null (hidden) at GEN.1's prev and REV.22's next.
    private AdjacentChapter? ComputeAdjacent(bool forward)
    {
        if (_toc is null)
        {
            return null;
        }

        var idx = _toc.FindIndex(b => b.Code == _book);
        if (idx < 0)
        {
            return null;
        }

        var entry = _toc[idx];
        if (forward)
        {
            if (_chapterNum < entry.Chapters.Count)
            {
                return new AdjacentChapter(_book, entry.Name, _chapterNum + 1);
            }

            return idx + 1 < _toc.Count ? new AdjacentChapter(_toc[idx + 1].Code, _toc[idx + 1].Name, 1) : null;
        }

        if (_chapterNum > 1)
        {
            return new AdjacentChapter(_book, entry.Name, _chapterNum - 1);
        }

        if (idx == 0)
        {
            return null;
        }

        var prevEntry = _toc[idx - 1];
        return new AdjacentChapter(prevEntry.Code, prevEntry.Name, prevEntry.Chapters.Count);
    }

    public async ValueTask DisposeAsync()
    {
        if (_readerJs is not null)
        {
            try
            {
                // Batch H (view-state round-trip): NOT a dispose-time
                // getScrollY read -- see reader.js's own watchScroll comment
                // for the real, confirmed race that loses (Blazor's own
                // router resets window scroll on navigation before
                // DisposeAsync ever runs, so a read here would reliably
                // capture 0). ViewState.Reader is already correct by this
                // point, kept that way continuously by OnScroll while this
                // component was mounted -- this call just stops the
                // listener, same "unwire before disposing the module"
                // ordering unwatchShiftRelease below already follows.
                await _readerJs.InvokeVoidAsync("unwatchScroll");

                // Batch R requirement 6: unwires watchChapterNavCenter's own
                // scroll/resize listeners -- same "unwire before disposing
                // the module" ordering every other reader.js watcher here
                // already follows.
                await _readerJs.InvokeVoidAsync("unwatchChapterNavCenter");

                // Removes reader.js's own window/document-level blur and
                // visibilitychange listeners (see watchShiftRelease's own
                // comment) BEFORE disposing the module reference itself --
                // those listeners are global (window/document, not scoped
                // to this component's own DOM), so leaving them wired past
                // this page's own lifetime would call back into a disposed
                // _selfRef on every future navigation's blur/visibility
                // event for as long as the browser tab stays open.
                await _readerJs.InvokeVoidAsync("unwatchShiftRelease");
                await _readerJs.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already gone during teardown -- nothing left to clean up JS-side.
            }
        }

        _selfRef?.Dispose();
    }
}
