    {
        ViewState.Map.CenterLat = lat;
        ViewState.Map.CenterLon = lon;
        ViewState.Map.Zoom = zoom;
    }

    public void OnPolityDeltaClick(string polityId, string polityName, string kind, int titleFromYear, int titleToYear, string? eventText, string[] verses, string? refNote)
    {
        _activeNode = new PolityDeltaNode(polityId, polityName, kind, titleFromYear, titleToYear, eventText, verses, refNote);
        CloseCardNow();
        StateHasChanged();
