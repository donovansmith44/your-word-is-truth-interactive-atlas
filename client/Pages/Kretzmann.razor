@page "/kretzmann"
@using BibleAtlas.Client.Explore
@using BibleAtlas.Client.State
@using BibleAtlas.Client.Views
@implements IDisposable
@inject StateAtom<Locus> LocusAtom
@inject AtlasClient Atlas

@* Batch CORP-1 (R2): the Kretzmann Popular Commentary browser -- a
   LOCUS-KEYED commentary browser. It PROJECTS the shared Locus atom
   (declares ViewCapabilities.BearsLocus, ViewRegistrySetup.Build): it
   ALWAYS shows the commentary for the current book+chapter -- the same one
   the reader is on, by the agreement law (client/Contracts/State.cs's own
   law 5) -- with the SAME ScripturePicker idiom Reader.razor uses for
   direct navigation (the picker's own OnApply dispatches SetLocus directly
   here, since this route carries no per-chapter route params of its own --
   unlike /read/{Book}/{Chapter}, there is nothing to navigate TO; the
   shared atom IS the destination).

   SPLIT-FOLLOW BY CONSTRUCTION (R2, the state layer's first free win):
   this view declares a "read-beside" enter-split hatch with Reader
   (EnterSplitKretzmannHostsReader, ViewRegistrySetup.cs), the SAME
   self-hosting shape Sources.razor's own hatch already proved generic.
   NO Follow link is declared or needed -- Reader ALSO projects the SAME
   Locus atom (BearsLocus) directly off its own `_book`/`_chapterNum` thin
   read, so once both panes are mounted, navigating the reader (picker,
   prev/next, a "read in context" hatch, ...) dispatches SetLocus onto the
   ONE shared atom both members already render off; this page's own
   OnLocusChanged (below) re-renders/refetches in response, with no wiring
   between the two views at all. tests/ux/kretzmann.spec.ts proves this
   directly: navigate the reader while split ⇒ the commentary pane follows.

   Batch VC-1's own official host recipe (CompositionSplit.razor's own
   header, "read this page as that reference example"): follows
   Sources.razor VERBATIM -- a `<CompositionSplit HostName="@ViewNames.Kretzmann">`
   wrapping this page's own content as ChildContent, a `SplitMode`
   parameter threaded to `SplitModeOverride`, `ctx.HostPaneClassSuffix` for
   the class conditional, and one route-level EnterSingle dispatch at mount.
   No second ViewArrangementAtom.Changed subscription -- CompositionSplit
   owns that one, exactly once (see its own header, RULING 1); this page's
   own ENTIRE markup lives inside ChildContent, so it re-renders for free
   whenever the arrangement changes.

   Body: the current chapter's CommentaryItem entries, in canonical order,
   grouped by verse (mirrors the reader's own verse-line grouping). Plain
   click on a row = the existing ONE-RULE explore/popover semantics
   (Explore/CommentaryItemNode.cs): the popover's own title is the row's
   heading (already fetched, shown here); its BODY carries the unit's own
   real prose (Batch CORP-1b, CommentaryItemProseSection -- the generic
   node card's additive `description` field, server-side:
   `atlas_graph::legacy::node_description`'s widened match, resolving
   CORP-1's own disclosed NEEDS_CONTEXT gap).

   LISTING MECHANISM (KRETZ-SCALE-1, batch-finalp1-brief.md ticket 2 --
   supersedes R2's own original "expressible as edge queries from the
   nodes that anchor them" client-side fan-out): `comments-on`/
   `commented-on-by` is a bespoke row table (graph.comments_on) ALREADY
   lowered into the generic directed edge index (graph-types/src/graph.rs's
   own KRETZ-1 "pre-authorized exception") -- R2 shipped with no
   chapter-scoped listing query on the server, so this page used to issue
   one `commented-on-by` edges call PER VERSE in the current chapter,
   concurrently (176 simultaneous requests for a chapter like PSA 119, on
   EVERY locus change). KRETZ-SCALE-1 adds a real, additive, chapter-scoped
   server endpoint (`GET /api/kretzmann/chapter/{cref}`,
   `atlas_graph::kretzmann_adapter::chapter_commentary`) that walks the
   SAME edge machinery server-side, in one request -- this page now issues
   exactly ONE fetch per locus change (`AtlasClient.KretzmannChapter`),
   already grouped by verse, already in document order (the server's own
   accessor sorts by each CommentaryItem's own trailing id ordinal --
   kretzmann_adapter.rs's own "NODE IDENTITY: kretzmann/{book}.{chapter}.
   {ordinal}" -- the SAME ordering this page's own retired client-side
   `OrdinalOf` used to compute locally). *@

<PageTitle>Bible Explorer &mdash; Kretzmann</PageTitle>

<CompositionSplit HostName="@ViewNames.Kretzmann" SplitModeOverride="@SplitMode" HostPaneClass="split-pane-host" Context="ctx">
    <div class="@($"kretzmann-page{ctx.HostPaneClassSuffix}")" data-testid="kretzmann-page">
        <div class="kretzmann-column">
            <h1 class="kretzmann-title">Kretzmann</h1>
            <p class="kretzmann-intro">
                Paul E. Kretzmann's <em>Popular Commentary of the Bible</em>
                (Concordia Publishing House, 1921&ndash;1924) &mdash; verse by
                verse, subordinate to the text it serves.
            </p>

            <ScripturePicker OnApply="ApplyScriptureRef" ThemeClass="picker-parchment" CurrentBook="@_book" CurrentChapter="@_chapterNum" />

            @* Sources.razor's own MINIMAL host recipe: only the "read
               beside" affordance renders here; a split-h GUEST closes
               itself (Reader's own guest-role close button, wired through
               ctx.RequestClose there) -- no separate host-side close
               affordance is needed, matching Sources exactly. *@
            @if (!ctx.IsSplitOpen)
            {
                <button type="button" class="split-open split-open-parchment" data-testid="split-open-kretzmann"
                        @onclick="ctx.InvokeHatch">
                    Read beside the reader
                </button>
            }

            <h2 class="kretzmann-chapter-head" data-testid="kretzmann-chapter-head">@BookName @_chapterNum</h2>

            @if (_error is not null)
            {
                <div class="toast" data-testid="toast">
                    <p class="toast-message">@_error</p>
                </div>
            }
            else if (_loading)
            {
                <p class="kretzmann-loading">Loading&hellip;</p>
            }
            else if (_rows.Count == 0)
            {
                <p class="kretzmann-empty" data-testid="kretzmann-empty">No commentary is indexed for this chapter.</p>
            }
            else
            {
                @foreach (var group in _rows)
                {
                    <section class="kretzmann-verse-group" data-testid="@($"kretzmann-verse-group-{group.Verse}")">
                        <p class="kretzmann-verse-num">@group.Verse</p>
                        @foreach (var item in group.Items)
                        {
                            <button type="button" class="kretzmann-item explorable" data-testid="@($"kretzmann-item-{Slug(item.Id)}")"
                                    @onclick="@(() => OnExplore(item))">
                                @item.Heading
                            </button>
                        }
                    </section>
                }
            }
        </div>
    </div>
</CompositionSplit>

@if (_activeNode is not null)
{
    <ExplorerPopover @key="_activeNode" Root="_activeNode" OnClose="ClosePopover" />
}

@code {
    private sealed record CommentaryItemRow(string Id, string Heading);
    private sealed record CommentaryVerseGroup(int Verse, List<CommentaryItemRow> Items);

    [Parameter] public bool? SplitMode { get; set; }

    private Projection<Locus>? _locusBacking;
    private Projection<Locus> _locus => _locusBacking ??= new Projection<Locus>(LocusAtom);
    private string _book => _locus.Value.Book;
    private int _chapterNum => _locus.Value.Chapter;

    private List<BookTocEntry>? _toc;
    private List<CommentaryVerseGroup> _rows = new();
    private bool _loading = true;
    private string? _error;
    private int _requestId;
    private IExplorable? _activeNode;

    private string BookName => _toc?.FirstOrDefault(b => b.Code == _book)?.Name ?? _book;

    // Wire ids ("CommentaryItem:kretzmann/0.1.0") carry ':' and '/' -- not
    // legal in a bare CSS-identifier-ish testid; a stable, readable slug for
    // the testid only (never used to re-derive the id itself).
    private static string Slug(string wireId) => wireId.Replace(':', '-').Replace('/', '-').Replace('.', '-');

    // Batch CORPREAD-1a (SPLIT-PERSIST-1): the standalone mount-time assert
    // this method used to perform directly is RETIRED -- CompositionSplit's
    // own OnParametersSet now performs it generically (see its own header,
    // RULING 5), and additionally restores a split from the URL when one is
    // present -- Kretzmann gets the SAME refresh-survives-split guarantee
    // Reader always had.
    protected override async Task OnInitializedAsync()
    {
        // Batch CORP-1: the one legitimate direct LocusAtom.Changed
        // subscription this view needs -- see ConformanceTests.cs's own
        // EffectsOnlyViaRegistry allowlist entry for the full justification
        // (mirrors World.razor's own OnLocusChanged: pure re-render, plus
        // here a refetch, no JS interop/Materialize-shaped side effect).
        LocusAtom.Changed += OnLocusChanged;

        try
        {
            _toc = await Atlas.Books();
        }
        catch (Exception)
        {
            // Non-fatal -- BookName falls back to the bare code (see its own
            // property above); the commentary fetch below does not need the
            // TOC at all except to resolve THIS chapter's own verse count.
        }

        await LoadCommentaryAsync();
    }

    private void OnLocusChanged()
    {
        _activeNode = null; // a new chapter invalidates whatever was open, same reset Reader.razor already performs on navigation
        _ = LoadCommentaryAsync();
    }

    public void Dispose()
    {
        LocusAtom.Changed -= OnLocusChanged;
    }

    // ScripturePicker's own composed sref ("GEN.1", "GEN.1.5", "GEN.1.5-9")
    // -- Kretzmann only cares about book+chapter (R2's own "browses by
    // chapter" scope); any verse-range suffix is simply not read.
    private void ApplyScriptureRef(string sref)
    {
        var parts = sref.Split('.');
        if (parts.Length == 0 || string.IsNullOrWhiteSpace(parts[0]))
        {
            return;
        }

        var book = parts[0];
        var chapter = parts.Length > 1 && int.TryParse(parts[1], out var c) ? c : 1;
        LocusAtom.Dispatch(new SetLocus(book, chapter));
    }

    private async Task LoadCommentaryAsync()
    {
        var myRequest = ++_requestId;
        var book = _book;
        var chapterNum = _chapterNum;
        _loading = true;
        _error = null;
        StateHasChanged();

        try
        {
            // KRETZ-SCALE-1: ONE chapter-scoped fetch -- replaces the retired
            // per-verse fan-out (this file's own header comment has the full
            // "why"). The server's own accessor already groups by verse and
            // orders within a verse by document order (its own trailing id
            // ordinal), so no client-side grouping/sorting is needed here at
            // all -- this page's own retired OrdinalOf helper (formerly
            // needed to re-sort the fan-out's own out-of-order concurrent
            // results) is deleted along with the fan-out itself, not merely
            // left dead.
            var doc = await Atlas.KretzmannChapter(book, chapterNum);

            if (myRequest != _requestId)
            {
                return; // superseded by a newer navigation -- discard this stale response
            }

            _rows = doc.Verses
                .Select(v => new CommentaryVerseGroup(
                    v.Verse,
                    v.Items.Select(item => new CommentaryItemRow(item.Id, item.Heading ?? "Commentary")).ToList())) // same fallback graph-types' own card() applies server-side for every OTHER consumer of a heading-less CommentaryItem
                .ToList();
        }
        catch (Exception)
        {
            if (myRequest != _requestId)
            {
                return;
            }

            _error = "Couldn't load the commentary for this chapter — check your connection and try again.";
        }
        finally
        {
            if (myRequest == _requestId)
            {
                _loading = false;
                StateHasChanged();
            }
        }
    }

    private void OnExplore(CommentaryItemRow item) => _activeNode = new CommentaryItemNode(item.Id, item.Heading);

    private void ClosePopover() => _activeNode = null;
}
