@using System.Globalization
@using BibleAtlas.Client.Explore
@inject AtlasClient Atlas
@* A parchment hover card floating over the dusk map (design-direction.md's
   "popovers and hover cards are parchment artifacts on both pages" --
   lamplit paper over the night world). World.razor owns the hover/close-
   delay state machine and just feeds this component whichever place is
   currently showing plus the screen point to anchor at (map.js reports
   that point as e.containerPoint, which lines up with this card's
   positioning context because #world-map fills .world-page via `inset: 0`
   with no border/padding -- see app.css).

   design-direction.md's "Hover place card -- REVISED": the card leads with
   scripture, not bookkeeping -- the place name, then the first two verses
   (canonical order) of the place's merged activating verses as real text,
   then a quiet "Show N more" control expanding the rest of the scene-
   provided (already server-capped) list. The per-(book,chapter) count rows
   (MergedVerseGroups, unchanged since WORLD-2) stay beneath as the compact
   index.

   Because World.razor renders this with no @key, hovering from one marker
   straight to another (no gap where hoverPlace goes null) reuses THIS SAME
   component instance with a new Place parameter, rather than
   destroying/recreating it -- OnParametersSetAsync's _lastPlaceId guard
   below is what resets expand/verse-text state for the new place instead
   of silently showing the previous place's already-fetched text. *@

<div class="place-card @(_expanded ? "place-card-expanded" : "")"
     data-testid="place-card"
     style="left: @X.ToString(CultureInfo.InvariantCulture)px; top: @Y.ToString(CultureInfo.InvariantCulture)px;"
     @onpointerenter="OnPointerEnter"
     @onpointerleave="OnPointerLeave">
    <button type="button" class="place-card-title" data-testid="place-card-title" @onclick="() => OnOpenPlace.InvokeAsync()">@Place.Name</button>

    @{
        var verses = MergedVerses();
        var shown = ShownCount(verses);
    }
    @for (var i = 0; i < shown; i++)
    {
        var vref = verses[i];
        <p class="place-card-verse" data-testid="hover-verse-@vref">
            <span class="place-card-verse-ref">@vref</span>
            <span class="place-card-verse-text">@VerseText(vref)</span>
        </p>
    }
    @if (verses.Count > shown)
    {
        <button type="button" class="place-card-expand" data-testid="place-card-expand" @onclick="Expand">
            Show @(verses.Count - shown) more
        </button>
    }

    <div class="place-card-index">
        @foreach (var vg in MergedVerseGroups())
        {
            <button type="button" class="place-card-verse-group" data-testid="verse-group-@vg.Book-@vg.Chapter"
                    @onclick="() => OpenVerseGroup(vg)">
                <span class="place-card-ref">@vg.Book @vg.Chapter</span>
                <span class="place-card-count">@vg.Count</span>
            </button>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ScenePlace Place { get; set; } = default!;
    [Parameter] public double X { get; set; }
    [Parameter] public double Y { get; set; }
    [Parameter] public EventCallback OnPointerEnter { get; set; }
    [Parameter] public EventCallback OnPointerLeave { get; set; }

    // WORLD-8/Task 15: verse-group rows and the title both promote this
    // hover card's content into a real ExplorerPopover -- World.razor owns
    // _activeNode and constructs the actual VerseNode/PlaceNode (it already
    // has Place.Id/Place.Name in hand from _hoverPlace, the same source this
    // component's own Place parameter comes from), so these callbacks stay
    // parameterless/string-only rather than passing whole node instances
    // across the component boundary.
    [Parameter] public EventCallback<string> OnOpenVerse { get; set; }
    [Parameter] public EventCallback OnOpenPlace { get; set; }

    private const int InitialShown = 2;

    // Identifies which place the fetched/fetching _verseText belongs to, so
    // a hover that moves marker-to-marker (see the file-header comment)
    // resets rather than showing stale text under the new place's name.
    private string? _lastPlaceId;
    private bool _expanded;
    private readonly Dictionary<string, string> _verseText = new();

    private sealed record MergedGroup(string Book, int Chapter, int Count);

    // Counts merge across every event attached to this place, summed per
    // (book, chapter) -- tests/ux/world-map.spec.ts's WORLD-2 property
    // builds the exact same book-chapter -> summed-count map from
    // p.events[].verse_groups[] before asserting against each
    // verse-group-{BOOK}-{chapter} row, so this must match it exactly.
    private List<MergedGroup> MergedVerseGroups()
    {
        var counts = new Dictionary<(string Book, int Chapter), int>();
        var order = new List<(string Book, int Chapter)>();

        foreach (var e in Place.Events)
        {
            foreach (var g in e.VerseGroups)
            {
                var key = (g.Book, g.Chapter);
                if (!counts.ContainsKey(key))
                {
                    order.Add(key);
                    counts[key] = 0;
                }

                counts[key] += g.Count;
            }
        }

        return order.Select(key => new MergedGroup(key.Book, key.Chapter, counts[key])).ToList();
    }

    // WORLD-8/Task 15: a verse-group row opens a VerseNode for the FIRST
    // verse of that (book,chapter) group -- same nested Events/VerseGroups
    // walk order as MergedVerseGroups above (event order, then each event's
    // own already book/chapter/verse-ascending VerseGroups), so "first
    // match" is exactly the group's own first (and canonically earliest)
    // verse, not an arbitrary pick.
    private async Task OpenVerseGroup(MergedGroup vg)
    {
        var vref = FirstVerseOf(vg.Book, vg.Chapter);
        if (vref is not null)
        {
            await OnOpenVerse.InvokeAsync(vref);
        }
    }

    private string? FirstVerseOf(string book, int chapter)
    {
        foreach (var e in Place.Events)
        {
            foreach (var g in e.VerseGroups)
            {
                if (g.Book == book && g.Chapter == chapter && g.Verses.Count > 0)
                {
                    return g.Verses[0];
                }
            }
        }

        return null;
    }

    // The flat, deduped verse-id list the new lead-with-scripture block
    // renders from -- same merge shape as MergedVerseGroups above (event
    // order, then each event's own already (book,chapter)-then-verse-number
    // sorted VerseGroups -- see atlas-core's verse_groups_for), just keeping
    // the actual capped verse ids instead of collapsing them to a count.
    // Deduped (a verse can legitimately anchor more than one event at the
    // same place, e.g. two narrative beats both citing the crossing verse)
    // so neither a hover-verse-{VREF} testid nor a human ever sees the same
    // verse twice.
    private List<string> MergedVerses()
    {
        var seen = new HashSet<string>();
        var result = new List<string>();

        foreach (var e in Place.Events)
        {
            foreach (var g in e.VerseGroups)
            {
                foreach (var v in g.Verses)
                {
                    if (seen.Add(v))
                    {
                        result.Add(v);
                    }
                }
            }
        }

        return result;
    }

    private int ShownCount(List<string> verses) => _expanded ? verses.Count : Math.Min(InitialShown, verses.Count);

    private string VerseText(string vref) => _verseText.TryGetValue(vref, out var text) ? text : "";

    // Fires on every parameter push, including this component's very first
    // render (Place.Id vacuously differs from the null _lastPlaceId then
    // too) -- the _lastPlaceId guard makes both cases, and an X/Y-only
    // update from the SAME place (no re-fetch needed), converge correctly.
    // Awaiting the fetch here (rather than firing it off unobserved) is
    // deliberate: Blazor renders once synchronously right after parameters
    // are applied and this method's synchronous prefix runs, THEN again
    // when the awaited task completes -- so the place name and every
    // hover-verse-{VREF} ref (MergedVerses/ShownCount are pure, synchronous)
    // paint immediately, and VerseText(vref) simply reads "" until the
    // second render fills it in. Same pattern ExplorerPopover's
    // OnInitializedAsync/LoadCurrent already relies on for its own body.
    protected override async Task OnParametersSetAsync()
    {
        if (Place.Id == _lastPlaceId)
        {
            return;
        }

        _lastPlaceId = Place.Id;
        _expanded = false;
        _verseText.Clear();
        await LoadChaptersFor(MergedVerses().Take(InitialShown));
    }

    private async Task Expand()
    {
        _expanded = true;
        await LoadChaptersFor(MergedVerses().Skip(InitialShown));
    }

    // Resolves every (book, chapter) pair the given verses span (usually
    // one) via AtlasClient's own Chapter LRU cache -- a hover that
    // revisits a place, or an expand that reopens a chapter InitialShown
    // already touched, never re-hits the network. Populates every verse
    // FROM each fetched chapter, not just the ones asked for: harmless
    // (VerseText only ever reads keys it knows to look up) and means two
    // requested verses sharing a chapter cost exactly one fetch.
    private async Task LoadChaptersFor(IEnumerable<string> vrefs)
    {
        var pairs = vrefs.Select(CanonRef.ParseVerse).Select(p => (p.Book, p.Chapter)).Distinct().ToList();
        if (pairs.Count == 0)
        {
            return;
        }

        try
        {
            var chapters = await Task.WhenAll(pairs.Select(p => Atlas.Chapter(p.Book, p.Chapter)));
            foreach (var chapter in chapters)
            {
                // chapter.Ref is the CODE-based "JDG.3" (atlas-server's
                // ChapterOut.sref, built from book.code()); chapter.Book is
                // the human-readable display NAME ("Judges", book.name()) --
                // a real, deliberate API distinction (VerseGroup.Book is the
                // code; ChapterOut.Book is the name), not interchangeable.
                // Building the key from Book here silently produced
                // "Judges.3.7" instead of "JDG.3.7", so it could never match
                // a hover-verse-{VREF} testid -- caught by
                // world-hover-text.spec.ts (verse text never appeared).
                foreach (var v in chapter.Verses)
                {
                    _verseText[$"{chapter.Ref}.{v.Verse}"] = v.Text;
                }
            }
        }
        catch (Exception)
        {
            // A hover card's verse text is a nicety, not load-bearing -- the
            // ref already rendered synchronously above; leaving its text
            // blank on a flaky-network failure degrades gracefully instead
            // of an unhandled exception from this lifecycle continuation
            // taking down the whole app.
        }
    }
}
