@* Era-segmented, year-exact time slider: the "timeline instrument" docked
   over the world map (design-direction.md). SVG-free -- era bands are flex
   children and the brush is two absolutely-positioned drag handles. All
   year math (handle positions, drag hit-testing) goes through SliderScale,
   which is zero-year-aware (there is no year 0).
   Batch C fix round: each band renders at an EXACT `flex: 0 0 {px}px` width
   computed by SliderScale.EraWidths (the SAME numbers the handles' own
   pixel math uses) -- NOT flex-grow-with-a-min-width-percentage, which
   this file used until WORLD-7's exhaustive era-click property test
   caught it drifting from SliderScale's own widths by enough px, once the
   track shrank to 520, for a released handle to land on the NEXT era
   button's clickable center instead of its own band's edge. See
   SliderScale.EraWidths's own doc comment for the full story. *@

<div class="slider" data-testid="slider" aria-disabled="@(Disabled ? "true" : "false")">
    <input class="slider-readout"
           data-testid="slider-readout"
           value="@_readoutText"
           spellcheck="false"
           aria-label="Time window"
           @oninput="OnReadoutInput"
           @onkeydown="OnReadoutKeyDown" />

    <div class="slider-track"
         @onpointermove="OnTrackPointerMove"
         @onpointerup="OnTrackPointerUp"
         @onpointercancel="OnTrackPointerUp"
         @onpointerleave="OnTrackPointerUp">
        @for (var i = 0; i < Eras.Count; i++)
        {
            var era = Eras[i];
            var active = EffectiveFrom <= era.ToYear && EffectiveTo >= era.FromYear;
            var bandWidthPx = EraWidthsPx[i].ToString(System.Globalization.CultureInfo.InvariantCulture);
            <button type="button"
                    class="slider-era"
                    data-testid="slider-era-@era.Id"
                    data-active="@(active ? "true" : "false")"
                    style="flex: 0 0 @(bandWidthPx)px;@(_dragTarget is not null ? " pointer-events: none;" : "")"
                    title="@era.Name"
                    @onclick="() => ApplyEra(era)">
                @era.Name
            </button>
        }

        @if (Eras.Count > 0)
        {
            <div class="slider-handle slider-handle-from"
                 style="left: @(HandleX(EffectiveFrom).ToString(System.Globalization.CultureInfo.InvariantCulture))px;@(_dragTarget is not null ? " pointer-events: none;" : "")"
                 role="slider"
                 tabindex="0"
                 aria-label="Window start year"
                 aria-valuenow="@EffectiveFrom"
                 aria-valuemin="@Eras[0].FromYear"
                 aria-valuemax="@Eras[^1].ToYear"
                 aria-valuetext="@YearText.Format(EffectiveFrom)"
                 @onpointerdown="@(() => OnHandlePointerDown("from"))"
                 @onkeydown="@(e => OnHandleKeyDown("from", e))"></div>
            <div class="slider-handle slider-handle-to"
                 style="left: @(HandleX(EffectiveTo).ToString(System.Globalization.CultureInfo.InvariantCulture))px;@(_dragTarget is not null ? " pointer-events: none;" : "")"
                 role="slider"
                 tabindex="0"
                 aria-label="Window end year"
                 aria-valuenow="@EffectiveTo"
                 aria-valuemin="@Eras[0].FromYear"
                 aria-valuemax="@Eras[^1].ToYear"
                 aria-valuetext="@YearText.Format(EffectiveTo)"
                 @onpointerdown="@(() => OnHandlePointerDown("to"))"
                 @onkeydown="@(e => OnHandleKeyDown("to", e))"></div>
        }
    </div>
</div>

@code {
    // Must equal .slider-track's content-box width (app.css) exactly, so a
    // pointer's OffsetX within the track maps 1:1 onto SliderScale's pixel
    // space without any DOM measurement (no JS interop needed). app.css
    // deliberately gives .slider-track `box-sizing: content-box` (overriding
    // the project-wide border-box reset) so its literal `width: 520px`
    // *is* this 520 -- under the default border-box, the track's 1px border
    // would shrink the actual content/padding box (what OffsetX and an
    // absolutely-positioned child's `left:` both resolve against) to 518px,
    // 2px short of this constant, making the last year(s) of the final era
    // unreachable by drag. If .slider-track's width or border ever changes,
    // update this constant to match -- SHRUNK from 800 to 520 (Batch C,
    // "Instrument chrome re-layout, de-cramped": timeline moves to
    // bottom-right with a smaller footprint, see app.css's own .slider
    // comment) alongside app.css's matching change, in the same commit.
    // First tried 460 -- screenshot review found the 4 shortest eras
    // (United Kingdom/Exile/Gospels/Early Church, all pinned to
    // SliderScale.EraWidths's own floor share) rendering as a single truncated letter,
    // which crosses from "smaller" into "not usable"; 520 gives the
    // proportionally-sized eras noticeably more room and is a still-real
    // 35% reduction from 800 (a fully independent, cheap mitigation for the
    // floored eras specifically -- the title="era.Name" native tooltip
    // added to the era button below -- covers the rest: no width was ever
    // going to fit "United Kingdom" into a 1/20th-of-the-track floor slot
    // this slider's own min-width mechanism defines). SliderScale's own
    // year<->pixel math is width-agnostic (every call site threads this
    // same constant through, so both directions of the conversion stay
    // exact at any width -- see client.Tests/SliderScaleTests.cs, which
    // exercises the math at a THIRD width (1000) entirely and still
    // passes, proving the algorithm itself never hardcoded 800 or 520).
    // Era buttons and handles get inline pointer-events:none while
    // dragging (below) so OffsetX always stays relative to the track
    // itself, never to whichever child happens to be under the pointer
    // mid-drag.
    private const double TrackWidthPx = 520.0;

    // Magnetic drag-release snap threshold in TRACK PIXELS (Batch C/CONTRACT
    // amendment -- user feedback 2026-08-19: "if I select a time period in
    // the slider, it should snap to that timerange exactly without
    // overlapping with other time periods unless I drag the slider
    // deliberately"). See SnapToEraBoundary below for how this is used --
    // only ever at the RELEASE point, never during the drag itself.
    private const double SnapThresholdPx = 6.0;

    [Parameter] public List<EraDto> Eras { get; set; } = new();
    [Parameter] public int From { get; set; }
    [Parameter] public int To { get; set; }
    [Parameter] public EventCallback<(int From, int To)> OnWindowChange { get; set; }

    // WORLD-6/CONTRACT: "the slider is aria-disabled=true while scripture
    // mode is active" -- World.razor passes this whenever a scripture ref is
    // driving the scene instead of a time window. Deliberately aria- rather
    // than the native `disabled` attribute (per CONTRACT's own wording), so
    // the control stays focusable/inspectable for assistive tech; every
    // handler below independently no-ops on Disabled so the slider is
    // actually inert (drag, era clicks, readout Enter/typing, arrow-key
    // nudge) regardless of how a browser or test driver reaches it -- CSS
    // (app.css: .slider[aria-disabled="true"]) only supplies the visual dim
    // and blocks mouse/touch pointer-events; it can't stop a keyboard path.
    [Parameter] public bool Disabled { get; set; }

    private string _readoutText = "";
    private int _lastFrom = int.MinValue;
    private int _lastTo = int.MinValue;

    private string? _dragTarget; // "from" | "to" | null when idle
    private int _dragFrom;
    private int _dragTo;

    private int EffectiveFrom => _dragTarget is not null ? _dragFrom : From;
    private int EffectiveTo => _dragTarget is not null ? _dragTo : To;

    // The exact per-era pixel widths the era bands render at -- SAME numbers
    // HandleX/SliderScale.XToYear use, by construction (see this file's own
    // header comment for why that equality is now load-bearing, not just
    // assumed). Recomputed on every access rather than cached in a field:
    // Eras only ever changes via a fresh parameter set, at which point a new
    // render happens anyway, so there's no stale-cache risk to guard against
    // and no measurable cost to recomputing (10 eras, O(eras) work).
    private double[] EraWidthsPx => SliderScale.EraWidths(Eras, TrackWidthPx);

    protected override void OnParametersSet()
    {
        // Resync the readout's text to the applied window whenever it
        // actually changes (initial load, era click, drag release, or an
        // external URL navigation) -- but never on an unrelated re-render,
        // so a keystroke mid-edit is never clobbered before Enter is pressed.
        if (From != _lastFrom || To != _lastTo)
        {
            _lastFrom = From;
            _lastTo = To;
            _readoutText = YearText.FormatRange(From, To);
        }
    }

    // Guarded (not just cosmetically ignored) so typing while disabled can
    // never leave the readout showing an edit that was never actually
    // applied -- it stays frozen at whatever From/To's own resync last set,
    // for as long as Disabled is true.
    private void OnReadoutInput(ChangeEventArgs e)
    {
        if (Disabled)
        {
            return;
        }

        _readoutText = e.Value?.ToString() ?? "";
    }

    private async Task OnReadoutKeyDown(KeyboardEventArgs e)
    {
        if (Disabled || e.Key != "Enter")
        {
            return;
        }

        if (YearText.TryParse(_readoutText, out var from, out var to))
        {
            await OnWindowChange.InvokeAsync((from, to));
        }
    }

    private async Task ApplyEra(EraDto era)
    {
        if (Disabled)
        {
            return;
        }

        await OnWindowChange.InvokeAsync((era.FromYear, era.ToYear));
    }

    // The sole place _dragTarget is ever set to non-null -- guarding here is
    // enough to keep the whole drag gesture (OnTrackPointerMove/Up below)
    // inert while disabled, since both already no-op on `_dragTarget is
    // null`.
    private void OnHandlePointerDown(string which)
    {
        if (Disabled)
        {
            return;
        }

        _dragTarget = which;
        _dragFrom = From;
        _dragTo = To;
    }

    private void OnTrackPointerMove(PointerEventArgs e)
    {
        if (_dragTarget is null || Eras.Count == 0)
        {
            return;
        }

        var year = SliderScale.XToYear(e.OffsetX, Eras, TrackWidthPx);
        if (_dragTarget == "from")
        {
            _dragFrom = Math.Min(year, _dragTo);
        }
        else
        {
            _dragTo = Math.Max(year, _dragFrom);
        }
    }

    // Magnetic drag-release snap (CONTRACT amendment -- see SnapThresholdPx's
    // own comment for the sanctioning feedback). Only the RELEASE point is
    // ever snapped: OnTrackPointerMove above is completely unchanged --
    // still pure raw-year tracking during the drag itself ("no snapping
    // during drag motion" per the brief), so the brush visibly tracks the
    // pointer exactly right up to release. Only then, here, does the
    // released handle possibly jump to the nearest era boundary -- and only
    // if the release pixel was within SnapThresholdPx of one; releasing
    // anywhere else keeps the exact dragged year ("a mid-era release keeps
    // the exact year -- deliberate drag wins").
    private async Task OnTrackPointerUp(PointerEventArgs e)
    {
        if (_dragTarget is null)
        {
            return;
        }

        var (from, to) = (_dragFrom, _dragTo);
        if (_dragTarget == "from")
        {
            from = Math.Min(SnapToEraBoundary(from, e.OffsetX), to);
        }
        else
        {
            to = Math.Max(SnapToEraBoundary(to, e.OffsetX), from);
        }

        _dragTarget = null;
        if (from != From || to != To)
        {
            await OnWindowChange.InvokeAsync((from, to));
        }
    }

    // Every era's FromYear AND ToYear is a candidate boundary (adjacent
    // eras' own boundary years are one year apart, not the same number --
    // e.g. primeval ends -2167, patriarchs starts -2166 -- so both sides
    // must be checked; whichever is pixel-nearest the actual release point
    // wins). Compares against the RAW release pixel (releaseOffsetX), not
    // the already-year-quantized draggedYear's own recomputed position --
    // "within ~6px of an era boundary" is about where the pointer physically
    // let go, which is the more precise/faithful signal. Returns
    // draggedYear unchanged if nothing is within SnapThresholdPx.
    private int SnapToEraBoundary(int draggedYear, double releaseOffsetX)
    {
        int? nearestYear = null;
        var nearestDist = double.MaxValue;
        foreach (var era in Eras)
        {
            foreach (var boundary in new[] { era.FromYear, era.ToYear })
            {
                var boundaryX = SliderScale.YearToX(boundary, Eras, TrackWidthPx);
                var dist = Math.Abs(boundaryX - releaseOffsetX);
                if (dist < nearestDist)
                {
                    nearestDist = dist;
                    nearestYear = boundary;
                }
            }
        }

        return nearestYear is int boundaryYear && nearestDist <= SnapThresholdPx ? boundaryYear : draggedYear;
    }

    private async Task OnHandleKeyDown(string which, KeyboardEventArgs e)
    {
        var delta = e.Key switch { "ArrowLeft" => -1, "ArrowRight" => 1, _ => 0 };
        if (Disabled || delta == 0 || Eras.Count == 0)
        {
            return;
        }

        var from = From;
        var to = To;
        if (which == "from")
        {
            from = ClampToSpan(NudgeYear(From, delta));
            if (from > to)
            {
                from = to;
            }
        }
        else
        {
            to = ClampToSpan(NudgeYear(To, delta));
            if (to < from)
            {
                to = from;
            }
        }

        if (from != From || to != To)
        {
            await OnWindowChange.InvokeAsync((from, to));
        }
    }

    // There is no year 0 (1 BC is immediately followed by AD 1); stepping by
    // one year must hop over it rather than land on it.
    private static int NudgeYear(int year, int delta)
    {
        var next = year + delta;
        return next == 0 ? next + delta : next;
    }

    private int ClampToSpan(int year) => Math.Clamp(year, Eras[0].FromYear, Eras[^1].ToYear);

    private double HandleX(int year) => Eras.Count == 0 ? 0 : SliderScale.YearToX(year, Eras, TrackWidthPx);
}
