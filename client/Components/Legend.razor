<div class="legend" data-testid="legend">
    @foreach (var n in Narratives)
    {
        var pressed = IsolatedId == n.Id;
        <button type="button"
                class="legend-item"
                data-testid="legend-item-@n.Id"
                aria-pressed="@(pressed ? "true" : "false")"
                @onclick="() => Toggle(n.Id)">
            <svg class="legend-swatch" viewBox="0 0 28 10" aria-hidden="true" focusable="false">
                <defs>
                    <marker id="legend-ah-@n.Id" viewBox="0 0 10 10" refX="8.5" refY="5"
                            markerWidth="6" markerHeight="6" orient="auto">
                        <path d="M0,0 L10,5 L0,10 z" fill="@n.Color" />
                    </marker>
                </defs>
                <line x1="1" y1="5" x2="21" y2="5" stroke="var(--dusk-deep)" stroke-width="5" opacity=".45" />
                <line x1="1" y1="5" x2="21" y2="5" stroke="@n.Color" stroke-width="3"
                      marker-end="url(#legend-ah-@n.Id)" />
            </svg>
            <span class="legend-name">@n.Name</span>
            <span class="legend-count">@n.LegsInScene</span>
        </button>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<SceneNarrative> Narratives { get; set; } = default!;
    [Parameter] public string? IsolatedId { get; set; }
    [Parameter] public EventCallback<string?> OnIsolate { get; set; }

    private async Task Toggle(string id) => await OnIsolate.InvokeAsync(IsolatedId == id ? null : id);
}
