@using BibleAtlas.Client.Contract
@using BibleAtlas.Client.Exploring

@if (Items.Count > 0)
{
    <div class="popover-catechism-list">
        @foreach (var unit in Items)
        {
            <button type="button" class="popover-catechism-item explorable" data-testid="@($"concord-link-{Slug(unit.Label)}")"
                    @onclick="() => OnExplore.InvokeAsync(new PopoverOpening.Explore(new NodePosition(unit)))">
                @unit.Label
            </button>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<NodeRef> Items { get; set; } = Array.Empty<NodeRef>();
    [Parameter, EditorRequired] public EventCallback<PopoverOpening> OnExplore { get; set; }

    private static string Slug(string citation) => citation.Replace(' ', '-').Replace('.', '-');
}
