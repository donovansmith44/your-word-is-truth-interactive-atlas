   CHRONO-MERGE-1 (owner NOD 2026-08-24, "put chronology up top... don't
   clutter with story line where story doesn't exist"): a SECOND rendering
   MODE, `Inline` -- the divergence-only story-thread line's own leg
   affordance ("in <narrative>: next -> <leg>", EventChronologySection's
   own doc comment has the full divergence rule) needs the identical
   click-commits/dwell-peeks contract this component already gives the
   block-mode arrows, living instead as ONE clickable run inside a running
   sentence, never a second arrow-button+role-caption grid. Rather than a
   parallel component (this file's own header above already explains why
   the dwell timer/peek machinery needs a real component instance, not a
   closure) or a second peek implementation, `Inline` branches ONLY the
   "what does the clickable content look like" fragment of the markup
   below -- every timer, the F1/F2 placement/truncation math, and the
   PEEK-TRUNC-1 corridor all stay the untouched, single implementation
   they already were ("do not re-derive placement math," the batch
   brief's own words). `InlinePrefixText` carries the sentence-level word
   a leg needs ("next ", following only -- the same asymmetry the brief's
   own worked example uses: "<-" alone for a diverging prior, "next ->"
   for a diverging following), so the CALLER (EventChronologySection)
   never has to reach into this component's own markup to compose it.
   `Glyph` for an inline leg is the ordinary prose arrow (&lt;-/-&gt;),
   never the block mode's own triangle glyphs (the same deliberately
   different register a sentence needs versus a button). The role caption
   (`RoleTestIdPrefix`) and TITLE-WRAP-1's own two-line clamp are both
   BLOCK-mode-only -- a story-thread leg shows its full name unclamped,
   never truncated: it is not squeezed into a 47%-width column the way a
   block arrow is, so there is nothing here for that clamp to solve. *@
@using System.Globalization
@inject AtlasClient Atlas
@inject IJSRuntime JS
@implements IDisposable

<div class="@WrapperClass" @ref="_sideRef"
     @onpointerenter="OnPointerEnter" @onpointerleave="OnPointerLeave" @onpointerdown="OnWrapperPointerDown">
@if (Adjacent is null)
{
    @* CHRONO-MERGE-1: the inline story-thread leg is only ever rendered by
       its caller when Adjacent is genuinely present (a diverging narrative
       leg is never null by construction -- see EventChronologySection's
       own Diverges doc comment) -- no empty-placeholder markup for a case
       this mode never reaches. *@
    @if (!Inline)
    {
        <span class="popover-event-nav-arrow popover-event-nav-arrow-@Direction popover-event-nav-arrow-empty"></span>
    }
}
else if (Inline)
{
    <button type="button" class="popover-story-thread-leg explorable-quiet"
            data-testid="@($"{EventTestIdPrefix}-{IdSuffix}")"
            aria-label="@($"{(Direction == "prior" ? "Prior" : "Following")} event: {Adjacent.Label}")"
            @onclick="Commit">@InlinePrefixText<span class="popover-event-nav-glyph">@Glyph</span> @Adjacent.Label</button>
}
else
{
    <button type="button" class="popover-event-nav-arrow popover-event-nav-arrow-@Direction explorable"
            data-testid="@($"{EventTestIdPrefix}-{IdSuffix}")"
            aria-label="@($"{(Direction == "prior" ? "Prior" : "Following")} event: {Adjacent.Label}")"
            @onclick="Commit">
        @if (Direction == "prior")
        {
            <span class="popover-event-nav-glyph">@Glyph</span>
        }
        @* TITLE-WRAP-1: LabelIsLong picks the two-line-clamp/smaller-size
           treatment (app.css's own .popover-event-nav-label-long) instead
           of the base one-line/ellipsis rule -- see that property's own
           doc comment below for the threshold, and app.css's own comment
           on the base rule for how the two stay grid-aligned regardless. *@
        <span class="popover-event-nav-label @(LabelIsLong ? "popover-event-nav-label-long" : null)" title="@Adjacent.Label">@Adjacent.Label</span>
        @if (Direction == "following")
        {
            <span class="popover-event-nav-glyph">@Glyph</span>
        }
    </button>

    <p class="popover-event-nav-role" data-testid="@($"{RoleTestIdPrefix}-{IdSuffix}")">@RoleText</p>
}

@* CHRONO-MERGE-1: hoisted out of the block-only `else` above -- the peek
   itself is IDENTICAL regardless of which mode opened it (the whole point
   of reusing this component rather than re-deriving a second one), so it
   is written ONCE and shared by both. `_showPeek` is never true while
   `Adjacent` is null (OnPointerEnter returns early in that case), but the
   guard is repeated here defensively now that this fragment no longer
   sits inside the `else` branch C#'s own flow analysis used to narrow it
   through. *@
@if (_showPeek && Adjacent is not null)
{
    <div class="popover-arrow-peek @(_peekFlipAbove ? "popover-arrow-peek-above" : null)" style="@PeekStyle"
         data-testid="@($"{EventTestIdPrefix}-{IdSuffix}-peek")">
        <p class="popover-arrow-peek-title" data-testid="@($"{EventTestIdPrefix}-{IdSuffix}-peek-title")">@Adjacent.Label</p>
        @if (_peekVerses.Count > 0)
        {
            @foreach (var v in _peekVerses.Take(_peekShown))
            {
                <p class="popover-arrow-peek-verse" data-testid="@($"{EventTestIdPrefix}-{IdSuffix}-peek-verse-{v.Vref}")">
                    <sup class="popover-arrow-peek-verse-num">@CanonRef.ParseVerse(v.Vref).Verse</sup><MentionText Text="@v.Text" Places="@(v.Places ?? Array.Empty<PlaceRefDto>())" Persons="@(v.Persons ?? Array.Empty<PersonRefDto>())"
                        Verse="@CanonRef.ParseVerse(v.Vref).Verse" ClassPrefix="popover-arrow-peek-mention" TestIdSuffix="@($"-{EventTestIdPrefix}-{IdSuffix}-peek")" OnExplore="OnExplore" />
                </p>
            }
            <RevealControls Total="@_peekVerses.Count" Default="1" Shown="@_peekShown" ShownChanged="OnPeekShownChanged"
                             MoreTestId="@($"{EventTestIdPrefix}-{IdSuffix}-peek-more")" CollapseTestId="@($"{EventTestIdPrefix}-{IdSuffix}-peek-collapse")"
                             RevealNoun="verses" />
            @* F2 fix round: RevealControls' own Total above is honest
               about what this peek actually HOLDS (_peekVerses.Count)
               -- "all (N)" never overclaims something more/all can't
               actually reveal. This separate, non-interactive note is
               the disclosure for verses the SERVER itself never sent
               at all (ComputeTruncatedBy's own doc comment has the
               full mechanism) -- present regardless of _peekShown, a
               standing fact about this chapter, not something tied to
               the current reveal state. *@
            @if (_peekTruncatedBy > 0)
            {
                <p class="popover-arrow-peek-truncated" data-testid="@($"{EventTestIdPrefix}-{IdSuffix}-peek-truncated")"
                   title="This chapter has more verses than this peek can show">+@_peekTruncatedBy more (this chapter's own display cap)</p>
            }
        }
    </div>
}
</div>

@code {
    // "prior" | "following" -- the ONE distinction every glyph/role/class
    // decision below reads off (never a bool: a third direction is not
    // conceivable here, but the string reads the same as the marker
    // testid/aria-label prefixes it feeds, one fewer translation to keep
    // in sync).
    [Parameter, EditorRequired] public string Direction { get; set; } = default!;

    // Base testid PREFIXES -- this instance's own `IdSuffix` (below) is
    // appended by every render site (`{prefix}-{suffix}`), the SAME
    // disambiguation convention the retired RenderNavArrow established
    // (a real narrative id for Narrative rows; "global" for the one
    // Chronology row -- see EventChronologySection's own call site).
    [Parameter, EditorRequired] public string EventTestIdPrefix { get; set; } = default!;
    [Parameter, EditorRequired] public string RoleTestIdPrefix { get; set; } = default!;
    [Parameter, EditorRequired] public string IdSuffix { get; set; } = default!;

    [Parameter] public NarrativeAdjacentEventDto? Adjacent { get; set; }
    [Parameter, EditorRequired] public string Glyph { get; set; } = default!;

    // CHRONO-MERGE-1: see this file's own header comment (the paragraph
    // immediately above the markup) for the full "why a mode, not a
    // second component" story. Both default false/null -- every
    // pre-existing call site (the block-mode narrative/Chronology arrows)
    // is unaffected without needing to pass either.
    [Parameter] public bool Inline { get; set; }
    [Parameter] public string? InlinePrefixText { get; set; }

    // The SAME "a caller/provider supplies the real push, this component
    // only ever proposes a node" contract MentionText/PericopeHeading
    // already follow -- reused for BOTH the arrow's own commit (click) and
    // a mention link resolved INSIDE the dwell peek's own verse text (a
    // peek is read-only in the sense that dwelling never itself commits,
    // but a place/person name within the peeked verse stays explorable
    // like it is everywhere else text renders -- decision 4 never asked
    // for THAT to be disabled, only for the ARROW's own hover to stop
    // short of traversing).
    [Parameter, EditorRequired] public EventCallback<IExplorable> OnExplore { get; set; }

    private string RoleText => Direction == "prior" ? "PRIOR EVENT" : "FOLLOWING EVENT";

    // CHRONO-MERGE-1: the ONE thing that actually differs about the
    // wrapper element between the two modes -- Inline drops the block
    // grid's own 47%-capped, direction-suffixed column class in favor of
    // a plain relatively-positioned inline-block (app.css's own
    // .popover-story-thread-leg-wrap), just enough to anchor the SAME
    // .popover-arrow-peek below it (position:relative is all the peek's
    // own absolute positioning ever needed from this wrapper, block or
    // inline alike).
    private string WrapperClass => Inline ? "popover-story-thread-leg-wrap" : $"popover-event-nav-side popover-event-nav-side-{Direction}";

    private Task Commit()
    {
        if (Adjacent is null)
        {
            return Task.CompletedTask;
        }

        // CHAP-HOVER-1's own "a click always supersedes any peek still
        // showing/mid-dwell -- never both at once" law, mirrored here: in
        // the ordinary case this instance is about to be disposed anyway
        // (the popover re-resolves its sections for the newly-pushed
        // node), which would cancel these same timers via Dispose below,
        // but there is no reason to leave a stale peek/timer alive for
        // even one extra render on the way there.
        CancelDwell();
        CancelDismiss();
        HidePeekState();
        return OnExplore.InvokeAsync(new EventNode(Adjacent.Id, Adjacent.Label));
    }

    // TITLE-WRAP-1 (owner report, 2026-08-24, verbatim: "i don't like that
    // arrow titles are getting cut off with elipses... we need to find a
    // way to have a nice presentation while showing a relatively full
    // title."): a character-count threshold, not a JS-measured pixel
    // check -- this is a cosmetic layout decision, not something worth a
    // round trip for. Measured against the real curated event-label corpus
    // (data/curated/events-extra.toml, 265 labels): median length 39,
    // only ~9% are <=24 characters, so 24 is picked as "reliably fits the
    // button's own ~200px column on one line at standard size" -- the
    // overwhelming majority of real names DO wrap, which matches the
    // owner's own complaint (routine, not rare, truncation). The two-line
    // clamp at the smaller size (app.css's own
    // .popover-event-nav-label-long) comfortably holds labels up to
    // ~60-65 characters at that size; only the longest ~4% of the same
    // corpus would ever reach its own ellipsis-past-two-lines backstop.
    private const int LongLabelThreshold = 24;
    private bool LabelIsLong => Adjacent is not null && Adjacent.Label.Length > LongLabelThreshold;

    private bool _showPeek;
    private List<PassageListVerse> _peekVerses = new();

    // F2 fix round -- how many MORE verses the server's own true count
    // says exist beyond what actually resolved into _peekVerses (the
    // server's own 20-verse-per-chapter cap, HOTFIX-4), computed once per
    // dwell session by ComputeTruncatedBy below. 0 (the overwhelming
    // majority of real events) renders nothing extra; >0 renders the
    // honest disclosure paragraph in the markup above.
    private int _peekTruncatedBy;

    // PEEK-TRUNC-1: RevealControls' own two-way-bound Shown state -- the
    // ONE-verse floor is Default="1" below (the markup), never re-derived
    // here; this field is purely "how many of _peekVerses are currently
    // revealed," reset to the floor every time a FRESH peek opens (never
    // remembers a prior session's own expansion -- HidePeekState below).
    private int _peekShown = 1;

    private CancellationTokenSource? _dwellCts;

    // PEEK-TRUNC-1 corridor -- see this file's own header comment for the
    // full "why a grace period, why 1000ms" story.
    private CancellationTokenSource? _dismissCts;
    private const int PeekDismissGraceMs = 1000;

    // PEEK-TRUNC-1 placement -- see this file's own header comment.
    // _peekMeasured guards OnAfterRenderAsync's own measurement to ONCE
    // per peek OPEN (reset alongside _showPeek itself, both in
    // DwellThenPeek -- a fresh open -- and HidePeekState -- a dismiss, so
    // the NEXT open always re-measures rather than reusing a stale rect
    // from wherever the page happened to be scrolled to last time).
    private ElementReference _sideRef;
    private bool _peekMeasured;
    private bool _peekFlipAbove;
    private double? _peekMaxHeightPx;

    // Breathing room between the peek's own far edge and the CLIPPING
    // boundary -- F1 fix round (reviewer live-repro): that boundary is the
    // enclosing `.popover`'s own edge, never the viewport (see
    // reader.js's own getElementRect doc comment for the full "why" --
    // .popover is routinely shorter than the viewport, vertically
    // centered with its own max-height:calc(100vh - 4rem), so budgeting
    // against window.innerHeight silently OVER-estimates real room and
    // lets an expanded peek spill past the popover's own bottom edge with
    // its internal scrollbar never engaging). Deliberately a little more
    // generous than the CSS .4rem (6.4px) gap between the wrapper and the
    // peek itself (app.css), so this estimate errs toward a SLIGHTLY
    // smaller max-height than the theoretical maximum rather than risking
    // a hairline clip; the only visible cost of erring small is that the
    // internal scroll (app.css's own overflow-y:auto) engages a few px
    // sooner than strictly necessary, never an actual overflow.
    private const double PeekMarginPx = 12;

    private string? PeekStyle => _peekMaxHeightPx is double h
        ? $"--peek-max-height:{h.ToString(CultureInfo.InvariantCulture)}px;"
        : null;

    // PEEK-TRUNC-1 fix round -- a real, live-caught bug (reproduced and
    // root-caused via an isolated repro, not guessed; reader.js's own
    // isPointInsideEither has the full mechanism writeup): clicking
    // RevealControls' own `less` can remove the EXACT element the pointer
    // is resting on (Shown returns to Default, `less` itself -- and,
    // moving back under Step, one or more verses -- disappear in the same
    // render). That breaks the BROWSER's own pointerenter/pointerleave
    // transition tracking for this component's wrapper: the next genuine
    // departure silently never fires OnPointerLeave at all, leaving the
    // peek stuck open. _pointerDownX/Y capture WHERE the pointer was for
    // whatever gesture is currently in flight; _recentPointerDown gates
    // OnPeekShownChanged's own re-verification to ONLY a genuine, JUST-
    // happened MOUSE interaction (a keyboard activation -- Enter/Space on
    // a focused reveal-control button -- dispatches no pointer event at
    // all, so this never fires for one) -- "keyboard/commit paths
    // unaffected" extends to this fallback too, not only the ordinary
    // dwell/commit paths decision 3 already names; without this gate, a
    // keyboard user's own unrelated, stationary mouse position could
    // wrongly read as "moved away" and schedule a dismiss out from under
    // them. Consumed exactly once per pointerdown (reset immediately in
    // OnPeekShownChanged) so a LATER, unrelated render is never
    // re-checked against a stale position.
    private double? _pointerDownX;
    private double? _pointerDownY;
    private bool _recentPointerDown;

    private void OnWrapperPointerDown(PointerEventArgs e)
    {
        _pointerDownX = e.ClientX;
        _pointerDownY = e.ClientY;
        _recentPointerDown = true;
    }

    // RevealControls' own ShownChanged target -- see this property's
    // sibling fields immediately above for the full "why re-verify at
    // all" story. Never dismisses immediately on its own finding: a
    // content-shrink landing the STATIONARY pointer just outside the
    // peek's own new, smaller bounds schedules the SAME ordinary grace-
    // period dismiss a real pointerleave would (ScheduleDismiss, not
    // HidePeekState directly) -- reads to the user as "you moved away,"
    // never an abrupt snap-shut the instant their own click happens to
    // shrink the box out from under a pointer that never actually moved.
    private async Task OnPeekShownChanged(int shown)
    {
        _peekShown = shown;

        if (!_recentPointerDown || _pointerDownX is not double x || _pointerDownY is not double y)
        {
            return;
        }
        _recentPointerDown = false; // consumed -- see the field's own doc comment

        try
        {
            var readerJs = await JS.InvokeAsync<IJSObjectReference>("import", "./js/reader.js");
            var stillInside = await readerJs.InvokeAsync<bool>("isPointInsideEither", _sideRef, x, y);
            if (!stillInside && _showPeek)
            {
                ScheduleDismiss();
            }
        }
        catch (Exception)
        {
            // Nicety, not load-bearing -- same graceful-degradation stance
            // every other measurement in this component already takes.
        }
    }

    private void OnPointerEnter()
    {
        if (Adjacent is null)
        {
            return; // the empty-placeholder side (this narrative/direction has no neighbor) -- nothing to peek at
        }

        // Corridor: re-entering the wrapper -- which fires for the arrow
        // itself, the peek box (a DOM descendant, see this file's own
        // header comment), or the transit gap's own leave+enter blip alike
        // -- always cancels any pending grace-close first.
        CancelDismiss();
        if (_showPeek)
        {
            return; // already showing -- nothing else to (re-)start
        }

        CancelDwell();
        var cts = new CancellationTokenSource();
        _dwellCts = cts;
        _ = DwellThenPeek(cts);
    }

    private void OnPointerLeave()
    {
        if (_showPeek)
        {
            ScheduleDismiss(); // PEEK-TRUNC-1 corridor -- give a real transit into the box a moment to land before hiding it
            return;
        }

        CancelDwell(); // still just mid-dwell, never shown yet -- PEEK-1's own "quick pass-over -> nothing" law, unchanged, no grace needed here
    }

    private void CancelDwell()
    {
        _dwellCts?.Cancel();
        _dwellCts = null;
    }

    private async Task DwellThenPeek(CancellationTokenSource cts)
    {
        try
        {
            await Task.Delay(DwellTiming.PeekDelayMs, cts.Token);
        }
        catch (TaskCanceledException)
        {
            return; // left before the dwell delay elapsed -- exactly "quick pass-over -> nothing"
        }

        if (cts.IsCancellationRequested || Adjacent is null)
        {
            return;
        }

        try
        {
            _peekVerses = await VerseTextResolver.ResolveGroupsAsync(Atlas, Adjacent.VerseGroups);
        }
        catch (Exception)
        {
            _peekVerses = new List<PassageListVerse>(); // fail soft -- same graceful-degradation policy every other lazy fetch in this app follows
        }

        if (cts.IsCancellationRequested)
        {
            return; // the pointer left WHILE the verse text was in flight -- never flip a dismissed peek back on
        }

        _peekShown = 1; // PEEK-TRUNC-1: every fresh peek starts back at the one-verse floor
        _peekTruncatedBy = ComputeTruncatedBy(_peekVerses); // F2 fix round -- see that method's own doc comment
        _peekMeasured = false; // a fresh measurement for THIS open -- see OnAfterRenderAsync
        _showPeek = true;
        StateHasChanged();
    }

    private void ScheduleDismiss()
    {
        CancelDismiss();
        var cts = new CancellationTokenSource();
        _dismissCts = cts;
        _ = DelayedDismiss(cts);
    }

    private void CancelDismiss()
    {
        _dismissCts?.Cancel();
        _dismissCts = null;
    }

    private async Task DelayedDismiss(CancellationTokenSource cts)
    {
        try
        {
            await Task.Delay(PeekDismissGraceMs, cts.Token);
        }
        catch (TaskCanceledException)
        {
            return; // re-entered (arrow or box) before the grace period elapsed -- CancelDismiss already ran
        }

        if (cts.IsCancellationRequested)
        {
            return;
        }

        HidePeekState();
        StateHasChanged();
    }

    private void HidePeekState()
    {
        _showPeek = false;
        _peekShown = 1;
        _peekTruncatedBy = 0;
        _peekMeasured = false;
        _peekFlipAbove = false;
        _peekMaxHeightPx = null;
        _recentPointerDown = false; // a fresh peek session never re-verifies against a pointerdown from a PRIOR one
    }

    // PEEK-TRUNC-1 placement -- see this file's own header comment for the
    // full "why getElementRect, why once per open" story. Runs after EVERY
    // render (ordinary Blazor lifecycle), but the _peekMeasured guard makes
    // it a real no-op except for the one render immediately after a fresh
    // peek opens.
    //
    // F1 fix round (reviewer live-repro, real bug -- default one-verse peek
    // was fine, but clicking `all` on a many-verse peek spilled the peek
    // ~269px past the enclosing .popover's own bottom edge, its internal
    // scrollbar never engaging because its budget had come from
    // window.innerHeight instead): spaceBelow/spaceAbove now budget
    // against r.PopoverBottom/r.PopoverTop (reader.js's own getElementRect,
    // measured off the .popover ancestor -- see that function's own doc
    // comment for why THAT, not the viewport, is the real clipping
    // boundary), never r.ViewportHeight. Both the FLIP decision and the
    // max-height budget read off the SAME corrected boundary, so a
    // subsequently-expanded peek (more/all clicked after the initial
    // flip/cap decision already landed) still fits: max-height is set to
    // the FULL room available on the chosen side up front, not derived
    // from the one-verse default's own smaller natural height, so
    // expanding never needs a second measurement.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_showPeek || _peekMeasured || Adjacent is null)
        {
            return;
        }

        _peekMeasured = true;
        try
        {
            var readerJs = await JS.InvokeAsync<IJSObjectReference>("import", "./js/reader.js");
            var rect = await readerJs.InvokeAsync<ElementRectDto?>("getElementRect", _sideRef);
            // Re-check _showPeek -- the pointer may already have left (and
            // HidePeekState already run, see ScheduleDismiss/CancelDismiss
            // above) while this measurement was in flight; never flip a
            // dismissed peek back on just because a stale measurement
            // landed late.
            if (rect is { } r && _showPeek)
            {
                var spaceBelow = r.PopoverBottom - (r.Top + r.Height) - PeekMarginPx;
                var spaceAbove = r.Top - r.PopoverTop - PeekMarginPx;
                _peekFlipAbove = spaceBelow < spaceAbove;
                _peekMaxHeightPx = Math.Max(_peekFlipAbove ? spaceAbove : spaceBelow, 0);
                StateHasChanged();
            }
        }
        catch (Exception)
        {
            // Positioning is a nicety, not load-bearing -- same graceful-
            // degradation stance ExplorerPopover's own verse/pane rect
            // measurement takes (see that file's own comment): a failed
            // measurement just leaves the peek at its default below/
            // unbounded rendering for that one instant instead of flipping
            // or capping it.
        }
    }

    // F2 fix round (reviewer finding: the server's own 20-verse-per-chapter
    // cap -- HOTFIX-4's GroupCount field, already flowing through every
    // _peekVerses entry via VerseTextResolver.ResolveGroupsAsync, just
    // never READ here -- was silently dropped once the peek stopped
    // rendering through PassageList/PassageBlockBuilder, which is the ONLY
    // other place in this app that turns GroupCount into an honest
    // disclosure). Mirrors PassageBlockBuilder's OWN computation
    // (Explore/PassageBlock.cs: "find, per distinct (book,chapter)
    // GroupCount actually present... the block reaching that group's own
    // HIGHEST verse number"), applied FLATLY here since the peek has no
    // block grouping of its own to hang a per-block TruncatedBy off --
    // for each distinct (book,chapter) origin actually represented among
    // _peekVerses, the server's own true count (GroupCount -- identical on
    // every verse from that one group, VerseTextResolver's own doc comment
    // has the full "attached from whichever VerseGroup it came from"
    // story) minus how many of that group's own verses actually made it
    // into this list is real, permanently missing text this peek can never
    // reveal via more/all -- the WIRE itself never sent it
    // (scene::verse_groups_for's own take(20) truncates server-side,
    // before this component ever asks). Summed across every distinct
    // group actually present, in case an event's own verse groups ever
    // span more than one chapter (rare, but this must stay honest either
    // way, not just for the single-group common case).
    private static int ComputeTruncatedBy(IReadOnlyList<PassageListVerse> verses)
    {
        var byGroup = new Dictionary<(string Book, int Chapter), (int Delivered, int? TrueCount)>();
        foreach (var v in verses)
        {
            var (book, chapter, _) = CanonRef.ParseVerse(v.Vref);
            var key = (book, chapter);
            var existing = byGroup.GetValueOrDefault(key, (0, null));
            byGroup[key] = (existing.Delivered + 1, v.GroupCount ?? existing.TrueCount);
        }

        var missing = 0;
        foreach (var (_, entry) in byGroup)
        {
            if (entry.TrueCount is int trueCount && trueCount > entry.Delivered)
            {
                missing += trueCount - entry.Delivered;
            }
        }
        return missing;
    }

    // Mirrors ExplorerPopover's own VerseAnchorRectDto/PaneRectDto -- a
    // small, file-scoped, PRIVATE DTO per consumer rather than a shared
    // type, the same "these overlap but stay separate" call SplitDivider's
    // own PaneRectDto already makes (see that file's own comment) for the
    // identical reasoning: nothing outside this file needs this shape, and
    // a shared type would only couple two otherwise-independent
    // measurement call sites for no real benefit.
    //
    // F1 fix round: PopoverTop/PopoverBottom replace the original
    // ViewportWidth/ViewportHeight -- see reader.js's own getElementRect
    // doc comment for why the enclosing .popover, not the viewport, is
    // this box's real clipping boundary. ViewportWidth was never actually
    // read anywhere in this file (this peek is left/right-anchored by CSS
    // off the arrow's own side, never viewport-centered, unlike
    // ExplorerPopover's own verse-anchoring) -- dropped rather than kept
    // unused.
    private sealed record ElementRectDto(double Left, double Top, double Width, double Height, double PopoverTop, double PopoverBottom);

    // F3 fix round (reviewer, verified harmless today, fixed for symmetry
    // anyway): Commit() already calls HidePeekState() before tearing down
    // via navigation; Dispose() -- the OTHER path this component's own
    // state can end on (the popover re-resolving its sections for a
    // DIFFERENT reason, e.g. a mention click elsewhere pushing a new node)
    // -- now does too, so every disposal path leaves this instance's own
    // fields in the identical, fully-reset shape, not just its two
    // cancellation tokens.
    public void Dispose()
    {
        CancelDwell();
        CancelDismiss();
        HidePeekState();
    }
}
